<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Granary.MpvSpike.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="Black" Loaded="OnRootLoaded">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Space" Invoked="OnPlayPauseAccelerator" />
            <KeyboardAccelerator Key="F" Invoked="OnFullscreenAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- Video area: SwapChainPanel for variants A and C, plain host element for variant B. -->
        <SwapChainPanel x:Name="VideoPanel" SizeChanged="OnVideoAreaChanged" CompositionScaleChanged="OnCompositionScaleChanged" />
        <Border x:Name="VideoHost" SizeChanged="OnVideoAreaChanged" />

        <!-- Status line, top left: shows whether XAML is drawn on top of the video. -->
        <TextBlock x:Name="Info" Margin="16" Padding="8,4" VerticalAlignment="Top" HorizontalAlignment="Left"
                   Foreground="White" FontFamily="Consolas" FontSize="13" />

        <!-- Transport controls overlay. -->
        <Grid x:Name="Overlay" VerticalAlignment="Bottom" Margin="24" Padding="16,10" CornerRadius="8"
              Background="#B0202020" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayPauseButton" Content="Pause" Width="88" Click="OnPlayPauseClick" />
            <Slider x:Name="SeekBar" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.1"
                    VerticalAlignment="Center" ValueChanged="OnSeekBarValueChanged" />
            <TextBlock x:Name="TimeText" Grid.Column="2" VerticalAlignment="Center" Foreground="White"
                       FontFamily="Consolas" Text="0:00 / 0:00" />
            <Button x:Name="FullscreenButton" Grid.Column="3" Content="Fullscreen" Click="OnFullscreenClick" />
        </Grid>
    </Grid>
</Window>
