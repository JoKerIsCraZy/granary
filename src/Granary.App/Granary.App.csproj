<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 shell. Unpackaged and self-contained Windows App SDK, so it runs without an installer. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Granary.App</RootNamespace>
    <AssemblyName>Granary</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Unpackaged too: the MSIX tooling puts the app's resources (Granary.pri, the compiled .xbf) in a published copy. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Granary's own icon (Assets/Logo): the window and the taskbar take it too (MainWindow). -->
    <ApplicationIcon>Assets\Logo\granary.ico</ApplicationIcon>
    <!-- Program.Main starts Velopack before WinUI, so the XAML compiler's own Main stays out. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!--
      The GitHub repository installed copies look for updates in (docs/release.md), for example
      https://github.com/owner/granary. Empty, as in development builds: no update checks. The release workflow sets it.
    -->
    <GranaryUpdateRepository Condition="'$(GranaryUpdateRepository)' == ''"></GranaryUpdateRepository>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GranaryUpdateRepository" Value="$(GranaryUpdateRepository)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Granary.Core\Granary.Core.csproj" />
    <ProjectReference Include="..\Granary.Player\Granary.Player.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <!-- Plus Jakarta Sans (SIL OFL 1.1, Assets/Fonts/OFL.txt), the typeface of Silo's web client. -->
  <ItemGroup>
    <Content Include="Assets\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Silo's mark, unmodified, to refer to Silo where a server is added and signed in to (Assets/Brand/NOTICE.txt). -->
    <Content Include="Assets\Brand\silo-mark-flat.svg" CopyToOutputDirectory="PreserveNewest" />
    <!-- Granary's own mark and icon; Assets/Logo/granary-icon.svg is the icon's source. -->
    <Content Include="Assets\Logo\granary-mark.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Logo\granary.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The AGPL asks that every copy carry the license; the notices name what else ships and whose work it holds. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- libmpv comes from native/ (scripts/fetch-native.ps1), it is not committed. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\native\libmpv\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\libmpv\libmpv-2.dll')" />
  </ItemGroup>

  <Target Name="WarnMissingLibmpv" BeforeTargets="Build" Condition="!Exists('$(MSBuildThisFileDirectory)..\..\native\libmpv\libmpv-2.dll')">
    <Warning Text="native/libmpv/libmpv-2.dll is missing. Run scripts/fetch-native.ps1, otherwise playback fails at runtime." />
  </Target>

</Project>
