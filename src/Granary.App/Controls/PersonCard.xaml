<?xml version="1.0" encoding="utf-8"?>
<!--
    A person found by Search, as the web's CastCarousel card: 110 px wide, a 2:3 photo with 12 px corners (initials on the
    surface while there is none), the name 10 px under it in 13 px medium, on one line. Interaction belongs to the button
    around it.
-->
<UserControl
    x:Class="Granary.App.Controls.PersonCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="110">

    <StackPanel Spacing="10">
        <Grid Height="165" CornerRadius="12" Background="{StaticResource SiloSurfaceBrush}">
            <TextBlock Text="{x:Bind Person.Initials, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="18"
                       Foreground="{StaticResource SiloMutedBrush}" AutomationProperties.AccessibilityView="Raw" />
            <Image x:Name="Photo" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
        </Grid>
        <TextBlock Text="{x:Bind Person.Name, Mode=OneWay}" Padding="2,0" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="13"
                   Foreground="{StaticResource SiloForegroundBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" />
    </StackPanel>
</UserControl>
