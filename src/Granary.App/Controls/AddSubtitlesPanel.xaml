<?xml version="1.0" encoding="utf-8"?>
<!--
    The web player's Add Subtitles dialog (SubtitleSearchModal with the player's SubtitleUploadForm): a 480 px card on a
    dark backdrop; upload first (a dashed drop zone, the language and HI, Upload), then Search online with its results.
    A click beside the card, ✕ or Esc closes it; Tab stays inside.
-->
<UserControl
    x:Class="Granary.App.Controls.AddSubtitlesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:player="using:Granary.Core.ViewModels.Player"
    RequestedTheme="Dark">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF262626" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF2E2E2E" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FF2E2E2E" />
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FF262626" />
        <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#FF262626" />
        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#FF262626" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#B3FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushUnfocused" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF1C1C1C" />

        <Style x:Key="PanelComboBoxStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- The web's bg-white/10 buttons: Upload and Search. -->
        <Style x:Key="PanelButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPlayerIconButtonStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="controls:Pill.IsEnabled" Value="False" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- A search result: white/5, lighter under the pointer. -->
        <Style x:Key="ResultButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPlayerMenuItemStyle}">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Backdrop" Background="#CC000000" Tapped="OnBackdropTapped" KeyDown="OnPanelKeyDown">
        <Border x:Name="Card" MaxWidth="480" Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="8"
                Background="#FF171717" Tapped="OnCardTapped" TabFocusNavigation="Cycle" AutomationProperties.Name="Add Subtitles">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header. -->
                <Grid Padding="16,10,10,10" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
                    <TextBlock Text="Add Subtitles" VerticalAlignment="Center" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                               FontSize="14" AutomationProperties.HeadingLevel="Level1" />
                    <Button x:Name="CloseButton" Width="28" Height="28" HorizontalAlignment="Right" Style="{StaticResource SiloPlayerIconButtonStyle}"
                            CornerRadius="4" controls:Pill.IsEnabled="False" Foreground="#99FFFFFF" Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}"
                            AutomationProperties.Name="Close" ToolTipService.ToolTip="Close (Esc)">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>

                <!-- Upload. -->
                <StackPanel Grid.Row="1" Padding="16,12" Spacing="12" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Upload subtitle" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="14" />
                        <TextBlock Text="Drag and drop or browse for SRT, VTT, ASS, SSA, or SUB files up to 5 MB. Language is detected automatically when possible."
                                   FontSize="12" Foreground="#80FFFFFF" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button x:Name="DropZone" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0"
                            Style="{StaticResource SiloPlayerMenuItemStyle}" CornerRadius="8" Background="#0DFFFFFF"
                            AllowDrop="True" DragEnter="OnDropZoneDragEnter" DragOver="OnDropZoneDragOver" DragLeave="OnDropZoneDragLeave" Drop="OnDropZoneDrop"
                            Click="OnBrowseClick" PointerEntered="OnDropZonePointerEntered" PointerExited="OnDropZonePointerExited"
                            AutomationProperties.Name="Drop subtitle file here or browse">
                        <Grid>
                            <Rectangle x:Name="DropZoneEdge" RadiusX="8" RadiusY="8" Stroke="#33FFFFFF" StrokeThickness="1" StrokeDashArray="4,3" />
                            <StackPanel Padding="16,24" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE898;" FontSize="20" Foreground="#B3FFFFFF" />
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="DropZoneTitle" Text="Drag and drop a subtitle file" HorizontalAlignment="Center"
                                               FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="14" Foreground="White" />
                                    <TextBlock Text="or click to browse" HorizontalAlignment="Center" FontSize="12" Foreground="#80FFFFFF" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <StackPanel Spacing="8">
                        <StackPanel Spacing="4">
                            <ComboBox Style="{StaticResource PanelComboBoxStyle}" ItemsSource="{x:Bind ViewModel.UploadLanguages, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.UploadLanguage, Mode=TwoWay}" IsEnabled="{x:Bind Not(ViewModel.IsDetecting), Mode=OneWay}"
                                      AutomationProperties.Name="Upload language" />
                            <TextBlock Text="{x:Bind ViewModel.DetectionText, Mode=OneWay}" FontSize="12" Foreground="#80FFFFFF"
                                       Visibility="{x:Bind Shows(ViewModel.DetectionText), Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <CheckBox Content="Hearing impaired (HI)" FontSize="12" Foreground="#B3FFFFFF" MinHeight="24" Padding="8,0,0,0"
                                  CornerRadius="3" VerticalContentAlignment="Center" IsChecked="{x:Bind ViewModel.HearingImpaired, Mode=TwoWay}" />
                        <Button x:Name="UploadButton" Style="{StaticResource PanelButtonStyle}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.UploadCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanUpload, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.UploadText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid Width="16" Height="16">
                                    <FontIcon Glyph="&#xE898;" FontSize="14" Visibility="{x:Bind Hides(ViewModel.IsUploading), Mode=OneWay}" />
                                    <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsUploading, Mode=OneWay}" Foreground="White" />
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.UploadText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{x:Bind SelectedText(ViewModel.FileName), Mode=OneWay}" FontSize="12" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind ViewModel.HasFile, Mode=OneWay}" />
                    <Border Padding="12,8" CornerRadius="4" Background="#667F1D1D" Visibility="{x:Bind Shows(ViewModel.UploadError), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.UploadError, Mode=OneWay}" FontSize="12" Foreground="#FFFCA5A5" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </Border>
                </StackPanel>

                <!-- Search online. -->
                <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.IsOnlineSearchEnabled, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Padding="16,8" Text="Search online" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="12"
                               Foreground="#99FFFFFF" AutomationProperties.HeadingLevel="Level2" />
                    <Border Height="1" VerticalAlignment="Bottom" Background="#1AFFFFFF" />
                    <Grid Grid.Row="1" Padding="16,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SearchLanguageBox" Style="{StaticResource PanelComboBoxStyle}" ItemsSource="{x:Bind ViewModel.SearchLanguages, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SearchLanguage, Mode=TwoWay}" AutomationProperties.Name="Language" />
                        <Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource PanelButtonStyle}" Command="{x:Bind ViewModel.SearchCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind Not(ViewModel.IsSearching), Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.SearchText, Mode=OneWay}" />
                        </Button>
                    </Grid>
                    <Border Grid.Row="2" Margin="16,0,16,12" Padding="12,8" CornerRadius="4" Background="#667F1D1D"
                            Visibility="{x:Bind Shows(ViewModel.SearchError), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.SearchError, Mode=OneWay}" FontSize="12" Foreground="#FFFCA5A5" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </Border>
                    <ItemsControl Grid.Row="3" Margin="16,0,16,8" ItemsSource="{x:Bind ViewModel.Warnings, Mode=OneWay}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Margin="0,0,0,4" Padding="12,6" CornerRadius="4" Background="#66713F12">
                                    <TextBlock Text="{x:Bind}" FontSize="12" Foreground="#FFFDE047" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ScrollViewer x:Name="ResultsScroller" Grid.Row="4" Padding="16,0,16,16" HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Padding="0,24" Text="Select a language and press Search." HorizontalAlignment="Center" FontSize="12" Foreground="#66FFFFFF"
                                       Visibility="{x:Bind ViewModel.ShowsSearchHint, Mode=OneWay}" />
                            <ItemsControl x:Name="ResultRows" ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="player:SubtitleSearchRow">
                                        <Button Style="{StaticResource ResultButtonStyle}" Click="OnResultClick" IsEnabled="{x:Bind CanDownload, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind AccessibleName}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Padding="6,1,6,2" CornerRadius="4" BorderThickness="1" VerticalAlignment="Center"
                                                        Background="{x:Bind controls:AddSubtitlesPanel.Fill(ScoreColor)}"
                                                        BorderBrush="{x:Bind controls:AddSubtitlesPanel.Edge(ScoreColor)}">
                                                    <TextBlock Text="{x:Bind ScoreText}" FontSize="12" FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold"
                                                               Typography.NumeralAlignment="Tabular" Foreground="{x:Bind controls:AddSubtitlesPanel.Solid(ScoreColor)}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind ReleaseName}" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ReleaseName}" />
                                                <Border Grid.Column="2" Padding="4,1,4,2" CornerRadius="4" Background="#1AFFFFFF" VerticalAlignment="Center"
                                                        Visibility="{x:Bind IsHearingImpaired}">
                                                    <TextBlock Text="HI" FontSize="10" Foreground="#99FFFFFF" />
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{x:Bind DownloadsText}" FontSize="10" Foreground="#66FFFFFF" VerticalAlignment="Center"
                                                           Typography.NumeralAlignment="Tabular" />
                                                <Border Grid.Column="4" Padding="6,1,6,2" CornerRadius="4" BorderThickness="1" VerticalAlignment="Center"
                                                        Background="{x:Bind controls:AddSubtitlesPanel.Fill(ProviderColor)}"
                                                        BorderBrush="{x:Bind controls:AddSubtitlesPanel.Edge(ProviderColor)}">
                                                    <TextBlock Text="{x:Bind ProviderText}" Style="{StaticResource BadgeTextStyle}"
                                                               Foreground="{x:Bind controls:AddSubtitlesPanel.Solid(ProviderColor)}" />
                                                </Border>
                                                <ProgressRing Grid.Column="5" Width="12" Height="12" Foreground="#99FFFFFF" IsActive="{x:Bind IsDownloading, Mode=OneWay}"
                                                              AutomationProperties.Name="Downloading" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
