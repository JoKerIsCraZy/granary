<?xml version="1.0" encoding="utf-8"?>
<!-- A cast or crew card: 2:3 photo (initials without one), name, then role or character. Not interactive yet: there is no person page. -->
<UserControl
    x:Class="Granary.App.Controls.PersonCreditCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="120">

    <StackPanel Spacing="10">
        <Grid Height="180" CornerRadius="{StaticResource SiloCardCornerRadius}" Background="{StaticResource SiloSurfaceBrush}"
              BorderBrush="#0DFFFFFF" BorderThickness="1">
            <TextBlock x:Name="InitialsText" Text="{x:Bind Person.Initials, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="22"
                       Foreground="{StaticResource SiloMutedBrush}" AutomationProperties.AccessibilityView="Raw" />
            <Image x:Name="Photo" Stretch="UniformToFill" ImageOpened="OnPhotoOpened" ImageFailed="OnPhotoFailed"
                   AutomationProperties.AccessibilityView="Raw" />
        </Grid>
        <StackPanel Spacing="2" Padding="2,0">
            <TextBlock Text="{x:Bind Person.Name, Mode=OneWay}" Style="{StaticResource SiloCardTitleTextStyle}" FontSize="13" />
            <TextBlock Text="{x:Bind Person.Role, Mode=OneWay}" Style="{StaticResource SiloCaptionTextStyle}" FontSize="11"
                       Visibility="{x:Bind Shows(Person.Role), Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>
