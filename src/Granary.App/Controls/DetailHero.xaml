<?xml version="1.0" encoding="utf-8"?>
<!--
    The top of the detail page (docs/ui-design.md): laid out as Silage's title page, on the backdrop the page itself draws
    behind its scrolling content. The logo (or the title), one line of facts, the tagline and four lines of overview, then
    Granary's own buttons at a larger size and the file's short facts. Chips, ratings, credits and the files' details are
    in the Info dialog. Below 1400 px of window everything steps down a size, so a 1280 window keeps it whole; the step
    sets sizes rather than styles, so a button keeps its focus when the window crosses it.
-->
<UserControl
    x:Class="Granary.App.Controls.DetailHero"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:detail="using:Granary.Core.ViewModels.Detail">

    <UserControl.Resources>
        <SolidColorBrush x:Key="DetailMetaBrush" Color="#99EDEDED" />
        <SolidColorBrush x:Key="DetailTextBrush" Color="#F2EDEDED" />
        <SolidColorBrush x:Key="DetailFaintBrush" Color="#73EDEDED" />
        <SolidColorBrush x:Key="DetailCreditLabelBrush" Color="#99A4A4AE" />
        <SolidColorBrush x:Key="DetailCreditSeparatorBrush" Color="#FF5C5C66" />

        <!-- Granary's own buttons, one size class up: 60 high pills and 60 round icons, 20 px labels. -->
        <Style x:Key="HeroPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPrimaryButtonStyle}">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="22,8,28,8" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style x:Key="HeroSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="22,8,28,8" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style x:Key="HeroIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloIconButtonStyle}">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="60" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SizeStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1400" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Column.Padding" Value="48,96,48,0" />
                        <Setter Target="Column.Spacing" Value="14" />
                        <Setter Target="Logo.MaxHeight" Value="136" />
                        <Setter Target="Logo.MaxWidth" Value="504" />
                        <Setter Target="TitleText.FontSize" Value="48" />
                        <Setter Target="TitleText.LineHeight" Value="52" />
                        <Setter Target="TitleText.MaxWidth" Value="720" />
                        <Setter Target="SubtitleText.FontSize" Value="16" />
                        <Setter Target="MetaText.FontSize" Value="16" />
                        <Setter Target="TaglineText.FontSize" Value="16" />
                        <Setter Target="TaglineText.MaxWidth" Value="720" />
                        <Setter Target="OverviewText.FontSize" Value="15" />
                        <Setter Target="OverviewText.LineHeight" Value="23" />
                        <Setter Target="OverviewText.MaxWidth" Value="720" />
                        <Setter Target="Buttons.Spacing" Value="12" />
                        <Setter Target="Buttons.Margin" Value="0,6,0,0" />
                        <Setter Target="PlayButton.MinHeight" Value="48" />
                        <Setter Target="PlayButton.Padding" Value="16,6,22,6" />
                        <Setter Target="PlayButton.FontSize" Value="16" />
                        <Setter Target="WatchedButton.MinHeight" Value="48" />
                        <Setter Target="WatchedButton.Padding" Value="16,6,22,6" />
                        <Setter Target="WatchedButton.FontSize" Value="16" />
                        <Setter Target="InfoButton.MinHeight" Value="48" />
                        <Setter Target="InfoButton.Padding" Value="16,6,22,6" />
                        <Setter Target="InfoButton.FontSize" Value="16" />
                        <Setter Target="StartOverButton.Width" Value="48" />
                        <Setter Target="StartOverButton.Height" Value="48" />
                        <Setter Target="FavoriteButton.Width" Value="48" />
                        <Setter Target="FavoriteButton.Height" Value="48" />
                        <Setter Target="MoreButton.Width" Value="48" />
                        <Setter Target="MoreButton.Height" Value="48" />
                        <Setter Target="PlayIcon.FontSize" Value="18" />
                        <Setter Target="StartOverIcon.FontSize" Value="18" />
                        <Setter Target="WatchedIcon.FontSize" Value="18" />
                        <Setter Target="InfoIcon.FontSize" Value="18" />
                        <Setter Target="FavoriteIcon.FontSize" Value="18" />
                        <Setter Target="MoreIcon.FontSize" Value="18" />
                        <Setter Target="VersionText.FontSize" Value="13" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel x:Name="Column" Padding="48,120,48,0" Spacing="18" HorizontalAlignment="Left">
            <ItemsRepeater Margin="-4,0,0,0" ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.HasBreadcrumbs, Mode=OneWay}" AutomationProperties.Name="Breadcrumb">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="2" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="detail:DetailCrumb">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <FontIcon Glyph="&#xE76C;" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource DetailCreditSeparatorBrush}"
                                      Visibility="{x:Bind controls:DetailHero.Not(IsFirst)}" AutomationProperties.AccessibilityView="Raw" />
                            <HyperlinkButton Padding="4,2" Click="OnCrumbClick" Visibility="{x:Bind IsLink}" DataContext="{x:Bind}"
                                             Foreground="{StaticResource SiloMutedBrush}" FontSize="14">
                                <TextBlock Text="{x:Bind Label}" />
                            </HyperlinkButton>
                            <TextBlock Margin="4,0" VerticalAlignment="Center" Text="{x:Bind Label}" FontSize="14"
                                       Foreground="{StaticResource DetailCreditLabelBrush}" Visibility="{x:Bind controls:DetailHero.Not(IsLink)}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!--
                The logo stands in for the title, at most 170 high and 70 % of the text's width, and takes no room until it is
                in (or when it fails and the title takes its place); screen readers still get the title.
            -->
            <Image x:Name="Logo" MaxHeight="170" MaxWidth="630" HorizontalAlignment="Left" Stretch="Uniform"
                   Source="{x:Bind controls:DetailHero.LoadImage(ViewModel.LogoUrl, 640), Mode=OneWay}" ImageFailed="OnLogoFailed"
                   Visibility="{x:Bind ViewModel.ShowsLogo, Mode=OneWay}"
                   AutomationProperties.Name="{x:Bind ViewModel.DisplayTitle, Mode=OneWay}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="TitleText" MaxWidth="900" HorizontalAlignment="Left" Text="{x:Bind ViewModel.DisplayTitle, Mode=OneWay}"
                       FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="60" LineHeight="64" TextWrapping="Wrap"
                       MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="{x:Bind ViewModel.ShowsTitleText, Mode=OneWay}"
                       AutomationProperties.HeadingLevel="Level1" />

            <TextBlock x:Name="SubtitleText" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontFamily="{StaticResource SiloFontMedium}"
                       FontWeight="Medium" FontSize="20" Foreground="{StaticResource DetailMetaBrush}"
                       Visibility="{x:Bind controls:DetailHero.Shows(ViewModel.Subtitle), Mode=OneWay}" />
            <TextBlock x:Name="MetaText" Text="{x:Bind ViewModel.MetaLine, Mode=OneWay}" FontSize="20" Foreground="{StaticResource DetailMetaBrush}"
                       TextWrapping="Wrap" Visibility="{x:Bind controls:DetailHero.Shows(ViewModel.MetaLine), Mode=OneWay}" />
            <TextBlock x:Name="TaglineText" MaxWidth="900" HorizontalAlignment="Left" Text="{x:Bind ViewModel.Tagline, Mode=OneWay}"
                       FontFamily="{StaticResource SiloFontItalic}" FontStyle="Italic" FontSize="20" Foreground="{StaticResource DetailTextBrush}"
                       TextWrapping="Wrap" Visibility="{x:Bind controls:DetailHero.Shows(ViewModel.Tagline), Mode=OneWay}" />
            <TextBlock x:Name="OverviewText" MaxWidth="900" HorizontalAlignment="Left" Text="{x:Bind ViewModel.Overview, Mode=OneWay}"
                       FontSize="19" LineHeight="29" Foreground="{StaticResource DetailTextBrush}" TextWrapping="Wrap" MaxLines="4"
                       TextTrimming="CharacterEllipsis" Visibility="{x:Bind ViewModel.HasOverview, Mode=OneWay}" />

            <StackPanel x:Name="Buttons" Margin="0,8,0,0" Orientation="Horizontal" Spacing="16">
                <Button x:Name="PlayButton" Style="{StaticResource HeroPrimaryButtonStyle}" Command="{x:Bind ViewModel.PlayCommand}"
                        AutomationProperties.Name="{x:Bind ViewModel.PlayButtonText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xF5B0;" FontSize="24" />
                        <TextBlock Text="{x:Bind ViewModel.PlayButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button x:Name="StartOverButton" Style="{StaticResource HeroIconButtonStyle}" Command="{x:Bind ViewModel.StartOverCommand}"
                        Visibility="{x:Bind ViewModel.CanStartOver, Mode=OneWay}"
                        AutomationProperties.Name="Start over" ToolTipService.ToolTip="Start over">
                    <FontIcon x:Name="StartOverIcon" Glyph="&#xE72C;" FontSize="22" />
                </Button>
                <Button x:Name="WatchedButton" Style="{StaticResource HeroSecondaryButtonStyle}" Command="{x:Bind ViewModel.ToggleWatchedCommand}"
                        Visibility="{x:Bind ViewModel.ShowsWatchedAction, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.WatchedLabel, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon x:Name="WatchedIcon" Glyph="&#xE73E;" FontSize="24" />
                        <TextBlock Text="{x:Bind ViewModel.WatchedLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button x:Name="InfoButton" Style="{StaticResource HeroSecondaryButtonStyle}" Click="OnInfoClick"
                        AutomationProperties.Name="Info: details, cast, crew and files">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon x:Name="InfoIcon" Glyph="&#xE946;" FontSize="24" />
                        <TextBlock Text="Info" />
                    </StackPanel>
                </Button>
                <Button x:Name="FavoriteButton" Style="{StaticResource HeroIconButtonStyle}" Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        Visibility="{x:Bind ViewModel.CanFavorite, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.FavoriteLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.FavoriteLabel, Mode=OneWay}">
                    <FontIcon x:Name="FavoriteIcon" Glyph="{x:Bind controls:DetailHero.HeartGlyph(ViewModel.IsFavorite), Mode=OneWay}" FontSize="24"
                              Foreground="{x:Bind controls:DetailHero.ActiveForeground(ViewModel.IsFavorite), Mode=OneWay}" />
                </Button>
                <Button x:Name="MoreButton" Style="{StaticResource HeroIconButtonStyle}" Visibility="{x:Bind ViewModel.CanFavorite, Mode=OneWay}"
                        AutomationProperties.Name="More actions" ToolTipService.ToolTip="More actions">
                    <FontIcon x:Name="MoreIcon" Glyph="&#xE712;" FontSize="22" RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="90" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="{x:Bind ViewModel.WatchlistLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleWatchlistCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="{x:Bind controls:DetailHero.WatchlistGlyph(ViewModel.IsInWatchlist), Mode=OneWay}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Add to Collection" Click="OnAddToCollectionClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8F4;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <TextBlock x:Name="VersionText" Text="{x:Bind ViewModel.AvailableVersionLine, Mode=OneWay}" FontSize="16"
                       Foreground="{StaticResource DetailFaintBrush}" TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.HasAvailableVersionLine, Mode=OneWay}" />

            <InfoBar MaxWidth="560" HorizontalAlignment="Left" Severity="Error" IsClosable="True"
                     IsOpen="{x:Bind ViewModel.HasActionError, Mode=OneWay}" Message="{x:Bind ViewModel.ActionError, Mode=OneWay}"
                     CloseButtonClick="OnActionErrorClosed" />
        </StackPanel>
    </Grid>
</UserControl>
