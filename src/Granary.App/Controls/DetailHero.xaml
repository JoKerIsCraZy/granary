<?xml version="1.0" encoding="utf-8"?>
<!--
    The top of the detail page (docs/ui-design.md), on the backdrop the page itself draws
    behind its scrolling content. The logo (or the title), one line of facts, the tagline and four lines of overview, then
    Granary's own buttons at a larger size and the file's short facts. Chips, ratings, credits and the files' details are
    in the Info dialog. Below 1400 px of window everything steps down a size, so a 1280 window keeps it whole; the step
    sets sizes rather than styles, so a button keeps its focus when the window crosses it.
-->
<UserControl
    x:Class="Granary.App.Controls.DetailHero"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:detail="using:Granary.Core.ViewModels.Detail"
    xmlns:vm="using:Granary.Core.ViewModels">

    <UserControl.Resources>
        <SolidColorBrush x:Key="DetailMetaBrush" Color="#99EDEDED" />
        <SolidColorBrush x:Key="DetailTextBrush" Color="#F2EDEDED" />
        <SolidColorBrush x:Key="DetailFaintBrush" Color="#73EDEDED" />
        <SolidColorBrush x:Key="DetailCreditLabelBrush" Color="#99A4A4AE" />
        <SolidColorBrush x:Key="DetailCreditSeparatorBrush" Color="#FF5C5C66" />

        <!-- Granary's own buttons, one size class up: 60 high pills and 60 round icons, 20 px labels. -->
        <Style x:Key="HeroPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPrimaryButtonStyle}">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Padding" Value="18,6,24,6" />
            <Setter Property="FontSize" Value="17" />
        </Style>
        <Style x:Key="HeroSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Padding" Value="18,6,24,6" />
            <Setter Property="FontSize" Value="17" />
        </Style>
        <Style x:Key="HeroIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloIconButtonStyle}">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="50" />
        </Style>

        <!--
            The web's stream pickers under the buttons (ActionBar.tsx): smaller pills with an icon, the label, what is chosen in
            muted text and a chevron; each opens its list as a menu in the player's look. A menu takes its rows as it opens
            (DetailHero.xaml.cs), so an item read again meanwhile does not rebuild it under the viewer.
        -->
        <Style x:Key="DetailPickerButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,6,14,6" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <!-- The web's popover under its picker: dark grey and nearly solid with a hairline edge, so the page's text stays out of it. -->
        <Style x:Key="DetailPickerMenuStyle" TargetType="FlyoutPresenter" BasedOn="{StaticResource SiloPlayerWideMenuStyle}">
            <Setter Property="Background" Value="{StaticResource SiloPlayerPopupBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SiloPlayerPopupBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DetailPickerChoiceTextStyle" TargetType="TextBlock">
            <Setter Property="MaxWidth" Value="300" />
            <Setter Property="FontFamily" Value="{StaticResource SiloFontRegular}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DetailPickerDetailTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#8CFFFFFF" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SizeStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1400" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Column.Padding" Value="48,84,48,0" />
                        <Setter Target="Column.Spacing" Value="12" />
                        <Setter Target="Logo.MaxHeight" Value="116" />
                        <Setter Target="Logo.MaxWidth" Value="430" />
                        <Setter Target="TitleText.FontSize" Value="42" />
                        <Setter Target="TitleText.LineHeight" Value="46" />
                        <Setter Target="TitleText.MaxWidth" Value="720" />
                        <Setter Target="SubtitleText.FontSize" Value="15" />
                        <Setter Target="MetaText.FontSize" Value="15" />
                        <Setter Target="TaglineText.FontSize" Value="15" />
                        <Setter Target="TaglineText.MaxWidth" Value="720" />
                        <Setter Target="OverviewText.FontSize" Value="14" />
                        <Setter Target="OverviewText.LineHeight" Value="22" />
                        <Setter Target="OverviewText.MaxWidth" Value="720" />
                        <Setter Target="Buttons.Spacing" Value="12" />
                        <Setter Target="Buttons.Margin" Value="0,6,0,0" />
                        <Setter Target="PlayButton.MinHeight" Value="44" />
                        <Setter Target="PlayButton.Padding" Value="14,5,20,5" />
                        <Setter Target="PlayButton.FontSize" Value="15" />
                        <Setter Target="WatchedButton.MinHeight" Value="44" />
                        <Setter Target="WatchedButton.Padding" Value="14,5,20,5" />
                        <Setter Target="WatchedButton.FontSize" Value="15" />
                        <Setter Target="InfoButton.MinHeight" Value="44" />
                        <Setter Target="InfoButton.Padding" Value="14,5,20,5" />
                        <Setter Target="InfoButton.FontSize" Value="15" />
                        <Setter Target="StartOverButton.Width" Value="44" />
                        <Setter Target="StartOverButton.Height" Value="44" />
                        <Setter Target="FavoriteButton.Width" Value="44" />
                        <Setter Target="FavoriteButton.Height" Value="44" />
                        <Setter Target="MoreButton.Width" Value="44" />
                        <Setter Target="MoreButton.Height" Value="44" />
                        <Setter Target="PlayIcon.FontSize" Value="16" />
                        <Setter Target="StartOverIcon.FontSize" Value="16" />
                        <Setter Target="WatchedIcon.FontSize" Value="16" />
                        <Setter Target="InfoIcon.FontSize" Value="16" />
                        <Setter Target="FavoriteIcon.FontSize" Value="16" />
                        <Setter Target="MoreIcon.FontSize" Value="16" />
                        <Setter Target="Pickers.Spacing" Value="8" />
                        <Setter Target="VersionPicker.MinHeight" Value="34" />
                        <Setter Target="VersionPicker.FontSize" Value="13" />
                        <Setter Target="AudioPicker.MinHeight" Value="34" />
                        <Setter Target="AudioPicker.FontSize" Value="13" />
                        <Setter Target="SubtitlePicker.MinHeight" Value="34" />
                        <Setter Target="SubtitlePicker.FontSize" Value="13" />
                        <Setter Target="VersionText.FontSize" Value="12" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel x:Name="Column" Padding="48,100,48,0" Spacing="14" HorizontalAlignment="Left">
            <ItemsRepeater Margin="-4,0,0,0" ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.HasBreadcrumbs, Mode=OneWay}" AutomationProperties.Name="Breadcrumb">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="2" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="detail:DetailCrumb">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <FontIcon Glyph="&#xE76C;" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource DetailCreditSeparatorBrush}"
                                      Visibility="{x:Bind controls:DetailHero.Not(IsFirst)}" AutomationProperties.AccessibilityView="Raw" />
                            <HyperlinkButton Padding="4,2" Click="OnCrumbClick" Visibility="{x:Bind IsLink}" DataContext="{x:Bind}"
                                             Foreground="{StaticResource SiloMutedBrush}" FontSize="14">
                                <TextBlock Text="{x:Bind Label}" />
                            </HyperlinkButton>
                            <TextBlock Margin="4,0" VerticalAlignment="Center" Text="{x:Bind Label}" FontSize="14"
                                       Foreground="{StaticResource DetailCreditLabelBrush}" Visibility="{x:Bind controls:DetailHero.Not(IsLink)}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!--
                The logo stands in for the title, at most 170 high and 70 % of the text's width, and takes no room until it is
                in (or when it fails and the title takes its place); screen readers still get the title.
            -->
            <Image x:Name="Logo" MaxHeight="140" MaxWidth="520" HorizontalAlignment="Left" Stretch="Uniform"
                   Source="{x:Bind controls:DetailHero.LoadImage(ViewModel.LogoUrl, 640), Mode=OneWay}" ImageFailed="OnLogoFailed"
                   Visibility="{x:Bind ViewModel.ShowsLogo, Mode=OneWay}"
                   AutomationProperties.Name="{x:Bind ViewModel.DisplayTitle, Mode=OneWay}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="TitleText" MaxWidth="900" HorizontalAlignment="Left" Text="{x:Bind ViewModel.DisplayTitle, Mode=OneWay}"
                       FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="50" LineHeight="54" TextWrapping="Wrap"
                       MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="{x:Bind ViewModel.ShowsTitleText, Mode=OneWay}"
                       AutomationProperties.HeadingLevel="Level1" />

            <TextBlock x:Name="SubtitleText" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontFamily="{StaticResource SiloFontMedium}"
                       FontWeight="Medium" FontSize="17" Foreground="{StaticResource DetailMetaBrush}"
                       Visibility="{x:Bind controls:DetailHero.Shows(ViewModel.Subtitle), Mode=OneWay}" />
            <TextBlock x:Name="MetaText" Text="{x:Bind ViewModel.MetaLine, Mode=OneWay}" FontSize="17" Foreground="{StaticResource DetailMetaBrush}"
                       TextWrapping="Wrap" Visibility="{x:Bind controls:DetailHero.Shows(ViewModel.MetaLine), Mode=OneWay}" />
            <TextBlock x:Name="TaglineText" MaxWidth="900" HorizontalAlignment="Left" Text="{x:Bind ViewModel.Tagline, Mode=OneWay}"
                       FontFamily="{StaticResource SiloFontItalic}" FontStyle="Italic" FontSize="17" Foreground="{StaticResource DetailTextBrush}"
                       TextWrapping="Wrap" Visibility="{x:Bind controls:DetailHero.Shows(ViewModel.Tagline), Mode=OneWay}" />
            <TextBlock x:Name="OverviewText" MaxWidth="900" HorizontalAlignment="Left" Text="{x:Bind ViewModel.Overview, Mode=OneWay}"
                       FontSize="16" LineHeight="25" Foreground="{StaticResource DetailTextBrush}" TextWrapping="Wrap" MaxLines="4"
                       TextTrimming="CharacterEllipsis" Visibility="{x:Bind ViewModel.ShowsOverview, Mode=OneWay}" />
            <!--
                An unwatched episode's description the profile hides: the web's DetailOverview puts this in its place, the
                struck-through eye and its words in 14 px muted text; it shows the description.
            -->
            <HyperlinkButton x:Name="RevealOverviewButton" Margin="-4,0,0,0" Padding="4,2" HorizontalAlignment="Left" FontSize="14"
                             Foreground="{StaticResource SiloMutedBrush}" Click="OnRevealOverviewClick"
                             Visibility="{x:Bind ViewModel.IsOverviewHidden, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xED1A;" FontSize="14" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{x:Bind vm:ItemDetailViewModel.OverviewHiddenText}" VerticalAlignment="Center" />
                </StackPanel>
            </HyperlinkButton>

            <StackPanel x:Name="Buttons" Margin="0,6,0,0" Orientation="Horizontal" Spacing="14">
                <Button x:Name="PlayButton" Style="{StaticResource HeroPrimaryButtonStyle}" Command="{x:Bind ViewModel.PlayCommand}"
                        AutomationProperties.Name="{x:Bind ViewModel.PlayButtonText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xF5B0;" FontSize="20" />
                        <TextBlock Text="{x:Bind ViewModel.PlayButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button x:Name="StartOverButton" Style="{StaticResource HeroIconButtonStyle}" Command="{x:Bind ViewModel.StartOverCommand}"
                        Visibility="{x:Bind ViewModel.CanStartOver, Mode=OneWay}"
                        AutomationProperties.Name="Start over" ToolTipService.ToolTip="Start over">
                    <FontIcon x:Name="StartOverIcon" Glyph="&#xE72C;" FontSize="19" />
                </Button>
                <Button x:Name="WatchedButton" Style="{StaticResource HeroSecondaryButtonStyle}" Command="{x:Bind ViewModel.ToggleWatchedCommand}"
                        Visibility="{x:Bind ViewModel.ShowsWatchedAction, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.WatchedLabel, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon x:Name="WatchedIcon" Glyph="&#xE73E;" FontSize="20" />
                        <TextBlock Text="{x:Bind ViewModel.WatchedLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button x:Name="InfoButton" Style="{StaticResource HeroSecondaryButtonStyle}" Click="OnInfoClick"
                        AutomationProperties.Name="Info: details, cast, crew and files">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon x:Name="InfoIcon" Glyph="&#xE946;" FontSize="20" />
                        <TextBlock Text="Info" />
                    </StackPanel>
                </Button>
                <Button x:Name="FavoriteButton" Style="{StaticResource HeroIconButtonStyle}" Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        Visibility="{x:Bind ViewModel.CanFavorite, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.FavoriteLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.FavoriteLabel, Mode=OneWay}">
                    <FontIcon x:Name="FavoriteIcon" Glyph="{x:Bind controls:DetailHero.HeartGlyph(ViewModel.IsFavorite), Mode=OneWay}" FontSize="20"
                              Foreground="{x:Bind controls:DetailHero.ActiveForeground(ViewModel.IsFavorite), Mode=OneWay}" />
                </Button>
                <Button x:Name="MoreButton" Style="{StaticResource HeroIconButtonStyle}" Visibility="{x:Bind ViewModel.CanFavorite, Mode=OneWay}"
                        AutomationProperties.Name="More actions" ToolTipService.ToolTip="More actions">
                    <FontIcon x:Name="MoreIcon" Glyph="&#xE712;" FontSize="19" RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="90" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="{x:Bind ViewModel.WatchlistLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleWatchlistCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="{x:Bind controls:DetailHero.WatchlistGlyph(ViewModel.IsInWatchlist), Mode=OneWay}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Add to Collection" Click="OnAddToCollectionClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8F4;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!--
                A movie's or episode's Version, Audio and Subs (the web's VersionDropdown, AudioTracksPopover and SubtitlesPopover):
                what Play plays, each showing what is chosen. In the focus order after the buttons; Left and Right move along.
            -->
            <StackPanel x:Name="Pickers" Orientation="Horizontal" Spacing="10" XYFocusKeyboardNavigation="Enabled"
                        Visibility="{x:Bind ViewModel.Pickers.ShowsAny, Mode=OneWay}">
                <Button x:Name="VersionPicker" Style="{StaticResource DetailPickerButtonStyle}"
                        Visibility="{x:Bind ViewModel.Pickers.ShowsVersions, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Pickers.VersionName, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE93C;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="Version" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.Pickers.VersionSummary, Mode=OneWay}" Style="{StaticResource DetailPickerChoiceTextStyle}" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource SiloMutedBrush}" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="VersionMenu" Placement="BottomEdgeAlignedLeft" FlyoutPresenterStyle="{StaticResource DetailPickerMenuStyle}"
                                Opening="OnVersionMenuOpening" Opened="OnVersionMenuOpened">
                            <ItemsControl x:Name="VersionRows" IsTabStop="False"
                                          XYFocusKeyboardNavigation="Enabled" Padding="6,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="detail:DetailVersionOption">
                                        <Button Style="{StaticResource SiloPlayerMenuItemStyle}" CornerRadius="8" Click="OnVersionClick"
                                                Background="{x:Bind controls:PlayerMenus.SubtitleRowBackground(IsSelected)}"
                                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                                AutomationProperties.ItemStatus="{x:Bind controls:PlayerMenus.Status(IsSelected)}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Summary}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium"
                                                                   FontSize="14" TextTrimming="CharacterEllipsis" Foreground="White" />
                                                        <Border Style="{StaticResource SiloPlayerMenuChipStyle}" Visibility="{x:Bind controls:PlayerMenus.Shows(RangeLabel)}">
                                                            <TextBlock Text="{x:Bind RangeLabel}" Style="{StaticResource SiloPlayerMenuChipTextStyle}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource DetailPickerDetailTextStyle}"
                                                               Visibility="{x:Bind controls:PlayerMenus.Shows(Detail)}" />
                                                </StackPanel>
                                                <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Center"
                                                          Foreground="{StaticResource SiloPrimaryBrush}" Visibility="{x:Bind IsSelected}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="AudioPicker" Style="{StaticResource DetailPickerButtonStyle}"
                        Visibility="{x:Bind ViewModel.Pickers.ShowsAudio, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Pickers.AudioName, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE767;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="Audio" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.Pickers.AudioSummary, Mode=OneWay}" Style="{StaticResource DetailPickerChoiceTextStyle}" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource SiloMutedBrush}" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="AudioMenu" Placement="BottomEdgeAlignedLeft" FlyoutPresenterStyle="{StaticResource DetailPickerMenuStyle}"
                                Opening="OnAudioMenuOpening" Opened="OnAudioMenuOpened">
                            <ItemsControl x:Name="AudioRows" IsTabStop="False"
                                          XYFocusKeyboardNavigation="Enabled" Padding="6,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="detail:DetailAudioOption">
                                        <Button Style="{StaticResource SiloPlayerMenuItemStyle}" CornerRadius="8" Click="OnAudioClick"
                                                Background="{x:Bind controls:PlayerMenus.SubtitleRowBackground(IsSelected)}"
                                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                                AutomationProperties.ItemStatus="{x:Bind controls:PlayerMenus.Status(IsSelected)}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{x:Bind Title}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium"
                                                                   FontSize="14" TextTrimming="CharacterEllipsis" Foreground="White" />
                                                        <Border Style="{StaticResource SiloPlayerMenuChipStyle}" Visibility="{x:Bind controls:PlayerMenus.Shows(Codec)}">
                                                            <TextBlock Text="{x:Bind controls:PlayerMenus.Upper(Codec)}" Style="{StaticResource SiloPlayerMenuChipTextStyle}" />
                                                        </Border>
                                                        <Border Style="{StaticResource SiloPlayerMenuChipStyle}" Visibility="{x:Bind controls:PlayerMenus.Shows(Channels)}">
                                                            <TextBlock Text="{x:Bind Channels}" Style="{StaticResource SiloPlayerMenuChipTextStyle}" />
                                                        </Border>
                                                        <Border Style="{StaticResource SiloPlayerMenuOutlineChipStyle}" Visibility="{x:Bind IsDefault}">
                                                            <TextBlock Text="DEFAULT" Style="{StaticResource SiloPlayerMenuChipTextStyle}" Foreground="#B3FFFFFF" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource DetailPickerDetailTextStyle}"
                                                               Visibility="{x:Bind controls:PlayerMenus.Shows(Description)}" />
                                                </StackPanel>
                                                <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Center"
                                                          Foreground="{StaticResource SiloPrimaryBrush}" Visibility="{x:Bind IsSelected}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="SubtitlePicker" Style="{StaticResource DetailPickerButtonStyle}"
                        Visibility="{x:Bind ViewModel.Pickers.ShowsSubtitles, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Pickers.SubtitleName, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE7F0;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="Subs" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.Pickers.SubtitleSummary, Mode=OneWay}" Style="{StaticResource DetailPickerChoiceTextStyle}" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource SiloMutedBrush}" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="SubtitleMenu" Placement="BottomEdgeAlignedLeft" FlyoutPresenterStyle="{StaticResource DetailPickerMenuStyle}"
                                Opening="OnSubtitleMenuOpening" Opened="OnSubtitleMenuOpened">
                            <ItemsControl x:Name="SubtitleRows" IsTabStop="False"
                                          XYFocusKeyboardNavigation="Enabled" Padding="6,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="detail:DetailSubtitleOption">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Section}" Style="{StaticResource SiloPlayerMenuHeaderTextStyle}" Margin="12,10,12,4"
                                                       Visibility="{x:Bind HasSection}" AutomationProperties.AccessibilityView="Raw" />
                                            <Button Style="{StaticResource SiloPlayerMenuItemStyle}" CornerRadius="8" Click="OnSubtitleClick"
                                                    Background="{x:Bind controls:PlayerMenus.SubtitleRowBackground(IsSelected)}"
                                                    AutomationProperties.Name="{x:Bind AccessibleName}"
                                                    AutomationProperties.ItemStatus="{x:Bind controls:PlayerMenus.Status(IsSelected)}">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{x:Bind Title}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium"
                                                                       FontSize="14" TextTrimming="CharacterEllipsis" Foreground="White" />
                                                            <Border Style="{StaticResource SiloPlayerMenuChipStyle}" Visibility="{x:Bind controls:PlayerMenus.Shows(Format)}">
                                                                <TextBlock Text="{x:Bind Format}" Style="{StaticResource SiloPlayerMenuChipTextStyle}" />
                                                            </Border>
                                                            <Border Style="{StaticResource SiloPlayerMenuOutlineChipStyle}" Visibility="{x:Bind IsForced}">
                                                                <TextBlock Text="FORCED" Style="{StaticResource SiloPlayerMenuChipTextStyle}" Foreground="#B3FFFFFF" />
                                                            </Border>
                                                            <Border Style="{StaticResource SiloPlayerMenuOutlineChipStyle}" Visibility="{x:Bind IsHearingImpaired}">
                                                                <TextBlock Text="HI" Style="{StaticResource SiloPlayerMenuChipTextStyle}" Foreground="#B3FFFFFF" />
                                                            </Border>
                                                            <Border Style="{StaticResource SiloPlayerMenuOutlineChipStyle}" Visibility="{x:Bind IsDefault}">
                                                                <TextBlock Text="DEFAULT" Style="{StaticResource SiloPlayerMenuChipTextStyle}" Foreground="#B3FFFFFF" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource DetailPickerDetailTextStyle}"
                                                                   Visibility="{x:Bind controls:PlayerMenus.Shows(Description)}" />
                                                    </StackPanel>
                                                    <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Center"
                                                              Foreground="{StaticResource SiloPrimaryBrush}" Visibility="{x:Bind IsSelected}" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <TextBlock x:Name="VersionText" Text="{x:Bind ViewModel.AvailableVersionLine, Mode=OneWay}" FontSize="14"
                       Foreground="{StaticResource DetailFaintBrush}" TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.HasAvailableVersionLine, Mode=OneWay}" />

            <InfoBar MaxWidth="560" HorizontalAlignment="Left" Severity="Error" IsClosable="True"
                     IsOpen="{x:Bind ViewModel.HasActionError, Mode=OneWay}" Message="{x:Bind ViewModel.ActionError, Mode=OneWay}"
                     CloseButtonClick="OnActionErrorClosed" />
        </StackPanel>
    </Grid>
</UserControl>
