<?xml version="1.0" encoding="utf-8"?>
<!-- A titled, horizontally scrolling row of cards, as on Silo's Home and library pages. -->
<UserControl
    x:Class="Granary.App.Controls.MediaRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:cards="using:Granary.Core.ViewModels.Cards"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited">

    <Grid RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                <TextBlock x:Name="TitleText" Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource SiloRowTitleTextStyle}" VerticalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level2" />
                <Border Padding="8,2,8,3" CornerRadius="9" Background="{StaticResource SiloPrimaryBrush}" VerticalAlignment="Center"
                        Visibility="{x:Bind HasText(TitleBadge), Mode=OneWay}">
                    <TextBlock Text="{x:Bind TitleBadge, Mode=OneWay}" FontSize="10" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                               Foreground="{StaticResource SiloOnPrimaryBadgeBrush}" />
                </Border>
            </StackPanel>
            <HyperlinkButton HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SiloLinkButtonStyle}"
                             Content="EXPLORE ALL" Command="{x:Bind ExploreAllCommand, Mode=OneWay}"
                             Visibility="{x:Bind HasCommand(ExploreAllCommand), Mode=OneWay}"
                             AutomationProperties.Name="{x:Bind ExploreAllName(Title), Mode=OneWay}" />
        </Grid>

        <Grid x:Name="Track" Grid.Row="1">
            <ScrollView x:Name="Scroller" ContentOrientation="Horizontal" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden" ViewChanged="OnViewChanged"
                        controls:WheelScrollsPage.IsEnabled="True">
                <ItemsRepeater x:Name="Items" ItemsSource="{x:Bind ItemsSource, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="20" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="cards:MediaCard">
                            <Button Style="{StaticResource SiloCardButtonStyle}" Width="{x:Bind controls:MediaRow.CardWidth(Shape)}" VerticalAlignment="Top" DataContext="{x:Bind}"
                                    Click="OnCardClick" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <controls:MediaCardView Card="{x:Bind}" />
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollView>

            <!-- Mouse users get arrows; touch and touchpads scroll directly, keyboard users tab through. -->
            <Button x:Name="PreviousButton" Style="{StaticResource SiloIconButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="-18,0,0,40" Visibility="Collapsed" Click="OnPreviousClick" IsTabStop="False"
                    AutomationProperties.Name="Scroll left">
                <FontIcon Glyph="&#xE76B;" FontSize="14" />
            </Button>
            <Button x:Name="NextButton" Style="{StaticResource SiloIconButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,-18,40" Visibility="Collapsed" Click="OnNextClick" IsTabStop="False"
                    AutomationProperties.Name="Scroll right">
                <FontIcon Glyph="&#xE76C;" FontSize="14" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
