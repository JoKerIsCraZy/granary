<?xml version="1.0" encoding="utf-8"?>
<!-- A titled, horizontally scrolling row of cards, as on Silo's Home and library pages. -->
<UserControl
    x:Class="Granary.App.Controls.MediaRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:cards="using:Granary.Core.ViewModels.Cards"
    xmlns:detail="using:Granary.Core.ViewModels.Detail"
    xmlns:t="using:Granary.Core.Texts"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited">

    <Grid RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                <!--
                    The title opens what Explore all opens, as the web's MediaCarousel links it (titleHref, the accent on hover):
                    for the mouse only. Keys, a remote and a controller have Explore all, so the row's stops stay as they were,
                    and a screen reader still reads the heading. Without Explore all it is the plain heading (MediaRow.ApplyExploreAll).
                -->
                <HyperlinkButton x:Name="TitleLink" Padding="0" MinHeight="0" VerticalAlignment="Center" IsTabStop="False"
                                 Command="{x:Bind ExploreAllCommand, Mode=OneWay}" IsHitTestVisible="False"
                                 PointerEntered="OnTitlePointerEntered" PointerExited="OnTitlePointerExited" PointerCanceled="OnTitlePointerExited"
                                 AutomationProperties.AccessibilityView="Raw">
                    <HyperlinkButton.Resources>
                        <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="Transparent" />
                    </HyperlinkButton.Resources>
                    <TextBlock x:Name="TitleText" Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource SiloRowTitleTextStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                </HyperlinkButton>
            </StackPanel>
            <HyperlinkButton x:Name="ExploreAllLink" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SiloLinkButtonStyle}"
                             Content="{x:Bind ExploreAllText}" Command="{x:Bind ExploreAllCommand, Mode=OneWay}" Visibility="Collapsed"
                             AutomationProperties.Name="{x:Bind ExploreAllName(Title), Mode=OneWay}" />
        </Grid>

        <Grid x:Name="Track" Grid.Row="1">
            <ScrollView x:Name="Scroller" ContentOrientation="Horizontal" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden" ViewChanged="OnViewChanged"
                        controls:WheelScrollsPage.IsEnabled="True">
                <!-- A card's width follows the profile's poster size at the window's breakpoint (MediaRow.OnElementPrepared). Cards are made
                     half a row's width past each end, not a whole one (MediaGrid). An episode's More Episodes also holds the places of
                     the season's missing and upcoming episodes, as wide as its cards. -->
                <ItemsRepeater x:Name="Items" ItemsSource="{x:Bind ItemsSource, Mode=OneWay}" ElementPrepared="OnElementPrepared"
                               ElementClearing="OnElementClearing" GettingFocus="OnItemsGettingFocus" HorizontalCacheLength="1">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="20" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <controls:MediaRowTemplateSelector>
                            <controls:MediaRowTemplateSelector.Card>
                                <DataTemplate x:DataType="cards:MediaCard">
                                    <Button Style="{StaticResource SiloCardButtonStyle}" VerticalAlignment="Top"
                                            Click="OnCardClick" PointerEntered="OnCardPointerEntered" GotFocus="OnCardGotFocus"
                                            AutomationProperties.Name="{x:Bind AccessibleName}">
                                        <controls:MediaCardView Card="{x:Bind}" />
                                    </Button>
                                </DataTemplate>
                            </controls:MediaRowTemplateSelector.Card>
                            <controls:MediaRowTemplateSelector.Placeholder>
                                <DataTemplate x:DataType="detail:DetailEpisodePlaceholder">
                                    <!-- A plain Grid as the root, on purpose: see "ItemsRepeater templates" in AGENTS.md. -->
                                    <Grid VerticalAlignment="Top">
                                        <controls:DetailEpisodePlaceholderCard Placeholder="{x:Bind}" />
                                    </Grid>
                                </DataTemplate>
                            </controls:MediaRowTemplateSelector.Placeholder>
                        </controls:MediaRowTemplateSelector>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollView>

            <!-- Mouse users get arrows; touch and touchpads scroll directly, keyboard users tab through. -->
            <Button x:Name="PreviousButton" Style="{StaticResource SiloIconButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="-18,0,0,40" Visibility="Collapsed" Click="OnPreviousClick" IsTabStop="False"
                    AutomationProperties.Name="{x:Bind t:AppText.Get('web.catalog.carousel.scrollLeft')}">
                <FontIcon Glyph="&#xE76B;" FontSize="14" />
            </Button>
            <Button x:Name="NextButton" Style="{StaticResource SiloIconButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,-18,40" Visibility="Collapsed" Click="OnNextClick" IsTabStop="False"
                    AutomationProperties.Name="{x:Bind t:AppText.Get('web.catalog.carousel.scrollRight')}">
                <FontIcon Glyph="&#xE76C;" FontSize="14" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
