<?xml version="1.0" encoding="utf-8"?>
<!-- The Info dialog's content (DetailHero): each section a heading over label and value rows, scrolling when long. -->
<UserControl
    x:Class="Granary.App.Controls.DetailInfoPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:detail="using:Granary.Core.ViewModels.Detail">

    <ScrollViewer Padding="0,0,16,0">
        <ItemsRepeater ItemsSource="{x:Bind Sections}">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="28" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="detail:DetailInfoSection">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource SiloSectionLabelTextStyle}" FontSize="13" CharacterSpacing="120"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <ItemsRepeater ItemsSource="{x:Bind Rows}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="detail:DetailInfoRow">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Label}" FontSize="17" Foreground="{StaticResource SiloMutedBrush}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="17" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </ScrollViewer>
</UserControl>
