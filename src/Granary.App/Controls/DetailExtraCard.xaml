<?xml version="1.0" encoding="utf-8"?>
<!--
    A local extra, the web's ExtraCard (ExtrasSection.tsx): its 16:9 still over its thumbhash, a muted play mark in its place
    when it has none or it fails to load; under the pointer the still grows and a play disc shows over a darker picture, and
    the disc alone shows while the keyboard or a remote is on the card. Its title and length under it. The button around it
    plays it; its name says it all, so the texts here are left to the eye.
-->
<UserControl
    x:Class="Granary.App.Controls.DetailExtraCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    PointerCanceled="OnPointerExited">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Art" CornerRadius="{StaticResource SiloCardCornerRadius}" Background="{StaticResource SiloSurfaceBrush}"
              BorderBrush="#0DFFFFFF" BorderThickness="1">
            <Image x:Name="BlurImage" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
            <FontIcon x:Name="PlayMark" Glyph="&#xE768;" FontSize="28" Foreground="{StaticResource SiloMutedBrush}" Opacity="0.4"
                      AutomationProperties.AccessibilityView="Raw" />
            <Image x:Name="StillImage" Stretch="UniformToFill" ImageOpened="OnStillOpened" ImageFailed="OnStillFailed"
                   AutomationProperties.AccessibilityView="Raw" />
            <!-- Darker under the pointer only, as the web's group-hover. -->
            <Grid x:Name="Shade" Background="#4D000000" Opacity="0" IsHitTestVisible="False">
                <Grid.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.2" />
                </Grid.OpacityTransition>
            </Grid>
            <!-- Under the pointer, and while the keyboard or a remote is on the card, as the web's group-focus-visible. -->
            <Border x:Name="PlayDisc" Width="40" Height="40" CornerRadius="20" Background="#99000000" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.2" />
                </Border.OpacityTransition>
                <FontIcon Glyph="&#xF5B0;" FontSize="15" Foreground="White" Margin="2,0,0,0" AutomationProperties.AccessibilityView="Raw" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="2" Padding="2,0">
            <TextBlock x:Name="TitleText" Style="{StaticResource SiloCardTitleTextStyle}" FontSize="13" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="DurationText" Style="{StaticResource SiloCaptionTextStyle}" FontSize="11" Typography.NumeralAlignment="Tabular"
                       AutomationProperties.AccessibilityView="Raw" />
        </StackPanel>
    </Grid>
</UserControl>
