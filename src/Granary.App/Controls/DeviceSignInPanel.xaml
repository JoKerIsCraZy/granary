<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Granary.App.Controls.DeviceSignInPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True" UseSystemFocusVisuals="True" CornerRadius="10"
    AutomationProperties.Name="Sign in with a code">

    <!-- Silo's web: a framed box in the login card with the code on white, where to enter it, and the progress. -->
    <Border Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="#9928282E" Background="#80141417">
        <StackPanel Spacing="16">
            <!-- Scanners need dark modules on a light background; the image brings its own quiet zone. -->
            <Grid Width="200" Height="200" HorizontalAlignment="Center">
                <Border CornerRadius="10" Background="{StaticResource SiloSurfaceRaisedBrush}" />
                <Border CornerRadius="10" Background="White"
                        Visibility="{x:Bind ViewModel.HasCode, Mode=OneWay}"
                        Opacity="{x:Bind QrOpacity(ViewModel.IsOpened), Mode=OneWay}">
                    <Image x:Name="QrImage" Stretch="Uniform"
                           AutomationProperties.Name="QR code to sign in. Scan it with your phone's camera." />
                </Border>
            </Grid>

            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasCode, Mode=OneWay}">
                <!-- One line, so the spaces come only from the Run texts. -->
                <TextBlock Style="{StaticResource SiloAuthTextStyle}" TextAlignment="Center"><Run Text="Or go to " /><Run Text="{x:Bind ViewModel.VerificationText, Mode=OneWay}" Foreground="{StaticResource SiloForegroundBrush}" /><Run Text=" and enter" /></TextBlock>
                <TextBlock Text="{x:Bind ViewModel.UserCode, Mode=OneWay}" IsTextSelectionEnabled="True" HorizontalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas" FontSize="24" FontWeight="SemiBold" CharacterSpacing="120"
                           Foreground="{StaticResource SiloForegroundBrush}" AutomationProperties.HelpText="Sign-in code" />
                <TextBlock Text="{x:Bind ViewModel.ExpiryText, Mode=OneWay}" Style="{StaticResource SiloCaptionTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- The text wraps beside the ring: 286 px is what the card leaves (344 - 2 x 17 - 16 - 8). -->
            <Grid HorizontalAlignment="Center" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsWaiting, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsWaiting, Mode=OneWay}" />
                <TextBlock Grid.Column="1" MaxWidth="286" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource SiloAuthTextStyle}"
                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            </Grid>

            <Button Content="Get a new code" Style="{StaticResource SiloAuthOutlineButtonStyle}" Command="{x:Bind ViewModel.RetryCommand}"
                    Visibility="{x:Bind ViewModel.CanRetry, Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>
