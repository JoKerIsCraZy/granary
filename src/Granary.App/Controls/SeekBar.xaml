<?xml version="1.0" encoding="utf-8"?>
<!--
    The player's seek bar as Silo's web player draws it: a thin track with the played part in white over the tinted
    marked parts (intro, recap, credits, preview), a tick where each chapter starts. Under the pointer the track
    thickens, a thumb appears and a bubble above it shows a picture of that moment (SeekBar.Preview.cs), the part and
    its range, the time and the chapter; the part under the pointer stands out with a white ring. The whole row is the
    hit area.
-->
<UserControl
    x:Class="Granary.App.Controls.SeekBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    FocusVisualMargin="-6,0"
    CornerRadius="8"
    Height="36">

    <Grid Background="Transparent">
        <Grid x:Name="Track" Height="3" VerticalAlignment="Center" CenterPoint="0,1.5,0" CornerRadius="1.5"
              Background="{StaticResource SiloPlayerTrackBrush}">
            <Grid.ScaleTransition>
                <Vector3Transition Duration="0:0:0.15" />
            </Grid.ScaleTransition>
            <Grid x:Name="Regions" />
            <Border x:Name="Progress" Width="0" HorizontalAlignment="Left" CornerRadius="1.5"
                    Background="{StaticResource SiloPlayerForegroundBrush}" />
        </Grid>
        <!-- Outside the track, which clips to its rounded ends: the ticks stand out above and below it. -->
        <Grid x:Name="ChapterTicks" Height="10" VerticalAlignment="Center" IsHitTestVisible="False" />
        <Border x:Name="RegionHighlight" Height="8" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="4"
                BorderThickness="1" BorderBrush="#CCFFFFFF" IsHitTestVisible="False" Visibility="Collapsed" />

        <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"
                 Fill="{StaticResource SiloPlayerForegroundBrush}" Opacity="0">
            <Ellipse.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Ellipse.OpacityTransition>
        </Ellipse>

        <!-- A canvas does not clip, so the bubble can sit above the bar's own row. -->
        <Canvas VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False">
            <!-- The caret under the bubble, its edges continuing the bubble's. -->
            <Canvas x:Name="TipCaret" Width="10" Height="6" Opacity="0">
                <Canvas.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.1" />
                </Canvas.OpacityTransition>
                <Polygon Points="0,0 10,0 5,6" Fill="{StaticResource SiloPlayerPopupBrush}" />
                <Polyline Points="0,0 5,6 10,0" Stroke="#14FFFFFF" StrokeThickness="1" />
            </Canvas>
            <Border x:Name="Tip" CornerRadius="8" BorderThickness="1" Opacity="0"
                    Background="{StaticResource SiloPlayerPopupBrush}" BorderBrush="#14FFFFFF">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.1" />
                </Border.OpacityTransition>
                <StackPanel>
                <Grid x:Name="TipPicture" Width="174" Visibility="Collapsed">
                    <!-- The web's placeholder: a faint film frame on a faint gradient. -->
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#0FFFFFFF" />
                                <GradientStop Offset="1" Color="#05FFFFFF" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <FontIcon Glyph="&#xE8B2;" FontSize="20" Foreground="#1FFFFFFF" />
                    </Grid>
                    <Image x:Name="TipImage" Stretch="UniformToFill" ImageFailed="OnTipImageFailed" />
                    <Canvas x:Name="TipTile" Background="Black" Visibility="Collapsed">
                        <Image x:Name="TipTileImage" Stretch="Fill" />
                    </Canvas>
                </Grid>
                <StackPanel x:Name="TipLines" MinHeight="26" Padding="10,6" VerticalAlignment="Center" Spacing="2">
                    <!-- The marked part under the pointer: a dot in its colour, its name and its range. -->
                    <StackPanel x:Name="TipRegion" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                        <Ellipse x:Name="TipRegionDot" Width="6" Height="6" VerticalAlignment="Center" />
                        <TextBlock x:Name="TipRegionName" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="11"
                                   Foreground="{StaticResource SiloPlayerForegroundBrush}" />
                        <TextBlock x:Name="TipRegionRange" FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="#73FFFFFF" />
                    </StackPanel>
                    <TextBlock x:Name="TipText" Typography.NumeralAlignment="Tabular"
                               FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{StaticResource SiloPlayerForegroundBrush}" />
                    <TextBlock x:Name="TipChapter" MaxWidth="154" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="#80FFFFFF"
                               Visibility="Collapsed" />
                </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
