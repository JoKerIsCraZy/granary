<?xml version="1.0" encoding="utf-8"?>
<!-- One catalog card in the Silo look (docs/ui-design.md). Interaction belongs to the button around it. -->
<UserControl
    x:Class="Granary.App.Controls.MediaCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnSizeChanged">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Art" CornerRadius="{StaticResource SiloCardCornerRadius}" Background="{StaticResource SiloSurfaceBrush}"
              BorderBrush="#0DFFFFFF" BorderThickness="1">
            <!-- Shown until the artwork arrives, and instead of it when there is none. -->
            <TextBlock x:Name="Placeholder" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                       Text="{x:Bind Card.Title, Mode=OneWay}" Style="{StaticResource SiloCaptionTextStyle}" TextWrapping="Wrap"
                       MaxLines="4" AutomationProperties.AccessibilityView="Raw" />
            <Image x:Name="ArtImage" Stretch="UniformToFill" ImageOpened="OnImageOpened" ImageFailed="OnImageFailed"
                   AutomationProperties.AccessibilityView="Raw" />

            <Grid Margin="8" VerticalAlignment="Top" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SiloBadgeStyle}" VerticalAlignment="Top"
                        Visibility="{x:Bind Shows(Card.ResolutionBadge), Mode=OneWay}">
                    <TextBlock Text="{x:Bind Card.ResolutionBadge, Mode=OneWay}" Style="{StaticResource SiloBadgeTextStyle}" />
                </Border>
                <StackPanel Grid.Column="2" Spacing="5" HorizontalAlignment="Right">
                    <Border Style="{StaticResource SiloBadgeStyle}" HorizontalAlignment="Right"
                            Visibility="{x:Bind Shows(Card.AudioBadge), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE767;" FontSize="10" Foreground="White" />
                            <TextBlock Text="{x:Bind Card.AudioBadge, Mode=OneWay}" Style="{StaticResource SiloBadgeTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SiloBadgeStyle}" HorizontalAlignment="Right"
                            Visibility="{x:Bind Shows(Card.StatusBadge), Mode=OneWay}">
                        <TextBlock Text="{x:Bind Card.StatusBadge, Mode=OneWay}" Style="{StaticResource SiloBadgeTextStyle}" />
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Margin="8" VerticalAlignment="Bottom">
                <Border Style="{StaticResource SiloBadgeStyle}" HorizontalAlignment="Left"
                        Visibility="{x:Bind Shows(Card.RatingBadge), Mode=OneWay}">
                    <TextBlock Text="{x:Bind Card.RatingBadge, Mode=OneWay}" Style="{StaticResource SiloBadgeTextStyle}" />
                </Border>
                <Border Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right" Background="{StaticResource SiloPrimaryBrush}"
                        Visibility="{x:Bind Card.IsWatched, Mode=OneWay}" AutomationProperties.Name="Watched">
                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="White" />
                </Border>
            </Grid>

            <ProgressBar Margin="10,0,10,8" VerticalAlignment="Bottom" Height="3" MinHeight="3" CornerRadius="2" Maximum="1"
                         Value="{x:Bind ProgressValue(Card.Progress), Mode=OneWay}" Visibility="{x:Bind HasProgress(Card.Progress), Mode=OneWay}"
                         Foreground="{StaticResource SiloPrimaryBrush}" Background="#40FFFFFF" AutomationProperties.Name="Progress" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="3" Padding="2,0">
            <TextBlock Text="{x:Bind Card.Title, Mode=OneWay}" Style="{StaticResource SiloCardTitleTextStyle}" />
            <TextBlock Text="{x:Bind Card.Subtitle, Mode=OneWay}" Style="{x:Bind SubtitleStyle(Card.Shape), Mode=OneWay}"
                       Visibility="{x:Bind Shows(Card.Subtitle), Mode=OneWay}" />
            <TextBlock Text="{x:Bind Card.Caption, Mode=OneWay}" Style="{StaticResource SiloCaptionTextStyle}"
                       Visibility="{x:Bind Shows(Card.Caption), Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
