<?xml version="1.0" encoding="utf-8"?>
<!--
    One catalog card in the Silo look (docs/ui-design.md). Interaction belongs to the button around it.
    The code-behind fills every part when the card changes: x:Bind function bindings skip null arguments,
    which would leave a recycled container showing the previous card's badges or progress.
-->
<UserControl
    x:Class="Granary.App.Controls.MediaCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnSizeChanged">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Art" CornerRadius="{StaticResource SiloCardCornerRadius}" Background="{StaticResource SiloSurfaceBrush}"
              BorderBrush="#0DFFFFFF" BorderThickness="1">
            <!-- Shown until the artwork arrives, and instead of it when there is none. -->
            <TextBlock x:Name="Placeholder" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                       Style="{StaticResource SiloCaptionTextStyle}" TextWrapping="Wrap" MaxLines="4"
                       AutomationProperties.AccessibilityView="Raw" />
            <Image x:Name="ArtImage" Stretch="UniformToFill" ImageOpened="OnImageOpened" ImageFailed="OnImageFailed"
                   AutomationProperties.AccessibilityView="Raw" />

            <Grid Margin="8" VerticalAlignment="Top" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ResolutionBadge" Style="{StaticResource SiloBadgeStyle}" VerticalAlignment="Top">
                    <TextBlock x:Name="ResolutionText" Style="{StaticResource SiloBadgeTextStyle}" />
                </Border>
                <StackPanel Grid.Column="2" Spacing="5" HorizontalAlignment="Right">
                    <Border x:Name="AudioBadge" Style="{StaticResource SiloBadgeStyle}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE767;" FontSize="10" Foreground="White" />
                            <TextBlock x:Name="AudioText" Style="{StaticResource SiloBadgeTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="StatusBadge" Style="{StaticResource SiloBadgeStyle}" HorizontalAlignment="Right">
                        <TextBlock x:Name="StatusText" Style="{StaticResource SiloBadgeTextStyle}" />
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Margin="8" VerticalAlignment="Bottom">
                <Border x:Name="RatingBadge" Style="{StaticResource SiloBadgeStyle}" HorizontalAlignment="Left">
                    <TextBlock x:Name="RatingText" Style="{StaticResource SiloBadgeTextStyle}" />
                </Border>
                <Border x:Name="WatchedMark" Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right"
                        Background="{StaticResource SiloPrimaryBrush}" AutomationProperties.Name="Watched">
                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="White" />
                </Border>
            </Grid>

            <ProgressBar x:Name="Progress" Margin="10,0,10,8" VerticalAlignment="Bottom" Height="3" MinHeight="3" CornerRadius="2"
                         Maximum="1" Foreground="{StaticResource SiloPrimaryBrush}" Background="#40FFFFFF"
                         AutomationProperties.Name="Progress" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="3" Padding="2,0">
            <TextBlock x:Name="TitleText" Style="{StaticResource SiloCardTitleTextStyle}" />
            <TextBlock x:Name="SubtitleText" />
            <TextBlock x:Name="CaptionText" Style="{StaticResource SiloCaptionTextStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
