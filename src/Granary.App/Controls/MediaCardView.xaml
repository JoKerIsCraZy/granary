<?xml version="1.0" encoding="utf-8"?>
<!--
    One catalog card in the Silo look (docs/ui-design.md), drawn as Silo's web draws it: badges in the corners over a
    darkened foot, and under the pointer the artwork grows while the play disc and the card's own buttons appear.
    Opening the card belongs to the button around it.
    The code-behind fills every part when the card changes: x:Bind function bindings skip null arguments,
    which would leave a recycled container showing the previous card's badges or progress.
-->
<UserControl
    x:Class="Granary.App.Controls.MediaCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    SizeChanged="OnSizeChanged"
    PointerEntered="OnPointerEntered"
    PointerMoved="OnPointerMoved"
    PointerExited="OnPointerExited"
    PointerCanceled="OnPointerExited"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    GotFocus="OnGotFocus"
    ContextRequested="OnContextRequested">

    <!-- Without a caption (the profile's "Nothing" under posters) the artwork is all, with no gap under it. -->
    <Grid x:Name="LayoutRoot" RowSpacing="11">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            A box set's card (MediaCard.BoxSetFilms), as the web's BoxSetCard.tsx: two sleeves peek 6 px above the poster and
            read as a stack of films; 24 high with 12 px top corners, the back one 10 % in from each side, the front one 5 % in
            and 3 px lower. Unlike the web's, which makes its card 6 px taller for them, they stand above the card's own box (a
            negative margin; nothing up the tree clips), so the card measures as a film's does, its poster level with theirs
            and a row holding both stays even. Made for the first box set card only (MediaCardView.BoxSet.cs).
        -->
        <Grid x:Name="Sleeves" x:Load="False" Height="24" Margin="0,-6,0,0" VerticalAlignment="Top" IsHitTestVisible="False"
              AutomationProperties.AccessibilityView="Raw">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="80*" />
                    <ColumnDefinition Width="10*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1" CornerRadius="12,12,0,0" Background="#FF28282E" BorderBrush="#FF28282E" BorderThickness="1" />
            </Grid>
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="90*" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1" CornerRadius="12,12,0,0" Background="#FF232328" BorderBrush="#FF28282E" BorderThickness="1" />
            </Grid>
        </Grid>

        <Grid x:Name="Art" CornerRadius="{StaticResource SiloCardCornerRadius}" Background="{StaticResource SiloSurfaceBrush}"
              BorderBrush="#A628282E" BorderThickness="1">
            <!-- Shown until the artwork arrives, and instead of it when there is none. -->
            <TextBlock x:Name="Placeholder" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                       Style="{StaticResource SiloCaptionTextStyle}" TextWrapping="Wrap" MaxLines="4"
                       AutomationProperties.AccessibilityView="Raw" />
            <!-- The thumbhash's blur, at once; the artwork shows over it once it is in (MediaCardView.ShowArtworkAsync). -->
            <Image x:Name="BlurImage" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
            <Image x:Name="ArtImage" Stretch="UniformToFill" ImageOpened="OnImageOpened" ImageFailed="OnImageFailed"
                   AutomationProperties.AccessibilityView="Raw" />
            <!--
                An unwatched episode's still the profile hides, blurred in place of the artwork (MediaCardView.Spoiler.cs); made for
                the first card that shows one.
            -->
            <Image x:Name="SpoilerImage" x:Load="False" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"
                   AutomationProperties.AccessibilityView="Raw" />

            <!-- A darker foot for the bottom badges and buttons. -->
            <Rectangle Height="96" VerticalAlignment="Bottom" Opacity="0.9" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                        <GradientStop Offset="0" Color="#8C000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!--
                The profile's badges in the four corners, as the web's CardOverlays: each edge a row of two stacks that
                share its width only when they must (BadgeEdge), a corner at most three badges (CardBadges). Top right also
                holds the card's own status ("NEW", "APPROVED") and the watched mark. Built in code (CardBadgeViews); a
                poster lays them out at the web's 185 px and scales them to its width (MediaCardView.PlaceBadges).
            -->
            <controls:BadgeEdge x:Name="TopBadges" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                <controls:BadgeEdge.RenderTransform>
                    <ScaleTransform x:Name="TopScale" />
                </controls:BadgeEdge.RenderTransform>
                <StackPanel x:Name="TopLeftBadges" Spacing="4" HorizontalAlignment="Left" />
                <StackPanel x:Name="TopRightBadges" Spacing="4" HorizontalAlignment="Right">
                    <Border x:Name="StatusBadge" Style="{StaticResource SiloBadgeStyle}" HorizontalAlignment="Right">
                        <TextBlock x:Name="StatusText" Style="{StaticResource SiloBadgeTextStyle}" />
                    </Border>
                    <Border x:Name="WatchedMark" Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right"
                            Background="{StaticResource SiloWatchedBrush}" AutomationProperties.Name="Watched">
                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White" />
                    </Border>
                </StackPanel>
            </controls:BadgeEdge>

            <controls:BadgeEdge x:Name="BottomBadges" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                RenderTransformOrigin="0,1">
                <controls:BadgeEdge.RenderTransform>
                    <ScaleTransform x:Name="BottomScale" />
                </controls:BadgeEdge.RenderTransform>
                <StackPanel x:Name="BottomLeftBadges" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                <StackPanel x:Name="BottomRightBadges" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </controls:BadgeEdge>

            <!--
                The page's own title among its siblings, as the web's EpisodeCarousel.tsx marks it, made for the first marked card
                only (MediaCardView.ShowMark). The 2 px accent ring is the art's hairline in the accent and one pixel more inside it
                (the hairline's 16 px corners less the hairline), so the art keeps its layout. The "Now Viewing" pill 10 px into the
                art, its dot pinging in the accent's label colour, is 18 high as the web's leading-none: the capitals' own height
                with the rest around them.
            -->
            <Border x:Name="NowViewing" x:Load="False" BorderBrush="{StaticResource SiloPrimaryBrush}" BorderThickness="1" CornerRadius="15"
                    IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                <Border Margin="9" Padding="10,5.5" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="{StaticResource SiloPillCornerRadius}"
                        controls:Pill.IsEnabled="True" Background="{StaticResource SiloPrimaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid Width="6" Height="6" VerticalAlignment="Center">
                            <Ellipse x:Name="NowViewingPing" Fill="{StaticResource SiloOnPrimaryBadgeBrush}" />
                            <Ellipse Fill="{StaticResource SiloOnPrimaryBadgeBrush}" />
                        </Grid>
                        <!-- The card's name says it already ("…, now viewing"). -->
                        <TextBlock Text="NOW VIEWING" Style="{StaticResource SiloBadgeTextStyle}" CharacterSpacing="80" TextLineBounds="Tight"
                                   Foreground="{StaticResource SiloOnPrimaryBadgeBrush}" VerticalAlignment="Center"
                                   AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                </Border>
            </Border>

            <!--
                A movie's own card in its box set's row, as the web's MovieBoxSetRow.tsx marks it: a 2 px ring in the text colour at
                80 % (the art's hairline and one pixel inside it, as Now Viewing's) and "THIS FILM" in the page's dark at 85 %,
                10 px semibold capitals 0.14 em apart, centred with its top 32 px above the poster's foot, or just above the
                bottom badges when the card shows any (MediaCardView.PlaceThisFilm). Made for the first such card only
                (MediaCardView.ShowMark); the corners keep their badges.
            -->
            <Border x:Name="ThisFilm" x:Load="False" BorderBrush="{StaticResource SiloThisFilmRingBrush}" BorderThickness="1" CornerRadius="15" IsHitTestVisible="False"
                    AutomationProperties.AccessibilityView="Raw">
                <Border x:Name="ThisFilmPill" Margin="0,0,0,11" Padding="10,6" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        CornerRadius="{StaticResource SiloPillCornerRadius}" controls:Pill.IsEnabled="True" Background="#D90E0E10">
                    <!-- The card's name says it already ("…, this film"). -->
                    <TextBlock Text="THIS FILM" Style="{StaticResource SiloBadgeTextStyle}" CharacterSpacing="140" TextLineBounds="Tight"
                               Foreground="{StaticResource SiloForegroundBrush}" AutomationProperties.AccessibilityView="Raw" />
                </Border>
            </Border>

            <!--
                A box set's "BOX SET" pill top left (the web's glass: the surface at 40 % with a 15 % white edge, 10 px semibold
                capitals 0.14 em apart) and its films bottom right ("3 films", 11 px bold on the page's dark at 60 %), as the
                web's BoxSetCard.tsx; the count rises clear of a watched bar. Made for the first box set card only.
            -->
            <Grid x:Name="BoxSetMarks" x:Load="False" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                <Border Margin="10" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="{StaticResource SiloPillCornerRadius}"
                        controls:Pill.IsEnabled="True" Background="#661C1C20" BorderBrush="#26FFFFFF" BorderThickness="1">
                    <TextBlock Text="BOX SET" Style="{StaticResource SiloBadgeTextStyle}" CharacterSpacing="140" TextLineBounds="Tight"
                               Foreground="{StaticResource SiloForegroundBrush}" />
                </Border>
                <Border x:Name="BoxSetCount" Margin="0,0,8,10" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="6"
                        Background="#990E0E10">
                    <TextBlock x:Name="BoxSetCountText" FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="11"
                               Foreground="{StaticResource SiloForegroundBrush}" />
                </Border>
            </Grid>

            <!-- Made only for a card with progress, the play disc and the card's buttons only on first need (MediaCardView.EnsureActions). -->
            <ProgressBar x:Name="Progress" x:Load="False" Margin="10,0,10,8" VerticalAlignment="Bottom" Height="3" MinHeight="3" CornerRadius="2"
                         Maximum="1" Foreground="{StaticResource SiloPrimaryBrush}" Background="#66000000"
                         AutomationProperties.Name="Progress" />

            <!--
                While its grid selects (History's Select): the web's pick mark top left, an empty ring or the accent with a
                check. Made on first need; the card's click then picks it (MediaGrid).
            -->
            <Border x:Name="PickMark" x:Load="False" Width="32" Height="32" CornerRadius="16" Margin="10" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Background="#8C000000" BorderBrush="#33FFFFFF" BorderThickness="1" IsHitTestVisible="False">
                <Border x:Name="PickDot" Width="16" Height="16" CornerRadius="8" BorderThickness="1" BorderBrush="#B3FFFFFF">
                    <FontIcon x:Name="PickCheck" Glyph="&#xE73E;" FontSize="9" Foreground="{StaticResource SiloOnPrimaryBrush}" />
                </Border>
            </Border>

            <!-- Under the pointer only: play in the middle, the card's buttons along the foot. -->
            <Grid x:Name="HoverLayer" x:Load="False" Opacity="0" IsHitTestVisible="False">
                <Grid.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.15" />
                </Grid.OpacityTransition>
                <Button x:Name="PlayButton" Style="{StaticResource SiloCardPlayButtonStyle}" Width="40" Height="40"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnPlayClick"
                        AutomationProperties.Name="Play">
                    <FontIcon Glyph="&#xF5B0;" FontSize="15" Margin="2,0,0,0" />
                </Button>
                <StackPanel x:Name="ActionsPanel" Margin="10" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <Button x:Name="WatchedButton" Style="{StaticResource SiloCardActionButtonStyle}" Click="OnWatchedClick">
                        <FontIcon x:Name="WatchedIcon" FontSize="15" />
                    </Button>
                    <Button x:Name="FavoriteButton" Style="{StaticResource SiloCardActionButtonStyle}" Click="OnFavoriteClick">
                        <FontIcon x:Name="FavoriteIcon" FontSize="15" />
                    </Button>
                </StackPanel>
                <Button x:Name="MoreButton" Style="{StaticResource SiloCardActionButtonStyle}" Margin="10" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" AutomationProperties.Name="More actions" ToolTipService.ToolTip="More actions">
                    <FontIcon Glyph="&#xE712;" FontSize="15" RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="90" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                    <Button.Flyout>
                        <!-- Silo's web card menu, in its order; also on right-click, Shift+F10 or the menu key. -->
                        <MenuFlyout x:Name="MoreMenu" Placement="BottomEdgeAlignedRight" Opening="OnMoreOpening">
                            <MenuFlyoutItem x:Name="MenuPlayFromBeginning" Text="Play from Beginning" Click="OnPlayFromBeginningClick" />
                            <MenuFlyoutItem x:Name="MenuWatched" Click="OnWatchedClick" />
                            <MenuFlyoutItem x:Name="MenuResetProgress" Text="Reset Progress" Click="OnResetProgressClick" />
                            <MenuFlyoutItem x:Name="MenuFavorite" Click="OnFavoriteClick" />
                            <MenuFlyoutItem x:Name="MenuWatchlist" Click="OnWatchlistClick" />
                            <MenuFlyoutItem x:Name="MenuNotInterested" Click="OnNotInterestedClick" />
                            <MenuFlyoutSeparator x:Name="MenuRemoveSeparator" />
                            <MenuFlyoutItem x:Name="MenuRemove" Click="OnRemoveClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <!-- A title from TMDB: the web's watchlist toggle, where library cards keep their menu. -->
                <Button x:Name="TitleWatchlistButton" Style="{StaticResource SiloCardActionButtonStyle}" Margin="10" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Click="OnTitleWatchlistClick">
                    <controls:BookmarkIcon x:Name="TitleWatchlistIcon" Width="16" Height="16" />
                </Button>
            </Grid>

            <!--
                A title from TMDB the viewer may request: the web's Request where library cards keep Play. Made on first need, and
                apart from the hover layer: while its request is on its way it stays in view, saying Sending, as the web's does.
            -->
            <Button x:Name="RequestButton" x:Load="False" Style="{StaticResource SiloCardRequestButtonStyle}" Opacity="0" IsHitTestVisible="False"
                    IsEnabled="False" AutomationProperties.AccessibilityView="Raw"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnRequestClick">
                <Button.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.15" />
                </Button.OpacityTransition>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="RequestPlus" Glyph="&#xE710;" FontSize="12" VerticalAlignment="Center" />
                    <ProgressRing x:Name="RequestSpinner" Width="14" Height="14" MinWidth="14" MinHeight="14" IsActive="False" Visibility="Collapsed"
                                  Foreground="{StaticResource SiloOnPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="RequestLabel" FontSize="12" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- The faint light along the top edge, as on the web. -->
            <Border BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" CornerRadius="{StaticResource SiloCardCornerRadius}" IsHitTestVisible="False" />
        </Grid>

        <StackPanel x:Name="CaptionPanel" Grid.Row="1" Spacing="4" Padding="2,0">
            <TextBlock x:Name="TitleText" Style="{StaticResource SiloCardTitleTextStyle}" />
            <TextBlock x:Name="EpisodeTitleText" Style="{StaticResource SiloCaptionTextStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SubtitleText" />
            <TextBlock x:Name="CaptionText" Style="{StaticResource SiloCaptionTextStyle}" />
            <!-- The episode title's line kept free at the foot, so a title's year stays right under it (ReservesEpisodeLine). -->
            <TextBlock x:Name="EpisodeLineSpacer" Style="{StaticResource SiloCaptionTextStyle}" Text="&#160;" Visibility="Collapsed"
                       AutomationProperties.AccessibilityView="Raw" />
        </StackPanel>
    </Grid>
</UserControl>
