<?xml version="1.0" encoding="utf-8"?>
<!--
    A quiet backdrop behind a page's header (Search): the picture of the card the pointer or the keyboard is on, at the top
    right and dimmed into the page. It takes no room of its own; the page lays it under its content.
-->
<UserControl
    x:Class="Granary.App.Controls.FocusBackdrop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    AutomationProperties.AccessibilityView="Raw">

    <Grid>
        <!-- Two layers, so a new picture fades in over the last one; the box (code-behind) cuts them around their middle. -->
        <Grid x:Name="BackdropBox" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Grid x:Name="LayerA" Opacity="0">
                <Image x:Name="BlurA" Stretch="UniformToFill" VerticalAlignment="Center" />
                <Image x:Name="ArtA" Stretch="UniformToFill" VerticalAlignment="Center" Opacity="0" ImageOpened="OnArtOpened" />
            </Grid>
            <Grid x:Name="LayerB" Opacity="0">
                <Image x:Name="BlurB" Stretch="UniformToFill" VerticalAlignment="Center" />
                <Image x:Name="ArtB" Stretch="UniformToFill" VerticalAlignment="Center" Opacity="0" ImageOpened="OnArtOpened" />
            </Grid>
        </Grid>
        <!-- Dark throughout, and gone into the page toward the left and down, where the text and the results are. -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.35" Color="{StaticResource SiloBackgroundColor}" />
                    <GradientStop Offset="1" Color="#990E0E10" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.2" Color="#590E0E10" />
                    <GradientStop Offset="0.7" Color="{StaticResource SiloBackgroundColor}" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
