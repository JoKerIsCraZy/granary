<?xml version="1.0" encoding="utf-8"?>
<!--
    The activity indicator of an acting administrator, as the web's (components/ServerActivity.tsx): a glass disc with the
    web's pulse icon (lucide's Activity), a red count on its corner while something is going on, a red dot at its foot once
    the events stream has stayed away, and behind it a panel, 320 px wide and at most 400 px of rows, that lists what the
    server does. Its rows are only read: the arrows walk them, and "View all" beside Streams opens Admin → Activity.
    The window places it and decides when it shows (MainWindow.Activity.cs).
-->
<UserControl
    x:Class="Granary.App.Controls.ServerActivityButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:admin="using:Granary.Core.ViewModels.Admin"
    xmlns:adminViews="using:Granary.App.Views.Admin"
    IsTabStop="False">

    <UserControl.Resources>
        <!-- The web's popover: the surface nearly opaque, a hairline around it, 16 px corners, no padding of its own. -->
        <Style x:Key="ActivityPanelStyle" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="#F2161619" />
            <Setter Property="BorderBrush" Value="{StaticResource SiloBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="340" />
            <Setter Property="RequestedTheme" Value="Dark" />
            <!-- The rows scroll in the panel's own scroller, under the header that stays. -->
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="ActivitySectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="CharacterSpacing" Value="120" />
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ActivityRowTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ActivityEmptyRowTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        </Style>
        <!-- A section's number beside its title. -->
        <Style x:Key="ActivityCountChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SiloPrimaryTint10Brush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ActivityCountChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SiloFontBold}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource SiloPrimaryBrush}" />
            <!-- Read with its section's heading (SectionName), not as a bare number after it. -->
            <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        </Style>
        <Style x:Key="ActivityLinkStyle" TargetType="HyperlinkButton">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="0,-2,-4,-2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="ActivityRowStyle" TargetType="controls:ReadingRow">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="-4,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <!-- A section: a hairline above it, so whichever sections show are parted by one line. -->
        <Style x:Key="ActivitySectionStyle" TargetType="StackPanel">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BorderBrush" Value="{StaticResource SiloBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <!-- "42%", "12.5%" at a row's right. -->
        <Style x:Key="ActivityRowNumberStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A row's smaller lines: "Queued", "Subtree · /media/tv/Dark". -->
        <Style x:Key="ActivityRowNoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A line that sums jobs up under the rows: an icon and "4 queued · 1 waiting to retry". -->
        <Style x:Key="ActivitySummaryIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        </Style>
        <!-- "Running" beside a spinner, in the accent. -->
        <Style x:Key="ActivityRowWorkingStyle" TargetType="TextBlock" BasedOn="{StaticResource ActivityRowNumberStyle}">
            <Setter Property="Foreground" Value="{StaticResource SiloPrimaryBrush}" />
        </Style>
        <Style x:Key="ActivitySpinnerStyle" TargetType="ProgressRing">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource SiloPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A row's progress: the web's 6 px bar, the accent on the muted track. -->
        <Style x:Key="ActivityProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Maximum" Value="100" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Foreground" Value="{StaticResource SiloPrimaryBrush}" />
            <Setter Property="Background" Value="#FF28282E" />
            <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        </Style>

        <!-- "2 Direct Play", behind a dot in the method's colour. The root is a plain Grid (AGENTS.md, ItemsRepeater templates). -->
        <DataTemplate x:Key="ActivityStreamRowTemplate" x:DataType="admin:ActivityStreamRow">
            <Grid>
                <controls:ReadingRow Style="{StaticResource ActivityRowStyle}" AutomationProperties.Name="{x:Bind Text, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind adminViews:AdminDashboardView.MethodBrush(Method)}" />
                        <TextBlock Text="{x:Bind Text, Mode=OneWay}" Style="{StaticResource ActivityRowTextStyle}" />
                    </StackPanel>
                </controls:ReadingRow>
            </Grid>
        </DataTemplate>

        <!-- A running task: its name, and "42%" over a bar once it says how far it is, a spinner and "Running" until then. -->
        <DataTemplate x:Key="ActivityTaskRowTemplate" x:DataType="admin:ActivityTaskRow">
            <Grid>
                <controls:ReadingRow Style="{StaticResource ActivityRowStyle}" AutomationProperties.Name="{x:Bind ReadText, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource ActivityRowTextStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind StatusText, Mode=OneWay}" Visibility="{x:Bind HasProgress, Mode=OneWay}"
                                       Style="{StaticResource ActivityRowNumberStyle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Visibility="{x:Bind IsWorking, Mode=OneWay}">
                                <ProgressRing IsActive="{x:Bind IsWorking, Mode=OneWay}" Style="{StaticResource ActivitySpinnerStyle}" />
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource ActivityRowWorkingStyle}" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Value="{x:Bind ProgressValue, Mode=OneWay}" Visibility="{x:Bind HasProgress, Mode=OneWay}"
                                     Style="{StaticResource ActivityProgressBarStyle}" />
                    </StackPanel>
                </controls:ReadingRow>
            </Grid>
        </DataTemplate>

        <!--
            A library scan: a spinner while it runs or the scan icon while it waits, the library with "Scanning…" or "Queued"
            at the right, what it covers, and how far it is once it says so.
        -->
        <DataTemplate x:Key="ActivityScanRowTemplate" x:DataType="admin:ActivityScanRow">
            <Grid>
                <controls:ReadingRow Style="{StaticResource ActivityRowStyle}" AutomationProperties.Name="{x:Bind ReadText, Mode=OneWay}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="14" Height="14" Margin="0,2,0,0" VerticalAlignment="Top">
                            <ProgressRing IsActive="{x:Bind IsRunning, Mode=OneWay}" Visibility="{x:Bind IsRunning, Mode=OneWay}"
                                          Style="{StaticResource ActivitySpinnerStyle}" Width="14" Height="14" />
                            <FontIcon Glyph="&#xEE6F;" FontSize="13" Foreground="{StaticResource SiloMutedBrush}"
                                      Visibility="{x:Bind IsQueued, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind LibraryName, Mode=OneWay}" Style="{StaticResource ActivityRowTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource ActivityRowNoteStyle}" />
                            </Grid>
                            <TextBlock Text="{x:Bind DetailText, Mode=OneWay}" Style="{StaticResource ActivityRowNoteStyle}" />
                            <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" Visibility="{x:Bind HasProgressText, Mode=OneWay}"
                                       Style="{StaticResource ActivityRowNoteStyle}" Opacity="0.8" />
                        </StackPanel>
                    </Grid>
                </controls:ReadingRow>
            </Grid>
        </DataTemplate>

        <!--
            A download being prepared: its title, "42%" over a bar once its progress is known (a spinner and "Encoding" or
            "Remuxing" until then), and under it what is made, where, and how long it still takes.
        -->
        <DataTemplate x:Key="ActivityPreparationRowTemplate" x:DataType="admin:ActivityPreparationRow">
            <Grid>
                <controls:ReadingRow Style="{StaticResource ActivityRowStyle}" AutomationProperties.Name="{x:Bind ReadText, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource ActivityRowTextStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind StatusText, Mode=OneWay}" Visibility="{x:Bind HasProgress, Mode=OneWay}"
                                       Style="{StaticResource ActivityRowNumberStyle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Visibility="{x:Bind IsWorking, Mode=OneWay}">
                                <ProgressRing IsActive="{x:Bind IsWorking, Mode=OneWay}" Style="{StaticResource ActivitySpinnerStyle}" />
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource ActivityRowWorkingStyle}" />
                            </StackPanel>
                        </Grid>
                        <!-- Named as the web names it: "Dark S01E03 progress". -->
                        <ProgressBar Value="{x:Bind ProgressValue, Mode=OneWay}" Visibility="{x:Bind HasProgress, Mode=OneWay}"
                                     Style="{StaticResource ActivityProgressBarStyle}" AutomationProperties.AccessibilityView="Control"
                                     AutomationProperties.Name="{x:Bind ProgressName, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind DetailText, Mode=OneWay}" Style="{StaticResource ActivityRowNoteStyle}" />
                    </StackPanel>
                </controls:ReadingRow>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="Trigger" Style="{StaticResource SiloPageBackButtonStyle}" AutomationProperties.Name="{x:Bind ViewModel.Name, Mode=OneWay}"
                ToolTipService.ToolTip="Server activity">
            <Viewbox Width="18" Height="18" Stretch="Uniform">
                <Canvas Width="24" Height="24">
                    <Path x:Name="Pulse" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{x:Bind PulseBrush(ViewModel.HasActivity), Mode=OneWay}"
                          Data="M22,12 H19.52 A2,2 0 0 0 17.59,13.46 L15.24,21.82 A0.25,0.25 0 0 1 14.76,21.82 L9.24,2.18 A0.25,0.25 0 0 0 8.76,2.18 L6.41,10.54 A2,2 0 0 1 4.49,12 H2" />
                </Canvas>
            </Viewbox>
            <Button.Flyout>
                <Flyout x:Name="Panel" Placement="BottomEdgeAlignedRight" FlyoutPresenterStyle="{StaticResource ActivityPanelStyle}"
                        Opened="OnPanelOpened" Closed="OnPanelClosed">
                    <Grid x:Name="PanelRoot" Width="320" PreviewKeyDown="OnPanelPreviewKeyDown">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Padding="16,12">
                            <TextBlock Text="Server Activity" FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="13"
                                       Foreground="{StaticResource SiloForegroundBrush}" AutomationProperties.HeadingLevel="Level2" />
                            <!-- Only while the events stream is not live. -->
                            <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasConnectionText, Mode=OneWay}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource SiloFontMedium}"
                                       FontWeight="Medium" FontSize="10" Foreground="#FFE9B44C" AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" MaxHeight="400" HorizontalScrollMode="Disabled"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" BorderBrush="{StaticResource SiloBorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <controls:ReadingRow Padding="16,32" AutomationProperties.Name="No active server activity">
                                        <TextBlock Text="No active server activity" FontSize="14" Foreground="{StaticResource SiloMutedBrush}"
                                                   HorizontalAlignment="Center" />
                                    </controls:ReadingRow>
                                </Border>

                                <StackPanel Visibility="{x:Bind ViewModel.HasSections, Mode=OneWay}">
                                    <!-- Streams: one row per play method. -->
                                    <StackPanel Style="{StaticResource ActivitySectionStyle}" Visibility="{x:Bind ViewModel.ShowsStreams, Mode=OneWay}">
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="STREAMS" Style="{StaticResource ActivitySectionTitleStyle}" AutomationProperties.HeadingLevel="Level3"
                                                           AutomationProperties.Name="{x:Bind SectionName('Streams', ViewModel.StreamCountText, ViewModel.HasStreams), Mode=OneWay}" />
                                                <Border Style="{StaticResource ActivityCountChipStyle}" Visibility="{x:Bind ViewModel.HasStreams, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind ViewModel.StreamCountText, Mode=OneWay}" Style="{StaticResource ActivityCountChipTextStyle}" />
                                                </Border>
                                            </StackPanel>
                                            <HyperlinkButton x:Name="ViewStreamsLink" Style="{StaticResource ActivityLinkStyle}" Click="OnViewStreamsClick"
                                                             AutomationProperties.Name="View all streams">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <TextBlock Text="View all" />
                                                    <FontIcon Glyph="&#xE76C;" FontSize="8" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </HyperlinkButton>
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.Streams}" ItemTemplate="{StaticResource ActivityStreamRowTemplate}"
                                                      IsTabStop="False" />
                                        <controls:ReadingRow Style="{StaticResource ActivityRowStyle}" Visibility="{x:Bind ViewModel.HasNoStreams, Mode=OneWay}"
                                                             AutomationProperties.Name="No active streams">
                                            <TextBlock Text="No active streams" Style="{StaticResource ActivityEmptyRowTextStyle}" />
                                        </controls:ReadingRow>
                                    </StackPanel>

                                    <!-- Tasks: the scheduled tasks running now. -->
                                    <StackPanel Style="{StaticResource ActivitySectionStyle}" Visibility="{x:Bind ViewModel.ShowsTasks, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                            <TextBlock Text="TASKS" Style="{StaticResource ActivitySectionTitleStyle}" AutomationProperties.HeadingLevel="Level3"
                                                       AutomationProperties.Name="{x:Bind SectionName('Tasks', ViewModel.TaskCountText, ViewModel.HasTasks), Mode=OneWay}" />
                                            <Border Style="{StaticResource ActivityCountChipStyle}" Visibility="{x:Bind ViewModel.HasTasks, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind ViewModel.TaskCountText, Mode=OneWay}" Style="{StaticResource ActivityCountChipTextStyle}" />
                                            </Border>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.Tasks}" ItemTemplate="{StaticResource ActivityTaskRowTemplate}"
                                                      IsTabStop="False" />
                                        <controls:ReadingRow Style="{StaticResource ActivityRowStyle}" Visibility="{x:Bind ViewModel.HasNoTasks, Mode=OneWay}"
                                                             AutomationProperties.Name="No running tasks">
                                            <TextBlock Text="No running tasks" Style="{StaticResource ActivityEmptyRowTextStyle}" />
                                        </controls:ReadingRow>
                                    </StackPanel>

                                    <!-- Scans: the library scans queued or running, 25 of them at most and a line for the rest. -->
                                    <StackPanel Style="{StaticResource ActivitySectionStyle}" Visibility="{x:Bind ViewModel.ShowsScans, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                            <TextBlock Text="SCANS" Style="{StaticResource ActivitySectionTitleStyle}" AutomationProperties.HeadingLevel="Level3"
                                                       AutomationProperties.Name="{x:Bind SectionName('Scans', ViewModel.ScanCountText, ViewModel.HasScans), Mode=OneWay}" />
                                            <Border Style="{StaticResource ActivityCountChipStyle}" Visibility="{x:Bind ViewModel.HasScans, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind ViewModel.ScanCountText, Mode=OneWay}" Style="{StaticResource ActivityCountChipTextStyle}" />
                                            </Border>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.Scans}" ItemTemplate="{StaticResource ActivityScanRowTemplate}"
                                                      IsTabStop="False" />
                                        <controls:ReadingRow Style="{StaticResource ActivityRowStyle}" Visibility="{x:Bind ViewModel.HasMoreScans, Mode=OneWay}"
                                                             AutomationProperties.Name="{x:Bind ViewModel.MoreScansText, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ViewModel.MoreScansText, Mode=OneWay}" Style="{StaticResource ActivityEmptyRowTextStyle}" />
                                        </controls:ReadingRow>
                                        <controls:ReadingRow Style="{StaticResource ActivityRowStyle}" Visibility="{x:Bind ViewModel.HasNoScans, Mode=OneWay}"
                                                             AutomationProperties.Name="{x:Bind ViewModel.ScanEmptyText, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ViewModel.ScanEmptyText, Mode=OneWay}" Style="{StaticResource ActivityEmptyRowTextStyle}" />
                                        </controls:ReadingRow>
                                    </StackPanel>

                                    <!--
                                        Preparing downloads: three running jobs at most, then how many more run, wait and retry, how
                                        many are paused, and how many failed in the last day. Only on a server with such a queue.
                                    -->
                                    <StackPanel Style="{StaticResource ActivitySectionStyle}" Visibility="{x:Bind ViewModel.ShowsPreparations, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                            <TextBlock Text="PREPARING DOWNLOADS" Style="{StaticResource ActivitySectionTitleStyle}"
                                                       AutomationProperties.HeadingLevel="Level3"
                                                       AutomationProperties.Name="{x:Bind SectionName('Preparing downloads', ViewModel.PreparationCountText, ViewModel.HasPreparations), Mode=OneWay}" />
                                            <Border Style="{StaticResource ActivityCountChipStyle}" Visibility="{x:Bind ViewModel.HasPreparations, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind ViewModel.PreparationCountText, Mode=OneWay}"
                                                           Style="{StaticResource ActivityCountChipTextStyle}" />
                                            </Border>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.Preparations}" ItemTemplate="{StaticResource ActivityPreparationRowTemplate}"
                                                      IsTabStop="False" />
                                        <controls:ReadingRow Style="{StaticResource ActivityRowStyle}"
                                                             Visibility="{x:Bind ViewModel.HasWaitingPreparations, Mode=OneWay}"
                                                             AutomationProperties.Name="{x:Bind ViewModel.WaitingPreparationsText, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE823;" Style="{StaticResource ActivitySummaryIconStyle}" />
                                                <TextBlock Text="{x:Bind ViewModel.WaitingPreparationsText, Mode=OneWay}"
                                                           Style="{StaticResource ActivityEmptyRowTextStyle}" />
                                            </StackPanel>
                                        </controls:ReadingRow>
                                        <controls:ReadingRow Style="{StaticResource ActivityRowStyle}"
                                                             Visibility="{x:Bind ViewModel.HasPausedPreparations, Mode=OneWay}"
                                                             AutomationProperties.Name="{x:Bind ViewModel.PausedPreparationsText, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE769;" Style="{StaticResource ActivitySummaryIconStyle}" />
                                                <TextBlock Text="{x:Bind ViewModel.PausedPreparationsText, Mode=OneWay}"
                                                           Style="{StaticResource ActivityEmptyRowTextStyle}" />
                                            </StackPanel>
                                        </controls:ReadingRow>
                                        <controls:ReadingRow Style="{StaticResource ActivityRowStyle}"
                                                             Visibility="{x:Bind ViewModel.HasFailedPreparations, Mode=OneWay}"
                                                             AutomationProperties.Name="{x:Bind ViewModel.FailedPreparationsText, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE7BA;" Style="{StaticResource ActivitySummaryIconStyle}"
                                                          Foreground="{StaticResource SiloDestructiveBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.FailedPreparationsText, Mode=OneWay}"
                                                           Style="{StaticResource ActivityEmptyRowTextStyle}" FontFamily="{StaticResource SiloFontMedium}"
                                                           FontWeight="Medium" Foreground="{StaticResource SiloDestructiveBrush}" />
                                            </StackPanel>
                                        </controls:ReadingRow>
                                        <controls:ReadingRow Style="{StaticResource ActivityRowStyle}" Visibility="{x:Bind ViewModel.HasNoPreparations, Mode=OneWay}"
                                                             AutomationProperties.Name="No downloads being prepared">
                                            <TextBlock Text="No downloads being prepared" Style="{StaticResource ActivityEmptyRowTextStyle}" />
                                        </controls:ReadingRow>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Flyout>
            </Button.Flyout>
        </Button>

        <!--
            How much is going on: the web's count on the corner, breathing once every two seconds. White, bold and 10 px on
            the web's bg-red-500, which its Tailwind 4 draws as #FB2C36: about 3.8:1, the web's own contrast.
        -->
        <Border x:Name="Badge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" MinWidth="18" Height="18"
                CornerRadius="9" Padding="4,0" Background="#FFFB2C36" IsHitTestVisible="False"
                Visibility="{x:Bind ViewModel.HasActivity, Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.BadgeText, Mode=OneWay}" FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="10"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <!-- The events stream has stayed away for a while: what shows may be old. -->
        <Ellipse HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3" Width="14" Height="14" Fill="#FFFB2C36"
                 Stroke="{StaticResource SiloBackgroundBrush}" StrokeThickness="2" IsHitTestVisible="False"
                 Visibility="{x:Bind ViewModel.ShowsConnectionProblem, Mode=OneWay}" />
    </Grid>
</UserControl>
