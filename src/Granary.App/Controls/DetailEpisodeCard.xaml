<?xml version="1.0" encoding="utf-8"?>
<!--
    An episode in a season grid: the shared landscape card ("S03E01 · Chapter 1", "23 Oct 2026 · 52m", the
    watched mark and progress), then up to three lines of the overview, as on the web's episode cards.
-->
<UserControl
    x:Class="Granary.App.Controls.DetailEpisodeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls">

    <StackPanel Spacing="6">
        <controls:MediaCardView Card="{x:Bind Episode.Card, Mode=OneWay}" />
        <TextBlock x:Name="OverviewText" Text="{x:Bind Episode.Overview, Mode=OneWay}" Style="{StaticResource SiloCaptionTextStyle}"
                   FontFamily="{StaticResource SiloFontRegular}" FontWeight="Normal" LineHeight="18" TextWrapping="Wrap" MaxLines="3" Padding="2,0" />
    </StackPanel>
</UserControl>
