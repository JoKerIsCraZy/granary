<?xml version="1.0" encoding="utf-8"?>
<!--
    The sheet "Start a Watch Party" opens on a title's page, as the web's StartPartySheet.tsx: "WATCH TOGETHER" over "Start a
    party with this", the title with its poster, the episode a series, season or episode puts up (with the web's chooser to
    pick another), "How to pick", "Allow guests to pause", and "Create party & copy invite". Shown in a ContentDialog
    (DetailHero.xaml.cs), whose Cancel closes it.
-->
<UserControl
    x:Class="Granary.App.Controls.StartPartyPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:wp="using:Granary.Core.ViewModels.WatchParty">

    <UserControl.Resources>
        <!-- The web's small capitals above a part: 11 px, semibold, 0.18 em apart, muted. -->
        <Style x:Key="EyebrowStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="180" />
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        </Style>
        <!-- The web's surface-panel-subtle: a faint raised surface, radius 12. -->
        <Style x:Key="SubtlePanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource SiloBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <!-- The web's ghost button: no fill until the pointer is on it. -->
        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloSecondaryButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="Sheet" Width="400" Spacing="16">
        <StackPanel Spacing="6">
            <TextBlock Text="WATCH TOGETHER" Style="{StaticResource EyebrowStyle}" />
            <TextBlock Text="Start a party with this" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="20"
                       AutomationProperties.HeadingLevel="Level1" />
        </StackPanel>

        <!-- The title as the page shows it: a 56 px poster on its placeholder, the title, and the line under it. -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="56" Height="84" CornerRadius="6" Background="{StaticResource SiloSurfaceRaisedBrush}"
                  AutomationProperties.AccessibilityView="Raw">
                <Image Source="{x:Bind controls:StartPartyPanel.Blur(ViewModel.PosterThumbhash), Mode=OneWay}" Stretch="UniformToFill" />
                <Image Source="{x:Bind controls:DetailHero.LoadImage(ViewModel.Poster, 112), Mode=OneWay}" Stretch="UniformToFill" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                           FontSize="15" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ViewModel.Caption, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SiloMutedBrush}"
                           TextTrimming="CharacterEllipsis" Visibility="{x:Bind ViewModel.HasCaption, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- The episode a series, season or episode puts up, with Change (or Choose while none is). -->
        <Border Style="{StaticResource SubtlePanelStyle}" Padding="12,10" Visibility="{x:Bind ViewModel.ShowsPick, Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="EPISODE" Style="{StaticResource EyebrowStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.EpisodeText, Mode=OneWay}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium"
                               FontSize="14" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="ChangeButton" Grid.Column="1" Style="{StaticResource GhostButtonStyle}" VerticalAlignment="Center"
                        Content="{x:Bind ViewModel.ChangeLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ChooseCommand}"
                        AutomationProperties.Name="{x:Bind controls:StartPartyPanel.ChangeName(ViewModel.ChangeLabel), Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- The web's EpisodeChooser: the seasons as pills, the season's episodes with a file, and Keep the current pick. -->
        <Border Style="{StaticResource SubtlePanelStyle}" Padding="12" Visibility="{x:Bind ViewModel.IsChoosing, Mode=OneWay}">
            <StackPanel Spacing="12">
                <ItemsRepeater x:Name="SeasonPills" ItemsSource="{x:Bind ViewModel.Seasons}" XYFocusKeyboardNavigation="Enabled"
                               AutomationProperties.Name="Seasons">
                    <ItemsRepeater.Layout>
                        <controls:WrapLayout HorizontalSpacing="6" VerticalSpacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="wp:StartPartySeason">
                            <Button Content="{x:Bind Label}" Click="OnSeasonClick" Padding="12,4" MinHeight="0" FontSize="12"
                                    FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" CornerRadius="{StaticResource SiloPillCornerRadius}"
                                    controls:Pill.IsEnabled="True" BorderThickness="0"
                                    Background="{x:Bind controls:StartPartyPanel.PillBackground(IsSelected), Mode=OneWay}"
                                    Foreground="{x:Bind controls:StartPartyPanel.PillForeground(IsSelected), Mode=OneWay}"
                                    AutomationProperties.ItemStatus="{x:Bind controls:PlayerMenus.Status(IsSelected), Mode=OneWay}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <ScrollViewer MaxHeight="256" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="EpisodeRows" ItemsSource="{x:Bind ViewModel.Episodes}" IsTabStop="False" XYFocusKeyboardNavigation="Enabled"
                                  AutomationProperties.Name="Episodes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="wp:StartPartyEpisode">
                                <Button Click="OnEpisodeClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8"
                                        Background="Transparent" BorderThickness="0" CornerRadius="8" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Number}" FontSize="12" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SiloMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="watched" FontSize="11" Foreground="{StaticResource SiloMutedBrush}" VerticalAlignment="Center"
                                                   Visibility="{x:Bind IsWatched}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsLoadingEpisodes, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsLoadingEpisodes, Mode=OneWay}" AutomationProperties.Name="Loading the episodes" />
                <TextBlock Text="No playable episodes here." FontSize="14" Foreground="{StaticResource SiloMutedBrush}" HorizontalAlignment="Center"
                           Margin="0,8" Visibility="{x:Bind ViewModel.HasNoEpisodes, Mode=OneWay}" />
                <Button x:Name="KeepButton" Content="Keep the current pick" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left"
                        Command="{x:Bind ViewModel.KeepCurrentCommand}" />
            </StackPanel>
        </Border>

        <!-- The web's radiogroup "How to pick": two cards, their captions naming what the title becomes. -->
        <StackPanel Spacing="8" AutomationProperties.Name="How to pick">
            <TextBlock Text="HOW TO PICK" Style="{StaticResource EyebrowStyle}" />
            <RadioButton GroupName="StartPartyMode" Style="{StaticResource SiloModeCardStyle}" CornerRadius="8" Padding="12,10" PreviewKeyDown="OnModeKeyDown"
                         IsChecked="{x:Bind ViewModel.IsHostPick, Mode=TwoWay}"
                         AutomationProperties.Name="Host picks" AutomationProperties.HelpText="{x:Bind ViewModel.HostPickCaption, Mode=OneWay}">
                <StackPanel Spacing="2">
                    <TextBlock Text="Host picks" Style="{StaticResource SiloModeTitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.HostPickCaption, Mode=OneWay}" Style="{StaticResource SiloModeCaptionTextStyle}" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="StartPartyMode" Style="{StaticResource SiloModeCardStyle}" CornerRadius="8" Padding="12,10" PreviewKeyDown="OnModeKeyDown"
                         IsChecked="{x:Bind ViewModel.IsVoteMode, Mode=TwoWay}"
                         AutomationProperties.Name="Everyone votes" AutomationProperties.HelpText="{x:Bind ViewModel.VoteCaption, Mode=OneWay}">
                <StackPanel Spacing="2">
                    <TextBlock Text="Everyone votes" Style="{StaticResource SiloModeTitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.VoteCaption, Mode=OneWay}" Style="{StaticResource SiloModeCaptionTextStyle}" />
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Allow guests to pause" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="14" />
                <TextBlock Text="Otherwise only you control playback" FontSize="12" Foreground="{StaticResource SiloMutedBrush}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                          IsOn="{x:Bind ViewModel.GuestsCanPause, Mode=TwoWay}"
                          AutomationProperties.Name="Allow guests to pause" AutomationProperties.HelpText="Otherwise only you control playback" />
        </Grid>

        <Border Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" CornerRadius="8" Padding="12,10" BorderThickness="1"
                BorderBrush="#4DEF4444" Background="#1AEF4444">
            <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" FontSize="13" Foreground="#FFFECACA" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive" />
        </Border>

        <Button x:Name="CreateButton" Content="{x:Bind ViewModel.CreateLabel, Mode=OneWay}" Style="{StaticResource SiloPrimaryButtonStyle}"
                HorizontalAlignment="Stretch" MinHeight="44" Command="{x:Bind ViewModel.CreateCommand}" />
        <TextBlock Text="You'll land in the room. Nothing plays until you start it. The room can see what members are mid-way through."
                   FontSize="12" Foreground="{StaticResource SiloMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>
</UserControl>
