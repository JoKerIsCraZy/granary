<?xml version="1.0" encoding="utf-8"?>
<!--
    The profile editor, as the web's ProfileEditorDialog: Profile (the preview, the name, the PIN, the preset pictures and the
    image of its own where the server keeps uploads) and Access (Kids, the content rating, the advisory age, the playback
    quality, the libraries and requests, each only where the server takes it). ProfileEditorDialog shows it in a dialog with
    Cancel and Save profile.
-->
<UserControl
    x:Class="Granary.App.Controls.ProfileEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:profiles="using:Granary.Core.ViewModels.Profiles"
    xmlns:t="using:Granary.Core.Texts">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Made in code: the page's dictionaries do not reach it. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Themes/SiloSettings.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="20" MinWidth="560">
        <!-- Profile -->
        <StackPanel Spacing="16" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource SiloSettingsHairlineBrush}">
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind t:AppText.Get('web.profiles.editor.profileSection')}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="{x:Bind t:AppText.Get('web.profiles.editor.profileSectionHint')}" Style="{StaticResource SiloSettingsMutedTextStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="10" Padding="12,16" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource SiloSettingsHairlineBrush}">
                    <Grid Width="96" Height="96" HorizontalAlignment="Center">
                        <controls:ProfileAvatar Width="96" Height="96" FontSize="36" Image="{x:Bind ViewModel.Preview, Mode=OneWay}"
                                                Initial="{x:Bind ViewModel.PreviewInitial, Mode=OneWay}" />
                        <Ellipse x:Name="NewPictureCircle" Visibility="Collapsed">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="NewPictureBrush" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.PreviewName, Mode=OneWay}" HorizontalAlignment="Center" FontFamily="{StaticResource SiloFontSemiBold}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.PreviewLine, Mode=OneWay}" HorizontalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource SiloMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBox x:Name="NameBox" Header="{x:Bind t:AppText.Get('web.profiles.editor.name')}" MaxLength="64"
                                 Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{x:Bind ViewModel.NameError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="13"
                                   Visibility="{x:Bind controls:SettingsText.Shows(ViewModel.NameError), Mode=OneWay}" AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <PasswordBox x:Name="PinBox" Header="{x:Bind ViewModel.PinLabel, Mode=OneWay}" PlaceholderText="{x:Bind ViewModel.PinPlaceholder, Mode=OneWay}"
                                     InputScope="NumericPin" MaxLength="4" IsEnabled="{x:Bind ViewModel.CanTypePin, Mode=OneWay}"
                                     PasswordChanged="OnPinChanged" />
                        <HyperlinkButton Content="{x:Bind ViewModel.PinToggleLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.CanClearPin}"
                                         Click="OnPinToggleClick" Padding="0,2" />
                        <TextBlock Text="{x:Bind ViewModel.PinError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="13"
                                   Visibility="{x:Bind controls:SettingsText.Shows(ViewModel.PinError), Mode=OneWay}" AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Preset avatars: a DiceBear style, its batch of pictures, More options. -->
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind t:AppText.Get('web.profiles.editor.presets')}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind t:AppText.Get('web.profiles.editor.presetsHint')}" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="StyleBox" MinWidth="200" ItemsSource="{x:Bind ViewModel.Styles}" SelectionChanged="OnChoiceChanged"
                              AutomationProperties.Name="{x:Bind t:AppText.Get('web.profiles.editor.presets')}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind ViewModel.PresetsShowing, Mode=OneWay}"
                               Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind ViewModel.MorePresetsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="{x:Bind t:AppText.Get('web.profiles.editor.moreOptions')}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <GridView x:Name="PresetGrid" ItemsSource="{x:Bind ViewModel.Presets}" SelectionMode="Single" IsItemClickEnabled="True"
                          ItemClick="OnPresetClick" AutomationProperties.Name="{x:Bind t:AppText.Get('web.profiles.editor.presets')}"
                          ContainerContentChanging="OnPresetContainerContentChanging">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="profiles:ProfileAvatarPreset">
                            <Grid Width="64" Height="64" Padding="4">
                                <controls:ProfileAvatar Width="56" Height="56" FontSize="20" Image="{x:Bind controls:ProfileEditorView.PresetImage(PreviewUrl)}"
                                                        Initial="{x:Bind Label}" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <!-- Custom upload, where the server keeps uploads. -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsUpload}">
                <TextBlock Text="{x:Bind t:AppText.Get('web.profiles.editor.customUpload')}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" Click="OnChoosePictureClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE898;" FontSize="12" />
                            <TextBlock Text="{x:Bind t:AppText.Get('granary.profiles.editor.choosePicture')}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" Click="OnRemoveNewPictureClick" Visibility="{x:Bind ViewModel.HasNewPicture, Mode=OneWay}"
                            Content="{x:Bind t:AppText.Get('web.common.ui.imageUpload.removeSelected')}" />
                    <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" Click="OnDeleteUploadedPictureClick"
                            Visibility="{x:Bind ViewModel.HasUploadedPicture, Mode=OneWay}" Content="{x:Bind t:AppText.Get('web.common.ui.imageUpload.delete')}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.PictureError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="13"
                           Visibility="{x:Bind controls:SettingsText.Shows(ViewModel.PictureError), Mode=OneWay}" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
            <StackPanel Spacing="2" Padding="16,12" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource SiloSettingsHairlineBrush}"
                        Visibility="{x:Bind ViewModel.ShowsUploadUnavailable}">
                <TextBlock Text="{x:Bind t:AppText.Get('web.profiles.editor.uploadsUnavailable')}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind t:AppText.Get('web.profiles.editor.uploadsUnavailableHint')}" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <!-- Access -->
        <StackPanel Spacing="16" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource SiloSettingsHairlineBrush}">
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind t:AppText.Get('web.profiles.editor.accessSection')}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="{x:Bind t:AppText.Get('web.profiles.editor.accessSectionHint')}" Style="{StaticResource SiloSettingsMutedTextStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <ToggleSwitch Header="{x:Bind t:AppText.Get('web.profiles.editor.kids')}" IsOn="{x:Bind ViewModel.IsChild, Mode=TwoWay}"
                          OnContent="{x:Bind t:AppText.Get('web.profiles.editor.kidsHint')}" OffContent="{x:Bind t:AppText.Get('web.profiles.editor.kidsHint')}" />

            <ComboBox x:Name="RatingBox" Header="{x:Bind t:AppText.Get('web.profiles.editor.maxContentRating')}" MinWidth="280" ItemsSource="{x:Bind ViewModel.ContentRatings}"
                      SelectionChanged="OnChoiceChanged" />

            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.ShowsAdvisoryAge}">
                <ComboBox x:Name="AgeBox" Header="{x:Bind t:AppText.Get('web.profiles.editor.maxAdvisoryAge')}" MinWidth="280" ItemsSource="{x:Bind ViewModel.AdvisoryAges}"
                          SelectionChanged="OnChoiceChanged" />
                <TextBlock Text="{x:Bind ViewModel.AdvisoryAgeHelp, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
                <ToggleSwitch Header="{x:Bind t:AppText.Get('web.profiles.editor.hideWithoutAge')}" IsOn="{x:Bind ViewModel.RequireAdvisoryAge, Mode=TwoWay}"
                              Visibility="{x:Bind ViewModel.ShowsRequireAdvisoryAge, Mode=OneWay}" />
                <TextBlock Text="{x:Bind t:AppText.Get('web.profiles.editor.hideWithoutAgeHint')}" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="12"
                           TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ShowsRequireAdvisoryAge, Mode=OneWay}" />
            </StackPanel>

            <ComboBox x:Name="QualityBox" Header="{x:Bind t:AppText.Get('web.profiles.editor.maxPlaybackQuality')}" MinWidth="280" ItemsSource="{x:Bind ViewModel.PlaybackCeilings}"
                      SelectionChanged="OnChoiceChanged" />

            <!-- Library Access: the primary profile sees every library; another can be limited to some. -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind t:AppText.Get('web.profiles.libraryAccess.label')}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind t:AppText.Get('web.profiles.libraryAccess.primaryNote')}" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="12"
                           TextWrapping="Wrap" Visibility="{x:Bind ViewModel.IsPrimary}" />
                <ToggleSwitch Header="{x:Bind t:AppText.Get('web.profiles.editor.restrictLibraries')}" IsOn="{x:Bind ViewModel.LibraryRestrictionsEnabled, Mode=TwoWay}"
                              Visibility="{x:Bind ViewModel.CanLimitLibraries}" OnContent="{x:Bind t:AppText.Get('web.profiles.editor.restrictLibrariesHint')}"
                              OffContent="{x:Bind t:AppText.Get('web.profiles.libraryAccess.allLibraries')}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Libraries}" Visibility="{x:Bind ViewModel.ShowsLibraryChoices, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="profiles:ProfileLibraryChoice">
                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{x:Bind ViewModel.LibrariesError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="13"
                           Visibility="{x:Bind controls:SettingsText.Shows(ViewModel.LibrariesError), Mode=OneWay}" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>

            <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.ShowsRequests}">
                <ToggleSwitch Header="{x:Bind t:AppText.Get('web.profiles.editor.requestsAllowed')}" IsOn="{x:Bind ViewModel.RequestsAllowed, Mode=TwoWay}" />
                <TextBlock Text="{x:Bind t:AppText.Get('web.profiles.editor.requestsAllowedHint')}" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                   Visibility="{x:Bind controls:SettingsText.Shows(ViewModel.Status), Mode=OneWay}" AutomationProperties.LiveSetting="Assertive" />
    </StackPanel>
</UserControl>
