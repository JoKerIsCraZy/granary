<?xml version="1.0" encoding="utf-8"?>
<!--
    A wrapping grid of cards for library, "Explore all" and search pages. It has no scroller of its own:
    put it in the page's ScrollViewer, under the page's title and filters, and it virtualizes against that.
    A placeholder card (a title not loaded yet) is drawn as a skeleton.
-->
<UserControl
    x:Class="Granary.App.Controls.MediaGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:cards="using:Granary.Core.ViewModels.Cards">

    <UserControl.Resources>
        <DataTemplate x:Key="CardTemplate" x:DataType="cards:MediaCard">
            <Button Style="{StaticResource SiloCardButtonStyle}" VerticalAlignment="Top" Click="OnCardClick" AutomationProperties.Name="{x:Bind AccessibleName}">
                <controls:MediaCardView Card="{x:Bind}" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="SkeletonTemplate">
            <controls:MediaCardSkeleton />
        </DataTemplate>
        <controls:MediaCardTemplateSelector x:Key="CardTemplateSelector" Card="{StaticResource CardTemplate}" Skeleton="{StaticResource SkeletonTemplate}" />
    </UserControl.Resources>

    <!-- Cards are made half a screen above and below the view, not ItemsRepeater's whole screen: fewer live cards make the
         collector's full pauses shorter, most on a wide window. -->
    <ItemsRepeater x:Name="Items" ItemsSource="{x:Bind ItemsSource, Mode=OneWay}" ItemTemplate="{StaticResource CardTemplateSelector}" VerticalCacheLength="1"
                   ElementPrepared="OnElementPrepared" EffectiveViewportChanged="OnEffectiveViewportChanged" SizeChanged="OnItemsSizeChanged">
        <ItemsRepeater.Layout>
            <!-- The columns and gap follow the profile's poster size at the window's breakpoint (MediaGrid.ApplyLook). -->
            <UniformGridLayout x:Name="GridLayout" MinItemWidth="64" MinColumnSpacing="12" MinRowSpacing="12" MaximumRowsOrColumns="8"
                               ItemsStretch="Fill" ItemsJustification="Start" />
        </ItemsRepeater.Layout>
    </ItemsRepeater>
</UserControl>
