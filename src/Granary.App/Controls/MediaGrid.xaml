<?xml version="1.0" encoding="utf-8"?>
<!--
    A wrapping grid of cards for library, "Explore all" and search pages. It has no scroller of its own:
    put it in the page's ScrollViewer, under the page's title and filters, and it virtualizes against that.
-->
<UserControl
    x:Class="Granary.App.Controls.MediaGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:cards="using:Granary.Core.ViewModels.Cards">

    <ItemsRepeater x:Name="Items" ItemsSource="{x:Bind ItemsSource, Mode=OneWay}" ElementPrepared="OnElementPrepared">
        <ItemsRepeater.Layout>
            <UniformGridLayout x:Name="GridLayout" MinItemWidth="185" MinColumnSpacing="20" MinRowSpacing="28"
                               ItemsStretch="Fill" ItemsJustification="Start" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="cards:MediaCard">
                <Button Style="{StaticResource SiloCardButtonStyle}" VerticalAlignment="Top" Click="OnCardClick" AutomationProperties.Name="{x:Bind AccessibleName}">
                    <controls:MediaCardView Card="{x:Bind}" />
                </Button>
            </DataTemplate>
        </ItemsRepeater.ItemTemplate>
    </ItemsRepeater>
</UserControl>
