<?xml version="1.0" encoding="utf-8"?>
<!--
    The web's PillGroup: one choice of a few, as round pills; the chosen one white with dark text, the others faint,
    lighter under the pointer. Arrow keys move between them.
-->
<UserControl
    x:Class="Granary.App.Controls.PillChoices"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    IsTabStop="False">

    <UserControl.Resources>
        <Style x:Key="PillStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#BFFFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,4,12,5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-2" />
            <!-- Half circles at any height, as the web's rounded-full. -->
            <Setter Property="controls:Pill.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Chosen.Opacity" Value="1" />
                                            <Setter Target="Content.Foreground" Value="Black" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border Background="#0FFFFFFF" />
                            <Border x:Name="Hover" Background="#0FFFFFFF" Opacity="0" />
                            <Border x:Name="Chosen" Background="White" Opacity="0" />
                            <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}" AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="Pills" Orientation="Horizontal" Spacing="6" XYFocusKeyboardNavigation="Enabled" />
</UserControl>
