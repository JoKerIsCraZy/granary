<?xml version="1.0" encoding="utf-8"?>
<!--
    The top of Home (docs/ui-design.md, Home): the title the pointer or the keyboard is on, or the slide of Home's banner,
    over its backdrop, which runs over the hero's whole width and fades into the page behind the text and toward the
    rows. It stays at the top while the rows scroll, folding to a compact header (BrowseHero.FollowScroll). The full hero
    lies under the fades of the web's banner (BrowseHero.ApplySizes).
-->
<UserControl
    x:Class="Granary.App.Controls.BrowseHero"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Top">

    <UserControl.Resources>
        <!-- The compact hero's fades: behind the text, and toward the rows. Its text hangs from the top, clear of the bottom
             fade the full hero's stands in, so the side shade is sized to the text's widest reach, not to the hero's width: the full
             hero's 88 % of the page's colour at the left edge and its 58 % where the text ends, then its 22 % and clear
             three eighths and three quarters of the text's reach further (the brush is 1.75 times the text's reach wide,
             BrowseHeroLayout.TextShadeReach, so the text ends at 4/7 of it). -->
        <LinearGradientBrush x:Key="CompactSideFade" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#E00E0E10" />
            <GradientStop Offset="0.5714" Color="#940E0E10" />
            <GradientStop Offset="0.7857" Color="#380E0E10" />
            <GradientStop Offset="1" Color="#000E0E10" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CompactBottomFade" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#00141417" />
            <GradientStop Offset="1" Color="{StaticResource SiloBackgroundColor}" />
        </LinearGradientBrush>
        <!-- The full hero's, as the web's banner's (.hero-gradient-left and .hero-gradient in its app.css): 88 %, 58 % and
             22 % of the page's colour over the left half; and from the bottom 100 %, 88 %, 48 % and 12 % of it at 0, 12, 30
             and 50 % of the hero's height, clear from 66 % (the fade is that high, BrowseHeroLayout.FullFadeShare). The
             page's colour is SiloBackgroundColor, #0E0E10. -->
        <LinearGradientBrush x:Key="FullSideFade" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#E00E0E10" />
            <GradientStop Offset="0.16" Color="#940E0E10" />
            <GradientStop Offset="0.34" Color="#380E0E10" />
            <GradientStop Offset="0.5" Color="#000E0E10" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FullBottomFade" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#000E0E10" />
            <GradientStop Offset="0.242" Color="#1F0E0E10" />
            <GradientStop Offset="0.545" Color="#7A0E0E10" />
            <GradientStop Offset="0.818" Color="#E00E0E10" />
            <GradientStop Offset="1" Color="{StaticResource SiloBackgroundColor}" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <!-- Heights from BrowseHeroLayout; a wheel or a touch drag on the header scrolls the rows. -->
    <Grid x:Name="Root" Background="Transparent" PointerWheelChanged="OnWheel"
          ManipulationMode="TranslateY,TranslateInertia" ManipulationStarted="OnDragStarting" ManipulationDelta="OnDrag">
        <Grid x:Name="BackdropBox" HorizontalAlignment="Left" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
            <!-- Two layers, so a new title's backdrop fades in over the last one. Their order changes only among themselves,
                 under the fades. The picture fills the box showing its upper part, as the web's heroes: an Image can only
                 be cut around its top, middle or bottom, so the layers have the picture's own size and lie in the box where
                 BrowseHeroLayout.PlaceBackdrop says, cut to it (BrowseHero.PlacePicture). -->
            <Canvas x:Name="Pictures">
                <Grid x:Name="Picture">
                    <Grid x:Name="LayerA">
                        <Image x:Name="BlurA" Stretch="UniformToFill" VerticalAlignment="Center" />
                        <Image x:Name="ArtA" Stretch="UniformToFill" VerticalAlignment="Center" Opacity="0" ImageOpened="OnArtOpened" />
                    </Grid>
                    <Grid x:Name="LayerB" Opacity="0">
                        <Image x:Name="BlurB" Stretch="UniformToFill" VerticalAlignment="Center" />
                        <Image x:Name="ArtB" Stretch="UniformToFill" VerticalAlignment="Center" Opacity="0" ImageOpened="OnArtOpened" />
                    </Grid>
                </Grid>
            </Canvas>
            <!-- The picture is dimmed a little, as the web's (brightness 0.9, which a tenth of the page's colour over it
                 comes to; the web's own detail heroes do it so). -->
            <Rectangle x:Name="Dim" Fill="#1A0E0E10" />
            <!-- As wide as the compact hero's text needs, or over the full hero's whole width (BrowseHero.ApplySizes). -->
            <Rectangle x:Name="SideFade" HorizontalAlignment="Left" Fill="{StaticResource CompactSideFade}" />
            <Rectangle x:Name="BottomFade" VerticalAlignment="Bottom" Fill="{StaticResource CompactBottomFade}" />
        </Grid>

        <!-- The sizes here are a 1080 px window's; a taller one grows them (BrowseHero.ApplySizes). -->
        <StackPanel x:Name="Texts" Margin="48,40,48,0" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <!-- Home's banner: the web's eyebrow over the slide's name, "FEATURED — NO. 01" in tracked small capitals. -->
            <TextBlock x:Name="Eyebrow" Visibility="Collapsed" Margin="0,0,0,12" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                       FontSize="11.5" LineHeight="14" LineStackingStrategy="BlockLineHeight" CharacterSpacing="220" TextWrapping="NoWrap"
                       Foreground="#9EE8E8EC"><Run Text="FEATURED" Foreground="#EBE8E8EC" /><Run Text="  —  " Foreground="#47E8E8EC" /><Run x:Name="EyebrowNumber" /></TextBlock>
            <!-- The logo stands in for the name; without one, or when it does not load, the name in large type. -->
            <Grid x:Name="Heading" Height="80" HorizontalAlignment="Left">
                <Image x:Name="Logo" MaxWidth="400" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0"
                       ImageOpened="OnLogoOpened" ImageFailed="OnLogoFailed" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="HeadingText" FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="40"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" AutomationProperties.HeadingLevel="Level1" />
            </Grid>
            <!-- The details, one line. A rating in it shows as the web's RatingEntry: its source's mark in smaller, fainter
                 type, as text (the web's IMDb mark; Granary draws TMDB's so too), and its score in bold. The line's own
                 type and colour otherwise (BrowseHero.ShowDetails, ApplySizes). -->
            <TextBlock x:Name="MetaText" Margin="0,10,0,0" FontSize="16" Foreground="{StaticResource SiloMutedBrush}"
                       TextTrimming="CharacterEllipsis" MaxLines="1"><Run x:Name="MetaLead" /><Run x:Name="MetaMark" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" CharacterSpacing="-25" Foreground="{StaticResource SiloMutedTint75Brush}" /><Run x:Name="MetaScore" FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" /><Run x:Name="MetaTail" /></TextBlock>
            <TextBlock x:Name="OverviewText" Margin="0,10,0,0" MaxWidth="570" HorizontalAlignment="Left" FontSize="15" LineHeight="22"
                       TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxLines="3" />
        </StackPanel>
    </Grid>
</UserControl>
