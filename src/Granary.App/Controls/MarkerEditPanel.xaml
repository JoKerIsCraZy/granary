<?xml version="1.0" encoding="utf-8"?>
<!--
    The web player's MarkerEditPanel: a 352 px card bottom left above the controls (neutral 900 at 95 %, radius 16),
    moved by its header. A row per kind (intro, recap, credits, preview) with its dot, name and range; the chosen row
    opens with Set start and Set end at the playhead, Reset and Clear. At the bottom the playhead's time, Reset all,
    Cancel and Save.
-->
<UserControl
    x:Class="Granary.App.Controls.MarkerEditPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:player="using:Granary.Core.ViewModels.Player"
    RequestedTheme="Dark">

    <UserControl.Resources>
        <!-- Set start, Set end: white 5 % with a faint edge, 11 px. -->
        <Style x:Key="EdgeButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPlayerMenuItemStyle}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="Foreground" Value="#D9FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <!-- Reset and Clear: a bare 14 px icon, white 40 %. -->
        <Style x:Key="RowIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPlayerMenuStepButtonStyle}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#66FFFFFF" />
        </Style>
        <Style x:Key="FooterButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPlayerMenuItemStyle}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="Card" Width="352" CornerRadius="16" BorderThickness="1" BorderBrush="#1AFFFFFF" Background="#F2171717"
            AutomationProperties.Name="Edit markers">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Offset" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: the handle to move the card. -->
            <controls:MoveHandle x:Name="Header" Padding="16,14,12,12" ColumnSpacing="8" Background="Transparent"
                  PointerPressed="OnHeaderPressed" PointerMoved="OnHeaderMoved" PointerReleased="OnHeaderReleased">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE76F;" FontSize="14" Margin="0,2,0,0" VerticalAlignment="Top" Foreground="#4DFFFFFF" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Edit markers" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="14"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="Drag the timeline handles, or set points to the playhead." FontSize="11" Foreground="#66FFFFFF" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Width="26" Height="26" VerticalAlignment="Top" Style="{StaticResource RowIconButtonStyle}" Foreground="#80FFFFFF"
                        Command="{x:Bind ViewModel.MarkerEditor.CancelCommand, Mode=OneWay}" AutomationProperties.Name="Close marker editor"
                        ToolTipService.ToolTip="Close">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </controls:MoveHandle>

            <!-- A row per kind; the chosen one open. -->
            <ItemsControl Grid.Row="1" Margin="8,0,8,8" ItemsSource="{x:Bind ViewModel.MarkerEditor.Rows, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="player:MarkerEditRow">
                        <Border Margin="0,0,0,4" Padding="{x:Bind controls:MarkerEditPanel.RowPadding(IsActive), Mode=OneWay}" CornerRadius="12"
                                Background="{x:Bind controls:MarkerEditPanel.RowBackground(IsActive), Mode=OneWay}"
                                BorderBrush="{x:Bind controls:MarkerEditPanel.RowEdge(IsActive), Mode=OneWay}" BorderThickness="1">
                            <StackPanel>
                                <Button Style="{StaticResource SiloPlayerMenuItemStyle}" Padding="0,4" CornerRadius="6" Background="Transparent"
                                        Click="OnRowClick" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                        AutomationProperties.ItemStatus="{x:Bind controls:PlayerMenus.Status(IsActive), Mode=OneWay}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="{x:Bind controls:MarkerEditPanel.DotSize(IsActive), Mode=OneWay}"
                                                 Height="{x:Bind controls:MarkerEditPanel.DotSize(IsActive), Mode=OneWay}"
                                                 Fill="{x:Bind controls:AddSubtitlesPanel.Solid(Color)}"
                                                 Opacity="{x:Bind controls:MarkerEditPanel.DotOpacity(IsActive), Mode=OneWay}"
                                                 Stroke="#40FFFFFF" StrokeThickness="{x:Bind controls:MarkerEditPanel.DotRing(IsActive), Mode=OneWay}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Label}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="13"
                                                   Foreground="{x:Bind controls:MarkerEditPanel.LabelForeground(IsActive), Mode=OneWay}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind RangeText, Mode=OneWay}" FontFamily="Consolas" FontSize="11"
                                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"
                                                   Foreground="{x:Bind controls:MarkerEditPanel.RangeForeground(HasRange), Mode=OneWay}" />
                                    </Grid>
                                </Button>
                                <Grid Margin="0,8,0,0" ColumnSpacing="6" Visibility="{x:Bind IsActive, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Set start" Style="{StaticResource EdgeButtonStyle}" Click="OnSetStartClick" BorderThickness="1" BorderBrush="#1AFFFFFF" />
                                    <Button Grid.Column="1" Content="Set end" Style="{StaticResource EdgeButtonStyle}" Click="OnSetEndClick" BorderThickness="1"
                                            BorderBrush="#1AFFFFFF" />
                                    <Button Grid.Column="3" Style="{StaticResource RowIconButtonStyle}" Click="OnResetClick" IsEnabled="{x:Bind IsDirty, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind controls:MarkerEditPanel.ResetName(Label)}" ToolTipService.ToolTip="Reset to saved">
                                        <FontIcon Glyph="&#xE7A7;" FontSize="13" />
                                    </Button>
                                    <Button Grid.Column="4" Style="{StaticResource RowIconButtonStyle}" Click="OnClearClick" IsEnabled="{x:Bind HasRange, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind controls:MarkerEditPanel.ClearName(Label)}"
                                            ToolTipService.ToolTip="Remove marker until manually set again">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="2" Margin="16,0,16,8" Padding="10,6" CornerRadius="6" Background="#26EF4444"
                    Visibility="{x:Bind Shows(ViewModel.MarkerEditor.Error), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.MarkerEditor.Error, Mode=OneWay}" FontSize="11" Foreground="#FFFCA5A5" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
            </Border>

            <!-- Footer. -->
            <Grid Grid.Row="3" Padding="16,10" ColumnSpacing="6" Background="#33000000" BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0"
                  CornerRadius="0,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Time(ViewModel.PositionSeconds), Mode=OneWay}" FontFamily="Consolas" FontSize="11" Foreground="#66FFFFFF"
                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" AutomationProperties.Name="Playhead" />
                <Button Grid.Column="1" Style="{StaticResource FooterButtonStyle}" Foreground="#99FFFFFF" Command="{x:Bind ViewModel.MarkerEditor.ResetAllCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.MarkerEditor.IsDirty, Mode=OneWay}" AutomationProperties.Name="Reset all"
                        ToolTipService.ToolTip="Reset all markers to saved">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                        <TextBlock Text="Reset all" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Content="Cancel" Style="{StaticResource FooterButtonStyle}" Command="{x:Bind ViewModel.MarkerEditor.CancelCommand, Mode=OneWay}" />
                <Button x:Name="SaveButton" Grid.Column="3" Style="{StaticResource FooterButtonStyle}" Background="White" Foreground="#FF171717" Padding="14,6"
                        FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" Command="{x:Bind ViewModel.MarkerEditor.SaveCommand, Mode=OneWay}"
                        AutomationProperties.Name="Save markers">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid Width="12" Height="12">
                            <FontIcon Glyph="&#xE73E;" FontSize="12" Visibility="{x:Bind Hides(ViewModel.MarkerEditor.IsSaving), Mode=OneWay}" />
                            <ProgressRing Width="12" Height="12" Foreground="#FF171717" IsActive="{x:Bind ViewModel.MarkerEditor.IsSaving, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
