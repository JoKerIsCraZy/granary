<?xml version="1.0" encoding="utf-8"?>
<!--
    The body of the download dialog, as the web's DownloadVersionPicker.tsx: its description, the title's files as rows with
    a download disc, the quality line and the size (one row per file, a choice here: Download starts the chosen one), and
    the footer under more than one. Granary adds the qualities your Silo server offers as pills, the size of what starts, the
    free space on this PC, and the web's error in an error bar. Shown in a ContentDialog (Services/DownloadOptionsDialog.cs).
-->
<UserControl
    x:Class="Granary.App.Controls.DownloadOptionsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:downloads="using:Granary.Core.ViewModels.Downloads">

    <UserControl.Resources>
        <!-- The web's small capitals above a part: 11 px, semibold, 0.18 em apart, muted. -->
        <Style x:Key="EyebrowStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="180" />
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        </Style>
        <!-- The web's version row: rounded-xl, a hairline, a faint fill, px-4 py-3, 8 apart. -->
        <Style x:Key="VersionRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource SiloBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <StackPanel Width="400" Spacing="16">
        <TextBlock Text="{x:Bind Description}" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource SiloMutedBrush}" />

        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsVersions}">
            <TextBlock Text="VERSION" Style="{StaticResource EyebrowStyle}" AutomationProperties.AccessibilityView="Raw" />
            <ListView x:Name="VersionList" ItemsSource="{x:Bind ViewModel.Versions}" SelectionMode="Single" MaxHeight="280"
                      SelectedItem="{x:Bind ViewModel.SelectedVersion, Mode=TwoWay}" ItemContainerStyle="{StaticResource VersionRowStyle}"
                      ContainerContentChanging="OnVersionContainerChanging" AutomationProperties.Name="Version">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="downloads:DownloadVersionRow">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- The web's disc: the accent at a tenth behind the accent's download arrow. -->
                            <Grid Width="36" Height="36" AutomationProperties.AccessibilityView="Raw">
                                <Ellipse Fill="{StaticResource SiloPrimaryBrush}" Opacity="0.1" />
                                <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{StaticResource SiloPrimaryBrush}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind Summary}" FontSize="14" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource SiloForegroundBrush}" />
                                <TextBlock Text="{x:Bind SizeText}" FontSize="12" Foreground="{StaticResource SiloMutedBrush}"
                                           Visibility="{x:Bind controls:DownloadOptionsPanel.HasText(SizeText)}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsQualities}">
            <TextBlock Text="QUALITY" Style="{StaticResource EyebrowStyle}" AutomationProperties.AccessibilityView="Raw" />
            <controls:PillChoices ItemsSource="{x:Bind Qualities}" SelectedItem="{x:Bind SelectedQuality, Mode=TwoWay}"
                                  AutomationProperties.Name="Quality" />
        </StackPanel>

        <!-- What starts and whether it fits: "About 2.1 GB", then "200.0 GB free on this PC." or why it does not fit, in red. -->
        <StackPanel Spacing="4">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.SizeText, Mode=OneWay}" FontSize="14" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium"
                           Foreground="{StaticResource SiloForegroundBrush}"
                           Visibility="{x:Bind controls:DownloadOptionsPanel.HasText(ViewModel.SizeText), Mode=OneWay}" />
                <ProgressRing Grid.Column="1" Width="16" Height="16" IsActive="{x:Bind ViewModel.IsStarting, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsStarting, Mode=OneWay}" AutomationProperties.Name="Starting the download" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.SpaceText, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"
                       Foreground="{x:Bind controls:DownloadOptionsPanel.SpaceForeground(ViewModel.IsShortOfSpace), Mode=OneWay}"
                       Visibility="{x:Bind controls:DownloadOptionsPanel.HasText(ViewModel.SpaceText), Mode=OneWay}" />
        </StackPanel>

        <TextBlock Text="{x:Bind Footer}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SiloMutedBrush}"
                   Visibility="{x:Bind ViewModel.ShowsFooter}" />

        <InfoBar Severity="Error" IsClosable="False" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />
    </StackPanel>
</UserControl>
