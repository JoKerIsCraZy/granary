<?xml version="1.0" encoding="utf-8"?>
<!--
    The body of the download dialog, as the web's DownloadVersionPicker.tsx: its description, the title's files as rows with
    a download disc, the quality line and the size (one row per file, a choice here: Download starts the chosen one), and
    the footer under more than one. Granary adds the qualities your Silo server offers as pills, the size of what starts, the
    free space on this PC, and the web's error in an error bar; for a season's or a series' episodes, one of them watched,
    Only unwatched episodes as a switch, and for a series the Apple app's This Episode, Season N and All Episodes as rows.
    From a card, the title's files come while it shows: its
    parts follow the view model. A series that can be monitored has the Apple app's One Time | Monitor above it
    (SeriesDownloadSheet.swift): Monitor's rules as rows, its quality, Delete after watching, its storage limit, one sentence
    on what comes, and Stop Monitoring, which asks in place. Shown in a ContentDialog (Services/DownloadOptionsDialog.cs).
-->
<UserControl
    x:Class="Granary.App.Controls.DownloadOptionsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:downloads="using:Granary.Core.ViewModels.Downloads"
    xmlns:t="using:Granary.Core.Texts">

    <UserControl.Resources>
        <!-- The web's small capitals above a part: 11 px, semibold, 0.18 em apart, muted. -->
        <Style x:Key="EyebrowStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="180" />
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        </Style>
        <!-- The web's version row: rounded-xl, a hairline, a faint fill, px-4 py-3, 8 apart. -->
        <Style x:Key="VersionRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource SiloBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <StackPanel Width="400" Spacing="16">
        <!-- One Time | Monitor, with the Apple app's line under it: only for a series that can be monitored. -->
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsKinds, Mode=OneWay}">
            <controls:PillChoices ItemsSource="{x:Bind ViewModel.Kinds, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedKind, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind t:AppText.Get('web.detail.actions.download')}" />
            <TextBlock Text="{x:Bind ViewModel.KindHint, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource SiloMutedBrush}" />
        </StackPanel>

        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ShowsOneTime, Mode=OneWay}">
        <!-- The web's description; from a card, its words while the title is read, or why there is nothing to download. -->
        <TextBlock Text="{x:Bind ViewModel.DescriptionText, Mode=OneWay}" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource SiloMutedBrush}" />

        <!--
            A card's dialog reads the title's files as it opens, as the web's card menu reads an item for its dialogs
            (MediaItemMenu.tsx, MetadataActionStatusDialog): a turning ring and "Loading…", then, when the read failed,
            "Please try again." with Try Again.
        -->
        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsReading, Mode=OneWay}">
            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsReading, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="{x:Bind t:AppText.Get('web.item.menu.loading')}" FontSize="14" Foreground="{StaticResource SiloMutedBrush}" />
        </StackPanel>
        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.ReadFailed, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind t:AppText.Get('web.item.menu.pleaseTryAgain')}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource SiloMutedBrush}" />
            <Button Grid.Column="1" Content="{x:Bind t:AppText.Get('web.item.menu.tryAgain')}" Command="{x:Bind ViewModel.TryAgainCommand}" />
        </Grid>

        <!--
            A series' One time: the Apple app's This Episode, Season N and All Episodes as rows (a title and its line) in the
            version rows' style, as Monitor's rules; a row with nothing to download, its episode or season on this PC, is off.
        -->
        <ListView ItemsSource="{x:Bind ViewModel.OneTimeRows, Mode=OneWay}" SelectionMode="Single" MaxHeight="280"
                  SelectedItem="{x:Bind ViewModel.SelectedOneTimeRow, Mode=TwoWay}" ItemContainerStyle="{StaticResource VersionRowStyle}"
                  Visibility="{x:Bind ViewModel.ShowsOneTimeRows, Mode=OneWay}" ContainerContentChanging="OnOneTimeContainerChanging"
                  AutomationProperties.Name="{x:Bind t:AppText.Get('granary.downloadOptions.oneTime')}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="downloads:OneTimeRow">
                    <StackPanel Spacing="1">
                        <TextBlock Text="{x:Bind Title}" FontSize="14" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource SiloForegroundBrush}" />
                        <TextBlock Text="{x:Bind Detail}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SiloMutedBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- A season's or a series' episodes, one of them watched: Only unwatched episodes, a switch as Monitor's Delete after watching. -->
        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.ShowsOnlyUnwatched, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind OnlyUnwatchedLabel}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource SiloForegroundBrush}" />
            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.OnlyUnwatched, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                          AutomationProperties.Name="{x:Bind OnlyUnwatchedLabel}" />
        </Grid>

        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsVersions, Mode=OneWay}">
            <TextBlock Text="{x:Bind VersionEyebrow}" Style="{StaticResource EyebrowStyle}" AutomationProperties.AccessibilityView="Raw" />
            <ListView x:Name="VersionList" ItemsSource="{x:Bind ViewModel.Versions, Mode=OneWay}" SelectionMode="Single" MaxHeight="280"
                      SelectedItem="{x:Bind ViewModel.SelectedVersion, Mode=TwoWay}" ItemContainerStyle="{StaticResource VersionRowStyle}"
                      ContainerContentChanging="OnVersionContainerChanging" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.downloadOptions.version')}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="downloads:DownloadVersionRow">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- The web's disc: the accent at a tenth behind the accent's download arrow. -->
                            <Grid Width="36" Height="36" AutomationProperties.AccessibilityView="Raw">
                                <Ellipse Fill="{StaticResource SiloPrimaryBrush}" Opacity="0.1" />
                                <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{StaticResource SiloPrimaryBrush}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind Summary}" FontSize="14" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource SiloForegroundBrush}" />
                                <TextBlock Text="{x:Bind SizeText}" FontSize="12" Foreground="{StaticResource SiloMutedBrush}"
                                           Visibility="{x:Bind controls:DownloadOptionsPanel.HasText(SizeText)}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsQualities, Mode=OneWay}">
            <TextBlock Text="{x:Bind QualityEyebrow}" Style="{StaticResource EyebrowStyle}" AutomationProperties.AccessibilityView="Raw" />
            <controls:PillChoices ItemsSource="{x:Bind Qualities}" SelectedItem="{x:Bind SelectedQuality, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind t:AppText.Get('granary.downloadOptions.quality')}" />
        </StackPanel>

        <!-- What starts and whether it fits: "About 2.1 GB", then "200.0 GB free on this PC." or why it does not fit, in red. -->
        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasOffer, Mode=OneWay}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.SizeText, Mode=OneWay}" FontSize="14" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium"
                           Foreground="{StaticResource SiloForegroundBrush}"
                           Visibility="{x:Bind controls:DownloadOptionsPanel.HasText(ViewModel.SizeText), Mode=OneWay}" />
                <ProgressRing Grid.Column="1" Width="16" Height="16" IsActive="{x:Bind ViewModel.IsStarting, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsStarting, Mode=OneWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.downloadOptions.starting')}" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.SpaceText, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"
                       Foreground="{x:Bind controls:DownloadOptionsPanel.SpaceForeground(ViewModel.IsShortOfSpace), Mode=OneWay}"
                       Visibility="{x:Bind controls:DownloadOptionsPanel.HasText(ViewModel.SpaceText), Mode=OneWay}" />
        </StackPanel>

        <TextBlock Text="{x:Bind Footer}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SiloMutedBrush}"
                   Visibility="{x:Bind ViewModel.ShowsFooter, Mode=OneWay}" />
        </StackPanel>

        <!-- Monitor: the Apple app's rules as rows (a title and its line), then its settings card's choices. -->
        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsMonitorChosen, Mode=OneWay}">
            <ListView ItemsSource="{x:Bind ViewModel.MonitorRows, Mode=OneWay}" SelectionMode="Single" MaxHeight="280"
                      SelectedItem="{x:Bind ViewModel.SelectedRule, Mode=TwoWay}" ItemContainerStyle="{StaticResource VersionRowStyle}"
                      ContainerContentChanging="OnRuleContainerChanging" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.downloadOptions.monitor')}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="downloads:MonitorRuleRow">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium"
                                       Foreground="{StaticResource SiloForegroundBrush}" />
                            <TextBlock Text="{x:Bind Detail}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SiloMutedBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsMonitorQualities, Mode=OneWay}">
                <TextBlock Text="{x:Bind QualityEyebrow}" Style="{StaticResource EyebrowStyle}" AutomationProperties.AccessibilityView="Raw" />
                <controls:PillChoices ItemsSource="{x:Bind ViewModel.MonitorQualities, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedMonitorQuality, Mode=TwoWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.downloadOptions.quality')}" />
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind t:AppText.Get('granary.downloadOptions.deleteWatched')}" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource SiloForegroundBrush}" />
                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.DeleteWatched, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                              AutomationProperties.Name="{x:Bind t:AppText.Get('granary.downloadOptions.deleteWatched')}" />
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind t:AppText.Get('granary.downloadOptions.storageLimit')}" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource SiloForegroundBrush}" />
                <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.StorageLimits, Mode=OneWay}" MinWidth="120"
                          SelectedItem="{x:Bind ViewModel.SelectedStorageLimit, Mode=TwoWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.downloadOptions.storageLimit')}" />
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.MonitorSummary, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource SiloMutedBrush}" />

            <!-- A monitored series: Stop Monitoring, which asks in place (a dialog cannot open over this one). -->
            <Button Content="{x:Bind t:AppText.Get('granary.downloadOptions.stopMonitoring')}" Command="{x:Bind ViewModel.StopMonitoringCommand}" HorizontalAlignment="Stretch"
                    Foreground="{StaticResource SiloDestructiveBrush}" Visibility="{x:Bind ViewModel.ShowsStopMonitoring, Mode=OneWay}" />
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsConfirmingStop, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.StopTitle}" FontSize="14" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{StaticResource SiloForegroundBrush}" />
                <TextBlock Text="{x:Bind StopMessage}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource SiloMutedBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{x:Bind t:AppText.Get('granary.downloadOptions.keep')}" Command="{x:Bind ViewModel.KeepMonitoringCommand}" />
                    <Button Content="{x:Bind t:AppText.Get('granary.downloadOptions.stop')}" Command="{x:Bind ViewModel.ConfirmStopCommand}" Foreground="{StaticResource SiloDestructiveBrush}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- What a season's or a series' start left waiting for your Silo server's download limit: information, not an error. -->
        <InfoBar Severity="Informational" IsClosable="False" IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                 Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}" />
        <InfoBar Severity="Error" IsClosable="False" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />
    </StackPanel>
</UserControl>
