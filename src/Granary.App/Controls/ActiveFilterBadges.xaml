<?xml version="1.0" encoding="utf-8"?>
<!--
    The applied filters under the filter bar, as the web's ActiveFilterBadges: a wrapping row of small rounded labels in
    its secondary colours (#232328, #D0D0D6, 12 px medium), each with an ✕ that removes that one filter ("Remove Genre:
    Crime"). Tab reaches each ✕, the arrow keys move between them. Hidden while no filter is on.
-->
<UserControl
    x:Class="Granary.App.Controls.ActiveFilterBadges"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:vm="using:Granary.Core.ViewModels">

    <UserControl.Resources>
        <Style x:Key="BadgeRemoveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFD0D0D6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template" Value="{StaticResource SiloPlayerButtonTemplate}" />
        </Style>
    </UserControl.Resources>

    <ItemsRepeater x:Name="Repeater" ItemsSource="{x:Bind Filters.Badges, Mode=OneWay}" XYFocusKeyboardNavigation="Enabled"
                   AutomationProperties.Name="Active filters">
        <ItemsRepeater.Layout>
            <controls:WrapLayout HorizontalSpacing="8" VerticalSpacing="8" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:LibraryFilterBadge">
                <Border Background="#FF232328" CornerRadius="6" Padding="8,2,3,2">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="12"
                                   Foreground="#FFD0D0D6" VerticalAlignment="Center" />
                        <Button Style="{StaticResource BadgeRemoveButtonStyle}" Tag="{x:Bind}" Click="OnRemoveClick"
                                AutomationProperties.Name="{x:Bind RemoveName}" ToolTipService.ToolTip="{x:Bind RemoveName}">
                            <FontIcon Glyph="&#xE711;" FontSize="9" />
                        </Button>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsRepeater.ItemTemplate>
    </ItemsRepeater>
</UserControl>
