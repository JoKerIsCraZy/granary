<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Granary.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:t="using:Granary.Core.Texts"
    Title="Granary">

    <!--
        The window-wide shortcuts must not show their tooltip ("Ctrl+K") wherever the pointer rests. F11 is taken on its way
        down (MainWindow.FullScreen.cs), so it works on every page and in the player.
    -->
    <Grid x:Name="Root" Background="{StaticResource SiloBackgroundBrush}" PointerPressed="OnRootPointerPressed"
          PreviewKeyDown="OnRootPreviewKeyDown" KeyboardAcceleratorPlacementMode="Hidden">
        <!-- The title bar is as high as Windows' caption buttons (32 px), so they and the title sit on one middle line. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="OnSearchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnSearchAccelerator" />
            <KeyboardAccelerator Modifiers="Menu" Key="Left" Invoked="OnBackAccelerator" />
        </Grid.KeyboardAccelerators>

        <StackPanel x:Name="AppTitle" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
            <Image Source="ms-appx:///Assets/Logo/granary-mark.svg" Width="16" Height="16" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="Granary" VerticalAlignment="Center" Style="{StaticResource SiloCaptionTextStyle}" />
        </StackPanel>
        <!--
            The drag area (SetTitleBar): the title bar but its own buttons. Full screen has nothing to drag, and the strip
            takes clicks as the page does (MainWindow.FullScreen.cs, FollowDragArea).
        -->
        <Grid x:Name="AppTitleBar" />

        <!--
            Full screen for the whole window (MainWindow.FullScreen.cs), drawn as caption buttons: in a window Full screen,
            left of Windows' own; in full screen, which has none, Exit full screen and Close in their place. Like the caption
            buttons they take no keyboard focus (SiloTitleBarButtonStyle): F11 is the keyboard's way. Drawn over the rest
            (ZIndex), a trailer's scrim included, as the caption buttons are. Hidden under the full player, which has its
            own, and while a trailer fills the screen.
        -->
        <StackPanel x:Name="WindowButtons" Canvas.ZIndex="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="FullScreenButton" Style="{StaticResource SiloTitleBarButtonStyle}" Click="OnFullScreenClick"
                    AutomationProperties.AcceleratorKey="F11">
                <FontIcon x:Name="FullScreenGlyph" FontSize="10" />
            </Button>
            <!-- Closes the window as Windows' Close does, through the same command, so playback stops as on any close. -->
            <Button x:Name="CloseButton" Style="{StaticResource SiloTitleBarCloseButtonStyle}" Click="OnCloseClick"
                    Visibility="Collapsed" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.shell.close')}"
                    ToolTipService.ToolTip="{x:Bind t:AppText.Get('granary.shell.close')}">
                <FontIcon Glyph="&#xE8BB;" FontSize="10" />
            </Button>
        </StackPanel>

        <!--
            The title bar's lower edge, across the whole window, where no sidebar shows; beside the sidebar the content's own
            rounded edge takes its place. The player, which reaches under the title bar, covers it.
        -->
        <Border x:Name="TitleBarEdge" Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False"
                Background="{ThemeResource NavigationViewContentGridBorderBrush}" />

        <!--
            Silo's sidebar: server name, Home, Search, libraries; servers and the profile at the bottom.
            The pane's visibility and the view's rows follow the route (MainWindow.ShowChrome).
        -->
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="260"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsTitleBarAutoPaddingEnabled="False"
            IsPaneVisible="False"
            PaneOpening="OnPaneOpening"
            PaneClosing="OnPaneClosing"
            PaneOpened="OnPaneSettled"
            PaneClosed="OnPaneSettled"
            ItemInvoked="OnItemInvoked">
            <NavigationView.PaneCustomContent>
                <!--
                    The server's name or wordmark opens Home, as the web's sidebar logo links to it (components/AppSidebar.tsx,
                    "Go home", a little faded under the pointer): for the mouse. Keys, a remote and a controller have Home's entry,
                    so the sidebar's stops stay as they were. The pane's custom content, not its header: NavigationView hides the
                    header in the rail, and the entries moved under it as the rail opened. Here the open pane's wordmark and the
                    rail's mark cross-fade in one place, as the web's do (MainWindow.Wordmark.cs).
                -->
                <HyperlinkButton x:Name="BrandLink" Margin="0,4,0,12" Padding="0" MinHeight="0" HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" Click="OnBrandClick"
                                 PointerEntered="OnBrandPointerEntered" PointerExited="OnBrandPointerExited" PointerCanceled="OnBrandPointerExited"
                                 AutomationProperties.Name="{x:Bind t:AppText.Get('web.shell.sidebar.goHome')}">
                    <HyperlinkButton.Resources>
                        <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="Transparent" />
                    </HyperlinkButton.Resources>
                    <Grid>
                        <Grid x:Name="BrandWide" Margin="20,0,12,0" VerticalAlignment="Center">
                            <Grid.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.15" />
                            </Grid.OpacityTransition>
                            <TextBlock x:Name="ServerNameText" Text="{x:Bind Sidebar.ServerName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource SiloFontExtraBold}" FontWeight="ExtraBold" FontSize="22" CharacterSpacing="-30"
                                       Foreground="{StaticResource SiloForegroundBrush}" />
                            <!-- The server's wordmark in place of its name, at the web's size (components/AppSidebar.tsx). -->
                            <Image x:Name="ServerWordmark" Width="112" Height="48" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed"
                                   AutomationProperties.Name="{x:Bind Sidebar.ServerName, Mode=OneWay}" />
                        </Grid>
                        <!--
                            The server's square mark in the rail, at the web's 36 px with its rounded corners (components/SiloBrand.tsx),
                            in the entries' icon column (its left margin is set from the rail's width).
                        -->
                        <Border x:Name="ServerMark" Width="36" Height="36" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.15" />
                            </Border.OpacityTransition>
                            <Border.Background>
                                <ImageBrush x:Name="ServerMarkBrush" Stretch="Uniform" />
                            </Border.Background>
                            <!--
                                Silo's own mark while the server has none, as the web shows it (components/SiloBrand.tsx): it refers to the
                                Silo server signed in to, unaltered, 26 px with the 20 % clear space Silo's brand page asks for
                                (Assets/Brand/NOTICE.txt).
                            -->
                            <Image x:Name="SiloMarkFallback" Style="{StaticResource SiloAuthMarkStyle}" Width="26" Height="26" Margin="0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                    </Grid>
                </HyperlinkButton>
            </NavigationView.PaneCustomContent>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="{x:Bind t:AppText.Get('web.shell.sidebar.home')}" Tag="Home" Icon="Home" />
                <NavigationViewItem Tag="Search" Icon="Find" AutomationProperties.Name="{x:Bind t:AppText.Get('web.shell.sidebar.search')}"
                                    ToolTipService.ToolTip="{x:Bind t:AppText.Get('granary.shell.searchTooltip')}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind t:AppText.Get('web.shell.sidebar.search')}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Margin="0,0,8,0" Padding="6,1" CornerRadius="5" BorderThickness="1"
                                BorderBrush="{StaticResource SiloBorderBrush}" VerticalAlignment="Center">
                            <!-- A key cap, as the web's: not a text. -->
                            <TextBlock Text="Ctrl K" FontSize="10" Foreground="{StaticResource SiloMutedBrush}" />
                        </Border>
                    </Grid>
                </NavigationViewItem>
                <!-- The three sections fold away by their headers, and stay so across starts (MainWindow.ShowSections). -->
                <NavigationViewItemHeader x:Name="LibrariesHeader" Style="{StaticResource SiloNavigationSectionHeaderStyle}">
                    <controls:SidebarSectionHeader x:Name="LibrariesToggle" Label="{x:Bind t:AppText.Get('web.shell.sidebar.libraries')}" IsExpanded="{x:Bind Sections.IsLibrariesExpanded, Mode=OneWay}"
                                                   Command="{x:Bind Sections.ToggleCommand}" CommandParameter="{x:Bind LibrariesSection}" />
                </NavigationViewItemHeader>
                <!-- The libraries go between the two headers. -->
                <NavigationViewItemHeader x:Name="DiscoverHeader" Style="{StaticResource SiloNavigationSectionHeaderStyle}">
                    <controls:SidebarSectionHeader x:Name="DiscoverToggle" Label="{x:Bind t:AppText.Get('web.shell.sidebar.discover')}" IsExpanded="{x:Bind Sections.IsDiscoverExpanded, Mode=OneWay}"
                                                   Command="{x:Bind Sections.ToggleCommand}" CommandParameter="{x:Bind DiscoverSection}" />
                </NavigationViewItemHeader>
                <NavigationViewItem Content="{x:Bind t:AppText.Get('web.shell.sidebar.forYou')}" Tag="ForYou">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Only while the server takes requests from the profile. -->
                <NavigationViewItem Content="{x:Bind t:AppText.Get('web.shell.sidebar.requests')}" Tag="Requests">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE724;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind t:AppText.Get('web.shell.sidebar.calendar')}" Tag="Calendar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--
                    Hidden when the server has no inbox for the profile; the unread count beside it in the accent, as the web's
                    primary (components/AppSidebar.tsx), its number in the label drawn on the accent.
                -->
                <NavigationViewItem Content="{x:Bind t:AppText.Get('web.shell.sidebar.notifications')}" Tag="Notifications"
                                    AutomationProperties.Name="{x:Bind NotificationsName(Notifications.UnreadCount), Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA8F;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind Notifications.UnreadCount, Mode=OneWay}" Visibility="{x:Bind Notifications.HasUnread, Mode=OneWay}"
                                   Background="{StaticResource SiloPrimaryBrush}" Foreground="{StaticResource SiloOnPrimaryBadgeBrush}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="YourStuffHeader" Style="{StaticResource SiloNavigationSectionHeaderStyle}">
                    <controls:SidebarSectionHeader x:Name="YourStuffToggle" Label="{x:Bind t:AppText.Get('web.shell.sidebar.yourStuff')}" IsExpanded="{x:Bind Sections.IsYourStuffExpanded, Mode=OneWay}"
                                                   Command="{x:Bind Sections.ToggleCommand}" CommandParameter="{x:Bind YourStuffSection}" />
                </NavigationViewItemHeader>
                <NavigationViewItem Content="{x:Bind t:AppText.Get('web.shell.sidebar.favorites')}" Tag="List:favorites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB51;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind t:AppText.Get('web.shell.sidebar.watchlist')}" Tag="List:watchlist">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Only while the server offers rooms to the account. -->
                <NavigationViewItem Content="{x:Bind t:AppText.Get('web.shell.sidebar.watchParty')}" Tag="WatchParty">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind t:AppText.Get('web.shell.sidebar.collections')}" Tag="Collections">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE838;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind t:AppText.Get('web.shell.sidebar.history')}" Tag="List:history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--
                    Only while the server lets the profile download, or while the profile has downloads on this PC. Beside it, as
                    Notifications' unread count, the count of the downloads coming or waiting (DownloadActivity); while one comes, a
                    small dot before the count breathes slowly (MainWindow.Downloads.cs). The icon-only rail shows the count on the
                    icon, without the dot.
                -->
                <NavigationViewItem Tag="Downloads" AutomationProperties.Name="{x:Bind DownloadsActivity.EntryName, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind t:AppText.Get('granary.downloads.title')}" VerticalAlignment="Center" />
                        <Ellipse x:Name="DownloadsPulse" Grid.Column="1" Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center"
                                 Fill="{StaticResource SiloPrimaryBrush}" Visibility="{x:Bind DownloadsActivity.IsTransferring, Mode=OneWay}"
                                 AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind DownloadsActivity.PendingCount, Mode=OneWay}" Visibility="{x:Bind DownloadsActivity.HasPending, Mode=OneWay}"
                                   Background="{StaticResource SiloPrimaryBrush}" Foreground="{StaticResource SiloOnPrimaryBadgeBrush}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <!-- The server's administration, for an administrator only, as the web's sidebar offers it. -->
                <NavigationViewItem x:Name="AdminItem" Content="{x:Bind t:AppText.Get('web.shell.sidebar.admin')}" Tag="Admin" Visibility="{x:Bind Sidebar.IsAdmin, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA18;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind t:AppText.Get('web.shell.sidebar.settings')}" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--
                    The profile and its menu. A sign-out can wait up to about 20 s for a drive or a server that does not answer:
                    meanwhile the entry reads "Signing out…" with a ring and takes no clicks, as Granary's busy buttons do
                    ("Signing in…"), also while the question about this PC's downloads is open over it. One that failed says so
                    under the name until the next Sign out or another profile. The web's menu has neither.
                    In the icon's place the profile's 28 px avatar, as the web's (components/AppSidebar.tsx). An icon is drawn
                    in a 16 px box, so the avatar is the content's, with no icon: 6 px into the slot an icon leaves, its middle on
                    the other icons' line and the name 10 px after it, on the other labels' line. The rail shows the same place,
                    once its content keeps the open pane's margin (NavigationViewCompactItemContentPresenterMargin, otherwise 0).
                -->
                <NavigationViewItem x:Name="ProfileItem" Tag="Profile" SelectsOnInvoked="False"
                                    IsEnabled="{x:Bind IsIdle(Sidebar.SignOutCommand.IsRunning), Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind Sidebar.ProfileName, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ProfileMenuName(Sidebar.ProfileName, Sidebar.SignOutCommand.IsRunning, Sidebar.SignOutError), Mode=OneWay}">
                    <NavigationViewItem.Resources>
                        <Thickness x:Key="NavigationViewCompactItemContentPresenterMargin">4,-1,8,-1</Thickness>
                    </NavigationViewItem.Resources>
                    <Grid x:Name="ProfileItemContent" Margin="-6,0,0,0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:ProfileAvatar x:Name="ProfileItemAvatar" Width="28" Height="28" FontSize="12" VerticalAlignment="Center"
                                                Image="{x:Bind Sidebar.Avatar, Mode=OneWay}" Initial="{x:Bind Sidebar.ProfileInitial, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ProfileLabel(Sidebar.ProfileName, Sidebar.SignOutCommand.IsRunning), Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Sidebar.SignOutError, Mode=OneWay}" Visibility="{x:Bind HasText(Sidebar.SignOutError), Mode=OneWay}"
                                       FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SiloDestructiveBrush}"
                                       AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                        <ProgressRing Grid.Column="2" Width="16" Height="16" Margin="0,0,8,0" IsActive="{x:Bind Sidebar.SignOutCommand.IsRunning, Mode=OneWay}"
                                      Visibility="{x:Bind Sidebar.SignOutCommand.IsRunning, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <!--
                                The web's label on top: the 40 px avatar, the name, and the account's name under it when it is
                                another. A menu holds only its items, so this is one drawn as its content (Tag), disabled so the
                                keys, a controller and clicks pass it; it is no item for a screen reader, the entry says whose
                                menu it is.
                            -->
                            <MenuFlyoutItem IsEnabled="False" AutomationProperties.AccessibilityView="Raw">
                                <MenuFlyoutItem.Template>
                                    <ControlTemplate TargetType="MenuFlyoutItem">
                                        <ContentPresenter Content="{TemplateBinding Tag}" Padding="{TemplateBinding Padding}" />
                                    </ControlTemplate>
                                </MenuFlyoutItem.Template>
                                <MenuFlyoutItem.Tag>
                                    <Grid MaxWidth="288" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:ProfileAvatar Width="40" Height="40" FontSize="14"
                                                                Image="{x:Bind Sidebar.Avatar, Mode=OneWay}" Initial="{x:Bind Sidebar.ProfileInitial, Mode=OneWay}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Sidebar.ProfileName, Mode=OneWay}" FontFamily="{StaticResource SiloFontSemiBold}"
                                                       FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SiloForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Sidebar.AccountName, Mode=OneWay}" Visibility="{x:Bind HasText(Sidebar.AccountName), Mode=OneWay}"
                                                       FontSize="11" Foreground="{StaticResource SiloMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </MenuFlyoutItem.Tag>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind t:AppText.Get('web.shell.sidebar.switchProfile')}" Command="{x:Bind Sidebar.SwitchProfileCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE748;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind t:AppText.Get('web.shell.sidebar.logout')}" Command="{x:Bind Sidebar.SignOutCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF3B1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- The arrows move focus across every page, as a TV remote's do (MainWindow.Remote.cs). -->
            <Frame x:Name="ContentFrame" XYFocusKeyboardNavigation="Enabled" />
        </NavigationView>

        <!--
            The way back, as the web's PageBack: a glass disc at the top left of a page opened from another; the sidebar has
            no back arrow. Placed and shown by MainWindow.ShowChrome; hidden while the rail is open over the page.
        -->
        <Button x:Name="PageBackButton" Grid.Row="1" Style="{StaticResource SiloPageBackButtonStyle}" Margin="64,12,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" Click="OnPageBackClick"
                AutomationProperties.Name="{x:Bind t:AppText.Get('web.shell.pageBack.goBack')}"
                ToolTipService.ToolTip="{x:Bind t:AppText.Get('granary.shell.backTooltip')}">
            <FontIcon Glyph="&#xE76B;" FontSize="14" />
        </Button>

        <StackPanel Grid.Row="1" Margin="0,12,20,0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
            <!--
                While Silo's phone app controls this PC (design 5.9): a quiet disc beside the activity indicator, "Remote control
                active", whose menu lets the phones go. Shown and hidden by MainWindow.PhoneRemote.cs; the full player has its own
                in its bar.
            -->
            <Button x:Name="RemoteIndicator" Style="{StaticResource SiloPageBackButtonStyle}" Visibility="Collapsed"
                    AutomationProperties.Name="{x:Bind RemoteActiveText}" ToolTipService.ToolTip="{x:Bind RemoteActiveText}">
                <FontIcon Glyph="&#xE8EA;" FontSize="14" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="{x:Bind RemoteDisconnectText}" Click="OnDisconnectRemoteClick" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <!--
                What the server does, for an acting administrator, as the web's ServerActivity: a glass disc at the top right of
                the page, where the web has it (20 px from the edge), level with the way back. Shown and hidden by
                MainWindow.Activity.cs; after the page in the tab order, so it is never a page's first focus.
            -->
            <controls:ServerActivityButton x:Name="ActivityButton" VerticalAlignment="Top" Visibility="Collapsed" />
        </StackPanel>

        <!--
            A downloaded update of Granary itself: restart into it, or it installs when Granary closes (AppUpdatesViewModel,
            docs/release.md). Over the page at the bottom right, under the start screen.
        -->
        <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Padding="18,16"
                MaxWidth="380" CornerRadius="14" Background="{StaticResource SiloSurfaceRaisedBrush}"
                BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="1"
                Visibility="{x:Bind Updates.IsNoticeShown, Mode=OneWay}">
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:GranaryMark Width="32" Height="32" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind Updates.NoticeText, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}"
                                   FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{x:Bind t:AppText.Get('granary.update.noticeHint')}" Style="{StaticResource SiloCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{x:Bind t:AppText.Get('granary.update.later')}" Style="{StaticResource SiloSecondaryButtonStyle}" Command="{x:Bind Updates.LaterCommand}" />
                    <Button Content="{x:Bind t:AppText.Get('granary.update.restartNow')}" Style="{StaticResource SiloPrimaryButtonStyle}" Command="{x:Bind Updates.RestartNowCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--
            The player, over the window (MainWindow.Player.cs): the whole of it while it plays, or minimized the bar at the
            bottom, under which the pages go on. Under the start screen.
        -->
        <Border x:Name="PlayerHost" Grid.RowSpan="2" Visibility="Collapsed" />

        <!-- A notice for the minimized player: above its bar, at its left edge (MainWindow.Player.cs, ShowDockNotice). -->
        <controls:PlaybackNoticeView x:Name="DockNotice" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" MaxWidth="576"
                                     Visibility="Collapsed" />

        <!--
            Downloads that finished or failed while Granary is in front, "Example Movie is ready to watch offline" for five
            seconds (DownloadNotices): the player's notice card without a title, amber when something did not download, at the
            top in the middle, over the pages and the player alike, where the player shows its own below its top bar. Behind
            another window or minimized, Granary says it as a Windows notification instead.
        -->
        <controls:PlaybackNoticeView Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,80,16,0" MaxWidth="576"
                                     Message="{x:Bind DownloadNotices.NoticeText, Mode=OneWay}" IsWarning="{x:Bind DownloadNotices.IsWarning, Mode=OneWay}"
                                     Visibility="{x:Bind DownloadNotices.HasNotice, Mode=OneWay}" />

        <!--
            "Elena's phone connected" for four seconds when a phone starts to control this PC, as Silo's Roku app says it
            (RemoteIndicatorViewModel): the notice card of the player's, over the pages and the player alike, where the player
            shows its own, below its top bar.
        -->
        <controls:PlaybackNoticeView Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,80,16,0" MaxWidth="576"
                                     Message="{x:Bind Remote.NoticeText, Mode=OneWay}" Visibility="{x:Bind Remote.HasNotice, Mode=OneWay}" />

        <!--
            A trailer, over everything but the start screen, title bar included, as a dialog: YouTube's player on a scrim
            (Controls/TrailerOverlay, MainWindow.Trailer.cs).
        -->
        <controls:TrailerOverlay x:Name="TrailerLayer" Grid.RowSpan="2" />

        <!--
            The start: Granary's mark plays its intro in the middle of the window while the app loads its first page, then
            its loading loop if that takes longer (MainWindow.ShowStartup). It lifts by the title bar's 32 px so it sits in the
            window's middle.
        -->
        <Grid x:Name="Splash" Grid.Row="1" Background="{StaticResource SiloBackgroundBrush}">
            <controls:GranaryMark x:Name="SplashMark" Width="132" Height="132" Margin="0,0,0,32"
                                  AutomationProperties.Name="{x:Bind t:AppText.Get('granary.shell.starting')}" />
        </Grid>
    </Grid>
</Window>
