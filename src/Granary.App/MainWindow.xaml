<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Granary.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    Title="Granary">

    <!-- The window-wide shortcuts must not show their tooltip ("Ctrl+K") wherever the pointer rests. -->
    <Grid x:Name="Root" Background="{StaticResource SiloBackgroundBrush}" PointerPressed="OnRootPointerPressed"
          KeyboardAcceleratorPlacementMode="Hidden">
        <!-- The title bar is as high as Windows' caption buttons (32 px), so they and the title sit on one middle line. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="OnSearchAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnSearchAccelerator" />
            <KeyboardAccelerator Modifiers="Menu" Key="Left" Invoked="OnBackAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel x:Name="AppTitle" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Logo/granary-mark.svg" Width="16" Height="16" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="Granary" VerticalAlignment="Center" Style="{StaticResource SiloCaptionTextStyle}" />
            </StackPanel>
        </Grid>

        <!-- The title bar's lower edge, across the whole window; the player, which reaches under the title bar, covers it. -->
        <Border Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False"
                Background="{ThemeResource NavigationViewContentGridBorderBrush}" />

        <!--
            Silo's sidebar: server name, Home, Search, libraries; servers and the profile at the bottom.
            The pane's visibility and the view's rows follow the route (MainWindow.ShowChrome).
        -->
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="260"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsTitleBarAutoPaddingEnabled="False"
            IsPaneVisible="False"
            PaneOpening="OnPaneOpening"
            PaneClosing="OnPaneClosing"
            PaneOpened="OnPaneSettled"
            PaneClosed="OnPaneSettled"
            ItemInvoked="OnItemInvoked">
            <NavigationView.PaneHeader>
                <TextBlock Margin="20,4,12,12" Text="{x:Bind Sidebar.ServerName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                           FontFamily="{StaticResource SiloFontExtraBold}" FontWeight="ExtraBold" FontSize="22" CharacterSpacing="-30"
                           Foreground="{StaticResource SiloForegroundBrush}" />
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="Home" Icon="Home" />
                <NavigationViewItem Tag="Search" Icon="Find" AutomationProperties.Name="Search" ToolTipService.ToolTip="Search (Ctrl+K)">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Search" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Margin="0,0,8,0" Padding="6,1" CornerRadius="5" BorderThickness="1"
                                BorderBrush="{StaticResource SiloBorderBrush}" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl K" FontSize="10" Foreground="{StaticResource SiloMutedBrush}" />
                        </Border>
                    </Grid>
                </NavigationViewItem>
                <!-- The three sections fold away by their headers, and stay so across starts (MainWindow.ShowSections). -->
                <NavigationViewItemHeader x:Name="LibrariesHeader" Style="{StaticResource SiloNavigationSectionHeaderStyle}">
                    <controls:SidebarSectionHeader x:Name="LibrariesToggle" Label="Libraries" IsExpanded="{x:Bind Sections.IsLibrariesExpanded, Mode=OneWay}"
                                                   Command="{x:Bind Sections.ToggleCommand}" CommandParameter="{x:Bind LibrariesSection}" />
                </NavigationViewItemHeader>
                <!-- The libraries go between the two headers. -->
                <NavigationViewItemHeader x:Name="DiscoverHeader" Style="{StaticResource SiloNavigationSectionHeaderStyle}">
                    <controls:SidebarSectionHeader x:Name="DiscoverToggle" Label="Discover" IsExpanded="{x:Bind Sections.IsDiscoverExpanded, Mode=OneWay}"
                                                   Command="{x:Bind Sections.ToggleCommand}" CommandParameter="{x:Bind DiscoverSection}" />
                </NavigationViewItemHeader>
                <NavigationViewItem Content="For You" Tag="ForYou">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Only while the server takes requests from the profile. -->
                <NavigationViewItem Content="Requests" Tag="Requests">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE724;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Calendar" Tag="Calendar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Hidden when the server has no inbox for the profile; the unread count in red beside it. -->
                <NavigationViewItem Content="Notifications" Tag="Notifications"
                                    AutomationProperties.Name="{x:Bind NotificationsName(Notifications.UnreadCount), Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA8F;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind Notifications.UnreadCount, Mode=OneWay}" Visibility="{x:Bind Notifications.HasUnread, Mode=OneWay}"
                                   Background="{StaticResource SiloPrimaryBrush}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="YourStuffHeader" Style="{StaticResource SiloNavigationSectionHeaderStyle}">
                    <controls:SidebarSectionHeader x:Name="YourStuffToggle" Label="Your Stuff" IsExpanded="{x:Bind Sections.IsYourStuffExpanded, Mode=OneWay}"
                                                   Command="{x:Bind Sections.ToggleCommand}" CommandParameter="{x:Bind YourStuffSection}" />
                </NavigationViewItemHeader>
                <NavigationViewItem Content="Favorites" Tag="List:favorites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB51;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Watchlist" Tag="List:watchlist">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Collections" Tag="Collections">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE838;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="List:history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <!-- The server's administration, for an administrator only, as the web's sidebar offers it. -->
                <NavigationViewItem x:Name="AdminItem" Content="Admin" Tag="Admin" Visibility="{x:Bind Sidebar.IsAdmin, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA18;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ProfileItem" Tag="Profile" SelectsOnInvoked="False"
                                    Content="{x:Bind Sidebar.ProfileName, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ProfileMenuName(Sidebar.ProfileName), Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Switch profile" Command="{x:Bind Sidebar.SwitchProfileCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE748;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Sign out" Command="{x:Bind Sidebar.SignOutCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF3B1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!--
            The way back, as the web's PageBack: a glass disc at the top left of a page opened from another; the sidebar has
            no back arrow. Placed and shown by MainWindow.ShowChrome; hidden while the rail is open over the page.
        -->
        <Button x:Name="PageBackButton" Grid.Row="1" Style="{StaticResource SiloPageBackButtonStyle}" Margin="64,12,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" Click="OnPageBackClick"
                AutomationProperties.Name="Go back" ToolTipService.ToolTip="Back (Alt+Left)">
            <FontIcon Glyph="&#xE76B;" FontSize="14" />
        </Button>

        <!--
            A downloaded update of Granary itself: restart into it, or it installs when Granary closes (AppUpdatesViewModel,
            docs/release.md). Over the page at the bottom right, under the start screen.
        -->
        <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Padding="18,16"
                MaxWidth="380" CornerRadius="14" Background="{StaticResource SiloSurfaceRaisedBrush}"
                BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="1"
                Visibility="{x:Bind Updates.IsNoticeShown, Mode=OneWay}">
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:GranaryMark Width="32" Height="32" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind Updates.NoticeText, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}"
                                   FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="Restart now, or it installs when you close Granary." Style="{StaticResource SiloCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Later" Style="{StaticResource SiloSecondaryButtonStyle}" Command="{x:Bind Updates.LaterCommand}" />
                    <Button Content="Restart now" Style="{StaticResource SiloPrimaryButtonStyle}" Command="{x:Bind Updates.RestartNowCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--
            The player, over the window (MainWindow.Player.cs): the whole of it while it plays, or minimized the bar at the
            bottom, under which the pages go on. Under the start screen.
        -->
        <Border x:Name="PlayerHost" Grid.RowSpan="2" Visibility="Collapsed" />

        <!-- A notice for the minimized player: above its bar, at its left edge (MainWindow.Player.cs, ShowDockNotice). -->
        <controls:PlaybackNoticeView x:Name="DockNotice" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" MaxWidth="576"
                                     Visibility="Collapsed" />

        <!--
            The start: Granary's mark plays its intro in the middle of the window while the app loads its first page, then
            its loading loop if that takes longer (MainWindow.ShowStartup). It lifts by the title bar's 32 px so it sits in the
            window's middle.
        -->
        <Grid x:Name="Splash" Grid.Row="1" Background="{StaticResource SiloBackgroundBrush}">
            <controls:GranaryMark x:Name="SplashMark" Width="132" Height="132" Margin="0,0,0,32"
                                  AutomationProperties.Name="Granary is starting" />
        </Grid>
    </Grid>
</Window>
