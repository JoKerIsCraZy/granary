<?xml version="1.0" encoding="utf-8"?>
<!--
    The Silo look (docs/ui-design.md): one dark theme taken from Silo's web client, red as the only
    accent, Plus Jakarta Sans. Fluent controls keep working; their theme brushes are pointed at this palette.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <!-- The app always runs dark (App.xaml); Light and Default point to the same values. -->
        <ResourceDictionary x:Key="Default">
            <Color x:Key="SystemAccentColor">#FFEF4444</Color>
            <Color x:Key="SystemAccentColorLight1">#FFF25858</Color>
            <Color x:Key="SystemAccentColorLight2">#FFEF4444</Color>
            <Color x:Key="SystemAccentColorLight3">#FFF87171</Color>
            <Color x:Key="SystemAccentColorDark1">#FFDC2F2F</Color>
            <Color x:Key="SystemAccentColorDark2">#FFB91C1C</Color>
            <Color x:Key="SystemAccentColorDark3">#FF991B1B</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFEF4444" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFF25858" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFDC2F2F" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFF87171" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFF87171" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFEF4444" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE8E8EC" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFA4A4AE" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF7C7C86" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FF141417" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF141417" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF141417" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF141417" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#B32A2A2F" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#E61F1F23" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FF232328" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#801F1F23" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF1C1C20" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#B32A2A2F" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF1C1C20" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF232328" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FF1C1C20" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#FFEF4444</Color>
            <Color x:Key="SystemAccentColorLight1">#FFF25858</Color>
            <Color x:Key="SystemAccentColorLight2">#FFEF4444</Color>
            <Color x:Key="SystemAccentColorLight3">#FFF87171</Color>
            <Color x:Key="SystemAccentColorDark1">#FFDC2F2F</Color>
            <Color x:Key="SystemAccentColorDark2">#FFB91C1C</Color>
            <Color x:Key="SystemAccentColorDark3">#FF991B1B</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFEF4444" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFF25858" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFDC2F2F" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFF87171" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFF87171" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFEF4444" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE8E8EC" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFA4A4AE" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF7C7C86" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FF141417" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF141417" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF141417" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF141417" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#B32A2A2F" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#E61F1F23" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FF232328" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#801F1F23" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF1C1C20" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#B32A2A2F" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF1C1C20" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF232328" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FF1C1C20" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Palette -->
    <Color x:Key="SiloBackgroundColor">#FF141417</Color>
    <Color x:Key="SiloSurfaceColor">#FF1C1C20</Color>
    <Color x:Key="SiloSurfaceRaisedColor">#FF232328</Color>
    <Color x:Key="SiloBorderColor">#B32A2A2F</Color>
    <Color x:Key="SiloForegroundColor">#FFE8E8EC</Color>
    <Color x:Key="SiloMutedColor">#FFA4A4AE</Color>
    <Color x:Key="SiloPrimaryColor">#FFEF4444</Color>
    <Color x:Key="SiloPrimaryHoverColor">#FFF25858</Color>
    <Color x:Key="SiloPrimaryPressedColor">#FFDC2F2F</Color>
    <Color x:Key="SiloBadgeBackgroundColor">#B314141E</Color>
    <Color x:Key="SiloBadgeBorderColor">#26FFFFFF</Color>
    <!-- The IMDb badge's gold, Tailwind's green-500 of a watched mark, emerald-400 of a watched button. -->
    <Color x:Key="SiloRatingBadgeColor">#C24F421C</Color>
    <Color x:Key="SiloWatchedColor">#E622C55E</Color>
    <Color x:Key="SiloWatchedButtonColor">#FF34D399</Color>
    <Color x:Key="SiloCompleteColor">#FF4CAF50</Color>

    <SolidColorBrush x:Key="SiloBackgroundBrush" Color="{StaticResource SiloBackgroundColor}" />
    <SolidColorBrush x:Key="SiloSurfaceBrush" Color="{StaticResource SiloSurfaceColor}" />
    <SolidColorBrush x:Key="SiloSurfaceRaisedBrush" Color="{StaticResource SiloSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SiloBorderBrush" Color="{StaticResource SiloBorderColor}" />
    <SolidColorBrush x:Key="SiloForegroundBrush" Color="{StaticResource SiloForegroundColor}" />
    <SolidColorBrush x:Key="SiloMutedBrush" Color="{StaticResource SiloMutedColor}" />
    <SolidColorBrush x:Key="SiloPrimaryBrush" Color="{StaticResource SiloPrimaryColor}" />
    <SolidColorBrush x:Key="SiloBadgeBackgroundBrush" Color="{StaticResource SiloBadgeBackgroundColor}" />
    <SolidColorBrush x:Key="SiloBadgeBorderBrush" Color="{StaticResource SiloBadgeBorderColor}" />
    <SolidColorBrush x:Key="SiloRatingBadgeBrush" Color="{StaticResource SiloRatingBadgeColor}" />
    <SolidColorBrush x:Key="SiloWatchedBrush" Color="{StaticResource SiloWatchedColor}" />
    <SolidColorBrush x:Key="SiloWatchedButtonBrush" Color="{StaticResource SiloWatchedButtonColor}" />
    <SolidColorBrush x:Key="SiloCompleteBrush" Color="{StaticResource SiloCompleteColor}" />

    <!-- Plus Jakarta Sans, one file per weight: XAML loads only the face of the file it names. -->
    <FontFamily x:Key="SiloFontRegular">ms-appx:///Assets/Fonts/PlusJakartaSans-Regular.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="SiloFontItalic">ms-appx:///Assets/Fonts/PlusJakartaSans-Italic.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="SiloFontMedium">ms-appx:///Assets/Fonts/PlusJakartaSans-Medium.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="SiloFontSemiBold">ms-appx:///Assets/Fonts/PlusJakartaSans-SemiBold.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="SiloFontBold">ms-appx:///Assets/Fonts/PlusJakartaSans-Bold.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="SiloFontExtraBold">ms-appx:///Assets/Fonts/PlusJakartaSans-ExtraBold.ttf#Plus Jakarta Sans</FontFamily>

    <!-- Fluent controls and the built-in text styles use the regular face. -->
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/PlusJakartaSans-Regular.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="XamlAutoFontFamily">ms-appx:///Assets/Fonts/PlusJakartaSans-Regular.ttf#Plus Jakarta Sans</FontFamily>

    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="SiloCardCornerRadius">16</CornerRadius>
    <!-- Pills: with controls:Pill.IsEnabled the radius becomes half the height once laid out; WinUI would draw 999 as an oval. -->
    <CornerRadius x:Key="SiloPillCornerRadius">999</CornerRadius>

    <!-- Text. Upper-case overlines come upper-cased from the view model: XAML has no text-transform. -->
    <Style x:Key="SiloDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontExtraBold}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="CharacterSpacing" Value="-50" />
        <Setter Property="LineHeight" Value="60" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SiloPageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontBold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="CharacterSpacing" Value="-30" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SiloRowTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="CharacterSpacing" Value="-25" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
    </Style>
    <Style x:Key="SiloBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontRegular}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SiloCardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="-25" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="SiloCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- "2021 SERIES" under a poster. -->
    <Style x:Key="SiloOverlineTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="140" />
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- "LIBRARIES", "EXPLORE ALL", breadcrumbs. -->
    <Style x:Key="SiloSectionLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
    </Style>
    <Style x:Key="SiloBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="25" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Pills on artwork: resolution, audio, status, rating. -->
    <Style x:Key="SiloBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SiloBadgeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SiloBadgeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SiloPillCornerRadius}" />
        <Setter Property="controls:Pill.IsEnabled" Value="True" />
        <Setter Property="Padding" Value="9,3" />
    </Style>
    <!-- Metadata chips on detail pages: "2026", "R", "1H 49M" (the web's metadata-badge). -->
    <Style x:Key="SiloChipStyle" TargetType="Border">
        <Setter Property="Background" Value="#14E8E8EC" />
        <Setter Property="BorderBrush" Value="#8C28282E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SiloPillCornerRadius}" />
        <Setter Property="controls:Pill.IsEnabled" Value="True" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <!-- Technical chips in the accent colour: "1080P", "EAC3". -->
    <Style x:Key="SiloAccentChipStyle" TargetType="Border" BasedOn="{StaticResource SiloChipStyle}">
        <Setter Property="Background" Value="#26EF4444" />
        <Setter Property="BorderBrush" Value="#99EF4444" />
    </Style>

    <!--
        Pill buttons as on Silo's web: the red primary (Play) with dark bold text, the dark secondary (Mark watched)
        with a faint light along its top edge, and round icon buttons of the secondary kind.
    -->
    <Style x:Key="SiloPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SiloPrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SiloBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SiloPillCornerRadius}" />
        <Setter Property="controls:Pill.IsEnabled" Value="True" />
        <Setter Property="Padding" Value="12,8,14,8" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontBold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CharacterSpacing" Value="25" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FFF25858" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FFDC2F2F" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontWeight="{TemplateBinding FontWeight}"
                            FontSize="{TemplateBinding FontSize}"
                            CharacterSpacing="{TemplateBinding CharacterSpacing}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SiloSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#FF1B1B1E" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="BorderBrush" Value="#4D28282E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SiloPillCornerRadius}" />
        <Setter Property="controls:Pill.IsEnabled" Value="True" />
        <Setter Property="Padding" Value="12,8,14,8" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FF25252A" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FF161619" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontWeight="{TemplateBinding FontWeight}"
                            FontSize="{TemplateBinding FontSize}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SiloIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloSecondaryButtonStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
    </Style>
    <!-- "EXPLORE ALL" next to a row title. -->
    <Style x:Key="SiloLinkButtonStyle" TargetType="HyperlinkButton">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="180" />
    </Style>

    <!--
        The signed-out screens (adding a server, signing in) as Silo's web draws its login: a 448 px card in the
        middle, on the background with a red glow at the top left and a light one at the top right, and Silo's
        wordmark above it (Assets/Brand/NOTICE.txt). The page puts its form in as the content and merges
        Themes/SiloAuth.xaml for the inputs. The glows are the web's circles stretched with the window.
    -->
    <Style x:Key="SiloAuthShellStyle" TargetType="ContentControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Background="{StaticResource SiloBackgroundBrush}">
                        <Grid IsHitTestVisible="False">
                            <Grid.Background>
                                <RadialGradientBrush Center="0.18,0.18" GradientOrigin="0.18,0.18" RadiusX="0.26" RadiusY="0.52">
                                    <GradientStop Offset="0" Color="#2EEF4444" />
                                    <GradientStop Offset="1" Color="#00EF4444" />
                                </RadialGradientBrush>
                            </Grid.Background>
                        </Grid>
                        <Grid IsHitTestVisible="False">
                            <Grid.Background>
                                <RadialGradientBrush Center="0.82,0.12" GradientOrigin="0.82,0.12" RadiusX="0.24" RadiusY="0.5">
                                    <GradientStop Offset="0" Color="#26E8E8EC" />
                                    <GradientStop Offset="1" Color="#00E8E8EC" />
                                </RadialGradientBrush>
                            </Grid.Background>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="496" Padding="24" Spacing="28" VerticalAlignment="Center">
                                <Image Height="64" HorizontalAlignment="Center" Source="ms-appx:///Assets/Brand/silo-wordmark-white.png"
                                       AutomationProperties.Name="Silo" />
                                <!-- The web's glass card: its surface, a faint light along the top edge, 28 + 24 px inside. -->
                                <Border Padding="52,24" CornerRadius="12" Background="{StaticResource SiloSurfaceBrush}"
                                        BorderBrush="#0AFFFFFF" BorderThickness="0,1,0,0">
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalContentAlignment="Stretch" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The server's name over the form. -->
    <Style x:Key="SiloAuthTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontExtraBold}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="CharacterSpacing" Value="-40" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- "Sign in with an existing account." -->
    <Style x:Key="SiloAuthLeadTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontRegular}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- "Use your phone instead". -->
    <Style x:Key="SiloAuthHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Explanations and progress in the card. -->
    <Style x:Key="SiloAuthTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontRegular}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- A field's label above it, 8 px away (WinUI's header margin). -->
    <DataTemplate x:Key="SiloAuthFieldHeaderTemplate">
        <TextBlock Text="{Binding}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="14"
                   Foreground="{StaticResource SiloForegroundBrush}" />
    </DataTemplate>
    <Style x:Key="SiloAuthTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,8,8,7" />
        <Setter Property="IsSpellCheckEnabled" Value="False" />
        <Setter Property="HeaderTemplate" Value="{StaticResource SiloAuthFieldHeaderTemplate}" />
    </Style>
    <Style x:Key="SiloAuthPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,8,8,7" />
        <Setter Property="HeaderTemplate" Value="{StaticResource SiloAuthFieldHeaderTemplate}" />
    </Style>
    <!-- The web's form buttons: the width of the card, 36 px high, rounded 10 rather than pills. -->
    <Style x:Key="SiloAuthButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPrimaryButtonStyle}">
        <Setter Property="controls:Pill.IsEnabled" Value="False" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>
    <Style x:Key="SiloAuthOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloSecondaryButtonStyle}">
        <Setter Property="controls:Pill.IsEnabled" Value="False" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#FF28282E" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <!-- A refusal in the card (the web's destructive alert); its text a lighter red, to read on the dark. -->
    <Style x:Key="SiloAuthErrorStyle" TargetType="Border">
        <Setter Property="Background" Value="#1AEF4444" />
        <Setter Property="BorderBrush" Value="#4DEF4444" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="SiloAuthWarningStyle" TargetType="Border" BasedOn="{StaticResource SiloAuthErrorStyle}">
        <Setter Property="Background" Value="#14F59E0B" />
        <Setter Property="BorderBrush" Value="#4DF59E0B" />
    </Style>

    <!--
        Sidebar group label ("LIBRARIES"). WinUI's template takes the text from Content and its own text style,
        so this copy keeps its pane states (hidden while the pane is closed) with the Silo label style.
    -->
    <Style x:Key="SiloNavigationHeaderStyle" TargetType="NavigationViewItemHeader">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="NavigationViewItemHeader">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="PaneStates">
                                <VisualState x:Name="HeaderTextVisible" />
                                <VisualState x:Name="HeaderTextCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="HeaderText.Visibility" Value="Collapsed" />
                                        <Setter Target="InnerHeaderGrid.Height" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DisplayModeStates">
                                <VisualState x:Name="LeftMode" />
                                <VisualState x:Name="TopMode" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="InnerHeaderGrid" Height="40" Padding="16,0,0,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="HeaderText" VerticalAlignment="Bottom" Margin="0,0,0,6" Text="{TemplateBinding Content}"
                                       Style="{StaticResource SiloSectionLabelTextStyle}" FontSize="10" CharacterSpacing="220" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The player (docs/ui-design.md, Player). Its controls sit on the picture, not on the Silo surfaces: white
        text and icons, glass buttons, and scrims that darken the top and bottom just enough to keep them legible.
    -->
    <LinearGradientBrush x:Key="SiloPlayerTopScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#8C000000" />
        <GradientStop Offset="0.5" Color="#2E000000" />
        <GradientStop Offset="1" Color="#00000000" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SiloPlayerBottomScrimBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Offset="0" Color="#D1000000" />
        <GradientStop Offset="0.55" Color="#8F000000" />
        <GradientStop Offset="1" Color="#00000000" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SiloPlayerForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SiloPlayerMetaBrush" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="SiloPlayerTrackBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="SiloPlayerPopupBrush" Color="#F2161618" />
    <SolidColorBrush x:Key="SiloPlayerPopupBorderBrush" Color="#1AFFFFFF" />

    <!-- Bottom left, as on Silo's web player: the title, and under it a small upper-case line with the times. -->
    <Style x:Key="SiloPlayerTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource SiloPlayerForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- Without a colour of its own: in the time toggle it takes the button's, which lightens under the pointer. -->
    <Style x:Key="SiloPlayerMetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="220" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        One template for the player's own buttons: a white highlight fades in under the pointer, so a glass disc
        and a bare icon both lighten by the same step. Focus is the system ring.
    -->
    <ControlTemplate x:Key="SiloPlayerButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Highlight.Opacity" Value="0.09" />
                            <Setter Target="Content.Foreground" Value="{StaticResource SiloPlayerForegroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Highlight.Opacity" Value="0.05" />
                            <Setter Target="Content.Foreground" Value="{StaticResource SiloPlayerForegroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Highlight" Background="White" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.1" />
                </Border.OpacityTransition>
            </Border>
            <ContentPresenter
                x:Name="Content"
                Padding="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>
    <!-- Bare icon at the bottom right: mute, full screen. -->
    <Style x:Key="SiloPlayerIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#C7FFFFFF" />
        <Setter Property="CornerRadius" Value="{StaticResource SiloPillCornerRadius}" />
        <Setter Property="controls:Pill.IsEnabled" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template" Value="{StaticResource SiloPlayerButtonTemplate}" />
    </Style>
    <!-- Glass disc around play: skip back and forward. -->
    <Style x:Key="SiloPlayerDiscButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPlayerIconButtonStyle}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="#0FFFFFFF" />
        <Setter Property="BorderBrush" Value="#1AFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#EBFFFFFF" />
    </Style>
    <!-- Leaving the player, top left: "✕ Exit" on a dark pill that stays readable on a bright picture. -->
    <Style x:Key="SiloPlayerPillButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPlayerIconButtonStyle}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0,16,0" />
        <Setter Property="Background" Value="#99000000" />
        <Setter Property="Foreground" Value="{StaticResource SiloPlayerForegroundBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <!-- A time that is also a toggle: the end time switches between duration and remaining time. -->
    <Style x:Key="SiloPlayerTextButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPlayerIconButtonStyle}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="controls:Pill.IsEnabled" Value="False" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="#8CFFFFFF" />
    </Style>
    <!-- Play and pause: the one white disc, its icon dark. -->
    <Style x:Key="SiloPlayerPlayButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource SiloBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SiloPillCornerRadius}" />
        <Setter Property="controls:Pill.IsEnabled" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#E6FFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#CCFFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--
        The next episode's card (the web's NextEpisodeOverlay): Play Now white with black text, Cancel outlined; both
        rounded 4, 14 px medium.
    -->
    <Style x:Key="SiloPlayerCardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.9" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.8" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Background="#1AFFFFFF" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontWeight="{TemplateBinding FontWeight}"
                            FontSize="{TemplateBinding FontSize}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SiloPlayerCardOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPlayerCardButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SiloPlayerForegroundBrush}" />
        <Setter Property="BorderBrush" Value="#4DFFFFFF" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontRegular}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <!-- "Play Now" on the Playing Next screen: the red pill with white text. -->
    <Style x:Key="SiloNextUpPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPrimaryButtonStyle}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Padding" Value="24,0,28,0" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>
    <!-- "Auto-play is on", under Play Now: a quiet line that switches it. -->
    <Style x:Key="SiloNextUpTextButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPlayerCardButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#4DFFFFFF" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontRegular}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--
        "Skip Intro", "Skip Credits": the web player's pill over the picture, black at 75 % with a faint white edge. The
        content fills the whole pill, so the page can lay the intro's running time under the label.
    -->
    <Style x:Key="SiloPlayerSkipButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#BF000000" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource SiloPlayerForegroundBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="{StaticResource SiloPillCornerRadius}" />
        <Setter Property="controls:Pill.IsEnabled" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#D9000000" />
                                        <Setter Target="Root.BorderBrush" Value="#59FFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#40FFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontWeight="{TemplateBinding FontWeight}"
                            FontSize="{TemplateBinding FontSize}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The player's menus (audio, captions, settings), as Silo's web player draws them: black at 90 % above their
        button, 12 px corners, a muted upper-case label, rows that lighten under the pointer, the chosen one in blue
        with a check.
    -->
    <SolidColorBrush x:Key="SiloPlayerMenuChosenBrush" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="SiloPlayerMenuRowBrush" Color="#D9FFFFFF" />
    <Style x:Key="SiloPlayerMenuStyle" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="#E6000000" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="RequestedTheme" Value="Dark" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <!-- The subtitle menu is wider and scrolls past 60 % of the window, as on the web. -->
    <Style x:Key="SiloPlayerWideMenuStyle" TargetType="FlyoutPresenter" BasedOn="{StaticResource SiloPlayerMenuStyle}">
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="MaxHeight" Value="560" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style x:Key="SiloPlayerMenuHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="25" />
        <Setter Property="Foreground" Value="#80FFFFFF" />
        <Setter Property="Margin" Value="12,6" />
    </Style>
    <Style x:Key="SiloPlayerMenuItemStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SiloPlayerMenuRowBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#1AFFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#0DFFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The small square buttons of a menu row: the subtitle delay's earlier, later and Reset. -->
    <Style x:Key="SiloPlayerMenuStepButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPlayerMenuItemStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
    </Style>
    <!-- A track's facts beside its name: codec and channels filled, the file's default outlined. -->
    <Style x:Key="SiloPlayerMenuChipStyle" TargetType="Border">
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2,6,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SiloPlayerMenuOutlineChipStyle" TargetType="Border" BasedOn="{StaticResource SiloPlayerMenuChipStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#40FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="SiloPlayerMenuChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="CharacterSpacing" Value="25" />
        <Setter Property="TextLineBounds" Value="Tight" />
        <Setter Property="Foreground" Value="#BFFFFFFF" />
    </Style>

    <!--
        The buttons a card shows under the pointer (Silo's web: media-card-action-trigger): a dark 32 px tile with a
        faint edge, the icon in the foreground colour.
    -->
    <Style x:Key="SiloCardActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Tile" Background="#CC141417" BorderBrush="#3328282E" BorderThickness="1" CornerRadius="10">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Tile.Background" Value="#E6141417" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Tile.Background" Value="#F2141417" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The red play disc in the middle of a card under the pointer; it grows a little under the pointer itself. -->
    <Style x:Key="SiloCardPlayButtonStyle" TargetType="Button">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource SiloBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Disc" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="DiscScale" />
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Fill" Value="#FFF25858" />
                                        <Setter Target="DiscScale.ScaleX" Value="1.1" />
                                        <Setter Target="DiscScale.ScaleY" Value="1.1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Fill" Value="#FFDC2F2F" />
                                        <Setter Target="DiscScale.ScaleX" Value="0.95" />
                                        <Setter Target="DiscScale.ScaleY" Value="0.95" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Ellipse x:Name="Fill" Fill="{StaticResource SiloPrimaryBrush}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A whole card as one button: keyboard focus and Enter work, and the system focus ring shows. Under the pointer
        the card itself reacts (MediaCardView: the artwork grows, its buttons appear), as on Silo's web.
    -->
    <Style x:Key="SiloCardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="Content"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
