<?xml version="1.0" encoding="utf-8"?>
<!--
    The Silo look (docs/ui-design.md): one dark theme taken from Silo's web client, red as the only
    accent, Plus Jakarta Sans. Fluent controls keep working; their theme brushes are pointed at this palette.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- The app always runs dark (App.xaml); Light and Default point to the same values. -->
        <ResourceDictionary x:Key="Default">
            <Color x:Key="SystemAccentColor">#FFEF4444</Color>
            <Color x:Key="SystemAccentColorLight1">#FFF25858</Color>
            <Color x:Key="SystemAccentColorLight2">#FFEF4444</Color>
            <Color x:Key="SystemAccentColorLight3">#FFF87171</Color>
            <Color x:Key="SystemAccentColorDark1">#FFDC2F2F</Color>
            <Color x:Key="SystemAccentColorDark2">#FFB91C1C</Color>
            <Color x:Key="SystemAccentColorDark3">#FF991B1B</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFEF4444" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFF25858" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFDC2F2F" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFF87171" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFF87171" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFEF4444" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE8E8EC" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFA4A4AE" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF7C7C86" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FF141417" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF141417" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF141417" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF141417" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#B32A2A2F" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#E61F1F23" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FF232328" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#801F1F23" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF1C1C20" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#B32A2A2F" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF1C1C20" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF232328" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FF1C1C20" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#FFEF4444</Color>
            <Color x:Key="SystemAccentColorLight1">#FFF25858</Color>
            <Color x:Key="SystemAccentColorLight2">#FFEF4444</Color>
            <Color x:Key="SystemAccentColorLight3">#FFF87171</Color>
            <Color x:Key="SystemAccentColorDark1">#FFDC2F2F</Color>
            <Color x:Key="SystemAccentColorDark2">#FFB91C1C</Color>
            <Color x:Key="SystemAccentColorDark3">#FF991B1B</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFEF4444" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFF25858" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFDC2F2F" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFF87171" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFF87171" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFEF4444" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE8E8EC" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFA4A4AE" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF7C7C86" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FF141417" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF141417" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF141417" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF141417" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#B32A2A2F" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#E61F1F23" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FF232328" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#801F1F23" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF1C1C20" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#B32A2A2F" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF1C1C20" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF232328" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FF1C1C20" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Palette -->
    <Color x:Key="SiloBackgroundColor">#FF141417</Color>
    <Color x:Key="SiloSurfaceColor">#FF1C1C20</Color>
    <Color x:Key="SiloSurfaceRaisedColor">#FF232328</Color>
    <Color x:Key="SiloBorderColor">#B32A2A2F</Color>
    <Color x:Key="SiloForegroundColor">#FFE8E8EC</Color>
    <Color x:Key="SiloMutedColor">#FFA4A4AE</Color>
    <Color x:Key="SiloPrimaryColor">#FFEF4444</Color>
    <Color x:Key="SiloPrimaryHoverColor">#FFF25858</Color>
    <Color x:Key="SiloPrimaryPressedColor">#FFDC2F2F</Color>
    <Color x:Key="SiloBadgeBackgroundColor">#B314141E</Color>
    <Color x:Key="SiloBadgeBorderColor">#26FFFFFF</Color>
    <!-- The IMDb badge's gold, Tailwind's green-500 of a watched mark, emerald-400 of a watched button. -->
    <Color x:Key="SiloRatingBadgeColor">#C24F421C</Color>
    <Color x:Key="SiloWatchedColor">#E622C55E</Color>
    <Color x:Key="SiloWatchedButtonColor">#FF34D399</Color>
    <Color x:Key="SiloCompleteColor">#FF4CAF50</Color>

    <SolidColorBrush x:Key="SiloBackgroundBrush" Color="{StaticResource SiloBackgroundColor}" />
    <SolidColorBrush x:Key="SiloSurfaceBrush" Color="{StaticResource SiloSurfaceColor}" />
    <SolidColorBrush x:Key="SiloSurfaceRaisedBrush" Color="{StaticResource SiloSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SiloBorderBrush" Color="{StaticResource SiloBorderColor}" />
    <SolidColorBrush x:Key="SiloForegroundBrush" Color="{StaticResource SiloForegroundColor}" />
    <SolidColorBrush x:Key="SiloMutedBrush" Color="{StaticResource SiloMutedColor}" />
    <SolidColorBrush x:Key="SiloPrimaryBrush" Color="{StaticResource SiloPrimaryColor}" />
    <SolidColorBrush x:Key="SiloBadgeBackgroundBrush" Color="{StaticResource SiloBadgeBackgroundColor}" />
    <SolidColorBrush x:Key="SiloBadgeBorderBrush" Color="{StaticResource SiloBadgeBorderColor}" />
    <SolidColorBrush x:Key="SiloRatingBadgeBrush" Color="{StaticResource SiloRatingBadgeColor}" />
    <SolidColorBrush x:Key="SiloWatchedBrush" Color="{StaticResource SiloWatchedColor}" />
    <SolidColorBrush x:Key="SiloWatchedButtonBrush" Color="{StaticResource SiloWatchedButtonColor}" />
    <SolidColorBrush x:Key="SiloCompleteBrush" Color="{StaticResource SiloCompleteColor}" />

    <!-- Plus Jakarta Sans, one file per weight: XAML loads only the face of the file it names. -->
    <FontFamily x:Key="SiloFontRegular">ms-appx:///Assets/Fonts/PlusJakartaSans-Regular.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="SiloFontItalic">ms-appx:///Assets/Fonts/PlusJakartaSans-Italic.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="SiloFontMedium">ms-appx:///Assets/Fonts/PlusJakartaSans-Medium.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="SiloFontSemiBold">ms-appx:///Assets/Fonts/PlusJakartaSans-SemiBold.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="SiloFontBold">ms-appx:///Assets/Fonts/PlusJakartaSans-Bold.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="SiloFontExtraBold">ms-appx:///Assets/Fonts/PlusJakartaSans-ExtraBold.ttf#Plus Jakarta Sans</FontFamily>

    <!-- Fluent controls and the built-in text styles use the regular face. -->
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/PlusJakartaSans-Regular.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="XamlAutoFontFamily">ms-appx:///Assets/Fonts/PlusJakartaSans-Regular.ttf#Plus Jakarta Sans</FontFamily>

    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="SiloCardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="SiloPillCornerRadius">999</CornerRadius>

    <!-- Text. Upper-case overlines come upper-cased from the view model: XAML has no text-transform. -->
    <Style x:Key="SiloDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontExtraBold}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="CharacterSpacing" Value="-50" />
        <Setter Property="LineHeight" Value="60" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SiloPageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontBold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="CharacterSpacing" Value="-30" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SiloRowTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="CharacterSpacing" Value="-25" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
    </Style>
    <Style x:Key="SiloBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontRegular}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SiloCardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="-25" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="SiloCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- "2021 SERIES" under a poster. -->
    <Style x:Key="SiloOverlineTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="140" />
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- "LIBRARIES", "EXPLORE ALL", breadcrumbs. -->
    <Style x:Key="SiloSectionLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
    </Style>
    <Style x:Key="SiloBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="25" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Pills on artwork: resolution, audio, status, rating. -->
    <Style x:Key="SiloBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SiloBadgeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SiloBadgeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SiloPillCornerRadius}" />
        <Setter Property="Padding" Value="9,3" />
    </Style>
    <!-- Metadata chips on detail pages: "2026", "R", "1H 49M". -->
    <Style x:Key="SiloChipStyle" TargetType="Border">
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SiloPillCornerRadius}" />
        <Setter Property="Padding" Value="10,3" />
    </Style>
    <!-- Technical chips in the accent colour: "1080P", "EAC3". -->
    <Style x:Key="SiloAccentChipStyle" TargetType="Border" BasedOn="{StaticResource SiloChipStyle}">
        <Setter Property="Background" Value="#26EF4444" />
        <Setter Property="BorderBrush" Value="#99EF4444" />
    </Style>

    <!-- Pill buttons: red primary (Play), dark secondary (Mark watched), round icon buttons. -->
    <Style x:Key="SiloPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource SiloPillCornerRadius}" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="SiloSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource SiloPillCornerRadius}" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Background" Value="#CC1C1C20" />
        <Setter Property="BorderBrush" Value="{StaticResource SiloBorderBrush}" />
    </Style>
    <Style x:Key="SiloIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloSecondaryButtonStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
    </Style>
    <!-- "EXPLORE ALL" next to a row title. -->
    <Style x:Key="SiloLinkButtonStyle" TargetType="HyperlinkButton">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="180" />
    </Style>

    <!--
        Sidebar group label ("LIBRARIES"). WinUI's template takes the text from Content and its own text style,
        so this copy keeps its pane states (hidden while the pane is closed) with the Silo label style.
    -->
    <Style x:Key="SiloNavigationHeaderStyle" TargetType="NavigationViewItemHeader">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="NavigationViewItemHeader">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="PaneStates">
                                <VisualState x:Name="HeaderTextVisible" />
                                <VisualState x:Name="HeaderTextCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="HeaderText.Visibility" Value="Collapsed" />
                                        <Setter Target="InnerHeaderGrid.Height" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DisplayModeStates">
                                <VisualState x:Name="LeftMode" />
                                <VisualState x:Name="TopMode" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="InnerHeaderGrid" Height="40" Padding="16,0,0,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="HeaderText" VerticalAlignment="Bottom" Margin="0,0,0,6" Text="{TemplateBinding Content}"
                                       Style="{StaticResource SiloSectionLabelTextStyle}" FontSize="10" CharacterSpacing="220" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The player (docs/ui-design.md, Player). Its controls sit on the picture, not on the Silo surfaces: white
        text and icons, glass buttons, and scrims that darken the top and bottom just enough to keep them legible.
    -->
    <LinearGradientBrush x:Key="SiloPlayerTopScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#8C000000" />
        <GradientStop Offset="0.5" Color="#2E000000" />
        <GradientStop Offset="1" Color="#00000000" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SiloPlayerBottomScrimBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Offset="0" Color="#D1000000" />
        <GradientStop Offset="0.55" Color="#8F000000" />
        <GradientStop Offset="1" Color="#00000000" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SiloPlayerForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SiloPlayerMutedBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="SiloPlayerTrackBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="SiloPlayerPopupBrush" Color="#F2161618" />
    <SolidColorBrush x:Key="SiloPlayerPopupBorderBrush" Color="#1AFFFFFF" />

    <!-- Position and duration beside the seek bar. -->
    <Style x:Key="SiloPlayerTimeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#D9FFFFFF" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        One template for the player's own buttons: a white highlight fades in under the pointer, so a glass disc
        and a bare icon both lighten by the same step. Focus is the system ring.
    -->
    <ControlTemplate x:Key="SiloPlayerButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Highlight.Opacity" Value="0.09" />
                            <Setter Target="Content.Foreground" Value="{StaticResource SiloPlayerForegroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Highlight.Opacity" Value="0.05" />
                            <Setter Target="Content.Foreground" Value="{StaticResource SiloPlayerForegroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Highlight" Background="White" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.1" />
                </Border.OpacityTransition>
            </Border>
            <ContentPresenter
                x:Name="Content"
                Padding="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}" />
        </Grid>
    </ControlTemplate>
    <!-- Bare icon in the bottom rail: mute, full screen. -->
    <Style x:Key="SiloPlayerIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#C7FFFFFF" />
        <Setter Property="CornerRadius" Value="{StaticResource SiloPillCornerRadius}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template" Value="{StaticResource SiloPlayerButtonTemplate}" />
    </Style>
    <!-- Glass disc: back, skip back and forward. -->
    <Style x:Key="SiloPlayerDiscButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPlayerIconButtonStyle}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Background" Value="#0FFFFFFF" />
        <Setter Property="BorderBrush" Value="#1FFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#EBFFFFFF" />
    </Style>
    <!-- A time that is also a toggle: the end of the seek bar switches between duration and remaining time. -->
    <Style x:Key="SiloPlayerTextButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPlayerIconButtonStyle}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Foreground" Value="#D9FFFFFF" />
    </Style>
    <!-- Play and pause: the red Silo disc, the one prominent control. -->
    <Style x:Key="SiloPlayerPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPrimaryButtonStyle}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--
        The buttons a card shows under the pointer (Silo's web: media-card-action-trigger): a dark 32 px tile with a
        faint edge, the icon in the foreground colour.
    -->
    <Style x:Key="SiloCardActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Tile" Background="#CC141417" BorderBrush="#3328282E" BorderThickness="1" CornerRadius="10">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Tile.Background" Value="#E6141417" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Tile.Background" Value="#F2141417" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The red play disc in the middle of a card under the pointer; it grows a little under the pointer itself. -->
    <Style x:Key="SiloCardPlayButtonStyle" TargetType="Button">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource SiloBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Disc" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="DiscScale" />
                        </Grid.RenderTransform>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Fill" Value="#FFF25858" />
                                        <Setter Target="DiscScale.ScaleX" Value="1.1" />
                                        <Setter Target="DiscScale.ScaleY" Value="1.1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Fill" Value="#FFDC2F2F" />
                                        <Setter Target="DiscScale.ScaleX" Value="0.95" />
                                        <Setter Target="DiscScale.ScaleY" Value="0.95" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Ellipse x:Name="Fill" Fill="{StaticResource SiloPrimaryBrush}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A whole card as one button: keyboard focus and Enter work, and the system focus ring shows. Under the pointer
        the card itself reacts (MediaCardView: the artwork grows, its buttons appear), as on Silo's web.
    -->
    <Style x:Key="SiloCardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="Content"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
