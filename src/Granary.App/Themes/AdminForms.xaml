<?xml version="1.0" encoding="utf-8"?>
<!--
    The look Admin → Users shares across its tabs, an account's page and their dialogs, as the web's admin tables and
    cards: a surface card, column headings, a cell, a small icon action, a badge, and the error and hint lines. It brings
    the settings' styles with it, so a view made in code gets both by merging this one.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/SiloSettings.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The web's info notice, in Silo's info blue (SiloInfoColor): its border at 25 %, its fill at 5 %. -->
    <SolidColorBrush x:Key="AdminInfoBorderBrush" Color="#404BA3F7" />
    <SolidColorBrush x:Key="AdminInfoBackgroundBrush" Color="#0D4BA3F7" />
    <SolidColorBrush x:Key="AdminInfoIconBrush" Color="#FF4BA3F7" />

    <Style x:Key="AdminFormCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SiloSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SiloBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="AdminColumnHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- A sortable heading: the web's button in the table head, its text and its chevron. -->
    <Style x:Key="AdminSortHeadingStyle" TargetType="Button" BasedOn="{StaticResource SiloSettingsGhostButtonStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
    </Style>

    <Style x:Key="AdminCellStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="AdminMutedCellStyle" TargetType="TextBlock" BasedOn="{StaticResource AdminCellStyle}">
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
    </Style>

    <Style x:Key="AdminRowIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloSettingsGhostButtonStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="AdminBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AdminBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="AdminErrorTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SiloDestructiveBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AdminHintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The web's amber notice (rounded-xl, p-3): a server setting that blocks or limits what the tab offers. -->
    <Style x:Key="AdminWarningCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#0DF59E0B" />
        <Setter Property="BorderBrush" Value="#33F59E0B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- A bearer link shown once: the web's muted box around its code line. -->
    <Style x:Key="AdminSecretBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SiloSurfaceRaisedBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!--
        The web's form parts (components/ui), its Tailwind values one to one. The web's radius token is 12 px: rounded-md is 10,
        rounded-lg 12, rounded-xl 16. text-sm is 14, text-xs 12; h-9 is 36, h-8 32. Its card border is #28282E, its input
        border #6A6A74, its accent (hover) #232328.
    -->
    <SolidColorBrush x:Key="AdminCardBorderBrush" Color="#FF28282E" />
    <SolidColorBrush x:Key="AdminInputBorderBrush" Color="#FF6A6A74" />
    <SolidColorBrush x:Key="AdminAccentBrush" Color="#FF232328" />
    <SolidColorBrush x:Key="AdminDialogBackgroundBrush" Color="#FF141417" />
    <!-- The web's amber-500, at full strength, 40 % (a chosen card's border) and 5 % (its fill). -->
    <SolidColorBrush x:Key="AdminAmberBrush" Color="#FFF59E0B" />
    <SolidColorBrush x:Key="AdminAmberBorderBrush" Color="#66F59E0B" />
    <SolidColorBrush x:Key="AdminAmberFillBrush" Color="#0DF59E0B" />
    <!-- The web's emerald-500 badge: the text, its border at 30 % and its fill at 10 %. -->
    <SolidColorBrush x:Key="AdminEmeraldBrush" Color="#FF10B981" />
    <SolidColorBrush x:Key="AdminEmeraldBorderBrush" Color="#4D10B981" />
    <SolidColorBrush x:Key="AdminEmeraldFillBrush" Color="#1A10B981" />
    <!-- The web's secondary badge: #232328 behind #D0D0D6. -->
    <SolidColorBrush x:Key="AdminSecondaryForegroundBrush" Color="#FFD0D0D6" />

    <!-- The web's DialogTitle: text-lg (18), semibold, leading-none. -->
    <Style x:Key="AdminDialogTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The web's DialogDescription: text-sm, muted. -->
    <Style x:Key="AdminDialogDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The dialog's X, top right: a 16 px glyph at 70 %, full on hover, as the web's DialogClose. -->
    <Style x:Key="AdminDialogCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloSettingsGhostButtonStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- The web's TableHead: text-sm medium in the foreground. -->
    <Style x:Key="AdminTableHeadStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The web's Label: text-sm, medium, leading-none. -->
    <Style x:Key="AdminFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The web's Input: h-9 (36), rounded-md, px-3, text-sm. -->
    <Style x:Key="AdminTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,7,12,6" />
    </Style>

    <Style x:Key="AdminPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,7,12,6" />
    </Style>

    <!-- The web's SelectTrigger: h-9 (36), rounded-md, text-sm, as wide as its choice (w-fit). -->
    <Style x:Key="AdminSelectStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- A SelectTrigger with w-full. -->
    <Style x:Key="AdminFullSelectStyle" TargetType="ComboBox" BasedOn="{StaticResource AdminSelectStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- The web's primary Button: h-9, rounded-md, px-4, text-sm medium, in the accent. -->
    <Style x:Key="AdminPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloPrimaryButtonStyle}">
        <Setter Property="controls:Pill.IsEnabled" Value="False" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>

    <!-- size="sm": h-8 (32), px-3. -->
    <Style x:Key="AdminSmallPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AdminPrimaryButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- variant="outline": the card border, rounded-md, the accent behind it on hover. -->
    <Style x:Key="AdminOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloSettingsOutlineButtonStyle}">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderBrush" Value="{StaticResource AdminCardBorderBrush}" />
    </Style>

    <Style x:Key="AdminSmallOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource AdminOutlineButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- variant="ghost": text only until the pointer is on it. -->
    <Style x:Key="AdminGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloSettingsGhostButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
    </Style>

    <!-- A bordered row of the policy fields, as the web's BooleanPolicyRow and permission cards: rounded-md, px-3 py-2. -->
    <Style x:Key="AdminFieldCardStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource AdminCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- The default a field shows while not overridden: the web's dashed box, rounded-md, px-3 py-2, text-sm muted. -->
    <Style x:Key="AdminDashedBoxStyle" TargetType="Rectangle">
        <Setter Property="Stroke" Value="{StaticResource AdminCardBorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeDashArray" Value="4,3" />
        <Setter Property="RadiusX" Value="10" />
        <Setter Property="RadiusY" Value="10" />
    </Style>

    <Style x:Key="AdminDashedTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        <Setter Property="Margin" Value="12,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The web's badge: rounded-md, px-2 py-0.5, text-xs medium. -->
    <Style x:Key="AdminPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="AdminPillTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--
        The web's line tabs (TabsList variant="line"): muted text-sm medium, the foreground once picked with a 2 px bar under
        it on the list's hairline, 35 px tall. Padding is the trigger's: px-2 on a page, px-1 in a dialog. RadioButtons in one
        group; HorizontalContentAlignment centres a stretched (flex-1) tab's text.
    -->
    <Style x:Key="AdminLineTabStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="35" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Text.Foreground" Value="{StaticResource SiloForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Text.Foreground" Value="{StaticResource SiloForegroundBrush}" />
                                        <Setter Target="Root.Opacity" Value="0.8" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Text.Foreground" Value="{StaticResource SiloForegroundBrush}" />
                                        <Setter Target="Bar.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Text" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <Border x:Name="Bar" Height="2" VerticalAlignment="Bottom" Background="{StaticResource SiloForegroundBrush}" Opacity="0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- In a dialog: flex-none px-1. -->
    <Style x:Key="AdminDialogTabStyle" TargetType="RadioButton" BasedOn="{StaticResource AdminLineTabStyle}">
        <Setter Property="Padding" Value="4,0" />
    </Style>

    <!--
        One card of a choice, as the web's ChoiceOption: rounded-xl, px-3.5 py-3, a hairline at 70 %; picked, an amber border
        at 40 % over an amber fill at 5 %. The radio sits top left in amber (accent-amber-500). Its content is the title and line.
    -->
    <Style x:Key="AdminChoiceCardStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card" BorderBrush="#B328282E" BorderThickness="1" CornerRadius="16" Padding="14,12" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Card.Opacity" Value="0.6" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Card.BorderBrush" Value="{StaticResource AdminAmberBorderBrush}" />
                                        <Setter Target="Card.Background" Value="{StaticResource AdminAmberFillBrush}" />
                                        <Setter Target="Ring.Stroke" Value="{StaticResource AdminAmberBrush}" />
                                        <Setter Target="Ring.Fill" Value="{StaticResource AdminAmberBrush}" />
                                        <Setter Target="Dot.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="14" Height="14" Margin="0,3,0,0" VerticalAlignment="Top">
                                <Ellipse x:Name="Ring" Stroke="{StaticResource SiloMutedBrush}" StrokeThickness="1" Fill="Transparent" />
                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="#FF141417" Opacity="0" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                              AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
