<?xml version="1.0" encoding="utf-8"?>
<!--
    The inputs of Silo's web login (its shadcn Input): a 36 px field on the page background with a faint
    outline, red when focused, the placeholder muted. A page with SiloAuthShellStyle merges this into its
    resources, so WinUI's text boxes there take these brushes in every state instead of the Fluent ones
    (whose focus is an accent underline).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="TextControlBackground" Color="#FF141417" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF141417" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF141417" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FF28282E" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF3A3A42" />
    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SiloPrimaryBrush" />
    <!-- The web adds a 3 px half-red ring around the red outline; a 2 px outline stands for both. -->
    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">2</Thickness>
    <SolidColorBrush x:Key="TextControlForeground" Color="#FFE8E8EC" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFE8E8EC" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFE8E8EC" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FFA4A4AE" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FFA4A4AE" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FFA4A4AE" />
    <SolidColorBrush x:Key="TextControlHeaderForeground" Color="#FFE8E8EC" />
    <x:Double x:Key="TextControlThemeMinHeight">36</x:Double>
</ResourceDictionary>
