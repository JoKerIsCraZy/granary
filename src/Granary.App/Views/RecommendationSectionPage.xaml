<?xml version="1.0" encoding="utf-8"?>
<!-- A For You row in full, as Silo's web shows it: its name, how many titles, and the posters. -->
<Page
    x:Class="Granary.App.Views.RecommendationSectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    NavigationCacheMode="Enabled">

    <ScrollViewer x:Name="Scroller" XYFocusKeyboardNavigation="Enabled">
        <StackPanel Padding="48,32,48,48" Spacing="24">
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource SiloDisplayTextStyle}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}" />
            </StackPanel>

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="32" Height="32" Margin="0,48" HorizontalAlignment="Center" AutomationProperties.Name="Loading titles" />
            <StackPanel Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" Spacing="16" Margin="0,48" HorizontalAlignment="Center">
                <TextBlock Text="Failed to load this section." Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}"
                           TextAlignment="Center" />
                <Button Content="Retry" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.RetryCommand}" />
            </StackPanel>
            <StackPanel Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" Spacing="6" Margin="0,48" HorizontalAlignment="Center">
                <TextBlock Text="Nothing here yet" Style="{StaticResource SiloRowTitleTextStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Watch and rate more content to surface picks for this section." Style="{StaticResource SiloBodyTextStyle}"
                           Foreground="{StaticResource SiloMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <controls:MediaGrid ItemsSource="{x:Bind ViewModel.Cards}" CardInvokedCommand="{x:Bind ViewModel.OpenCardCommand}"
                                Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
