<?xml version="1.0" encoding="utf-8"?>
<!--
    The settings, as Silo's web opens them: the app's sidebar gives way to the settings' own (260 px) with Back to App,
    the profile the settings belong to and the pages by group; the page on the right scrolls, 1120 px at most.
-->
<Page
    x:Class="Granary.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:t="using:Granary.Core.Texts">

    <Page.Resources>
        <ResourceDictionary Source="ms-appx:///Themes/SiloSettings.xaml" />
    </Page.Resources>

    <Grid Background="{StaticResource SiloBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#FF111113" BorderBrush="{StaticResource SiloSettingsHairlineBrush}" BorderThickness="0,0,1,0">
            <!--
                As the web's: the head stays, and the groups below it scroll in a window too short for them all, so the last
                pages (Downloads, About) stay reachable by the mouse, the keyboard and a controller.
            -->
            <Grid Padding="0,20,0,0" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Padding="12,0" Spacing="4">
                    <Button x:Name="BackButton" Style="{StaticResource SiloSettingsBackButtonStyle}" Padding="8,4" Click="OnBackClick"
                            AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.sidebar.backToApp')}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="12" />
                            <TextBlock Text="{x:Bind t:AppText.Get('web.settings.sidebar.backToApp')}" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{x:Bind t:AppText.Get('web.settings.sidebar.title')}" Margin="8,16,0,12" FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="22"
                               Foreground="{StaticResource SiloForegroundBrush}" AutomationProperties.HeadingLevel="Level1" />
                    <Grid Margin="8,0,8,16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" Background="#FF2A2A30">
                            <TextBlock Text="{x:Bind Sidebar.ProfileInitials, Mode=OneWay}" FontFamily="{StaticResource SiloFontSemiBold}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SiloForegroundBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind t:AppText.Get('web.settings.currentProfileLink.caption')}" FontSize="12" Foreground="{StaticResource SiloMutedBrush}" />
                            <TextBlock Text="{x:Bind Sidebar.ProfileName, Mode=OneWay}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                                       FontSize="14" Foreground="{StaticResource SiloForegroundBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <ScrollViewer x:Name="PagesScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <!-- An arrow moves the focus on from list to list here, before the scroller would take it to scroll a line. -->
                    <StackPanel Padding="12,0,12,24" Spacing="4" XYFocusKeyboardNavigation="Enabled">
                        <TextBlock x:Name="PlaybackGroup" Margin="8,8,0,6" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="11"
                                   CharacterSpacing="150" Foreground="{StaticResource SiloMutedBrush}" AutomationProperties.HeadingLevel="Level2" />
                        <!-- Each list is named by its group's heading as the page is made (SettingsPage.NameGroup). -->
                        <ListView x:Name="Pages" SelectionMode="Single" SelectionChanged="OnPageSelected" IsItemClickEnabled="False">
                            <ListViewItem Tag="playback" AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.playback.title')}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="{x:Bind t:AppText.Get('web.settings.playback.title')}" FontSize="14" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="subtitles" AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.title')}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE7F0;" FontSize="14" />
                                    <TextBlock Text="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.title')}" FontSize="14" />
                                </StackPanel>
                            </ListViewItem>
                        </ListView>
                        <!-- How Granary looks: posters, badges and the sidebar; what a title's page shows; the language it speaks. -->
                        <TextBlock x:Name="AppearanceGroup" Margin="8,20,0,6" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="11"
                                   CharacterSpacing="150" Foreground="{StaticResource SiloMutedBrush}" AutomationProperties.HeadingLevel="Level2" />
                        <ListView x:Name="AppearancePages" SelectionMode="Single" SelectionChanged="OnPageSelected" IsItemClickEnabled="False">
                            <ListViewItem Tag="interface" AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.interface.title')}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8A1;" FontSize="14" />
                                    <TextBlock Text="{x:Bind t:AppText.Get('web.settings.interface.title')}" FontSize="14" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="title-pages" AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.titlePages.title')}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8B2;" FontSize="14" />
                                    <TextBlock Text="{x:Bind t:AppText.Get('web.settings.titlePages.title')}" FontSize="14" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="accessibility" AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.accessibility.title')}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE890;" FontSize="14" />
                                    <TextBlock Text="{x:Bind t:AppText.Get('web.settings.accessibility.title')}" FontSize="14" />
                                </StackPanel>
                            </ListViewItem>
                        </ListView>
                        <!-- The account's: where it is signed in, and the devices it watches on. -->
                        <TextBlock x:Name="AccountGroup" Margin="8,20,0,6" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="11"
                                   CharacterSpacing="150" Foreground="{StaticResource SiloMutedBrush}" AutomationProperties.HeadingLevel="Level2" />
                        <ListView x:Name="AccountPages" SelectionMode="Single" SelectionChanged="OnPageSelected" IsItemClickEnabled="False">
                            <ListViewItem Tag="devices" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.devices.title')}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8EA;" FontSize="14" />
                                    <TextBlock Text="{x:Bind t:AppText.Get('granary.settings.devices.title')}" FontSize="14" />
                                </StackPanel>
                            </ListViewItem>
                        </ListView>
                        <!-- The app's own: its servers, its downloads on this PC, and what it is. One page is open across all the lists. -->
                        <TextBlock x:Name="AppGroup" Margin="8,20,0,6" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="11"
                                   CharacterSpacing="150" Foreground="{StaticResource SiloMutedBrush}" AutomationProperties.HeadingLevel="Level2" />
                        <ListView x:Name="AppPages" SelectionMode="Single" SelectionChanged="OnPageSelected" IsItemClickEnabled="False">
                            <ListViewItem Tag="servers" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.servers.title')}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE968;" FontSize="14" />
                                    <TextBlock Text="{x:Bind t:AppText.Get('granary.servers.title')}" FontSize="14" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="downloads" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.nav.downloads')}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="{x:Bind t:AppText.Get('granary.settings.nav.downloads')}" FontSize="14" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="about" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.nav.about')}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" />
                                    <TextBlock Text="{x:Bind t:AppText.Get('granary.settings.nav.about')}" FontSize="14" />
                                </StackPanel>
                            </ListViewItem>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!--
            The page in a column of at most 1120 px. A column, not MaxWidth on the host: a host held to MaxWidth placed a page
            of short lines by its own narrower width and still drew it full width, pushing it off the right edge.
        -->
        <ScrollViewer x:Name="PageScroller" Grid.Column="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <!-- The middle column takes nearly all the width up to its maximum; the sides share the rest, so the page is centred. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1000*" MaxWidth="1120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="PageHost" Grid.Column="1" Padding="50,48,50,64" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                IsTabStop="False" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
