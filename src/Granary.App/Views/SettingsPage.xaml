<?xml version="1.0" encoding="utf-8"?>
<!--
    The settings, as Silo's web opens them: the app's sidebar gives way to the settings' own (260 px) with Back to App,
    the profile the settings belong to and the pages by group; the page on the right scrolls, 1120 px at most.
-->
<Page
    x:Class="Granary.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Settings">

    <Page.Resources>
        <ResourceDictionary Source="ms-appx:///Themes/SiloSettings.xaml" />
    </Page.Resources>

    <Grid Background="{StaticResource SiloBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#FF111113" BorderBrush="{StaticResource SiloSettingsHairlineBrush}" BorderThickness="0,0,1,0">
            <StackPanel Padding="12,20,12,24" Spacing="4">
                <Button x:Name="BackButton" Style="{StaticResource SiloSettingsBackButtonStyle}" Padding="8,4" Click="OnBackClick"
                        AutomationProperties.Name="Back to App">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        <TextBlock Text="Back to App" FontSize="14" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Settings" Margin="8,16,0,12" FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="22"
                           Foreground="{StaticResource SiloForegroundBrush}" AutomationProperties.HeadingLevel="Level1" />
                <Grid Margin="8,0,8,16" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="16" Background="#FF2A2A30">
                        <TextBlock Text="{x:Bind Sidebar.ProfileInitials, Mode=OneWay}" FontFamily="{StaticResource SiloFontSemiBold}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SiloForegroundBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Current profile" FontSize="12" Foreground="{StaticResource SiloMutedBrush}" />
                        <TextBlock Text="{x:Bind Sidebar.ProfileName, Mode=OneWay}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                                   FontSize="14" Foreground="{StaticResource SiloForegroundBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="PLAYBACK" Margin="8,8,0,6" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="11"
                           CharacterSpacing="150" Foreground="{StaticResource SiloMutedBrush}" AutomationProperties.HeadingLevel="Level2" />
                <ListView x:Name="Pages" SelectionMode="Single" SelectionChanged="OnPageSelected" IsItemClickEnabled="False"
                          AutomationProperties.Name="Settings pages">
                    <ListViewItem Tag="playback" AutomationProperties.Name="Playback">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Playback" FontSize="14" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="subtitles" AutomationProperties.Name="Language &amp; Subtitles">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE7F0;" FontSize="14" />
                            <TextBlock Text="Language &amp; Subtitles" FontSize="14" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>
                <!-- The app's own: its servers, and what it is. One page is open across both lists. -->
                <TextBlock Text="APP" Margin="8,20,0,6" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="11"
                           CharacterSpacing="150" Foreground="{StaticResource SiloMutedBrush}" AutomationProperties.HeadingLevel="Level2" />
                <ListView x:Name="AppPages" SelectionMode="Single" SelectionChanged="OnPageSelected" IsItemClickEnabled="False"
                          AutomationProperties.Name="App pages">
                    <ListViewItem Tag="servers" AutomationProperties.Name="Servers">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE968;" FontSize="14" />
                            <TextBlock Text="Servers" FontSize="14" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="about" AutomationProperties.Name="About">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE946;" FontSize="14" />
                            <TextBlock Text="About" FontSize="14" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </StackPanel>
        </Border>

        <!--
            The page in a column of at most 1120 px. A column, not MaxWidth on the host: a host held to MaxWidth placed a page
            of short lines by its own narrower width and still drew it full width, pushing it off the right edge.
        -->
        <ScrollViewer x:Name="PageScroller" Grid.Column="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <!-- The middle column takes nearly all the width up to its maximum; the sides share the rest, so the page is centred. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1000*" MaxWidth="1120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="PageHost" Grid.Column="1" Padding="50,48,50,64" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                IsTabStop="False" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
