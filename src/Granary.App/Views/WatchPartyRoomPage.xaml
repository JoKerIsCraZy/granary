<?xml version="1.0" encoding="utf-8"?>
<!--
    The room, as Silo's web shows it: the status strip (code, invite link, Leave, End room), the stage (an empty lobby,
    the title up next, or what plays), the host's search for what to put up next, and who is here at the side. When the
    room starts a title the player opens by itself.
-->
<Page
    x:Class="Granary.App.Views.WatchPartyRoomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Granary.App.Views"
    xmlns:wp="using:Granary.Core.ViewModels.WatchParty">

    <Page.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SiloSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SiloBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="EyebrowStyle" TargetType="TextBlock" BasedOn="{StaticResource SiloOverlineTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        </Style>
        <Style x:Key="MutedStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller" XYFocusKeyboardNavigation="Enabled">
        <StackPanel Padding="48,32,48,48" Spacing="20" MaxWidth="1280">
            <!-- The status strip. -->
            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasRoom, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Watch Party" Style="{StaticResource SiloPageTitleTextStyle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
                    <Button Style="{StaticResource SmallButtonStyle}" Click="OnCopyCodeClick" AutomationProperties.Name="Copy room code"
                            ToolTipService.ToolTip="Copy the code">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Code, Mode=OneWay}" FontFamily="Consolas" CharacterSpacing="150" />
                            <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Connecting&#x2026;" Style="{StaticResource MutedStyle}" VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.IsConnecting, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource SmallButtonStyle}" Click="OnCopyLinkClick" AutomationProperties.Name="Copy invite link">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71B;" FontSize="13" />
                            <TextBlock Text="Invite link" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallButtonStyle}" Command="{x:Bind ViewModel.LeaveCommand}" AutomationProperties.Name="Leave room">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE89B;" FontSize="13" />
                            <TextBlock Text="Leave" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallButtonStyle}" Click="OnEndRoomClick" Visibility="{x:Bind ViewModel.IsHost, Mode=OneWay}"
                            AutomationProperties.Name="End room" Foreground="#FFF87171">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                            <TextBlock Text="End room" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource MutedStyle}" Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}" />

            <!-- The room ended, or this profile joined on another device. -->
            <Border Style="{StaticResource PanelStyle}" Visibility="{x:Bind ViewModel.IsEnded, Mode=OneWay}" HorizontalAlignment="Center" MaxWidth="560" Padding="32">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Bind views:WatchPartyRoomPage.EndedTitle(ViewModel.IsReplaced), Mode=OneWay}" FontSize="22"
                               FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.EndedText, Mode=OneWay}" Style="{StaticResource MutedStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Content="Rejoin Watch Party" Style="{StaticResource SiloPrimaryButtonStyle}" Command="{x:Bind ViewModel.RejoinCommand}"
                                Visibility="{x:Bind ViewModel.IsReplaced, Mode=OneWay}" />
                        <Button Content="Back to Watch Party" Style="{StaticResource SiloSecondaryButtonStyle}" Command="{x:Bind ViewModel.LeaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Nothing to show: no room on this device. -->
            <StackPanel Spacing="12" Margin="0,64" HorizontalAlignment="Center" Visibility="{x:Bind views:WatchPartyRoomPage.Unless(ViewModel.HasRoom), Mode=OneWay}">
                <TextBlock Text="You're not in a Watch Party." Style="{StaticResource MutedStyle}" HorizontalAlignment="Center" />
                <Button Content="Back to Watch Party" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.LeaveCommand}" />
            </StackPanel>

            <Grid ColumnSpacing="20" Visibility="{x:Bind views:WatchPartyRoomPage.Live(ViewModel.HasRoom, ViewModel.IsEnded), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="16">
                    <!-- An empty lobby. -->
                    <Border Style="{StaticResource PanelStyle}" BorderBrush="#1AFFFFFF" Padding="24,40" Visibility="{x:Bind ViewModel.IsLobbyEmpty, Mode=OneWay}">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <TextBlock Text="ROOM IS OPEN" Style="{StaticResource EyebrowStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Nothing on yet" FontSize="28" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.LobbyText, Mode=OneWay}" Style="{StaticResource MutedStyle}" MaxWidth="448" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- The title up next, or what plays. -->
                    <Border Style="{StaticResource PanelStyle}" Visibility="{x:Bind views:WatchPartyRoomPage.Either(ViewModel.IsStaged, ViewModel.IsPlaying), Mode=OneWay}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="120" Height="180" CornerRadius="10" Background="#1AFFFFFF">
                                <Image Source="{x:Bind views:WatchPartyRoomPage.Poster(ViewModel.StagedPoster), Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind views:WatchPartyRoomPage.Eyebrow(ViewModel.IsPlaying, ViewModel.StagedEyebrow), Mode=OneWay}"
                                           Style="{StaticResource EyebrowStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.StagedTitle, Mode=OneWay}" FontSize="26" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Text="{x:Bind ViewModel.StagedMeta, Mode=OneWay}" Style="{StaticResource MutedStyle}" />
                                <TextBlock Text="{x:Bind views:WatchPartyRoomPage.Caption(ViewModel.IsPlaying, ViewModel.PlayingCaption, ViewModel.StagedCaption), Mode=OneWay}"
                                           Style="{StaticResource MutedStyle}" />
                                <!-- Up next: the host starts it; guests mark themselves ready. -->
                                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsStaged, Mode=OneWay}">
                                    <Button Style="{StaticResource SiloPrimaryButtonStyle}" Command="{x:Bind ViewModel.StartCommand}" Visibility="{x:Bind ViewModel.IsHost, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.StartLabel, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SiloPrimaryButtonStyle}" Command="{x:Bind ViewModel.ToggleReadyCommand}"
                                            Visibility="{x:Bind ViewModel.CanMarkReady, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE73E;" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.ReadyLabel, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <!-- Playing: back in, or the host stops it for everyone. -->
                                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsPlaying, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Style="{StaticResource SiloPrimaryButtonStyle}" Command="{x:Bind ViewModel.RejoinPlaybackCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE768;" FontSize="13" />
                                                <TextBlock Text="Rejoin playback" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SiloSecondaryButtonStyle}" Command="{x:Bind ViewModel.StopCommand}" Visibility="{x:Bind ViewModel.CanStop, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE71A;" FontSize="12" />
                                                <TextBlock Text="Stop for everyone" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.StopHint, Mode=OneWay}" Style="{StaticResource MutedStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- The invite bar: the code to share, and who controls playback. -->
                    <Border Style="{StaticResource PanelStyle}" Padding="16,12" Visibility="{x:Bind ViewModel.ShowsPicker, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Share the code to let people in." Style="{StaticResource MutedStyle}" FontSize="13" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" MinWidth="0" IsOn="{x:Bind ViewModel.GuestsCanPause, Mode=OneWay}" Toggled="OnPolicyToggled"
                                          OnContent="Guests can pause" OffContent="Host controls playback" AutomationProperties.Name="Guests can pause" />
                        </Grid>
                    </Border>

                    <!-- The host's search for what to put up next. -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowsPicker, Mode=OneWay}">
                        <TextBlock Text="PICK SOMETHING" Style="{StaticResource EyebrowStyle}" />
                        <Grid>
                            <TextBox Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search movies and shows"
                                     AutomationProperties.Name="Search titles to watch" MinHeight="40" Padding="36,9,8,8" CornerRadius="8" />
                            <FontIcon Glyph="&#xE721;" FontSize="14" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Foreground="{StaticResource SiloMutedBrush}" IsHitTestVisible="False" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.SearchState, Mode=OneWay}" Style="{StaticResource MutedStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Picks}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="wp:WatchPartyPick">
                                    <Grid ColumnSpacing="12" Padding="8" CornerRadius="10" Background="#0AFFFFFF">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="54" CornerRadius="5" Background="#1AFFFFFF">
                                            <Image Source="{x:Bind views:WatchPartyRoomPage.Poster(PosterUrl)}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Meta}" FontSize="12" Foreground="{StaticResource SiloMutedBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Queue this" Style="{StaticResource SmallButtonStyle}" VerticalAlignment="Center"
                                                Click="OnQueueClick" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind views:WatchPartyRoomPage.QueueName(Title)}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>

                <!-- Who is here. -->
                <Border Grid.Column="1" Style="{StaticResource PanelStyle}" VerticalAlignment="Top" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.MembersHeading, Mode=OneWay}" Style="{StaticResource EyebrowStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Members}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="10" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="wp:WatchPartyMemberRow">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource SiloSurfaceRaisedBrush}">
                                            <TextBlock Text="{x:Bind Initial}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Name}" FontSize="14" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                <FontIcon Glyph="&#xE734;" FontSize="11" Foreground="#FFFBBF24" Visibility="{x:Bind IsHost}"
                                                          AutomationProperties.Name="Host" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Status}" FontSize="12" Foreground="{StaticResource SiloMutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
