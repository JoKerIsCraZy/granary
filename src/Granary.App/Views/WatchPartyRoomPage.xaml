<?xml version="1.0" encoding="utf-8"?>
<!--
    The room, as Silo's web shows it (WatchTogetherRoomPage.tsx): the status strip (live state and count, the code, the
    invite link, how the room picks, the connection, Leave and End room); the stage, which changes with the room (a
    candidate from the shelf, what plays, the vote, the title up next, the open lobby), with the suggestions and the
    invite row under it; the browse shelf; and People and Activity at the side.
-->
<Page
    x:Class="Granary.App.Views.WatchPartyRoomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Granary.App.Views"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:wp="using:Granary.Core.ViewModels.WatchParty"
    xmlns:settings="using:Granary.Core.ViewModels.Settings">

    <Page.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SiloSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SiloBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="EyebrowStyle" TargetType="TextBlock" BasedOn="{StaticResource SiloOverlineTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
        </Style>
        <Style x:Key="MutedStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SmallMutedStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedStyle}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <!-- A shelf card: the poster with who it is about (two badges and "+n"), a series' pill, the room's progress. -->
        <DataTemplate x:Key="WatchPartyCardTemplate" x:DataType="wp:WatchPartyShelfCard">
            <Button Width="112" Padding="0" Background="Transparent" BorderThickness="0" Click="OnCardClick" Tag="{x:Bind}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                    AutomationProperties.Name="{x:Bind Title}" AutomationProperties.HelpText="{x:Bind MemberNames}"
                    ToolTipService.ToolTip="{x:Bind views:WatchPartyRoomPage.Tip(MemberNames)}">
                <StackPanel Spacing="6">
                    <Grid Width="112" Height="168" CornerRadius="8" Background="{StaticResource SiloSurfaceRaisedBrush}"
                          BorderBrush="{x:Bind views:WatchPartyRoomPage.Ring(IsSelected), Mode=OneWay}" BorderThickness="2">
                        <Image Source="{x:Bind views:WatchPartyRoomPage.Poster(PosterUrl)}" Stretch="UniformToFill" />
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="2" CornerRadius="12" Background="#FF121214"
                                BorderBrush="#33FFFFFF" BorderThickness="1" Visibility="{x:Bind HasBadges}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ItemsRepeater ItemsSource="{x:Bind Badges}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="2" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="wp:WatchPartyBadge">
                                            <Border Width="20" Height="20" CornerRadius="10" Background="{x:Bind views:WatchPartyRoomPage.SolidTint(Tint)}"
                                                    ToolTipService.ToolTip="{x:Bind Name}">
                                                <TextBlock Text="{x:Bind Initials}" FontSize="8" FontWeight="SemiBold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock Text="{x:Bind MoreText}" FontSize="11" FontWeight="SemiBold" Foreground="White" Margin="2,0,4,0"
                                           VerticalAlignment="Center" Visibility="{x:Bind HasMoreMembers}" />
                            </StackPanel>
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6,6,6,8" Padding="6,1" CornerRadius="8" Background="#99000000"
                                BorderBrush="#26FFFFFF" BorderThickness="1" Visibility="{x:Bind IsSeries}">
                            <TextBlock Text="Series &#x203A;" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <ProgressBar VerticalAlignment="Bottom" Value="{x:Bind ProgressPercent}" Maximum="100" Visibility="{x:Bind HasProgress}" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Caption}" FontSize="11" Foreground="{StaticResource SiloMutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The status strip: "● Live · 1 here", the code, the invite link, how the room picks; the connection, Leave, End room. -->
        <Border BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="0,0,0,1" Padding="24,10" Visibility="{x:Bind ViewModel.HasRoom, Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#FF34D399" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.PhaseLabel, Mode=OneWay}" FontSize="14" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium"
                               VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Style="{StaticResource PillButtonStyle}" Click="OnCopyCodeClick" AutomationProperties.Name="{x:Bind views:WatchPartyRoomPage.CopyCodeName(ViewModel.Code), Mode=OneWay}"
                            ToolTipService.ToolTip="Copy the code">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.Code, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" CharacterSpacing="200" />
                            <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{StaticResource SiloMutedBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PillButtonStyle}" Click="OnCopyLinkClick" AutomationProperties.Name="Copy invite link"
                            Visibility="{x:Bind ViewModel.HasInviteLink, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71B;" FontSize="11" />
                            <TextBlock Text="Invite link" />
                        </StackPanel>
                    </Button>
                    <DropDownButton CornerRadius="14" Padding="12,3" MinHeight="28" FontSize="12" Visibility="{x:Bind ViewModel.CanSwitchMode, Mode=OneWay}"
                                    AutomationProperties.Name="Change how the room picks">
                        <TextBlock Text="{x:Bind views:WatchPartyRoomPage.ModeMenuLabel(ViewModel.ModeLabel), Mode=OneWay}" />
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Text="Host picks" Command="{x:Bind ViewModel.SwitchModeCommand}" CommandParameter="host_pick"
                                                IsEnabled="{x:Bind ViewModel.IsVote, Mode=OneWay}" />
                                <MenuFlyoutItem Text="Everyone votes" Command="{x:Bind ViewModel.SwitchModeCommand}" CommandParameter="vote"
                                                IsEnabled="{x:Bind views:WatchPartyRoomPage.Not(ViewModel.IsVote), Mode=OneWay}" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Border Style="{StaticResource SiloChipStyle}" Padding="12,4" Visibility="{x:Bind ViewModel.ShowsModeLabel, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.ModeLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SiloMutedBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Ellipse Width="8" Height="8" Fill="{x:Bind views:WatchPartyRoomPage.ConnectionDot(ViewModel.IsLive), Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ConnectionLabel, Mode=OneWay}" Style="{StaticResource SmallMutedStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource SmallButtonStyle}" Command="{x:Bind ViewModel.LeaveCommand}" AutomationProperties.Name="Leave room">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE89B;" FontSize="12" />
                            <TextBlock Text="Leave" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallButtonStyle}" Click="OnEndRoomClick" Visibility="{x:Bind ViewModel.IsHost, Mode=OneWay}"
                            AutomationProperties.Name="End room" Background="#FFDC2626" Foreground="White" BorderBrush="#FFDC2626">
                        <TextBlock Text="End room" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="Scroller" XYFocusKeyboardNavigation="Enabled">
                <StackPanel Padding="24,20,24,40" Spacing="20" MaxWidth="1180">
                    <!-- A copy, a suggestion that went in, or what failed; it goes after a few seconds, as the web's toasts. -->
                    <Border Style="{StaticResource PanelStyle}" Padding="14,10" Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </Border>

                    <!-- The room ended, or this profile joined on another device. -->
                    <Border Style="{StaticResource PanelStyle}" Visibility="{x:Bind ViewModel.IsEnded, Mode=OneWay}" HorizontalAlignment="Center" MaxWidth="560" Padding="32" Margin="0,48,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind views:WatchPartyRoomPage.EndedTitle(ViewModel.IsReplaced), Mode=OneWay}" FontSize="22"
                                       FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.EndedText, Mode=OneWay}" Style="{StaticResource MutedStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Button Content="Rejoin Watch Party" Style="{StaticResource SiloPrimaryButtonStyle}" Command="{x:Bind ViewModel.RejoinCommand}"
                                        Visibility="{x:Bind ViewModel.IsReplaced, Mode=OneWay}" />
                                <Button Content="Back to Watch Party" Style="{StaticResource SiloSecondaryButtonStyle}" Command="{x:Bind ViewModel.LeaveCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- No room on this device. -->
                    <StackPanel Spacing="12" Margin="0,64" HorizontalAlignment="Center" Visibility="{x:Bind views:WatchPartyRoomPage.Unless(ViewModel.HasRoom), Mode=OneWay}">
                        <TextBlock Text="You're not in a Watch Party." Style="{StaticResource MutedStyle}" HorizontalAlignment="Center" />
                        <Button Content="Back to Watch Party" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.LeaveCommand}" />
                    </StackPanel>

                    <StackPanel Spacing="20" Visibility="{x:Bind views:WatchPartyRoomPage.Live(ViewModel.HasRoom, ViewModel.IsEnded), Mode=OneWay}">
                        <!-- A card from the shelf, previewed on the stage. -->
                        <Border Style="{StaticResource PanelStyle}" Visibility="{x:Bind ViewModel.HasCandidate, Mode=OneWay}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="112" Height="168" CornerRadius="8" Background="{StaticResource SiloSurfaceRaisedBrush}" VerticalAlignment="Top">
                                    <Image Source="{x:Bind views:WatchPartyRoomPage.Poster(ViewModel.Candidate.Poster), Mode=OneWay}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <Grid>
                                        <TextBlock Text="{x:Bind ViewModel.Candidate.Headline, Mode=OneWay}" FontSize="22" FontFamily="{StaticResource SiloFontSemiBold}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,40,0" AutomationProperties.HeadingLevel="Level2" />
                                        <Button Style="{StaticResource SiloIconButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Command="{x:Bind ViewModel.Candidate.DismissCommand}" AutomationProperties.Name="Close" ToolTipService.ToolTip="Close">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{x:Bind ViewModel.Candidate.Meta, Mode=OneWay}" Style="{StaticResource MutedStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.Candidate.Overview, Mode=OneWay}" Style="{StaticResource MutedStyle}" MaxLines="3" TextTrimming="WordEllipsis" />
                                    <!-- A movie: who in the room has seen it. -->
                                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Candidate.IsMovie, Mode=OneWay}">
                                        <Grid>
                                            <TextBlock Text="WHO'S SEEN IT" Style="{StaticResource EyebrowStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.Candidate.SeenSummary, Mode=OneWay}" Style="{StaticResource SmallMutedStyle}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Candidate.Seen}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="6" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="wp:WatchPartySeenRow">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="24" Height="24" CornerRadius="12" Background="{x:Bind views:WatchPartyRoomPage.TintBackground(Tint)}">
                                                            <TextBlock Text="{x:Bind Initials}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind views:WatchPartyRoomPage.TintForeground(Tint)}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE8A4;" FontSize="11" Foreground="{StaticResource SiloMutedBrush}" Visibility="{x:Bind OnWatchlist}"
                                                                      AutomationProperties.Name="On their watchlist" />
                                                            <TextBlock Text="{x:Bind State}" Style="{StaticResource SmallMutedStyle}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                    <!-- A series: a season, then an episode. -->
                                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Candidate.IsSeries, Mode=OneWay}">
                                        <ComboBox ItemsSource="{x:Bind ViewModel.Candidate.Seasons}" SelectedItem="{x:Bind ViewModel.Candidate.SelectedSeason, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" MinWidth="180" AutomationProperties.Name="Season" />
                                        <ListView ItemsSource="{x:Bind ViewModel.Candidate.Episodes}" SelectedItem="{x:Bind ViewModel.Candidate.SelectedEpisode, Mode=TwoWay}"
                                                  SelectionMode="Single" MaxHeight="260" AutomationProperties.Name="Episodes">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="wp:WatchPartyEpisodeRow">
                                                    <TextBlock Text="{x:Bind Label}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock Text="{x:Bind ViewModel.Candidate.PickedText, Mode=OneWay}" Style="{StaticResource SmallMutedStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                        <Button Style="{StaticResource SiloPrimaryButtonStyle}" Command="{x:Bind ViewModel.Candidate.ConfirmCommand}">
                                            <TextBlock Text="{x:Bind ViewModel.Candidate.ConfirmLabel, Mode=OneWay}" />
                                        </Button>
                                        <TextBlock Text="{x:Bind ViewModel.Candidate.Replaces, Mode=OneWay}" Style="{StaticResource SmallMutedStyle}" VerticalAlignment="Center"
                                                   Visibility="{x:Bind ViewModel.Candidate.HasReplaces, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- The hero: what plays, what is up next, or the vote's leader. -->
                        <Border Style="{StaticResource PanelStyle}" Padding="0" Visibility="{x:Bind ViewModel.ShowsHero, Mode=OneWay}">
                            <Grid>
                                <!-- A brush, not an Image: the backdrop fills the hero without setting its height, which the poster sets, as
                                     the web's StagedHero draws it behind (absolute inset-0). -->
                                <Grid.Background>
                                    <ImageBrush ImageSource="{x:Bind views:WatchPartyRoomPage.Backdrop(ViewModel.HeroBackdrop), Mode=OneWay}" Stretch="UniformToFill" Opacity="0.22" />
                                </Grid.Background>
                                <Grid Padding="24" ColumnSpacing="22">
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#F00B0B0E" Offset="0" />
                                            <GradientStop Color="#C00B0B0E" Offset="0.6" />
                                            <GradientStop Color="#000B0B0E" Offset="1" />
                                        </LinearGradientBrush>
                                    </Grid.Background>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="112" Height="168" CornerRadius="8" Background="{StaticResource SiloSurfaceRaisedBrush}">
                                        <Image Source="{x:Bind views:WatchPartyRoomPage.Poster(ViewModel.HeroPoster), Mode=OneWay}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.HeroEyebrow, Mode=OneWay}" Style="{StaticResource SiloOverlineTextStyle}"
                                                   Foreground="{x:Bind views:WatchPartyRoomPage.ToneBrush(ViewModel.HeroTone), Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.HeroHeadline, Mode=OneWay}" FontSize="24" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                                        <TextBlock Text="{x:Bind ViewModel.HeroLine, Mode=OneWay}" Style="{StaticResource MutedStyle}" />
                                        <!-- Playing: back in, or the host stops it for everyone. -->
                                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ShowsPlaying, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Style="{StaticResource SiloPrimaryButtonStyle}" Command="{x:Bind ViewModel.RejoinPlaybackCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                        <TextBlock Text="Rejoin playback" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource SiloSecondaryButtonStyle}" Command="{x:Bind ViewModel.StopCommand}" Visibility="{x:Bind ViewModel.CanStop, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE71A;" FontSize="11" />
                                                        <TextBlock Text="Stop for everyone" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.StopHint, Mode=OneWay}" Style="{StaticResource MutedStyle}" />
                                        </StackPanel>
                                        <!-- The vote: the host plays the leader for everyone. -->
                                        <Button Style="{StaticResource SiloPrimaryButtonStyle}" Command="{x:Bind ViewModel.PlayLeaderCommand}" HorizontalAlignment="Left"
                                                Visibility="{x:Bind views:WatchPartyRoomPage.Both(ViewModel.ShowsVoting, ViewModel.IsHost), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                <TextBlock Text="{x:Bind ViewModel.PlayLeaderLabel, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                        <!-- Up next: the host starts it or changes it; guests mark themselves ready. -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.ShowsStaged, Mode=OneWay}">
                                            <Button Style="{StaticResource SiloPrimaryButtonStyle}" Command="{x:Bind ViewModel.StartCommand}" Visibility="{x:Bind ViewModel.IsHost, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                    <TextBlock Text="{x:Bind ViewModel.StartLabel, Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Content="Change" Style="{StaticResource SiloSecondaryButtonStyle}" Command="{x:Bind ViewModel.ChangeCommand}"
                                                    Visibility="{x:Bind ViewModel.IsHost, Mode=OneWay}" />
                                            <Button Style="{StaticResource SiloPrimaryButtonStyle}" Command="{x:Bind ViewModel.ToggleReadyCommand}"
                                                    Visibility="{x:Bind ViewModel.CanMarkReady, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="12" />
                                                    <TextBlock Text="{x:Bind ViewModel.ReadyLabel, Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Voting, with nothing suggested yet. -->
                        <Border Style="{StaticResource PanelStyle}" Padding="24,36" Visibility="{x:Bind ViewModel.ShowsVotingEmpty, Mode=OneWay}">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <TextBlock Text="VOTING IS OPEN" Style="{StaticResource EyebrowStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="No suggestions yet" FontSize="20" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.VotingEmptyText, Mode=OneWay}" Style="{StaticResource MutedStyle}" MaxWidth="400" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- The open lobby. -->
                        <Border Style="{StaticResource PanelStyle}" BorderBrush="#33FFFFFF" Padding="24,40" Visibility="{x:Bind ViewModel.ShowsEmptyLobby, Mode=OneWay}">
                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <TextBlock Text="ROOM IS OPEN" Style="{StaticResource EyebrowStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Nothing on yet" FontSize="28" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.LobbyText, Mode=OneWay}" Style="{StaticResource MutedStyle}" MaxWidth="448" TextAlignment="Center" />
                                <Button Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                        Command="{x:Bind ViewModel.OpenVotingCommand}" Visibility="{x:Bind ViewModel.IsHost, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8FB;" FontSize="13" />
                                        <TextBlock Text="Open the floor to votes" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- The suggestions: ranked by votes, the guests' ideas in a host-pick lobby, or what comes after. -->
                        <Border Style="{StaticResource PanelStyle}" Padding="14,14" Visibility="{x:Bind ViewModel.ShowsSuggestions, Mode=OneWay}">
                            <StackPanel Spacing="8">
                                <Grid Padding="6,0">
                                    <TextBlock Text="{x:Bind views:WatchPartyRoomPage.Upper(ViewModel.SuggestionsHeading), Mode=OneWay}" Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SuggestionsHint, Mode=OneWay}" Style="{StaticResource SmallMutedStyle}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.SuggestionsEmptyText, Mode=OneWay}" Style="{StaticResource MutedStyle}" HorizontalAlignment="Center" Margin="0,16"
                                           Visibility="{x:Bind ViewModel.HasNoSuggestions, Mode=OneWay}" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.SuggestionRows}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="2" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="wp:WatchPartySuggestionRow">
                                            <Grid ColumnSpacing="12" Padding="6,6" CornerRadius="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Width="28" Height="28" Padding="0" CornerRadius="14" Click="OnVoteClick" Tag="{x:Bind}" Visibility="{x:Bind ShowsVotes, Mode=OneWay}"
                                                        Background="{x:Bind views:WatchPartyRoomPage.VoteBackground(VotedByMe), Mode=OneWay}" BorderBrush="{x:Bind views:WatchPartyRoomPage.VoteBorder(VotedByMe), Mode=OneWay}"
                                                        AutomationProperties.Name="{x:Bind VoteName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind VoteName, Mode=OneWay}">
                                                    <TextBlock Text="&#x2713;" FontSize="12" Foreground="White" Opacity="{x:Bind views:WatchPartyRoomPage.Shown(VotedByMe), Mode=OneWay}" />
                                                </Button>
                                                <Border Grid.Column="1" Width="32" Height="48" CornerRadius="4" Background="{StaticResource SiloSurfaceRaisedBrush}">
                                                    <Image Source="{x:Bind views:WatchPartyRoomPage.SmallPoster(PosterUrl), Mode=OneWay}" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource SmallMutedStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                                                        <Border Padding="6,1" CornerRadius="8" Background="#26FBBF24" Visibility="{x:Bind IsLeading, Mode=OneWay}" VerticalAlignment="Center">
                                                            <TextBlock Text="LEADING" FontSize="10" FontWeight="SemiBold" Foreground="#FFFCD34D" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind By, Mode=OneWay}" Style="{StaticResource SmallMutedStyle}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Visibility="{x:Bind ShowsVotes, Mode=OneWay}">
                                                    <ProgressBar Width="120" Value="{x:Bind SharePercent, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                    <TextBlock Text="{x:Bind VotesText, Mode=OneWay}" Style="{StaticResource SmallMutedStyle}" Width="56" TextAlignment="Right" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SmallButtonStyle}" Click="OnPromoteClick" Tag="{x:Bind}" Visibility="{x:Bind CanPromote, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE768;" FontSize="10" />
                                                            <TextBlock Text="{x:Bind PromoteLabel, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource SiloIconButtonStyle}" Click="OnDeleteSuggestionClick" Tag="{x:Bind}" Visibility="{x:Bind CanDelete, Mode=OneWay}"
                                                            AutomationProperties.Name="{x:Bind DeleteName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind DeleteName, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>

                        <!-- The invite row: the link, Link and Code, and the guests' pause switch. -->
                        <Border Style="{StaticResource PanelStyle}" Padding="16,10" Visibility="{x:Bind ViewModel.ShowsInvite, Mode=OneWay}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="INVITE" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{StaticResource SiloSurfaceRaisedBrush}" CornerRadius="6" Padding="10,6"
                                        Visibility="{x:Bind ViewModel.HasInviteLink, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.InviteText, Mode=OneWay}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource SiloMutedBrush}"
                                               TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Share the code to let people in." Style="{StaticResource SmallMutedStyle}" VerticalAlignment="Center"
                                           Visibility="{x:Bind views:WatchPartyRoomPage.Unless(ViewModel.HasInviteLink), Mode=OneWay}" />
                                <Button Grid.Column="2" Style="{StaticResource SmallButtonStyle}" Click="OnCopyLinkClick" Visibility="{x:Bind ViewModel.HasInviteLink, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE71B;" FontSize="11" />
                                        <TextBlock Text="Link" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource SmallButtonStyle}" Click="OnCopyCodeClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                        <TextBlock Text="Code" />
                                    </StackPanel>
                                </Button>
                                <ToggleSwitch Grid.Column="4" MinWidth="0" IsOn="{x:Bind ViewModel.GuestsCanPause, Mode=OneWay}" Toggled="OnPolicyToggled"
                                              OnContent="Guests can pause" OffContent="Guests can pause" AutomationProperties.Name="Guests can pause"
                                              Visibility="{x:Bind ViewModel.IsHost, Mode=OneWay}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.PolicyText, Mode=OneWay}" Style="{StaticResource SmallMutedStyle}" VerticalAlignment="Center"
                                           Visibility="{x:Bind ViewModel.IsGuest, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <!-- The shelf, folded to one line where the stage leads. -->
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,12" Style="{StaticResource SiloSecondaryButtonStyle}"
                                Command="{x:Bind ViewModel.Shelf.OpenCommand}" Visibility="{x:Bind ViewModel.Shelf.IsFolded, Mode=OneWay}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{StaticResource SiloMutedBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind ViewModel.Shelf.FoldedLabel, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.Shelf.FoldedHint, Mode=OneWay}" Style="{StaticResource SmallMutedStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="12" Foreground="{StaticResource SiloMutedBrush}" />
                            </Grid>
                        </Button>
                        <StackPanel Spacing="18" Visibility="{x:Bind ViewModel.Shelf.IsExpanded, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ViewModel.Shelf.ShelfName, Mode=OneWay}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="220" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox Text="{x:Bind ViewModel.Shelf.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search movies, series, episodes&#x2026;"
                                             AutomationProperties.Name="Search movies and series" MinHeight="40" Padding="36,9,8,8" CornerRadius="8" />
                                    <FontIcon Glyph="&#xE721;" FontSize="14" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Foreground="{StaticResource SiloMutedBrush}" IsHitTestVisible="False" />
                                </Grid>
                                <controls:PillChoices Grid.Column="1" ItemsSource="{x:Bind ViewModel.Shelf.Chips}" SelectedItem="{x:Bind ViewModel.Shelf.SelectedChip, Mode=TwoWay}"
                                                      VerticalAlignment="Center" AutomationProperties.Name="Filter" />
                                <Button Grid.Column="2" Style="{StaticResource SiloIconButtonStyle}" Command="{x:Bind ViewModel.Shelf.FoldCommand}"
                                        Visibility="{x:Bind ViewModel.Shelf.IsCollapsible, Mode=OneWay}" AutomationProperties.Name="Hide browse" ToolTipService.ToolTip="Hide browse">
                                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                </Button>
                            </Grid>

                            <!-- Search results: scanned, not flicked through. -->
                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.Shelf.IsSearching, Mode=OneWay}">
                                <TextBlock Text="{x:Bind views:WatchPartyRoomPage.Upper(ViewModel.Shelf.ResultsHeading), Mode=OneWay}" Style="{StaticResource EyebrowStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind ViewModel.Shelf.HasSearchState, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.Shelf.SearchState, Mode=OneWay}" Style="{StaticResource MutedStyle}" VerticalAlignment="Center" />
                                    <Button Content="Retry" Style="{StaticResource SmallButtonStyle}" Command="{x:Bind ViewModel.Shelf.RetrySearchCommand}"
                                            Visibility="{x:Bind ViewModel.Shelf.SearchFailed, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Shelf.NoResultsText, Mode=OneWay}" Style="{StaticResource MutedStyle}"
                                           Visibility="{x:Bind ViewModel.Shelf.HasNoResults, Mode=OneWay}" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Shelf.Results}" ItemTemplate="{StaticResource WatchPartyCardTemplate}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="112" MinColumnSpacing="14" MinRowSpacing="16" ItemsStretch="None" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>

                            <!-- The rows the room has in common. -->
                            <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.Shelf.IsBrowsing, Mode=OneWay}">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Shelf.Rows}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="22" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="wp:WatchPartyShelfRow">
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind views:WatchPartyRoomPage.Upper(Title)}" Style="{StaticResource SiloOverlineTextStyle}" />
                                                    <TextBlock Text="{x:Bind views:WatchPartyRoomPage.Hint(Hint)}" FontSize="11" Foreground="{StaticResource SiloMutedBrush}"
                                                               VerticalAlignment="Center" Visibility="{x:Bind HasHint}" />
                                                </StackPanel>
                                                <ScrollView ContentOrientation="Horizontal" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                                            VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden" controls:WheelScrollsPage.IsEnabled="True">
                                                    <ItemsRepeater ItemsSource="{x:Bind Cards}" ItemTemplate="{StaticResource WatchPartyCardTemplate}" Margin="0,4,0,12">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout Orientation="Horizontal" Spacing="14" />
                                                        </ItemsRepeater.Layout>
                                                    </ItemsRepeater>
                                                </ScrollView>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock Text="{x:Bind ViewModel.Shelf.EmptyText, Mode=OneWay}" Style="{StaticResource MutedStyle}" HorizontalAlignment="Center" Margin="0,24"
                                           Visibility="{x:Bind ViewModel.Shelf.HasEmptyText, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- People and Activity. -->
            <Border Grid.Column="1" Width="320" BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="1,0,0,0"
                    Visibility="{x:Bind views:WatchPartyRoomPage.Live(ViewModel.HasRoom, ViewModel.IsEnded), Mode=OneWay}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="4" Padding="12,6,12,0" BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="0,0,0,1">
                        <RadioButton x:Name="PeopleTab" GroupName="RailTabs" Style="{StaticResource SiloLineTabStyle}" IsChecked="True" Checked="OnRailTabChecked"
                                     AutomationProperties.Name="People">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="People" />
                                <Border Padding="6,0" CornerRadius="8" Background="{StaticResource SiloSurfaceRaisedBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.PeopleCount, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ActivityTab" GroupName="RailTabs" Content="Activity" Style="{StaticResource SiloLineTabStyle}" Checked="OnRailTabChecked" />
                    </StackPanel>

                    <ScrollViewer x:Name="PeoplePanel" Grid.Row="1">
                        <StackPanel Padding="0,6">
                            <TextBlock Text="No one here yet. Share the invite to fill the room." Style="{StaticResource MutedStyle}" TextAlignment="Center" Margin="16,24"
                                       Visibility="{x:Bind ViewModel.HasNoMembers, Mode=OneWay}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Members}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="wp:WatchPartyMemberRow">
                                        <Grid ColumnSpacing="12" Padding="16,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="16" Background="{x:Bind views:WatchPartyRoomPage.TintBackground(Tint)}">
                                                <TextBlock Text="{x:Bind Initials}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind views:WatchPartyRoomPage.TintForeground(Tint)}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="14" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                    <Border Padding="6,1" CornerRadius="8" BorderBrush="#1AFFFFFF" BorderThickness="1" Visibility="{x:Bind IsHost}" VerticalAlignment="Center">
                                                        <TextBlock Text="HOST" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SiloMutedBrush}" />
                                                    </Border>
                                                    <TextBlock Text="(you)" FontSize="12" Foreground="{StaticResource SiloMutedBrush}" Visibility="{x:Bind IsSelf}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#FF34D399" Visibility="{x:Bind ShowsReadyTick}" />
                                                    <TextBlock Text="{x:Bind State}" FontSize="12" Foreground="{StaticResource SiloMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind views:WatchPartyRoomPage.MemberDot(IsWaiting)}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ActivityPanel" Grid.Row="1" Visibility="Collapsed">
                        <StackPanel Padding="16,12" Spacing="12">
                            <TextBlock Text="Things people do in the room show up here." Style="{StaticResource MutedStyle}" TextAlignment="Center" Margin="0,12"
                                       Visibility="{x:Bind ViewModel.HasNoActivity, Mode=OneWay}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.ActivityRows}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="wp:WatchPartyActivityRow">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Time, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SiloMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Text, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                        <TextBlock Text="{x:Bind ViewModel.RailFooter, Mode=OneWay}" Style="{StaticResource SmallMutedStyle}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
