<?xml version="1.0" encoding="utf-8"?>
<!--
    Admin → Users, as the web's (pages/AdminUsers.tsx; docs/ui-design.md, Admin): every account in a table that searches,
    filters by group, sorts by its headings and shows a page at a time; the header's signups badge, Access Groups and Add
    User; an account's Edit and Delete. Its Invitations tab is AdminInvitationsView, its Invite Codes tab
    AdminInviteCodesView.
-->
<UserControl
    x:Class="Granary.App.Views.Admin.AdminUsersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Granary.App.Views.Admin"
    xmlns:admin="using:Granary.Core.ViewModels.Admin"
    xmlns:t="using:Granary.Core.Texts"
    AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.list.title')}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Themes/AdminForms.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <StackPanel Spacing="24">
            <!--
                The web's PageHeader: title and subtitle; on the right (gap-2) the "Public signups on →" badge linking to the
                web's sign-in settings, Access Groups (outline, size sm) leading to the web's page, and + Add User (size sm).
            -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.title')}" Style="{StaticResource SiloSettingsPageTitleStyle}"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.subtitle')}" Style="{StaticResource SiloSettingsMutedTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <HyperlinkButton Padding="0" VerticalAlignment="Center" Click="OnSignupsClick" Visibility="{x:Bind ViewModel.SignupsKnown, Mode=OneWay}"
                                     AutomationProperties.Name="{x:Bind SignupsText(ViewModel.SignupsOn), Mode=OneWay}">
                        <Grid>
                            <!-- On: the web's outline badge in emerald. -->
                            <Border Style="{StaticResource AdminPillStyle}" Background="{StaticResource AdminEmeraldFillBrush}" BorderBrush="{StaticResource AdminEmeraldBorderBrush}"
                                    Visibility="{x:Bind ViewModel.SignupsOn, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.signupsOn')}" Style="{StaticResource AdminPillTextStyle}"
                                               Foreground="{StaticResource AdminEmeraldBrush}" />
                                    <FontIcon Glyph="&#xE72A;" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource AdminEmeraldBrush}" />
                                </StackPanel>
                            </Border>
                            <!-- Off: its secondary badge. -->
                            <Border Style="{StaticResource AdminPillStyle}" Background="{StaticResource AdminAccentBrush}" BorderBrush="{StaticResource AdminAccentBrush}"
                                    Visibility="{x:Bind local:AdminUsersView.Hidden(ViewModel.SignupsOn), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.signupsOff')}" Style="{StaticResource AdminPillTextStyle}"
                                               Foreground="{StaticResource AdminSecondaryForegroundBrush}" />
                                    <FontIcon Glyph="&#xE72A;" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource AdminSecondaryForegroundBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </HyperlinkButton>
                    <Button Style="{StaticResource AdminSmallOutlineButtonStyle}" Click="OnAccessGroupsClick">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE9E9;" FontSize="14" />
                            <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.accessGroupsLink')}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AdminSmallPrimaryButtonStyle}" Click="OnAddUserClick" IsEnabled="{x:Bind ViewModel.IsAvailable, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.addUser')}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ActionError" Style="{StaticResource AdminErrorTextStyle}" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind ViewModel.LoadFailed, Mode=OneWay}">
                <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.loadFailed')}" Style="{StaticResource AdminErrorTextStyle}" VerticalAlignment="Center" />
                <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind ViewModel.LoadCommand}"
                        Content="{x:Bind t:AppText.Get('web.admin.users.list.reload')}" />
            </StackPanel>
            <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.unavailable')}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                       Visibility="{x:Bind local:AdminUsersView.Hidden(ViewModel.IsAvailable), Mode=OneWay}" />

            <!-- The web's line tabs across the page (each trigger flex-1): Users, Invitations, Invite Codes; their content pt-4. -->
            <StackPanel Spacing="16">
                <Grid XYFocusKeyboardNavigation="Enabled" AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.list.title')}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Background="{StaticResource AdminCardBorderBrush}" />
                    <RadioButton x:Name="UsersTab" GroupName="AdminUsersTabs" Style="{StaticResource AdminLineTabStyle}" HorizontalAlignment="Stretch"
                                 Content="{x:Bind t:AppText.Get('web.admin.users.list.tab.users')}" Checked="OnTabChecked" />
                    <RadioButton x:Name="InvitationsTab" Grid.Column="1" GroupName="AdminUsersTabs" Style="{StaticResource AdminLineTabStyle}"
                                 HorizontalAlignment="Stretch" Content="{x:Bind t:AppText.Get('web.admin.users.list.tab.invitations')}" Checked="OnTabChecked" />
                    <RadioButton x:Name="InviteCodesTab" Grid.Column="2" GroupName="AdminUsersTabs" Style="{StaticResource AdminLineTabStyle}"
                                 HorizontalAlignment="Stretch" Content="{x:Bind t:AppText.Get('web.admin.users.list.tab.inviteCodes')}" Checked="OnTabChecked" />
                </Grid>

            <ContentControl x:Name="InvitationsHost" IsTabStop="False" HorizontalContentAlignment="Stretch" Visibility="Collapsed" />
            <ContentControl x:Name="InviteCodesHost" IsTabStop="False" HorizontalContentAlignment="Stretch" Visibility="Collapsed" />

            <StackPanel x:Name="UsersPanel" Spacing="16">
                <!-- The search and the group filter. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="224" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{x:Bind t:AppText.Get('web.admin.users.list.searchPlaceholder')}"
                             AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.list.searchPlaceholder')}" />
                    <ComboBox Grid.Column="1" Style="{StaticResource SiloSettingsComboBoxStyle}" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.GroupFilters, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.list.groupFilterLabel')}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind ViewModel.GroupsFailed, Mode=OneWay}">
                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.groupsLoadFailed')}" Style="{StaticResource AdminErrorTextStyle}"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind ViewModel.RetryGroupsCommand}"
                            Content="{x:Bind t:AppText.Get('common.retry')}" />
                </StackPanel>

                <ProgressRing IsActive="{x:Bind local:AdminUsersView.IsLoading(ViewModel.State), Mode=OneWay}"
                              Visibility="{x:Bind local:AdminUsersView.LoadingShown(ViewModel.State), Mode=OneWay}" Width="40" Height="40" Margin="0,32" />

                <Border Style="{StaticResource AdminFormCardStyle}" Padding="16,8" Visibility="{x:Bind local:AdminUsersView.Ready(ViewModel.State), Mode=OneWay}">
                    <StackPanel>
                        <!-- The headings sort, as the web's SortableUserHead: the chevron shows the column and its order. -->
                        <Grid ColumnSpacing="12" Padding="0,8" BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource AdminSortHeadingStyle}" Click="OnSortClick" Tag="Username">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.column.username')}" />
                                    <FontIcon x:Name="UsernameChevron" FontSize="10" Glyph="&#xE70D;" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource AdminSortHeadingStyle}" Click="OnSortClick" Tag="Email">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.column.email')}" />
                                    <FontIcon x:Name="EmailChevron" FontSize="10" Glyph="&#xE70D;" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource AdminSortHeadingStyle}" Click="OnSortClick" Tag="Role">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.column.role')}" />
                                    <FontIcon x:Name="RoleChevron" FontSize="10" Glyph="&#xE70D;" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="3" Text="{x:Bind t:AppText.Get('web.admin.users.list.column.group')}" Style="{StaticResource AdminColumnHeadingStyle}" />
                            <Button Grid.Column="4" Style="{StaticResource AdminSortHeadingStyle}" Click="OnSortClick" Tag="Status">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.column.status')}" />
                                    <FontIcon x:Name="StatusChevron" FontSize="10" Glyph="&#xE70D;" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="5" Style="{StaticResource AdminSortHeadingStyle}" Click="OnSortClick" Tag="Created">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.column.created')}" />
                                    <FontIcon x:Name="CreatedChevron" FontSize="10" Glyph="&#xE70D;" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="6" Style="{StaticResource AdminSortHeadingStyle}" Click="OnSortClick" Tag="LastActive">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.column.lastActive')}" />
                                    <FontIcon x:Name="LastActiveChevron" FontSize="10" Glyph="&#xE70D;" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="7" Text="{x:Bind t:AppText.Get('web.admin.users.list.column.actions')}" Style="{StaticResource AdminColumnHeadingStyle}" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" IsTabStop="False"
                                      AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.list.title')}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="admin:AdminAccountRow">
                                    <Grid ColumnSpacing="12" Padding="0,6" BorderBrush="#4D2A2A2F" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <HyperlinkButton Padding="0" Click="OnOpenClick" Tag="{x:Bind Id}" Foreground="{StaticResource SiloForegroundBrush}">
                                            <TextBlock Text="{x:Bind Username}" FontFamily="{StaticResource SiloFontMedium}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        </HyperlinkButton>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Email}" Style="{StaticResource AdminCellStyle}" IsTextSelectionEnabled="True" />
                                        <Border Grid.Column="2" Style="{StaticResource AdminBadgeStyle}" Background="{x:Bind local:AdminUsersView.RoleBackground(IsAdmin)}"
                                                BorderBrush="{x:Bind local:AdminUsersView.RoleBackground(IsAdmin)}">
                                            <TextBlock Text="{x:Bind RoleText}" Style="{StaticResource AdminBadgeTextStyle}"
                                                       Foreground="{x:Bind local:AdminUsersView.RoleForeground(IsAdmin)}" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{x:Bind GroupText}"
                                                   Style="{StaticResource AdminCellStyle}" Foreground="{x:Bind local:AdminUsersView.GroupForeground(HasGroup)}" />
                                        <Border Grid.Column="4" Style="{StaticResource AdminBadgeStyle}"
                                                BorderBrush="{x:Bind local:AdminDashboardView.StatusBorder(IsEnabled)}"
                                                Background="{x:Bind local:AdminDashboardView.StatusBackground(IsEnabled)}">
                                            <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource AdminBadgeTextStyle}" Foreground="{StaticResource SiloForegroundBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="5" Text="{x:Bind CreatedText}" Style="{StaticResource AdminCellStyle}" ToolTipService.ToolTip="{x:Bind CreatedTitle}" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind LastActiveText}" Style="{StaticResource AdminCellStyle}"
                                                   ToolTipService.ToolTip="{x:Bind local:AdminUsersView.TipOrNull(LastActiveTitle)}" />
                                        <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4">
                                            <Button Style="{StaticResource AdminRowIconButtonStyle}" Visibility="{x:Bind CanEdit}" Click="OnOpenClick" Tag="{x:Bind Id}"
                                                    ToolTipService.ToolTip="{x:Bind t:AppText.Get('web.admin.users.list.editTooltip')}" AutomationProperties.Name="{x:Bind EditName}">
                                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource AdminRowIconButtonStyle}" Visibility="{x:Bind CanDelete}" Click="OnDeleteClick" Tag="{x:Bind Id}"
                                                    ToolTipService.ToolTip="{x:Bind t:AppText.Get('web.admin.users.list.deleteTooltip')}" AutomationProperties.Name="{x:Bind DeleteName}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Bind ViewModel.NoMatchesText}" Style="{StaticResource SiloSettingsMutedTextStyle}" HorizontalAlignment="Center" Margin="0,16"
                                   Visibility="{x:Bind ViewModel.HasNoMatches, Mode=OneWay}" />

                        <!-- The pages, when there is more than one: the range, the page size, Previous and Next. -->
                        <Grid ColumnSpacing="12" Padding="0,12,0,4" Visibility="{x:Bind ViewModel.HasPages, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.PageRangeText, Mode=OneWay}" Style="{StaticResource AdminMutedCellStyle}" />
                            <ComboBox x:Name="PageSizeBox" Grid.Column="1" Style="{StaticResource SiloSettingsComboBoxStyle}" MinWidth="110"
                                      AutomationProperties.Name="{x:Bind t:AppText.Get('granary.admin.users.pageSize')}"
                                      SelectionChanged="OnPageSizeChanged" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind ViewModel.PreviousPageCommand}"
                                        Content="{x:Bind t:AppText.Get('web.admin.users.list.previousPage')}" />
                                <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind ViewModel.NextPageCommand}"
                                        Content="{x:Bind t:AppText.Get('web.admin.users.list.nextPage')}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            </StackPanel>
        </StackPanel>

        <!--
            The web's Create User dialog (components/admin/users/CreateUserForm.tsx), sm:max-w-2xl: the title with its X, the
            "Create a default profile" checkbox, the line tabs Account, Access and Limits over a body that scrolls, and one
            full-width Save under a hairline. No Cancel: the X and Esc close it.
        -->
        <ContentDialog x:Name="CreateDialog" Closing="OnCreateClosing">
            <Grid x:Name="CreateForm" Width="622" RowSpacing="0" KeyDown="OnCreateKeyDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- DialogHeader: the title (text-lg semibold) and the X; gap-4 to what follows. -->
                <Grid Margin="0,0,0,16" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.createDialogTitle')}" Style="{StaticResource AdminDialogTitleStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Button Grid.Column="1" Style="{StaticResource AdminDialogCloseButtonStyle}" Margin="0,-8,-8,0" Click="OnCreateCloseClick"
                            AutomationProperties.Name="{x:Bind t:AppText.Get('web.ui.close')}" ToolTipService.ToolTip="{x:Bind t:AppText.Get('web.ui.close')}">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1" Text="{x:Bind NewUser.Error, Mode=OneWay}" Style="{StaticResource AdminErrorTextStyle}" Margin="0,0,0,12"
                           Visibility="{x:Bind local:AdminUsersView.Shown(NewUser.Error), Mode=OneWay}" />

                <!-- The checkbox, mb-3. -->
                <CheckBox Grid.Row="2" Margin="0,0,0,12" MinHeight="0" Padding="8,0,0,0" FontSize="14" IsChecked="{x:Bind NewUser.CreateDefaultProfile, Mode=TwoWay}"
                          Content="{x:Bind NewUser.DefaultProfileText, Mode=OneWay}" />

                <!-- TabsList variant="line": w-full, justify-start, a hairline under it, pb-1, mb-4. -->
                <Grid Grid.Row="3" Margin="0,0,0,16">
                    <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource AdminCardBorderBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="0" XYFocusKeyboardNavigation="Enabled"
                                AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.list.createDialogTitle')}">
                        <RadioButton x:Name="AccountTab" GroupName="CreateUserTabs" Style="{StaticResource AdminDialogTabStyle}" Margin="0,0,8,0"
                                     Content="{x:Bind t:AppText.Get('web.admin.users.list.create.tab.account')}"
                                     IsChecked="{x:Bind local:AdminUsersView.IsTab(NewUser.SelectedTab, 0), Mode=OneWay}" Checked="OnCreateTabChecked" Tag="0" />
                        <RadioButton x:Name="AccessTab" GroupName="CreateUserTabs" Style="{StaticResource AdminDialogTabStyle}" Margin="0,0,8,0"
                                     Content="{x:Bind t:AppText.Get('web.admin.users.list.create.tab.access')}"
                                     IsChecked="{x:Bind local:AdminUsersView.IsTab(NewUser.SelectedTab, 1), Mode=OneWay}" Checked="OnCreateTabChecked" Tag="1" />
                        <RadioButton x:Name="LimitsTab" GroupName="CreateUserTabs" Style="{StaticResource AdminDialogTabStyle}"
                                     Content="{x:Bind t:AppText.Get('web.admin.users.list.create.tab.limits')}"
                                     IsChecked="{x:Bind local:AdminUsersView.IsTab(NewUser.SelectedTab, 2), Mode=OneWay}" Checked="OnCreateTabChecked" Tag="2" />
                    </StackPanel>
                </Grid>

                <!-- The tab's body scrolls (max-h-[70vh] on the form); a fixed height keeps the dialog from jumping between tabs. -->
                <ScrollViewer Grid.Row="4" Height="440" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <Grid>
                        <!-- Account: Username | Email, Password (with the switch under it) | Role; grid gap-3, each field space-y-2. -->
                        <Grid ColumnSpacing="12" RowSpacing="12" VerticalAlignment="Top"
                              Visibility="{x:Bind local:AdminUsersView.TabShown(NewUser.SelectedTab, 0), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.create.username')}" Style="{StaticResource AdminFieldLabelStyle}" />
                                <TextBox Style="{StaticResource AdminTextBoxStyle}" Text="{x:Bind NewUser.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.list.create.username')}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.create.email')}" Style="{StaticResource AdminFieldLabelStyle}" />
                                <TextBox Style="{StaticResource AdminTextBoxStyle}" Text="{x:Bind NewUser.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         InputScope="EmailSmtpAddress" AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.list.create.email')}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="8">
                                <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.create.password')}" Style="{StaticResource AdminFieldLabelStyle}" />
                                <PasswordBox Style="{StaticResource AdminPasswordBoxStyle}" Password="{x:Bind NewUser.Password, Mode=TwoWay}"
                                             AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.list.create.password')}" />
                                <!-- The switch on the left, its text-xs label beside it (gap-2). -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" HorizontalAlignment="Left"
                                                  IsOn="{x:Bind NewUser.RequirePasswordChangeShown, Mode=TwoWay}" IsEnabled="{x:Bind NewUser.CanRequireChange, Mode=OneWay}"
                                                  AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.list.create.requirePasswordChange')}" />
                                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.create.requirePasswordChange')}" FontSize="12" TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                                <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.create.role')}" Style="{StaticResource AdminFieldLabelStyle}" />
                                <ComboBox Style="{StaticResource AdminSelectStyle}" SelectedIndex="{x:Bind NewUser.RoleIndex, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.list.create.role')}">
                                    <ComboBoxItem Content="{x:Bind t:AppText.Get('web.admin.users.list.create.role.user')}" />
                                    <ComboBoxItem Content="{x:Bind t:AppText.Get('web.admin.users.list.create.role.admin')}"
                                                  IsEnabled="{x:Bind NewUser.CanGrantAdmin, Mode=OneWay}" />
                                </ComboBox>
                                <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.create.adminOwnerOnly')}" Style="{StaticResource AdminHintTextStyle}"
                                           Visibility="{x:Bind NewUser.IsAdminLocked, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <!-- Access: the group (w-full), the two permission cards, then the policy's access fields; space-y-4. -->
                        <StackPanel Spacing="16" VerticalAlignment="Top" Visibility="{x:Bind local:AdminUsersView.TabShown(NewUser.SelectedTab, 1), Mode=OneWay}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.create.group')}" Style="{StaticResource AdminFieldLabelStyle}" />
                                <ComboBox Style="{StaticResource AdminFullSelectStyle}" ItemsSource="{x:Bind NewUser.GroupChoices, Mode=OneWay}"
                                          SelectedItem="{x:Bind NewUser.SelectedGroupChoice, Mode=TwoWay}" IsEnabled="{x:Bind NewUser.CanPickGroup, Mode=OneWay}"
                                          AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.list.create.group')}" />
                                <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.create.adminNoGroups')}" Style="{StaticResource AdminHintTextStyle}"
                                           Visibility="{x:Bind NewUser.IsGroupHintShown, Mode=OneWay}" />
                            </StackPanel>
                            <Border Style="{StaticResource AdminFieldCardStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.create.markerEdit')}" Style="{StaticResource AdminFieldLabelStyle}" />
                                        <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.create.markerEditHelp')}" Style="{StaticResource AdminHintTextStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind NewUser.MarkerEdit, Mode=TwoWay}"
                                                  AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.list.create.markerEdit')}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource AdminFieldCardStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.create.metadataCuration')}" Style="{StaticResource AdminFieldLabelStyle}" />
                                        <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.create.metadataCurationHelp')}" Style="{StaticResource AdminHintTextStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind NewUser.MetadataCuration, Mode=TwoWay}"
                                                  AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.list.create.metadataCuration')}" />
                                </Grid>
                            </Border>
                            <local:AdminPolicyFieldsView x:Name="AccessFields" Policy="{x:Bind NewUser.Policy}" />
                        </StackPanel>

                        <!-- Limits: the policy's limit fields. -->
                        <local:AdminPolicyFieldsView x:Name="LimitFields" Policy="{x:Bind NewUser.Policy}" ShowsLimits="True" VerticalAlignment="Top"
                                                     Visibility="{x:Bind local:AdminUsersView.TabShown(NewUser.SelectedTab, 2), Mode=OneWay}" />
                    </Grid>
                </ScrollViewer>

                <!-- A hairline (mt-4 pt-4) and the one full-width Save. -->
                <Border Grid.Row="5" Margin="0,16,0,0" Padding="0,16,0,0" BorderBrush="{StaticResource AdminCardBorderBrush}" BorderThickness="0,1,0,0">
                    <Button Style="{StaticResource AdminPrimaryButtonStyle}" HorizontalAlignment="Stretch" Click="OnCreateSaveClick"
                            Content="{x:Bind NewUser.SaveText, Mode=OneWay}" IsEnabled="{x:Bind local:AdminUsersView.Not(NewUser.IsSaving), Mode=OneWay}" />
                </Border>
            </Grid>
        </ContentDialog>
    </Grid>
</UserControl>
