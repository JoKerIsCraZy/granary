<?xml version="1.0" encoding="utf-8"?>
<!-- A number tile of the dashboard, as the web's StatTile: its label and icon, the value large, a line below it. -->
<UserControl
    x:Class="Granary.App.Views.Admin.AdminStatTileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border MinHeight="96" Padding="16,12" CornerRadius="16" Background="{StaticResource SiloSurfaceBrush}"
            BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" Spacing="6">
            <Grid>
                <TextBlock Text="{x:Bind Tile.Label, Mode=OneWay}" FontFamily="{StaticResource SiloFontMedium}" FontSize="11"
                           Foreground="{StaticResource SiloMutedBrush}" TextTrimming="CharacterEllipsis" />
                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="14" HorizontalAlignment="Right" Foreground="{StaticResource SiloMutedBrush}" />
            </Grid>
            <TextBlock Text="{x:Bind Tile.Value, Mode=OneWay}" Visibility="{x:Bind Tile.IsAvailable, Mode=OneWay}"
                       FontFamily="{StaticResource SiloFontExtraBold}" FontWeight="ExtraBold" FontSize="28" LineHeight="30"
                       Foreground="{StaticResource SiloForegroundBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind Tile.Sub, Mode=OneWay}" Visibility="{x:Bind Tile.IsAvailable, Mode=OneWay}" FontSize="11"
                       Foreground="{StaticResource SiloMutedBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Unavailable" Visibility="{x:Bind Tile.IsUnavailable, Mode=OneWay}" FontSize="14"
                       Foreground="#FFEF4444" />
        </StackPanel>
    </Border>
</UserControl>
