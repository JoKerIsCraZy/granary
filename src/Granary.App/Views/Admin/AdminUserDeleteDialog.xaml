<?xml version="1.0" encoding="utf-8"?>
<!--
    The web's delete dialog (components/AdminUserDeleteDialog.tsx): what goes with the account, Disable instead where the
    page offers it, and the account's name typed before Delete account does anything.
-->
<ContentDialog
    x:Class="Granary.App.Views.Admin.AdminUserDeleteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:admin="using:Granary.Core.ViewModels.Admin"
    xmlns:t="using:Granary.Core.Texts"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    PrimaryButtonText="{x:Bind t:AppText.Get('web.admin.users.deleteDialog.confirm')}"
    SecondaryButtonText="{x:Bind SecondaryText(ViewModel.OffersDisable), Mode=OneWay}"
    CloseButtonText="{x:Bind t:AppText.Get('common.cancel')}"
    DefaultButton="Close"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}"
    IsSecondaryButtonEnabled="{x:Bind ViewModel.CanDisable, Mode=OneWay}"
    PrimaryButtonClick="OnDeleteClick"
    SecondaryButtonClick="OnDisableClick"
    Closing="OnClosing">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Themes/AdminForms.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <StackPanel MinWidth="380" MaxWidth="480" Spacing="14">
        <TextBlock Text="{x:Bind admin:AdminUserDeleteViewModel.Description}" TextWrapping="Wrap" Foreground="{StaticResource SiloMutedBrush}" />
        <Border Visibility="{x:Bind ViewModel.OffersDisable, Mode=OneWay}" Padding="12,10" CornerRadius="12" BorderThickness="1"
                BorderBrush="{StaticResource AdminInfoBorderBrush}" Background="{StaticResource AdminInfoBackgroundBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{StaticResource AdminInfoIconBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock x:Name="DisableHint" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource SiloMutedBrush}" />
            </Grid>
        </Border>
        <StackPanel Spacing="6">
            <TextBlock x:Name="ConfirmLabel" FontFamily="{StaticResource SiloFontMedium}" FontSize="13" TextWrapping="Wrap" />
            <TextBox x:Name="TypedBox" Text="{x:Bind ViewModel.Typed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSpellCheckEnabled="False"
                     AutomationProperties.LabeledBy="{x:Bind ConfirmLabel}" />
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Style="{StaticResource AdminErrorTextStyle}"
                   Visibility="{x:Bind Shown(ViewModel.Error), Mode=OneWay}" />
        <Button Visibility="{x:Bind ViewModel.HasConflict, Mode=OneWay}" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Click="OnReloadClick"
                Content="{x:Bind t:AppText.Get('web.admin.users.deleteDialog.reload')}" />
    </StackPanel>
</ContentDialog>
