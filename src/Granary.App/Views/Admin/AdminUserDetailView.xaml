<?xml version="1.0" encoding="utf-8"?>
<!--
    One account in Admin → Users, as the web's (pages/AdminUserDetail.tsx; docs/ui-design.md, Admin): the header with its
    actions, the Sign-in & role and Library access cards, and the account's signed-in sessions.
-->
<UserControl
    x:Class="Granary.App.Views.Admin.AdminUserDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Granary.App.Views.Admin"
    xmlns:admin="using:Granary.Core.ViewModels.Admin"
    xmlns:settings="using:Granary.Core.ViewModels.Settings"
    xmlns:t="using:Granary.Core.Texts">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Themes/AdminForms.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
            </Style>
            <Style x:Key="RowLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="20">
        <!-- The web's breadcrumb: Users › the account. -->
        <StackPanel Orientation="Horizontal" Spacing="6" AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.detail.header.breadcrumb')}">
            <HyperlinkButton Padding="0" Click="OnUsersClick" Foreground="{StaticResource SiloMutedBrush}"
                             Content="{x:Bind t:AppText.Get('web.admin.users.detail.header.breadcrumbUsers')}" />
            <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="{StaticResource SiloMutedBrush}" />
            <TextBlock Text="{x:Bind local:AdminUserDetailView.NameOf(ViewModel.Header), Mode=OneWay}" FontFamily="{StaticResource SiloFontMedium}" FontSize="13"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <InfoBar IsOpen="{x:Bind local:AdminUserDetailView.HasText(ViewModel.Notice), Mode=OneWay}" Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                 Severity="{x:Bind local:AdminActivityView.NoticeSeverity(ViewModel.NoticeIsError), Mode=OneWay}" IsClosable="False" />
        <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.list.unavailable')}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                   Visibility="{x:Bind local:AdminUserDetailView.Unavailable(ViewModel.Capabilities), Mode=OneWay}" />

        <ProgressRing IsActive="{x:Bind local:AdminUsersView.IsLoading(ViewModel.State), Mode=OneWay}"
                      Visibility="{x:Bind local:AdminUsersView.LoadingShown(ViewModel.State), Mode=OneWay}" Width="40" Height="40" Margin="0,32" />

        <!-- Could not read it, or it is gone. -->
        <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,32" Visibility="{x:Bind local:AdminUserDetailView.Failed(ViewModel.State), Mode=OneWay}">
            <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.page.loadFailedTitle')}" FontFamily="{StaticResource SiloFontSemiBold}" FontSize="18"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.page.loadFailedDescription')}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" />
            <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" HorizontalAlignment="Center" Click="OnRetryClick"
                    Content="{x:Bind t:AppText.Get('common.retry')}" />
        </StackPanel>
        <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,32" Visibility="{x:Bind local:AdminUserDetailView.Gone(ViewModel.State), Mode=OneWay}">
            <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.page.notFoundTitle')}" FontFamily="{StaticResource SiloFontSemiBold}" FontSize="18"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.page.notFoundDescription')}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" />
            <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" HorizontalAlignment="Center" Click="OnUsersClick"
                    Content="{x:Bind t:AppText.Get('web.admin.users.page.allUsers')}" />
        </StackPanel>

        <StackPanel x:Name="AccountPanel" Spacing="20" Visibility="{x:Bind local:AdminUsersView.Ready(ViewModel.State), Mode=OneWay}">
            <!-- The header: initial, name, badges, the line of facts, the notices, and the actions. -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource SiloPrimaryBrush}" VerticalAlignment="Top">
                    <TextBlock Text="{x:Bind local:AdminUserDetailView.Initial(ViewModel.Header), Mode=OneWay}" FontFamily="{StaticResource SiloFontBold}" FontSize="22"
                               Foreground="{StaticResource SiloOnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind local:AdminUserDetailView.NameOf(ViewModel.Header), Mode=OneWay}" Style="{StaticResource SiloSettingsPageTitleStyle}"
                                   AutomationProperties.HeadingLevel="Level1" TextTrimming="CharacterEllipsis" />
                        <Border Style="{StaticResource AdminBadgeStyle}" Background="{x:Bind local:AdminUserDetailView.RoleBackground(ViewModel.Header), Mode=OneWay}"
                                BorderBrush="{x:Bind local:AdminUserDetailView.RoleBackground(ViewModel.Header), Mode=OneWay}">
                            <TextBlock Text="{x:Bind local:AdminUserDetailView.RoleOf(ViewModel.Header), Mode=OneWay}" Style="{StaticResource AdminBadgeTextStyle}"
                                       Foreground="{x:Bind local:AdminUserDetailView.RoleForeground(ViewModel.Header), Mode=OneWay}" />
                        </Border>
                        <Border Style="{StaticResource AdminBadgeStyle}" BorderBrush="{x:Bind local:AdminUserDetailView.StatusBorder(ViewModel.Header), Mode=OneWay}"
                                Background="{x:Bind local:AdminUserDetailView.StatusBackground(ViewModel.Header), Mode=OneWay}">
                            <TextBlock Text="{x:Bind local:AdminUserDetailView.StatusOf(ViewModel.Header), Mode=OneWay}" Style="{StaticResource AdminBadgeTextStyle}"
                                       Foreground="{StaticResource SiloForegroundBrush}" />
                        </Border>
                        <Border Style="{StaticResource AdminBadgeStyle}" BorderBrush="#4DF59E0B" Background="#1AF59E0B"
                                Visibility="{x:Bind local:AdminUserDetailView.Temporary(ViewModel.Header), Mode=OneWay}">
                            <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.detail.header.temporaryPassword')}" Style="{StaticResource AdminBadgeTextStyle}"
                                       Foreground="#FFFCD34D" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Bind local:AdminUserDetailView.FactsOf(ViewModel.Header), Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <Border Padding="12,10" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource AdminInfoBorderBrush}"
                            Background="{StaticResource AdminInfoBackgroundBrush}" Visibility="{x:Bind local:AdminUserDetailView.ViewOnly(ViewModel.Header), Mode=OneWay}">
                        <TextBlock Text="{x:Bind local:AdminUserDetailView.ViewOnlyText(ViewModel.Header), Mode=OneWay}" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{StaticResource SiloMutedBrush}" />
                    </Border>
                    <Border Padding="12,10" CornerRadius="12" BorderThickness="1" BorderBrush="#4DEF4444" Background="#1AEF4444"
                            Visibility="{x:Bind local:AdminUserDetailView.Disabled(ViewModel.Header), Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.detail.header.disabledNotice')}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind ViewModel.EnableCommand}"
                                    Visibility="{x:Bind local:AdminUserDetailView.Enableable(ViewModel.Header), Mode=OneWay}"
                                    Content="{x:Bind t:AppText.Get('web.admin.users.detail.header.enableAccount')}" />
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" Click="OnResetClick"
                            Visibility="{x:Bind local:AdminUserDetailView.Resettable(ViewModel.Header), Mode=OneWay}"
                            Content="{x:Bind t:AppText.Get('web.admin.users.detail.header.resetPassword')}" />
                    <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" Click="OnSetPasswordClick"
                            Visibility="{x:Bind local:AdminUserDetailView.PasswordSettable(ViewModel.Header), Mode=OneWay}"
                            Content="{x:Bind t:AppText.Get('web.admin.users.detail.header.setPassword')}" />
                    <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" Padding="10,0"
                            Visibility="{x:Bind local:AdminUserDetailView.HasMenu(ViewModel.Header), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.detail.header.moreActions')}"
                            ToolTipService.ToolTip="{x:Bind t:AppText.Get('web.admin.users.detail.header.moreActions')}">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnMenuOpening">
                                <MenuFlyoutItem x:Name="MakeOwnerItem" Text="{x:Bind t:AppText.Get('web.admin.users.detail.header.makeOwner')}"
                                                Command="{x:Bind ViewModel.MakeOwnerCommand}" />
                                <MenuFlyoutItem x:Name="DisableItem" Text="{x:Bind t:AppText.Get('web.admin.users.detail.header.disableAccount')}"
                                                Command="{x:Bind ViewModel.DisableCommand}" />
                                <MenuFlyoutItem x:Name="EnableItem" Text="{x:Bind t:AppText.Get('web.admin.users.detail.header.enableAccount')}"
                                                Command="{x:Bind ViewModel.EnableCommand}" />
                                <MenuFlyoutSeparator x:Name="DeleteSeparator" />
                                <MenuFlyoutItem x:Name="DeleteItem" Text="{x:Bind t:AppText.Get('web.admin.users.detail.header.deleteAccount')}"
                                                Foreground="{StaticResource SiloDestructiveBrush}" Click="OnDeleteClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.detail.access.tab.ownerOnlyNote')}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                       Visibility="{x:Bind local:AdminUserDetailView.OwnerOnlyNote(ViewModel.Header), Mode=OneWay}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sign-in & role, as the web's SignInCard. -->
                <Border Style="{StaticResource AdminFormCardStyle}" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.detail.common.cardTitle.signin')}" Style="{StaticResource CardTitleStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBox Header="{x:Bind t:AppText.Get('web.admin.users.detail.access.signIn.username')}" Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.CanEditSignIn, Mode=OneWay}" />
                        <TextBox Header="{x:Bind t:AppText.Get('web.admin.users.detail.access.signIn.email')}" Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.CanEditSignIn, Mode=OneWay}" InputScope="EmailSmtpAddress" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.detail.access.signIn.role')}" Style="{StaticResource RowLabelStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton GroupName="DetailRole" Content="{x:Bind t:AppText.Get('web.admin.users.detail.access.role.user')}"
                                             IsChecked="{x:Bind ViewModel.IsUserRole, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChangeRole, Mode=OneWay}" />
                                <RadioButton GroupName="DetailRole" Content="{x:Bind t:AppText.Get('web.admin.users.detail.access.role.admin')}"
                                             IsChecked="{x:Bind ViewModel.IsAdminRole, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanPickAdmin, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.RoleNote, Mode=OneWay}" Style="{StaticResource AdminHintTextStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" Header="{x:Bind t:AppText.Get('web.admin.users.detail.access.signIn.canSignIn')}"
                                          IsOn="{x:Bind ViewModel.CanSignIn, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanToggleSignIn, Mode=OneWay}" OnContent="" OffContent="" />
                            <TextBlock Text="{x:Bind ViewModel.SignInNote, Mode=OneWay}" Style="{StaticResource AdminHintTextStyle}"
                                       Visibility="{x:Bind local:AdminUsersView.Shown(ViewModel.SignInNote), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.HasSignInChanges, Mode=OneWay}">
                            <Button Style="{StaticResource SiloPrimaryButtonStyle}" Command="{x:Bind ViewModel.SaveSignInCommand}"
                                    Content="{x:Bind ViewModel.SignInCard.SaveText, Mode=OneWay}" />
                            <Button Style="{StaticResource SiloSettingsGhostButtonStyle}" Command="{x:Bind ViewModel.CancelSignInCommand}"
                                    Content="{x:Bind t:AppText.Get('common.cancel')}" />
                            <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind ViewModel.ReviewSignInCommand}"
                                    Visibility="{x:Bind ViewModel.SignInCard.HasConflict, Mode=OneWay}"
                                    Content="{x:Bind t:AppText.Get('web.admin.users.detail.access.card.reloadAndReview')}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.SignInCard.Error, Mode=OneWay}" Style="{StaticResource AdminErrorTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SignInCard.Saved, Mode=OneWay}" Style="{StaticResource AdminHintTextStyle}" Foreground="{StaticResource SiloSuccessBrush}" />
                    </StackPanel>
                </Border>

                <!-- Library access, as the web's LibraryAccessCard. -->
                <Border Grid.Column="1" Style="{StaticResource AdminFormCardStyle}" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.detail.common.cardTitle.library')}" Style="{StaticResource CardTitleStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <ComboBox Header="{x:Bind t:AppText.Get('web.admin.users.detail.access.library.accessGroup')}" Style="{StaticResource SiloSettingsComboBoxStyle}"
                                  HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.GroupChoices, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanPickGroup, Mode=OneWay}"
                                  Visibility="{x:Bind local:AdminUserDetailView.NotAdmin(ViewModel.IsAdminAccount), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.detail.access.library.adminDescription')}" Style="{StaticResource AdminHintTextStyle}"
                                   Visibility="{x:Bind ViewModel.IsAdminAccount, Mode=OneWay}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.detail.access.library.libraries')}" Style="{StaticResource RowLabelStyle}" />
                            <RadioButton GroupName="DetailLibraries" Content="{x:Bind ViewModel.InheritLibrariesText, Mode=OneWay}"
                                         IsChecked="{x:Bind ViewModel.UsesGroupLibraries, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChooseLibraries, Mode=OneWay}" />
                            <RadioButton GroupName="DetailLibraries" Content="{x:Bind t:AppText.Get('web.admin.users.detail.access.library.chooseForAccount')}"
                                         IsChecked="{x:Bind ViewModel.ChoosesLibraries, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChooseLibraries, Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Libraries}" Margin="28,0,0,0" IsTabStop="False"
                                          Visibility="{x:Bind ViewModel.ChoosesLibraries, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="admin:AdminLibraryChoice">
                                        <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.detail.access.library.noLibraryWarning')}" Style="{StaticResource AdminHintTextStyle}"
                                       Foreground="{StaticResource SiloWarningBrush}" Visibility="{x:Bind ViewModel.HasNoLibraryWarning, Mode=OneWay}" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.detail.access.library.markerEdit')}" FontSize="13" />
                                <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.detail.access.library.markerEditDescription')}" Style="{StaticResource AdminHintTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.MarkerEdit, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.CanEditAccess, Mode=OneWay}" OnContent="" OffContent=""
                                          AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.detail.access.library.markerEdit')}" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.detail.access.library.metadataCuration')}" FontSize="13" />
                                <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.detail.access.library.metadataCurationDescription')}" Style="{StaticResource AdminHintTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.MetadataCuration, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.CanEditAccess, Mode=OneWay}" OnContent="" OffContent=""
                                          AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.detail.access.library.metadataCuration')}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.HasAccessChanges, Mode=OneWay}">
                            <Button Style="{StaticResource SiloPrimaryButtonStyle}" Command="{x:Bind ViewModel.SaveAccessCommand}"
                                    Content="{x:Bind ViewModel.AccessCard.SaveText, Mode=OneWay}" />
                            <Button Style="{StaticResource SiloSettingsGhostButtonStyle}" Command="{x:Bind ViewModel.CancelAccessCommand}"
                                    Content="{x:Bind t:AppText.Get('common.cancel')}" />
                            <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind ViewModel.ReviewAccessCommand}"
                                    Visibility="{x:Bind ViewModel.AccessCard.HasConflict, Mode=OneWay}"
                                    Content="{x:Bind t:AppText.Get('web.admin.users.detail.access.card.reloadAndReview')}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.AccessCard.Error, Mode=OneWay}" Style="{StaticResource AdminErrorTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.AccessCard.Saved, Mode=OneWay}" Style="{StaticResource AdminHintTextStyle}" Foreground="{StaticResource SiloSuccessBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- The account's sign-ins, as the web's LoginSessionsPanel for an administrator. -->
            <Border x:Name="SessionsCard" Style="{StaticResource AdminFormCardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind t:AppText.Get('web.settings.sessions.title')}" Style="{StaticResource CardTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Text="{x:Bind Sessions.Description, Mode=OneWay}" Style="{StaticResource AdminHintTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SiloSettingsOutlineButtonStyle}" VerticalAlignment="Top" Command="{x:Bind Sessions.SignOutEverywhereCommand}"
                                IsEnabled="{x:Bind Sessions.Manageable, Mode=OneWay}" Content="{x:Bind t:AppText.Get('web.settings.sessions.signOutEverywhere')}" />
                    </Grid>
                    <TextBlock Text="{x:Bind t:AppText.Get('web.settings.sessions.admin.ownerOnly')}" Style="{StaticResource AdminHintTextStyle}"
                               Visibility="{x:Bind local:AdminUsersView.Hidden(Sessions.Manageable), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Sessions.Notice, Mode=OneWay}" Style="{StaticResource AdminHintTextStyle}"
                               Foreground="{x:Bind local:AdminActivityView.MessageBrush(Sessions.NoticeIsError), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind t:AppText.Get('web.settings.sessions.loading')}" Style="{StaticResource AdminHintTextStyle}"
                               Visibility="{x:Bind local:AdminUsersView.LoadingShown(Sessions.State), Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind local:AdminUserDetailView.Failed(Sessions.State), Mode=OneWay}">
                        <TextBlock Text="{x:Bind t:AppText.Get('web.settings.sessions.loadFailed')}" Style="{StaticResource AdminErrorTextStyle}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind Sessions.RetryCommand}" Content="{x:Bind t:AppText.Get('common.retry')}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind t:AppText.Get('web.settings.sessions.admin.empty')}" Style="{StaticResource AdminHintTextStyle}"
                               Visibility="{x:Bind Sessions.IsEmpty, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind Sessions.Sessions}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="settings:SignedInSessionRow">
                                <Grid ColumnSpacing="12" Padding="0,8" BorderBrush="#4D2A2A2F" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource AdminCellStyle}" FontFamily="{StaticResource SiloFontMedium}" />
                                        <TextBlock Text="{x:Bind StatusLine}" Style="{StaticResource AdminHintTextStyle}" />
                                        <TextBlock Text="{x:Bind IpAddress}" Style="{StaticResource AdminHintTextStyle}" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SiloSettingsOutlineButtonStyle}" VerticalAlignment="Center" Click="OnSignOutSessionClick"
                                            Tag="{x:Bind Id}" Content="{x:Bind t:AppText.Get('common.signOut')}" AutomationProperties.Name="{x:Bind SignOutName}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind Sessions.LoadMoreCommand}"
                            Visibility="{x:Bind Sessions.HasMore, Mode=OneWay}" Content="{x:Bind t:AppText.Get('web.settings.sessions.loadMore')}" />
                    <TextBlock Text="{x:Bind t:AppText.Get('web.settings.sessions.footnoteAdmin')}" Style="{StaticResource AdminHintTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
