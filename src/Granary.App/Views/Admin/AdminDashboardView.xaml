<?xml version="1.0" encoding="utf-8"?>
<!--
    Admin → Dashboard, in the web's default arrangement (docs/ui-design.md, Admin): the number tiles, the health strip, Now
    Playing, playback and egress over 24 hours, the week's top titles and profiles, the libraries and users, and the
    recent activity. Each card shows its own failure. Columns fold as the page narrows.
-->
<UserControl
    x:Class="Granary.App.Views.Admin.AdminDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Granary.App.Views.Admin"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:admin="using:Granary.Core.ViewModels.Admin"
    AutomationProperties.Name="Dashboard">

    <!-- Its own copy of the settings' styles: the view is made before it joins the page, whose resources it cannot see then. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Themes/SiloSettings.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="AdminCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SiloSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SiloBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20,16" />
            </Style>
            <Style x:Key="AdminCardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SiloFontBold}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="AdminSmallMutedStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="AdminMessageStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,16" />
            </Style>
            <Style x:Key="AdminErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource AdminMessageStyle}">
                <Setter Property="Foreground" Value="#FFEF4444" />
            </Style>
            <Style x:Key="AdminLinkStyle" TargetType="HyperlinkButton">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="AdminTitleLinkStyle" TargetType="HyperlinkButton">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="AdminPillStyle" TargetType="Border">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#992A2A2F" />
                <Setter Property="Background" Value="#4D2A2A2F" />
            </Style>

            <!-- A leaderboard row, as the web's BarList: its rank, its name, its plays and watch time over a bar of its share. -->
            <DataTemplate x:Key="AdminBarRowTemplate" x:DataType="admin:AdminBarRow">
                <Grid Margin="0,2" CornerRadius="4" AutomationProperties.Name="{x:Bind local:AdminDashboardView.BarName(Rank, Label, Value, Secondary)}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind local:AdminDashboardView.Share(Fraction)}" />
                            <ColumnDefinition Width="{x:Bind local:AdminDashboardView.Rest(Fraction)}" />
                        </Grid.ColumnDefinitions>
                        <Border MinWidth="6" CornerRadius="0,4,4,0" Background="#FF5F74EE" Opacity="0.18" />
                    </Grid>
                    <Grid Padding="8,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Rank}" FontSize="11" Foreground="{StaticResource SiloMutedBrush}" VerticalAlignment="Center" />
                        <HyperlinkButton Grid.Column="1" Style="{StaticResource AdminTitleLinkStyle}" Visibility="{x:Bind CanOpen}"
                                         Command="{x:Bind OpenCommand}" CommandParameter="{x:Bind ContentId}" ToolTipService.ToolTip="{x:Bind Label}">
                            <TextBlock Text="{x:Bind Label}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        </HyperlinkButton>
                        <TextBlock Grid.Column="1" Text="{x:Bind Label}" Visibility="{x:Bind IsPlain}" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource SiloForegroundBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Label}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Value}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource SiloForegroundBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Secondary}" FontSize="11" Foreground="{StaticResource SiloMutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="24">
        <!-- The header, as the web's: what the page is, when it was read, and Refresh. -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="Dashboard" Style="{StaticResource SiloSettingsPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="Live sessions, content health, and server activity in one view." Style="{StaticResource SiloSettingsMutedTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.UpdatedText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SiloMutedBrush}"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" MinWidth="132" Command="{x:Bind ViewModel.RefreshCommand}"
                        AutomationProperties.Name="{x:Bind ViewModel.RefreshText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="{x:Bind ViewModel.RefreshText, Mode=OneWay}" FontSize="13" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="40" Height="40" Margin="0,48" HorizontalAlignment="Center" />
        <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                   Style="{StaticResource AdminErrorStyle}" Margin="0,48" />

        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsShown, Mode=OneWay}">
            <!-- Live numbers: one row of tiles, 3 + 3 where six do not fit. -->
            <controls:ColumnsPanel MinColumnWidth="150" MaxColumns="6" EvenRows="True">
                <local:AdminStatTileView Tile="{x:Bind ViewModel.ActiveStreamsTile, Mode=OneWay}" Glyph="&#xE9D9;" />
                <local:AdminStatTileView Tile="{x:Bind ViewModel.EgressNowTile, Mode=OneWay}" Glyph="&#xEC4A;" />
                <local:AdminStatTileView Tile="{x:Bind ViewModel.ProfilesTile, Mode=OneWay}" Glyph="&#xE716;" />
                <local:AdminStatTileView Tile="{x:Bind ViewModel.MoviesTile, Mode=OneWay}" Glyph="&#xE8B2;" />
                <local:AdminStatTileView Tile="{x:Bind ViewModel.ShowsTile, Mode=OneWay}" Glyph="&#xE7F4;" />
                <local:AdminStatTileView Tile="{x:Bind ViewModel.StorageTile, Mode=OneWay}" Glyph="&#xEDA2;" />
            </controls:ColumnsPanel>

            <!-- The deployment's health in one strip. -->
            <Border Style="{StaticResource AdminCardStyle}" Padding="12">
                <Grid>
                    <TextBlock Text="Failed to load server health." Style="{StaticResource AdminErrorStyle}" Margin="0,8"
                               Visibility="{x:Bind local:AdminDashboardView.Failed(ViewModel.HealthState), Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Health, Mode=OneWay}" IsTabStop="False" AutomationProperties.Name="Server health">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:ColumnsPanel MinColumnWidth="130" MaxColumns="6" EvenRows="True" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="admin:AdminHealthCell">
                                <Border Padding="10" CornerRadius="8" Background="{StaticResource SiloBackgroundBrush}" BorderBrush="{StaticResource SiloBorderBrush}"
                                        BorderThickness="1" AutomationProperties.Name="{x:Bind local:AdminDashboardView.HealthName(Label, Value, Detail)}">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="{x:Bind local:AdminDashboardView.HealthGlyph(Label)}" FontSize="12" Foreground="{StaticResource SiloMutedBrush}" />
                                            <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource SiloFontMedium}" FontSize="11" Foreground="{StaticResource SiloMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Value}" FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="15"
                                                   Foreground="{x:Bind local:AdminDashboardView.ToneBrush(Tone)}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind HasDetail}" FontSize="10" Foreground="{StaticResource SiloMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- What plays right now: a card a stream, four at most. -->
            <Border Style="{StaticResource AdminCardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Now Playing" Style="{StaticResource AdminCardTitleStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level2" />
                        <HyperlinkButton Content="{x:Bind ViewModel.StreamsLinkText, Mode=OneWay}" Style="{StaticResource AdminLinkStyle}"
                                         HorizontalAlignment="Right" Command="{x:Bind ViewModel.OpenActivityCommand}" />
                    </Grid>
                    <TextBlock Text="Nothing playing right now" FontSize="13" Foreground="{StaticResource SiloMutedBrush}"
                               Visibility="{x:Bind local:AdminDashboardView.Empty(ViewModel.SessionsState), Mode=OneWay}" />
                    <TextBlock Text="Failed to load streams." Style="{StaticResource AdminErrorStyle}"
                               Visibility="{x:Bind local:AdminDashboardView.Failed(ViewModel.SessionsState), Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Streams, Mode=OneWay}" IsTabStop="False" AutomationProperties.Name="Now playing">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:ColumnsPanel MinColumnWidth="340" MaxColumns="2" Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="admin:AdminStreamCard">
                                <Border Padding="14" CornerRadius="16" Background="{StaticResource SiloSurfaceRaisedBrush}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="70" Height="105" VerticalAlignment="Top" CornerRadius="8" Background="{StaticResource SiloBackgroundBrush}">
                                            <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="{StaticResource SiloMutedBrush}" />
                                            <Image Source="{x:Bind local:AdminDashboardView.Poster(PosterUrl)}" Stretch="UniformToFill"
                                                   Opacity="{x:Bind local:AdminDashboardView.PosterOpacity(IsPaused)}" />
                                            <Border Visibility="{x:Bind IsPaused}" Background="#59000000">
                                                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" CornerRadius="10"
                                                        Background="#E6141417" BorderBrush="#66FFFFFF" BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE769;" FontSize="10" />
                                                        <TextBlock Text="Paused" FontFamily="{StaticResource SiloFontSemiBold}" FontSize="10" />
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                        </Grid>
                                        <Grid Grid.Column="1" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <HyperlinkButton Style="{StaticResource AdminTitleLinkStyle}" Visibility="{x:Bind CanOpen}"
                                                             Command="{x:Bind OpenCommand}" CommandParameter="{x:Bind ContentId}">
                                                <TextBlock Text="{x:Bind Title}" FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" />
                                            </HyperlinkButton>
                                            <TextBlock Text="{x:Bind Title}" Visibility="{x:Bind IsPlain}" FontFamily="{StaticResource SiloFontBold}"
                                                       FontWeight="Bold" FontSize="14" Foreground="{StaticResource SiloForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1" Text="{x:Bind Subtitle}" Visibility="{x:Bind HasSubtitle}" FontSize="12"
                                                       Foreground="{StaticResource SiloMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                                                <Border Padding="6,2" CornerRadius="4" BorderThickness="1" Background="{x:Bind local:AdminDashboardView.MethodBackground(Method)}"
                                                        BorderBrush="{x:Bind local:AdminDashboardView.MethodBorder(Method)}">
                                                    <TextBlock Text="{x:Bind MethodLabel}" FontFamily="{StaticResource SiloFontSemiBold}" FontSize="10"
                                                               Foreground="{x:Bind local:AdminDashboardView.MethodBrush(Method)}" />
                                                </Border>
                                                <Border Style="{StaticResource AdminPillStyle}" Visibility="{x:Bind HasClient}" MaxWidth="150">
                                                    <TextBlock Text="{x:Bind Client}" FontFamily="{StaticResource SiloFontSemiBold}" FontSize="10"
                                                               Foreground="{StaticResource SiloMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <Border Style="{StaticResource AdminPillStyle}" Visibility="{x:Bind HasProfile}" MaxWidth="150">
                                                    <TextBlock Text="{x:Bind Profile}" FontFamily="{StaticResource SiloFontSemiBold}" FontSize="10"
                                                               Foreground="{StaticResource SiloMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </StackPanel>
                                            <Grid Grid.Row="3" VerticalAlignment="Bottom" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource SiloPrimaryBrush}">
                                                    <TextBlock Text="{x:Bind Initial}" FontFamily="{StaticResource SiloFontBold}" FontSize="9"
                                                               Foreground="{StaticResource SiloOnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Username}" FontFamily="{StaticResource SiloFontMedium}" FontSize="12"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SiloForegroundBrush}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Elapsed}" FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{StaticResource SiloMutedBrush}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <HyperlinkButton Content="{x:Bind ViewModel.MoreStreamsText, Mode=OneWay}" Style="{StaticResource AdminLinkStyle}" FontSize="12"
                                     HorizontalAlignment="Center" Command="{x:Bind ViewModel.OpenActivityCommand}"
                                     Visibility="{x:Bind local:AdminDashboardView.Shown(ViewModel.MoreStreamsText), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- The trends that explain the numbers. -->
            <controls:ColumnsPanel MinColumnWidth="420" MaxColumns="2">
                <Border Style="{StaticResource AdminCardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="220" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Playback activity · last 24 h" Style="{StaticResource AdminCardTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PlaybackTotalText, Mode=OneWay}" Style="{StaticResource AdminSmallMutedStyle}" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14" Visibility="{x:Bind local:AdminDashboardView.Ready(ViewModel.PlaybackState), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="#FF5F74EE" VerticalAlignment="Center" />
                                <TextBlock Text="Direct play" Style="{StaticResource AdminSmallMutedStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="#FF169E88" VerticalAlignment="Center" />
                                <TextBlock Text="Direct stream" Style="{StaticResource AdminSmallMutedStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="#FFBF7F22" VerticalAlignment="Center" />
                                <TextBlock Text="Transcode" Style="{StaticResource AdminSmallMutedStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <controls:PlaybackChart Grid.Row="2" Columns="{x:Bind ViewModel.PlaybackColumns, Mode=OneWay}"
                                                Visibility="{x:Bind local:AdminDashboardView.Ready(ViewModel.PlaybackState), Mode=OneWay}"
                                                AutomationProperties.Name="Playback sessions per hour over the last 24 hours, by play method" />
                        <StackPanel Grid.Row="2" VerticalAlignment="Center" Spacing="4"
                                    Visibility="{x:Bind local:AdminDashboardView.Empty(ViewModel.PlaybackState), Mode=OneWay}">
                            <TextBlock Text="No playback in the last 24 hours" Style="{StaticResource AdminMessageStyle}" Margin="0" />
                            <TextBlock Text="Sessions appear here as soon as someone starts watching." Style="{StaticResource AdminMessageStyle}"
                                       FontSize="11" Margin="0" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Failed to load playback activity." Style="{StaticResource AdminErrorStyle}"
                                   Visibility="{x:Bind local:AdminDashboardView.Failed(ViewModel.PlaybackState), Mode=OneWay}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource AdminCardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="244" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Egress · last 24 h" Style="{StaticResource AdminCardTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.EgressTotalText, Mode=OneWay}" Style="{StaticResource AdminSmallMutedStyle}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.EgressPeakText, Mode=OneWay}" Style="{StaticResource AdminSmallMutedStyle}" />
                        </Grid>
                        <controls:RateChart Grid.Row="1" Series="{x:Bind ViewModel.Egress, Mode=OneWay}" StartLabel="24h ago"
                                            Visibility="{x:Bind local:AdminDashboardView.Ready(ViewModel.EgressState), Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind local:AdminDashboardView.EgressName(ViewModel.EgressPeakText), Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Text="No egress samples yet" Style="{StaticResource AdminMessageStyle}"
                                   Visibility="{x:Bind local:AdminDashboardView.Empty(ViewModel.EgressState), Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Text="Failed to load egress history." Style="{StaticResource AdminErrorStyle}"
                                   Visibility="{x:Bind local:AdminDashboardView.Failed(ViewModel.EgressState), Mode=OneWay}" />
                    </Grid>
                </Border>
            </controls:ColumnsPanel>

            <!-- Who watched what this week. -->
            <controls:ColumnsPanel MinColumnWidth="420" MaxColumns="2">
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Top titles · last 7 d" Style="{StaticResource AdminCardTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopTitles, Mode=OneWay}" ItemTemplate="{StaticResource AdminBarRowTemplate}"
                                      IsTabStop="False" AutomationProperties.Name="Top titles" />
                        <TextBlock Text="No plays in the last 7 days" Style="{StaticResource AdminMessageStyle}"
                                   Visibility="{x:Bind local:AdminDashboardView.Empty(ViewModel.TopTitlesState), Mode=OneWay}" />
                        <TextBlock Text="Failed to load top titles." Style="{StaticResource AdminErrorStyle}"
                                   Visibility="{x:Bind local:AdminDashboardView.Failed(ViewModel.TopTitlesState), Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Most active profiles · last 7 d" Style="{StaticResource AdminCardTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopProfiles, Mode=OneWay}" ItemTemplate="{StaticResource AdminBarRowTemplate}"
                                      IsTabStop="False" AutomationProperties.Name="Most active profiles" />
                        <TextBlock Text="No profile activity in the last 7 days" Style="{StaticResource AdminMessageStyle}"
                                   Visibility="{x:Bind local:AdminDashboardView.Empty(ViewModel.TopProfilesState), Mode=OneWay}" />
                        <TextBlock Text="Failed to load profile activity." Style="{StaticResource AdminErrorStyle}"
                                   Visibility="{x:Bind local:AdminDashboardView.Failed(ViewModel.TopProfilesState), Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </controls:ColumnsPanel>

            <!-- The server's content and accounts. -->
            <controls:ColumnsPanel MinColumnWidth="420" MaxColumns="2">
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Libraries" Style="{StaticResource AdminCardTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Libraries, Mode=OneWay}" IsTabStop="False" AutomationProperties.Name="Libraries">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="admin:AdminLibraryRow">
                                    <Border Padding="12" CornerRadius="8" Background="{StaticResource SiloBackgroundBrush}" BorderBrush="{StaticResource SiloBorderBrush}"
                                            BorderThickness="1" AutomationProperties.Name="{x:Bind local:AdminDashboardView.LibraryName(Name, Detail, StatusText)}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="8" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                                <FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{StaticResource SiloPrimaryBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="14"
                                                           Foreground="{StaticResource SiloForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Detail}" FontSize="11" Foreground="{StaticResource SiloMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{x:Bind local:AdminDashboardView.LibraryDot(IsEnabled)}" ToolTipService.ToolTip="{x:Bind StatusText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No libraries configured." Style="{StaticResource AdminMessageStyle}"
                                   Visibility="{x:Bind local:AdminDashboardView.Empty(ViewModel.LibrariesState), Mode=OneWay}" />
                        <TextBlock Text="Failed to load libraries." Style="{StaticResource AdminErrorStyle}"
                                   Visibility="{x:Bind local:AdminDashboardView.Failed(ViewModel.LibrariesState), Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AdminCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Users" Style="{StaticResource AdminCardTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <Grid ColumnSpacing="12" Padding="0,0,0,6" BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="0,0,0,1"
                              Visibility="{x:Bind local:AdminDashboardView.Ready(ViewModel.UsersState), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="User" Style="{StaticResource AdminSmallMutedStyle}" FontFamily="{StaticResource SiloFontMedium}" />
                            <TextBlock Grid.Column="1" Text="Last active" Style="{StaticResource AdminSmallMutedStyle}" FontFamily="{StaticResource SiloFontMedium}" />
                            <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource AdminSmallMutedStyle}" FontFamily="{StaticResource SiloFontMedium}" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Users, Mode=OneWay}" IsTabStop="False" AutomationProperties.Name="Users">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="admin:AdminUserRow">
                                    <Grid ColumnSpacing="12" Padding="0,8" BorderBrush="#4D2A2A2F" BorderThickness="0,0,0,1"
                                          AutomationProperties.Name="{x:Bind local:AdminDashboardView.UserName(Username, Role, LastActive, StatusText)}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource SiloPrimaryBrush}">
                                                <TextBlock Text="{x:Bind Initial}" FontFamily="{StaticResource SiloFontBold}" FontSize="10"
                                                           Foreground="{StaticResource SiloOnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind Username}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{StaticResource SiloForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                                    <Border Visibility="{x:Bind HasRole}" Padding="6,0" CornerRadius="8" Background="{StaticResource SiloPrimaryBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Role}" FontFamily="{StaticResource SiloFontSemiBold}" FontSize="9"
                                                                   Foreground="{StaticResource SiloOnPrimaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Email}" Visibility="{x:Bind HasEmail}" FontSize="10" Foreground="{StaticResource SiloMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{x:Bind LastActive}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource SiloMutedBrush}" />
                                        <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,2" CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{x:Bind local:AdminDashboardView.StatusBorder(IsEnabled)}"
                                                Background="{x:Bind local:AdminDashboardView.StatusBackground(IsEnabled)}">
                                            <TextBlock Text="{x:Bind StatusText}" FontFamily="{StaticResource SiloFontSemiBold}" FontSize="11"
                                                       Foreground="{StaticResource SiloForegroundBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No users." Style="{StaticResource AdminMessageStyle}"
                                   Visibility="{x:Bind local:AdminDashboardView.Empty(ViewModel.UsersState), Mode=OneWay}" />
                        <TextBlock Text="Failed to load users." Style="{StaticResource AdminErrorStyle}"
                                   Visibility="{x:Bind local:AdminDashboardView.Failed(ViewModel.UsersState), Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </controls:ColumnsPanel>

            <!-- The history feed: who started what. -->
            <Border Style="{StaticResource AdminCardStyle}">
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock Text="Recent Activity" Style="{StaticResource AdminCardTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <HyperlinkButton Content="View all ›" Style="{StaticResource AdminLinkStyle}" HorizontalAlignment="Right"
                                         Command="{x:Bind ViewModel.OpenActivityCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Recent, Mode=OneWay}" IsTabStop="False" AutomationProperties.Name="Recent activity">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="admin:AdminActivityRow">
                                <Grid ColumnSpacing="12" Padding="0,10" BorderBrush="#4D2A2A2F" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" VerticalAlignment="Top" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource SiloPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <Grid ColumnSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Username}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{StaticResource SiloForegroundBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind local:AdminDashboardView.StartedWatching(ProfileNote)}" FontSize="12"
                                                       Foreground="{StaticResource SiloMutedBrush}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Title}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{StaticResource SiloForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Meta}" FontSize="10" Foreground="{StaticResource SiloMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No recent activity." Style="{StaticResource AdminMessageStyle}"
                               Visibility="{x:Bind local:AdminDashboardView.Empty(ViewModel.SessionsState), Mode=OneWay}" />
                    <TextBlock Text="Failed to load activity." Style="{StaticResource AdminErrorStyle}"
                               Visibility="{x:Bind local:AdminDashboardView.Failed(ViewModel.SessionsState), Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
