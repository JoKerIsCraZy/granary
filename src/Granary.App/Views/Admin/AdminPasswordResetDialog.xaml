<?xml version="1.0" encoding="utf-8"?>
<!--
    The web's password reset dialog (components/AdminUserPasswordResetDialog.tsx), sm:max-w-lg: the title and its line with
    the X; what happened (an error, the email sent, a password set) and a link to share, once, in its muted box with its line
    and Copy link (outline, size sm); the three ways as ChoiceOption cards (space-y-2), the third holding the password, its
    rules and "Require change"; the footer on the right: Cancel (ghost) and the way's button, or Done.
-->
<ContentDialog
    x:Class="Granary.App.Views.Admin.AdminPasswordResetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Granary.App.Views.Admin"
    xmlns:t="using:Granary.Core.Texts"
    Closing="OnClosing">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Themes/AdminForms.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <!-- The title and the footer stay; only the body between them scrolls, its scrollbar in a gutter of its own. -->
    <Grid x:Name="ResetRoot" Width="478" Padding="0,0,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource AdminDialogTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.description')}" Style="{StaticResource AdminDialogDescriptionStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource AdminDialogCloseButtonStyle}" Margin="0,-8,-8,0" Click="OnCloseClick"
                    AutomationProperties.Name="{x:Bind t:AppText.Get('web.ui.close')}">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-16,0" Padding="0,0,16,0">
        <StackPanel Spacing="16">
        <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource SiloDestructiveBrush}"
                   Visibility="{x:Bind local:AdminUsersView.Shown(ViewModel.Error), Mode=OneWay}" />
        <TextBlock Text="{x:Bind ViewModel.Outcome, Mode=OneWay}" FontSize="14" TextWrapping="Wrap"
                   Visibility="{x:Bind local:AdminUsersView.Shown(ViewModel.Outcome), Mode=OneWay}" />

        <!-- The link to share, once: in a muted box (rounded-md, p-2.5), its line, and Copy link. -->
        <StackPanel Spacing="8" Visibility="{x:Bind local:AdminUsersView.Shown(ViewModel.ResetUrl), Mode=OneWay}">
            <Border Background="{StaticResource SiloSurfaceRaisedBrush}" CornerRadius="10" Padding="10">
                <TextBlock Text="{x:Bind ViewModel.ResetUrl, Mode=OneWay}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Border>
            <TextBlock Text="{x:Bind ViewModel.LinkShareText, Mode=OneWay}" Style="{StaticResource AdminHintTextStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Style="{StaticResource AdminSmallOutlineButtonStyle}" Click="OnCopyClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.copyLink')}" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="CopyResult" Style="{StaticResource AdminHintTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- How they get back in: three ChoiceOption cards. -->
        <StackPanel Spacing="8" Visibility="{x:Bind ChoiceShown(ViewModel.IsDone), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.methodGroup')}">
            <RadioButton GroupName="ResetMethod" Style="{StaticResource AdminChoiceCardStyle}" IsChecked="{x:Bind ViewModel.IsEmail, Mode=TwoWay}"
                         IsEnabled="{x:Bind EnabledWhen(ViewModel.CanEmail, ViewModel.CanChoose), Mode=OneWay}"
                         AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.emailOption')}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.emailOption')}" Style="{StaticResource AdminFieldLabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.EmailHint, Mode=OneWay}" Style="{StaticResource AdminHintTextStyle}" LineHeight="19" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="ResetMethod" Style="{StaticResource AdminChoiceCardStyle}" IsChecked="{x:Bind ViewModel.IsLink, Mode=TwoWay}"
                         IsEnabled="{x:Bind EnabledWhen(ViewModel.CanLink, ViewModel.CanChoose), Mode=OneWay}"
                         AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.linkOption')}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.linkOption')}" Style="{StaticResource AdminFieldLabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.LinkHint, Mode=OneWay}" Style="{StaticResource AdminHintTextStyle}" LineHeight="19" />
                </StackPanel>
            </RadioButton>
            <RadioButton GroupName="ResetMethod" Style="{StaticResource AdminChoiceCardStyle}" IsChecked="{x:Bind ViewModel.IsPassword, Mode=TwoWay}"
                         IsEnabled="{x:Bind ViewModel.CanChoose, Mode=OneWay}"
                         AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.passwordOption')}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.passwordOption')}" Style="{StaticResource AdminFieldLabelStyle}" />
                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.passwordOptionHint')}" Style="{StaticResource AdminHintTextStyle}"
                               LineHeight="19" />
                    <!-- mt-2.5 space-y-2, dimmed until the card is picked. -->
                    <StackPanel Spacing="8" Margin="0,8,0,0" IsHitTestVisible="{x:Bind ViewModel.IsPassword, Mode=OneWay}"
                                Opacity="{x:Bind PasswordOpacity(ViewModel.IsPassword), Mode=OneWay}">
                        <PasswordBox Style="{StaticResource AdminPasswordBoxStyle}" Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                                     IsEnabled="{x:Bind ViewModel.IsPassword, Mode=OneWay}"
                                     AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.passwordLabel')}" />
                        <TextBlock Text="{x:Bind ViewModel.PasswordRules, Mode=OneWay}" Style="{StaticResource AdminHintTextStyle}" />
                        <CheckBox MinHeight="0" Padding="8,0,0,0" FontSize="12" IsChecked="{x:Bind ViewModel.MustChange, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.IsPassword, Mode=OneWay}"
                                  Content="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.mustChange')}" />
                    </StackPanel>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        </StackPanel>
        </ScrollViewer>

        <!-- DialogFooter: on the right, gap-2. -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Style="{StaticResource AdminGhostButtonStyle}" Click="OnCloseClick" Visibility="{x:Bind ChoiceShown(ViewModel.IsDone), Mode=OneWay}"
                    Content="{x:Bind t:AppText.Get('common.cancel')}" />
            <Button Style="{StaticResource AdminPrimaryButtonStyle}" Click="OnPrimaryClick" Content="{x:Bind PrimaryText(ViewModel.IsDone, ViewModel.ActionText), Mode=OneWay}"
                    IsEnabled="{x:Bind PrimaryEnabled(ViewModel.IsDone, ViewModel.CanRun), Mode=OneWay}" />
        </StackPanel>
    </Grid>
</ContentDialog>
