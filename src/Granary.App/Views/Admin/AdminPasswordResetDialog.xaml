<?xml version="1.0" encoding="utf-8"?>
<!--
    The web's password reset dialog (components/AdminUserPasswordResetDialog.tsx): email a reset link, create one to share
    (shown once, with Copy link), or set a temporary password now.
-->
<ContentDialog
    x:Class="Granary.App.Views.Admin.AdminPasswordResetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Granary.App.Views.Admin"
    xmlns:t="using:Granary.Core.Texts"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    PrimaryButtonText="{x:Bind PrimaryText(ViewModel.IsDone, ViewModel.ActionText), Mode=OneWay}"
    CloseButtonText="{x:Bind CloseText(ViewModel.IsDone), Mode=OneWay}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind PrimaryEnabled(ViewModel.IsDone, ViewModel.CanRun), Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryClick"
    Closing="OnClosing">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Themes/AdminForms.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <StackPanel MinWidth="400" MaxWidth="520" Spacing="12">
        <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.description')}" Foreground="{StaticResource SiloMutedBrush}" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Style="{StaticResource AdminErrorTextStyle}"
                   Visibility="{x:Bind local:AdminUsersView.Shown(ViewModel.Error), Mode=OneWay}" />
        <TextBlock Text="{x:Bind ViewModel.Outcome, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"
                   Visibility="{x:Bind local:AdminUsersView.Shown(ViewModel.Outcome), Mode=OneWay}" />

        <!-- The link to share, once: in a box, its line, and Copy link. -->
        <StackPanel Spacing="8" Visibility="{x:Bind local:AdminUsersView.Shown(ViewModel.ResetUrl), Mode=OneWay}">
            <Border Style="{StaticResource AdminSecretBoxStyle}">
                <TextBlock Text="{x:Bind ViewModel.ResetUrl, Mode=OneWay}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Border>
            <TextBlock Text="{x:Bind ViewModel.LinkShareText, Mode=OneWay}" Style="{StaticResource AdminHintTextStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" Click="OnCopyClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                        <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.copyLink')}" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="CopyResult" Style="{StaticResource AdminHintTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- How they get back in. -->
        <StackPanel Spacing="10" Visibility="{x:Bind ChoiceShown(ViewModel.IsDone), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.methodGroup')}">
            <StackPanel Spacing="2">
                <RadioButton GroupName="ResetMethod" Content="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.emailOption')}"
                             IsChecked="{x:Bind ViewModel.IsEmail, Mode=TwoWay}" IsEnabled="{x:Bind EnabledWhen(ViewModel.CanEmail, ViewModel.CanChoose), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.EmailHint, Mode=OneWay}" Style="{StaticResource AdminHintTextStyle}" Margin="28,0,0,0" />
            </StackPanel>
            <StackPanel Spacing="2">
                <RadioButton GroupName="ResetMethod" Content="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.linkOption')}"
                             IsChecked="{x:Bind ViewModel.IsLink, Mode=TwoWay}" IsEnabled="{x:Bind EnabledWhen(ViewModel.CanLink, ViewModel.CanChoose), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.LinkHint, Mode=OneWay}" Style="{StaticResource AdminHintTextStyle}" Margin="28,0,0,0" />
            </StackPanel>
            <StackPanel Spacing="6">
                <RadioButton GroupName="ResetMethod" Content="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.passwordOption')}"
                             IsChecked="{x:Bind ViewModel.IsPassword, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChoose, Mode=OneWay}" />
                <StackPanel Spacing="6" Margin="28,0,0,0" IsHitTestVisible="{x:Bind ViewModel.IsPassword, Mode=OneWay}"
                            Opacity="{x:Bind PasswordOpacity(ViewModel.IsPassword), Mode=OneWay}">
                    <TextBlock Text="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.passwordOptionHint')}" Style="{StaticResource AdminHintTextStyle}" />
                    <PasswordBox Password="{x:Bind ViewModel.Password, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsPassword, Mode=OneWay}"
                                 AutomationProperties.Name="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.passwordLabel')}" />
                    <TextBlock Text="{x:Bind ViewModel.PasswordRules, Mode=OneWay}" Style="{StaticResource AdminHintTextStyle}" />
                    <CheckBox IsChecked="{x:Bind ViewModel.MustChange, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsPassword, Mode=OneWay}"
                              Content="{x:Bind t:AppText.Get('web.admin.users.passwordResetDialog.mustChange')}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ContentDialog>
