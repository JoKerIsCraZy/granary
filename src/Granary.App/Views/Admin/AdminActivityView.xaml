<?xml version="1.0" encoding="utf-8"?>
<!--
    Admin → Activity, as the web's (docs/ui-design.md, Admin): the streams running now, the share of each play method and
    routing node, a filter, the IP lookup, and a stream's commands. Read again every ten seconds while it shows.
-->
<UserControl
    x:Class="Granary.App.Views.Admin.AdminActivityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Granary.App.Views.Admin"
    xmlns:admin="using:Granary.Core.ViewModels.Admin"
    AutomationProperties.Name="Activity">

    <!-- Its own copy of the settings' styles: the view is made before it joins the page, whose resources it cannot see then. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Themes/SiloSettings.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ActivityCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SiloSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SiloBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="ActivityOverlineStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="CharacterSpacing" Value="100" />
                <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
            </Style>
            <Style x:Key="ActivityDetailLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
                <Setter Property="Width" Value="84" />
            </Style>
            <Style x:Key="ActivityDetailValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource SiloForegroundBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
            <Style x:Key="ActivityChipStyle" TargetType="ToggleButton">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
            <Style x:Key="ActivityActionStyle" TargetType="Button" BasedOn="{StaticResource SiloSettingsOutlineButtonStyle}">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="ActivityTerminateStyle" TargetType="Button" BasedOn="{StaticResource ActivityActionStyle}">
                <Setter Property="BorderBrush" Value="#66EF4444" />
                <Setter Property="Foreground" Value="#FFEF4444" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="20">
        <!-- The header: how many streams, Refresh, and how often the page reads itself again. -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="Activity" Style="{StaticResource SiloSettingsPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{x:Bind ViewModel.SubtitleText, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Visibility="{x:Bind Sidebar.HasLive, Mode=OneWay}" Padding="10,4" CornerRadius="12" Background="#26EF4444" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE93E;" FontSize="11" Foreground="#FFEF4444" />
                        <TextBlock Text="{x:Bind Sidebar.LiveText, Mode=OneWay}" FontFamily="{StaticResource SiloFontSemiBold}" FontSize="12" Foreground="#FFEF4444" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource SiloSettingsOutlineButtonStyle}" MinWidth="132" Command="{x:Bind ViewModel.RefreshCommand}"
                        AutomationProperties.Name="{x:Bind ViewModel.RefreshText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="{x:Bind ViewModel.RefreshText, Mode=OneWay}" FontSize="13" />
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AUTO REFRESH" Style="{StaticResource ActivityOverlineStyle}" HorizontalAlignment="Right" />
                    <TextBlock Text="Every 10 s" FontSize="12" Foreground="{StaticResource SiloForegroundBrush}" HorizontalAlignment="Right" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <InfoBar IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}" Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                 Severity="{x:Bind local:AdminActivityView.NoticeSeverity(ViewModel.NoticeIsError), Mode=OneWay}" CloseButtonClick="OnNoticeClosed" />

        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="40" Height="40" Margin="0,48" HorizontalAlignment="Center" />
        <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" Foreground="#FFEF4444"
                   FontSize="13" HorizontalAlignment="Center" Margin="0,48" TextWrapping="Wrap" />

        <!-- Which accounts used an address over the last 30 days. -->
        <Border Style="{StaticResource ActivityCardStyle}" Padding="0">
            <Expander Header="IP Lookup" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="360" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{x:Bind ViewModel.IpQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="IP lookup (e.g. 203.0.113.50)"
                                 AutomationProperties.Name="IP address" KeyDown="OnIpKeyDown" />
                        <Button Grid.Column="1" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind ViewModel.LookupCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE721;" FontSize="12" />
                                <TextBlock Text="Lookup" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.IpMessage, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasIpMessage, Mode=OneWay}" FontSize="13"
                               Foreground="{x:Bind local:AdminActivityView.MessageBrush(ViewModel.IpFailed), Mode=OneWay}" TextWrapping="Wrap" />
                    <StackPanel Visibility="{x:Bind ViewModel.HasIpUsers, Mode=OneWay}">
                        <Grid ColumnSpacing="12" Padding="0,0,0,6" BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="User" Style="{StaticResource ActivityOverlineStyle}" />
                            <TextBlock Grid.Column="1" Text="First Seen" Style="{StaticResource ActivityOverlineStyle}" />
                            <TextBlock Grid.Column="2" Text="Last Seen" Style="{StaticResource ActivityOverlineStyle}" />
                            <TextBlock Grid.Column="3" Text="Requests" Style="{StaticResource ActivityOverlineStyle}" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.IpUsers}" IsTabStop="False" AutomationProperties.Name="Accounts at this address">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="admin:AdminIpUserRow">
                                    <Grid ColumnSpacing="12" Padding="0,8" BorderBrush="#4D2A2A2F" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Username}" FontFamily="{StaticResource SiloFontSemiBold}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind FirstSeen}" FontSize="12" Foreground="{StaticResource SiloMutedBrush}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind LastSeen}" FontSize="12" Foreground="{StaticResource SiloMutedBrush}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Requests}" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button Content="Load more" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind ViewModel.LoadMoreIpUsersCommand}"
                            Visibility="{x:Bind ViewModel.HasMoreIpUsers, Mode=OneWay}" />
                </StackPanel>
            </Expander>
        </Border>

        <!-- How the streams play, and the nodes they pass; a share filters the streams. -->
        <Border Style="{StaticResource ActivityCardStyle}" Visibility="{x:Bind ViewModel.HasStreams, Mode=OneWay}">
            <StackPanel Spacing="10">
                <TextBlock Text="PLAYBACK METHOD" Style="{StaticResource ActivityOverlineStyle}" />
                <Grid x:Name="MethodBar" Height="8" CornerRadius="4" Background="#14FFFFFF" AutomationProperties.Name="Playback method distribution" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Methods, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="admin:AdminMethodShare">
                            <Button Padding="0" Background="Transparent" BorderThickness="0" Click="OnMethodClick" Tag="{x:Bind}"
                                    Opacity="{x:Bind local:AdminActivityView.DimmedOpacity(IsDimmed)}"
                                    AutomationProperties.Name="{x:Bind local:AdminActivityView.ShareName(Label, Count, IsSelected)}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{x:Bind local:AdminDashboardView.MethodBrush(Method)}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource SiloFontMedium}" FontSize="11" />
                                    <TextBlock Text="{x:Bind Count}" FontSize="11" Foreground="{StaticResource SiloMutedBrush}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasNodeChoice, Mode=OneWay}" Padding="0,10,0,0"
                            BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Text="BY ROUTING NODE" Style="{StaticResource ActivityOverlineStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Nodes, Mode=OneWay}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="admin:AdminNodeShare">
                                <ToggleButton Style="{StaticResource ActivityChipStyle}" IsChecked="{x:Bind IsSelected}" Click="OnNodeClick" Tag="{x:Bind}"
                                              Opacity="{x:Bind local:AdminActivityView.DimmedOpacity(IsDimmed)}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Label}" Foreground="{StaticResource SiloMutedBrush}" />
                                        <TextBlock Text="{x:Bind Name}" />
                                        <TextBlock Text="{x:Bind Count}" Foreground="{StaticResource SiloMutedBrush}" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Search and filters. -->
        <Grid ColumnSpacing="8" Visibility="{x:Bind local:AdminActivityView.NotLoading(ViewModel.IsLoading, ViewModel.HasError), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" QueryIcon="Find"
                            PlaceholderText="Filter by user, media, client, or node..." AutomationProperties.Name="Filter streams" />
            <ToggleButton Grid.Column="1" Content="Movies" Style="{StaticResource ActivityChipStyle}" IsChecked="{x:Bind ViewModel.IsMoviesOnly, Mode=OneWay}"
                          Command="{x:Bind ViewModel.ToggleMoviesCommand}" />
            <ToggleButton Grid.Column="2" Content="Series" Style="{StaticResource ActivityChipStyle}" IsChecked="{x:Bind ViewModel.IsSeriesOnly, Mode=OneWay}"
                          Command="{x:Bind ViewModel.ToggleSeriesCommand}" />
            <HyperlinkButton Grid.Column="3" Content="Clear filters" FontSize="11" Command="{x:Bind ViewModel.ClearFiltersCommand}"
                             Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay}" Foreground="{StaticResource SiloMutedBrush}" />
        </Grid>
        <TextBlock Text="{x:Bind ViewModel.FilterStatusText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource SiloMutedBrush}"
                   Visibility="{x:Bind local:AdminDashboardView.Shown(ViewModel.FilterStatusText), Mode=OneWay}" />

        <StackPanel Visibility="{x:Bind ViewModel.HasNoStreamsShown, Mode=OneWay}" Spacing="10" Margin="0,48" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE768;" FontSize="28" Opacity="0.25" />
            <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SiloMutedBrush}" />
        </StackPanel>

        <!-- A card a stream: who, what, how it plays, where it is; its details open below. -->
        <ItemsControl ItemsSource="{x:Bind ViewModel.Streams}" IsTabStop="False" AutomationProperties.Name="Streams">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="admin:AdminSessionRow">
                    <Border Style="{StaticResource ActivityCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="48" Height="72" VerticalAlignment="Top" CornerRadius="6" Background="{StaticResource SiloBackgroundBrush}">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{StaticResource SiloMutedBrush}" />
                                    <Image Source="{x:Bind local:AdminDashboardView.Poster(PosterUrl), Mode=OneWay}" Stretch="UniformToFill"
                                           Opacity="{x:Bind local:AdminDashboardView.PosterOpacity(IsPaused), Mode=OneWay}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <HyperlinkButton Padding="0" Foreground="{StaticResource SiloForegroundBrush}" Visibility="{x:Bind CanOpen, Mode=OneWay}"
                                                     Click="OnTitleClick" Tag="{x:Bind ContentId, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis" />
                                    </HyperlinkButton>
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Visibility="{x:Bind IsPlain, Mode=OneWay}" FontFamily="{StaticResource SiloFontBold}"
                                               FontWeight="Bold" FontSize="14" Foreground="{StaticResource SiloForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Visibility="{x:Bind HasSubtitle, Mode=OneWay}" FontSize="11"
                                               Foreground="{StaticResource SiloMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource SiloPrimaryBrush}">
                                            <TextBlock Text="{x:Bind Initial, Mode=OneWay}" FontFamily="{StaticResource SiloFontBold}" FontSize="9"
                                                       Foreground="{StaticResource SiloOnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Username, Mode=OneWay}" FontFamily="{StaticResource SiloFontMedium}" FontSize="12" VerticalAlignment="Center" />
                                        <Border Visibility="{x:Bind HasProfile, Mode=OneWay}" Padding="6,1" CornerRadius="4" Background="#4D2A2A2F" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Profile, Mode=OneWay}" FontSize="10" Foreground="{StaticResource SiloMutedBrush}" />
                                        </Border>
                                        <Border Padding="6,1" CornerRadius="4" BorderThickness="1" VerticalAlignment="Center"
                                                Background="{x:Bind local:AdminDashboardView.MethodBackground(Method), Mode=OneWay}"
                                                BorderBrush="{x:Bind local:AdminDashboardView.MethodBorder(Method), Mode=OneWay}">
                                            <TextBlock Text="{x:Bind MethodLabel, Mode=OneWay}" FontFamily="{StaticResource SiloFontSemiBold}" FontSize="10"
                                                       Foreground="{x:Bind local:AdminDashboardView.MethodBrush(Method), Mode=OneWay}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind TranscodeMode, Mode=OneWay}" Visibility="{x:Bind HasTranscodeMode, Mode=OneWay}" FontSize="10"
                                                   Foreground="{StaticResource SiloMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Client, Mode=OneWay}" Visibility="{x:Bind HasClient, Mode=OneWay}" FontSize="10"
                                                   Foreground="{StaticResource SiloMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="{StaticResource SiloMutedBrush}" TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind local:AdminActivityView.StreamLine(Container, Video, Audio), Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right" MinWidth="200">
                                    <!-- As the web's row: Terminate beside the menu (Granary asks first), the rest in the menu. -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ActivityTerminateStyle}" IsEnabled="{x:Bind IsIdle, Mode=OneWay}" Click="OnTerminateClick" Tag="{x:Bind}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE7BA;" FontSize="12" />
                                                <TextBlock Text="Terminate" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ActivityActionStyle}" IsEnabled="{x:Bind IsIdle, Mode=OneWay}" Padding="8,0" AutomationProperties.Name="Session actions">
                                            <FontIcon Glyph="&#xE712;" FontSize="12" />
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuFlyoutItem Text="{x:Bind PauseLabel, Mode=OneWay}" Click="OnPauseClick" Tag="{x:Bind}" Visibility="{x:Bind CanControl, Mode=OneWay}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="{x:Bind local:AdminActivityView.PauseGlyph(IsPaused), Mode=OneWay}" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Stop" Click="OnStopClick" Tag="{x:Bind}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE71A;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Message…" Click="OnMessageClick" Tag="{x:Bind}" Visibility="{x:Bind CanControl, Mode=OneWay}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8BD;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource SiloMutedBrush}"
                                               Text="{x:Bind local:AdminActivityView.TimeLine(Started, Elapsed), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Position, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource SiloForegroundBrush}" />
                                    <ProgressBar Value="{x:Bind local:AdminActivityView.Percent(Progress), Mode=OneWay}" Maximum="100" Width="200" HorizontalAlignment="Right"
                                                 AutomationProperties.Name="Playback position" />
                                </StackPanel>
                            </Grid>
                            <Expander Header="Details" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Container" Style="{StaticResource ActivityDetailLabelStyle}" />
                                        <TextBlock Text="{x:Bind Container, Mode=OneWay}" Style="{StaticResource ActivityDetailValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Video" Style="{StaticResource ActivityDetailLabelStyle}" />
                                        <TextBlock Text="{x:Bind Video, Mode=OneWay}" Style="{StaticResource ActivityDetailValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Audio" Style="{StaticResource ActivityDetailLabelStyle}" />
                                        <TextBlock Text="{x:Bind Audio, Mode=OneWay}" Style="{StaticResource ActivityDetailValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Visibility="{x:Bind HasBitrate, Mode=OneWay}">
                                        <TextBlock Text="Bitrate" Style="{StaticResource ActivityDetailLabelStyle}" />
                                        <TextBlock Text="{x:Bind Bitrate, Mode=OneWay}" Style="{StaticResource ActivityDetailValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Route" Style="{StaticResource ActivityDetailLabelStyle}" />
                                        <TextBlock Text="{x:Bind Route, Mode=OneWay}" Style="{StaticResource ActivityDetailValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Visibility="{x:Bind HasClient, Mode=OneWay}">
                                        <TextBlock Text="Client" Style="{StaticResource ActivityDetailLabelStyle}" />
                                        <TextBlock Text="{x:Bind ClientFull, Mode=OneWay}" Style="{StaticResource ActivityDetailValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Visibility="{x:Bind HasClientIp, Mode=OneWay}">
                                        <TextBlock Text="Address" Style="{StaticResource ActivityDetailLabelStyle}" />
                                        <TextBlock Text="{x:Bind local:AdminActivityView.AddressLine(ClientIp, Location), Mode=OneWay}" Style="{StaticResource ActivityDetailValueStyle}" />
                                        <HyperlinkButton Content="Look up" FontSize="11" Padding="8,0" Click="OnLookupAddressClick" Tag="{x:Bind ClientIp, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock Visibility="{x:Bind CannotControl, Mode=OneWay}" FontSize="11" Foreground="{StaticResource SiloMutedBrush}" TextWrapping="Wrap"
                                               Text="This session does not support live pause, resume, or messages. Stop and Terminate can still end playback." />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
