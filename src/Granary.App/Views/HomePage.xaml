<?xml version="1.0" encoding="utf-8"?>
<!--
    Home: the server's rows as on Silo's web client (docs/ui-design.md). No page title, as on the web; the
    sidebar shows the server and the profile. Cached, so Back returns to the same scroll position.
-->
<Page
    x:Class="Granary.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:vm="using:Granary.Core.ViewModels"
    NavigationCacheMode="Enabled"
    AutomationProperties.Name="Home">

    <Page.Resources>
        <!-- Continue Watching and Next Up cards: right-click, Shift+F10 or the menu key. -->
        <MenuFlyout x:Name="CardMenu">
            <MenuFlyoutItem x:Name="RemoveItem" Text="Remove from Continue Watching" Click="OnRemoveClick">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE738;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="Scroller" XYFocusKeyboardNavigation="Enabled">
            <StackPanel Padding="48,32,48,48" Spacing="16">
                <TextBlock Text="{x:Bind ViewModel.Notice, Mode=OneWay}" Visibility="{x:Bind HasText(ViewModel.Notice), Mode=OneWay}"
                           Style="{StaticResource SiloCaptionTextStyle}" Foreground="{StaticResource SiloPrimaryBrush}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" ContextRequested="OnRowsContextRequested">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="40" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:HomeRowViewModel">
                            <controls:MediaRow DataContext="{x:Bind}" Title="{x:Bind Title}" ItemsSource="{x:Bind Cards}"
                                               CardInvokedCommand="{x:Bind OpenCardCommand}" ExploreAllCommand="{x:Bind ExploreAllCommand}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading, error and empty state in the middle of the page; the status line is also announced. -->
        <StackPanel MaxWidth="440" Padding="48,0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                    Visibility="{x:Bind HasText(ViewModel.StatusText), Mode=OneWay}">
            <ProgressRing Width="40" Height="40" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
            <FontIcon Glyph="&#xE8B9;" FontSize="40" Foreground="{StaticResource SiloMutedBrush}"
                      Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="Home could not be loaded" Style="{StaticResource SiloRowTitleTextStyle}" HorizontalAlignment="Center"
                       Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Style="{x:Bind StatusStyle(ViewModel.HasError), Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="Rows appear here once this server has something for the profile." HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource SiloCaptionTextStyle}"
                       Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
            <Button Content="Retry" HorizontalAlignment="Center" Style="{StaticResource SiloSecondaryButtonStyle}"
                    Command="{x:Bind ViewModel.RetryCommand}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
