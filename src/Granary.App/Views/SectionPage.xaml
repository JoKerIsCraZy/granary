<?xml version="1.0" encoding="utf-8"?>
<!-- "Explore all" of a row: its title and every card in the row's order. A section listing has no sort or filter. -->
<Page
    x:Class="Granary.App.Views.SectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    NavigationCacheMode="Enabled">

    <ScrollViewer x:Name="Scroller" XYFocusKeyboardNavigation="Enabled">
        <StackPanel Padding="48,32,48,48" Spacing="28">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource SiloPageTitleTextStyle}"
                       AutomationProperties.HeadingLevel="Level1" />

            <controls:MediaGrid ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}" CardShape="{x:Bind ViewModel.CardShape, Mode=OneWay}"
                                CardInvokedCommand="{x:Bind ViewModel.OpenCardCommand}" LoadMoreCommand="{x:Bind ViewModel.LoadMoreCommand}" />

            <ProgressRing Width="28" Height="28" HorizontalAlignment="Center" IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" AutomationProperties.Name="Loading more" />

            <!-- Loading, empty and error; the status line is also announced. -->
            <StackPanel MaxWidth="440" Margin="0,24,0,0" HorizontalAlignment="Center" Spacing="14"
                        Visibility="{x:Bind HasText(ViewModel.StatusText), Mode=OneWay}">
                <ProgressRing Width="40" Height="40" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}"
                           AutomationProperties.LiveSetting="Polite" />
                <Button Content="Retry" HorizontalAlignment="Center" Style="{StaticResource SiloSecondaryButtonStyle}"
                        Command="{x:Bind ViewModel.RetryCommand}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
