<?xml version="1.0" encoding="utf-8"?>
<!--
    The Calendar, as Silo's web shows it: the title with the presets (Following, Trending, All) and the library filter,
    the week strip pinned above the days (previous and next week, Today, a button per day with a dot on days with
    airings), then a row per day. The page is cached: Back keeps the week.
-->
<Page
    x:Class="Granary.App.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:views="using:Granary.App.Views"
    xmlns:vm="using:Granary.Core.ViewModels"
    NavigationCacheMode="Enabled">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="48,32,48,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Calendar" Style="{StaticResource SiloDisplayTextStyle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <controls:PillChoices IsAccent="True" ItemsSource="{x:Bind ViewModel.Presets}" SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                                      VerticalAlignment="Center" AutomationProperties.Name="Calendar preset" />
                <DropDownButton CornerRadius="{StaticResource SiloPillCornerRadius}" controls:Pill.IsEnabled="True" MinHeight="34" Padding="14,4,10,4"
                                FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="13"
                                Background="#CC1C1C20" BorderBrush="{StaticResource SiloBorderBrush}"
                                Content="{x:Bind ViewModel.SelectedLibrary.Label, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasLibraryChoice, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind LibraryName(ViewModel.SelectedLibrary), Mode=OneWay}">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="LibraryMenu" Placement="BottomEdgeAlignedRight" Opening="OnLibraryMenuOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- The week strip stays in place while the days scroll under it. -->
        <Border Grid.Row="1" Margin="48,0,48,12" Padding="12" CornerRadius="16" Background="#E6141417"
                BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="1" AutomationProperties.Name="{x:Bind ViewModel.WeekName, Mode=OneWay}">
            <StackPanel Spacing="8">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Style="{StaticResource SiloIconButtonStyle}" Command="{x:Bind ViewModel.PreviousWeekCommand}"
                                AutomationProperties.Name="Previous week" ToolTipService.ToolTip="Previous week">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                        </Button>
                        <TextBlock Text="{x:Bind ViewModel.WeekLabel, Mode=OneWay}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                                   FontSize="14" Foreground="{StaticResource SiloForegroundBrush}" VerticalAlignment="Center" Margin="4,0" />
                        <Button Style="{StaticResource SiloIconButtonStyle}" Command="{x:Bind ViewModel.NextWeekCommand}"
                                AutomationProperties.Name="Next week" ToolTipService.ToolTip="Next week">
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <Button Content="Today" HorizontalAlignment="Right" Style="{StaticResource SiloSecondaryButtonStyle}" Command="{x:Bind ViewModel.ThisWeekCommand}" />
                </Grid>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Days, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MaximumRowsOrColumns="7" ItemsStretch="Fill" MinColumnSpacing="6" MinItemWidth="40" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarDayChip">
                            <Button HorizontalAlignment="Stretch" MinHeight="56" Padding="2,8" CornerRadius="12" BorderThickness="0"
                                    Background="{x:Bind views:CalendarPage.DayBackground(IsSelected, IsToday), Mode=OneWay}"
                                    Command="{x:Bind SelectCommand}" CommandParameter="{x:Bind}"
                                    AutomationProperties.Name="{x:Bind AccessibleName}">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="{x:Bind Label}" FontSize="11" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium"
                                               HorizontalAlignment="Center" CharacterSpacing="40"
                                               Foreground="{x:Bind views:CalendarPage.DayLabelForeground(IsSelected, IsToday), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Day}" FontSize="16" FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{x:Bind views:CalendarPage.DayNumberForeground(IsSelected, IsToday), Mode=OneWay}" />
                                    <Ellipse Width="4" Height="4" HorizontalAlignment="Center" Margin="0,2,0,0"
                                             Fill="{x:Bind views:CalendarPage.DayDotFill(IsSelected, IsToday), Mode=OneWay}"
                                             Opacity="{x:Bind views:CalendarPage.DayDotOpacity(HasEvents)}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="2" XYFocusKeyboardNavigation="Enabled">
            <StackPanel Padding="48,8,48,48" Spacing="24">
                <Border Padding="16,12" CornerRadius="16" Background="#0AFFFFFF" Visibility="{x:Bind ViewModel.HasSelectedDayEmpty, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.SelectedDayEmptyText, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}"
                               Foreground="{StaticResource SiloMutedBrush}" />
                </Border>

                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="32" Height="32" Margin="0,48" HorizontalAlignment="Center" AutomationProperties.Name="Loading the calendar" />
                <StackPanel Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" Spacing="16" Margin="0,48" HorizontalAlignment="Center">
                    <TextBlock Text="Couldn't load the calendar." Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}"
                               TextAlignment="Center" />
                    <Button Content="Retry" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.RetryCommand}" />
                </StackPanel>

                <!-- An empty week offers the other presets. -->
                <Border Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" MinHeight="300" CornerRadius="28" Background="#0AFFFFFF" Padding="24,64">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE787;" FontSize="40" Foreground="{StaticResource SiloMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}"
                                   Foreground="{StaticResource SiloMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.EmptyLinks, Mode=OneWay}" HorizontalAlignment="Center">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalendarPresetLink">
                                    <HyperlinkButton Content="{x:Bind Label}" Foreground="{StaticResource SiloPrimaryBrush}"
                                                     Command="{x:Bind Command}" CommandParameter="{x:Bind Preset}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <ItemsRepeater x:Name="DayRows" ItemsSource="{x:Bind ViewModel.Rows}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="32" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarDayRow">
                            <controls:MediaRow Title="{x:Bind Heading}" TitleBadge="{x:Bind Badge}" ItemsSource="{x:Bind Cards}"
                                               CardInvokedCommand="{x:Bind OpenCommand}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
