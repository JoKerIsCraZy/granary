<?xml version="1.0" encoding="utf-8"?>
<!--
    The Calendar as Granary's own week grid, the design the user chose over the web's rows (docs/ui-design.md): the title
    with the week's summary under it, the presets (Following, Trending, All) and the library filter on the right; the week
    bar (previous and next week, "Nov 16 – 22, 2026", Today); then a column per day, Monday first, each with its weekday and
    date over its airings, today's tinted with the accent, past days' cards dimmed. Each column scrolls on its own, so the
    headers stay in place. A page narrower than the grid needs lists the days one under another instead, their cards
    wrapping. The texts are the web's. The page is cached: Back keeps the week.
-->
<Page
    x:Class="Granary.App.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:views="using:Granary.App.Views"
    xmlns:vm="using:Granary.Core.ViewModels"
    xmlns:t="using:Granary.Core.Texts"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <!-- SiloCardButtonStyle's, pressed in to 0.97 over 160 ms with an ease-out, as the mockup's card:active. -->
        <Style x:Key="CalendarCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-4" />
            <Setter Property="FocusVisualPrimaryThickness" Value="2" />
            <Setter Property="FocusVisualSecondaryThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.16">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Content.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                x:Name="Content"
                                RenderTransformOrigin="0.5,0.5"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                AutomationProperties.AccessibilityView="Raw"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform x:Name="Press" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A card, the same in the grid and in the narrow list; the button is the template's root, as in MediaRow. -->
        <DataTemplate x:Key="AiringTemplate" x:DataType="vm:CalendarAiring">
            <Button Style="{StaticResource CalendarCardButtonStyle}" Command="{x:Bind OpenCommand}" CommandParameter="{x:Bind}"
                    AutomationProperties.Name="{x:Bind AccessibleName}" ToolTipService.ToolTip="{x:Bind ToolTip}">
                <controls:CalendarAiringCard Airing="{x:Bind}" />
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{StaticResource SiloBackgroundBrush}" Padding="40,32,40,24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6" VerticalAlignment="Bottom">
                <TextBlock Text="{x:Bind t:AppText.Get('web.calendar.title')}" FontSize="32" FontFamily="{StaticResource SiloFontExtraBold}"
                           FontWeight="ExtraBold" CharacterSpacing="-20" Foreground="{StaticResource SiloForegroundBrush}"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontSize="14" FontFamily="{StaticResource SiloFontRegular}"
                           Foreground="{StaticResource SiloMutedBrush}" TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.HasSummary, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                <Border Padding="4" CornerRadius="{StaticResource SiloPillCornerRadius}" Background="#FF161619"
                        BorderBrush="#FF242428" BorderThickness="1" VerticalAlignment="Center">
                    <controls:PillChoices ItemsSource="{x:Bind ViewModel.Presets}" SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Bind t:AppText.Get('web.calendar.presetLabel')}" />
                </Border>
                <DropDownButton CornerRadius="{StaticResource SiloPillCornerRadius}" controls:Pill.IsEnabled="True" MinHeight="34" Padding="14,4,10,4"
                                FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                Background="#FF161619" BorderBrush="#FF242428"
                                Content="{x:Bind ViewModel.SelectedLibrary.Label, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasLibraryChoice, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind LibraryName(ViewModel.SelectedLibrary), Mode=OneWay}">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="LibraryMenu" Placement="BottomEdgeAlignedRight" Opening="OnLibraryMenuOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- The week bar. -->
        <Grid Grid.Row="1" AutomationProperties.Name="{x:Bind ViewModel.WeekName, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Style="{StaticResource SiloIconButtonStyle}" Width="36" Height="36" Background="#FF1C1C20" BorderThickness="0"
                        Command="{x:Bind ViewModel.PreviousWeekCommand}"
                        AutomationProperties.Name="{x:Bind t:AppText.Get('web.calendar.previousWeek')}" ToolTipService.ToolTip="{x:Bind t:AppText.Get('web.calendar.previousWeek')}">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <Button Style="{StaticResource SiloIconButtonStyle}" Width="36" Height="36" Background="#FF1C1C20" BorderThickness="0"
                        Command="{x:Bind ViewModel.NextWeekCommand}"
                        AutomationProperties.Name="{x:Bind t:AppText.Get('web.calendar.nextWeek')}" ToolTipService.ToolTip="{x:Bind t:AppText.Get('web.calendar.nextWeek')}">
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </Button>
                <TextBlock Text="{x:Bind ViewModel.WeekLabel, Mode=OneWay}" Margin="6,0,0,0" FontSize="18" FontFamily="{StaticResource SiloFontBold}"
                           FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{StaticResource SiloForegroundBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="{x:Bind t:AppText.Get('web.calendar.todayButton')}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource SiloSecondaryButtonStyle}" MinHeight="34" Padding="16,6" FontSize="13"
                    Background="Transparent" BorderBrush="#FF34343A" Command="{x:Bind ViewModel.ThisWeekCommand}" />
        </Grid>

        <Grid x:Name="DayArea" Grid.Row="2" SizeChanged="OnDaysSizeChanged" XYFocusKeyboardNavigation="Enabled"
              XYFocusLeftNavigationStrategy="NavigationDirectionDistance" XYFocusRightNavigationStrategy="NavigationDirectionDistance">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="32" Height="32" Margin="0,48" HorizontalAlignment="Center" VerticalAlignment="Top"
                          AutomationProperties.Name="{x:Bind t:AppText.Get('web.calendar.loading')}" />
            <StackPanel Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" Spacing="16" Margin="0,48" HorizontalAlignment="Center" VerticalAlignment="Top">
                <TextBlock Text="{x:Bind t:AppText.Get('granary.calendar.loadFailed')}" Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}"
                           TextAlignment="Center" />
                <Button Content="{x:Bind t:AppText.Get('common.retry')}" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.RetryCommand}" />
            </StackPanel>

            <!-- An empty week offers the other presets. -->
            <Border Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" MinHeight="300" CornerRadius="28" Background="#0AFFFFFF" Padding="24,64"
                    VerticalAlignment="Top">
                <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE787;" FontSize="40" Foreground="{StaticResource SiloMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}"
                               Foreground="{StaticResource SiloMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.EmptyLinks, Mode=OneWay}" HorizontalAlignment="Center">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalendarPresetLink">
                                <HyperlinkButton Content="{x:Bind Label}" Foreground="{StaticResource SiloPrimaryBrush}"
                                                 Command="{x:Bind Command}" CommandParameter="{x:Bind Preset}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- The week grid: seven columns filling the rest of the page, each scrolling on its own. -->
            <ItemsRepeater x:Name="WeekGrid" ItemsSource="{x:Bind ViewModel.Days}" Visibility="{x:Bind GridVisibility(ViewModel.IsReady, IsWide), Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <controls:WeekColumnsLayout Spacing="10" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:CalendarWeekDay">
                        <Grid Padding="8,12,8,8" RowSpacing="6" CornerRadius="16" BorderThickness="1"
                              Background="{x:Bind views:CalendarPage.ColumnBackground(IsToday)}" BorderBrush="{x:Bind views:CalendarPage.ColumnRing(IsToday)}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- Read as the day's heading, "Thursday, October 1st", then TODAY on today's. -->
                            <Grid Padding="6,2,6,4" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Weekday}" FontSize="12" FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold"
                                               CharacterSpacing="100" Foreground="{StaticResource SiloMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                               AutomationProperties.Name="{x:Bind Heading}" AutomationProperties.HeadingLevel="Level2" />
                                    <TextBlock Text="{x:Bind DayNumber}" FontSize="22" FontFamily="{StaticResource SiloFontExtraBold}" FontWeight="ExtraBold"
                                               Typography.NumeralAlignment="Tabular" Foreground="{StaticResource SiloForegroundBrush}"
                                               AutomationProperties.AccessibilityView="Raw" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Badge}" FontSize="10" FontFamily="{StaticResource SiloFontExtraBold}" FontWeight="ExtraBold"
                                           CharacterSpacing="100" Foreground="{StaticResource SiloPrimaryBrush}" Grid.Column="1"
                                           VerticalAlignment="Bottom" Margin="0,0,0,4" Visibility="{x:Bind IsToday}" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" Visibility="{x:Bind HasAirings}" HorizontalScrollMode="Disabled"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsRepeater ItemsSource="{x:Bind Airings}" ItemTemplate="{StaticResource AiringTemplate}" Margin="4"
                                               Opacity="{x:Bind views:CalendarPage.CardsOpacity(IsPast)}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="14" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </ScrollViewer>
                            <Grid Grid.Row="1" Margin="4" MinHeight="90" Visibility="{x:Bind HasNoAirings}">
                                <Rectangle RadiusX="12" RadiusY="12" Stroke="#FF2A2A30" StrokeThickness="1" StrokeDashArray="4,3" />
                                <TextBlock Text="{x:Bind t:AppText.Get('granary.calendar.dayEmpty')}" FontSize="12" Foreground="#FF6F6F78"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="8" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Too narrow for seven columns: the days one under another, their cards wrapping. -->
            <ScrollViewer x:Name="DayList" Visibility="{x:Bind ListVisibility(ViewModel.IsReady, IsWide), Mode=OneWay}" Margin="-4,0,-4,0">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Days}" Margin="4,0,4,24">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="28" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarWeekDay">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{x:Bind Heading}" Style="{StaticResource SiloRowTitleTextStyle}" VerticalAlignment="Center"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <TextBlock Text="{x:Bind Badge}" FontSize="10" FontFamily="{StaticResource SiloFontExtraBold}" FontWeight="ExtraBold"
                                               CharacterSpacing="100" Foreground="{StaticResource SiloPrimaryBrush}" VerticalAlignment="Center"
                                               Visibility="{x:Bind IsToday}" />
                                </StackPanel>
                                <ItemsRepeater ItemsSource="{x:Bind Airings}" ItemTemplate="{StaticResource AiringTemplate}" Visibility="{x:Bind HasAirings}"
                                               Opacity="{x:Bind views:CalendarPage.CardsOpacity(IsPast)}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="200" MinColumnSpacing="14" MinRowSpacing="18" ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <Grid MinHeight="56" Visibility="{x:Bind HasNoAirings}">
                                    <Rectangle RadiusX="12" RadiusY="12" Stroke="#FF2A2A30" StrokeThickness="1" StrokeDashArray="4,3" />
                                    <TextBlock Text="{x:Bind t:AppText.Get('granary.calendar.dayEmpty')}" FontSize="12" Foreground="#FF6F6F78"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
