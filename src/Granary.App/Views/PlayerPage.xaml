<?xml version="1.0" encoding="utf-8"?>
<!--
    The player (docs/ui-design.md, Player), laid out as Silo's web player: Minimize top left, Exit top right; at the bottom the
    seek bar across the width, under it the title on the left, the transport in the middle and volume and full screen on
    the right. The controls fade out during playback. The page itself takes focus, so the keyboard map works without a
    control being focused; it has no focus visual of its own. Minimized, it is the bar at the bottom of the window
    (DockBar), the picture playing on at its left (MainWindow.Player.cs).
-->
<Page
    x:Class="Granary.App.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:player="using:Granary.Core.ViewModels.Player"
    IsTabStop="True"
    AutomationProperties.Name="Player">

    <Grid x:Name="Root" Background="Black">
        <!-- The picture; on the Playing Next screen it plays on small in the top left corner (PlayerPage.NextUp.cs). -->
        <Border x:Name="VideoFrame">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.7" />
            </Border.OpacityTransition>
            <controls:MpvVideoHost x:Name="VideoHost" SizeChanged="OnVideoHostSizeChanged" />
        </Border>

        <!-- The picture: a click plays or pauses, a double click toggles full screen. -->
        <Grid x:Name="Surface" Background="Transparent" Tapped="OnSurfaceTapped" DoubleTapped="OnSurfaceDoubleTapped"
              Visibility="{x:Bind ShowsUndocked(IsDocked), Mode=OneWay}" />

        <!--
            Preparing, and waiting for data later on: Granary's mark runs its loading loop. The dark disc keeps it visible on
            a bright picture.
        -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
              Visibility="{x:Bind SpinnerVisibility(ViewModel.Phase, ViewModel.IsBuffering, IsDocked), Mode=OneWay}">
            <Ellipse Width="88" Height="88" Fill="#73000000" />
            <controls:GranaryMark Width="60" Height="60"
                                  IsLoading="{x:Bind ShowsSpinner(ViewModel.Phase, ViewModel.IsBuffering), Mode=OneWay}"
                                  AutomationProperties.Name="{x:Bind SpinnerName(ViewModel.Phase), Mode=OneWay}" />
        </Grid>

        <!-- Failed: what went wrong, Retry when it can help, and Back. -->
        <Grid Background="#B3000000" Visibility="{x:Bind ShowsInWindow(ViewModel.IsFailed, IsDocked), Mode=OneWay}">
            <StackPanel MaxWidth="560" Margin="32" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7BA;" FontSize="36" Foreground="{StaticResource SiloPrimaryBrush}" />
                <TextBlock x:Name="ErrorText" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource SiloRowTitleTextStyle}"
                           TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Button x:Name="RetryButton" Content="Retry" Style="{StaticResource SiloPrimaryButtonStyle}"
                            Command="{x:Bind ViewModel.RetryCommand}" Visibility="{x:Bind ViewModel.CanRetry, Mode=OneWay}" />
                    <Button x:Name="FailedBackButton" Content="Back" Style="{StaticResource SiloSecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.CloseCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Top bar: Minimize (the web's chevron) top left, Exit top right. In a window it starts below the title bar's drag area. -->
        <Grid x:Name="TopChrome" VerticalAlignment="Top" Visibility="{x:Bind ShowsTopChrome(ViewModel.IsNextUpScreenShown, IsCompact), Mode=OneWay}">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.3" />
            </Grid.OpacityTransition>
            <Grid.TranslationTransition>
                <Vector3Transition Duration="0:0:0.3" />
            </Grid.TranslationTransition>
            <Border Background="{StaticResource SiloPlayerTopScrimBrush}" IsHitTestVisible="False" />
            <Grid x:Name="TopBar" Padding="{x:Bind TopBarPadding(IsFullScreen), Mode=OneWay}">
                <Button x:Name="MinimizeButton" Style="{StaticResource SiloPlayerDiscButtonStyle}" HorizontalAlignment="Left"
                        Click="OnMinimizeClick" AutomationProperties.Name="Minimize player" ToolTipService.ToolTip="Minimize player">
                    <FontIcon Glyph="&#xE70D;" FontSize="16" />
                </Button>
                <Button x:Name="ExitButton" Style="{StaticResource SiloPlayerPillButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.CloseCommand}" AutomationProperties.Name="Exit"
                        AutomationProperties.AcceleratorKey="Escape" ToolTipService.ToolTip="Exit (Esc)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                        <TextBlock Text="Exit" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Bottom bar: the seek bar, then the title with the times, the transport, and volume and full screen. -->
        <Grid x:Name="BottomChrome" VerticalAlignment="Bottom"
              Visibility="{x:Bind ShowsTransport(ViewModel.Phase, ViewModel.IsNextUpScreenShown, IsCompact), Mode=OneWay}">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.3" />
            </Grid.OpacityTransition>
            <Grid.TranslationTransition>
                <Vector3Transition Duration="0:0:0.3" />
            </Grid.TranslationTransition>
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="2" Background="{StaticResource SiloPlayerBottomScrimBrush}" IsHitTestVisible="False" />

            <!-- Transparent, so a click that misses a button does not reach the picture. -->
            <Grid x:Name="BottomBar" Grid.Row="1" Padding="32,0,32,24" RowSpacing="12" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:SeekBar x:Name="SeekBar" AutomationProperties.Name="Seek"
                                  Position="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}"
                                  Duration="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                                  Markers="{x:Bind ViewModel.SeekBarMarkers, Mode=OneWay}"
                                  EditKind="{x:Bind EditKindOf(ViewModel.MarkerEditor.IsEditing, ViewModel.MarkerEditor.ActiveKind), Mode=OneWay}"
                                  MarkerEdgeDragged="OnMarkerEdgeDragged"
                                  Chapters="{x:Bind ViewModel.ChapterMarks, Mode=OneWay}"
                                  Trickplay="{x:Bind ViewModel.Trickplay, Mode=OneWay}"
                                  IsEnabled="{x:Bind ViewModel.CanSeek, Mode=OneWay}"
                                  SeekRequested="OnSeekRequested" />

                <Grid Grid.Row="1" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="RightColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        The title, and "S1 · E1 — EPISODE · 31:55 / 48:41" under it. Left-aligned, the line takes only the
                        width it needs, so the times follow the episode; a long episode title is cut, never the times.
                        Clicking the times switches the end between duration and time left.
                    -->
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource SiloPlayerTitleTextStyle}" />
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind MetaText(ViewModel.Subtitle), Mode=OneWay}" Style="{StaticResource SiloPlayerMetaTextStyle}"
                                       Foreground="{StaticResource SiloPlayerMetaBrush}" Visibility="{x:Bind Shows(ViewModel.Subtitle), Mode=OneWay}"
                                       AutomationProperties.Name="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="·" Margin="5,0,3,0" Style="{StaticResource SiloPlayerMetaTextStyle}"
                                       Foreground="{StaticResource SiloPlayerMetaBrush}" Visibility="{x:Bind Shows(ViewModel.Subtitle), Mode=OneWay}"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <Button Grid.Column="2" Margin="-4,-2" Style="{StaticResource SiloPlayerTextButtonStyle}" Click="OnEndTimeClick"
                                    AutomationProperties.Name="{x:Bind EndTimeName(ShowsRemaining), Mode=OneWay}">
                                <TextBlock Style="{StaticResource SiloPlayerMetaTextStyle}" Typography.NumeralAlignment="Tabular"
                                           Text="{x:Bind TimesText(ViewModel.PositionSeconds, ViewModel.DurationSeconds, ShowsRemaining), Mode=OneWay}" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!--
                        Previous and next episode either side of the skips, as on the web: both slots stay while one has an
                        episode, so Play keeps the middle.
                    -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                        <Grid Width="44" Visibility="{x:Bind ViewModel.ShowsEpisodeSlots, Mode=OneWay}">
                            <Button x:Name="PreviousEpisodeButton" Style="{StaticResource SiloPlayerDiscButtonStyle}"
                                    Command="{x:Bind ViewModel.PlayPreviousEpisodeCommand}" Visibility="{x:Bind ViewModel.HasPreviousEpisode, Mode=OneWay}"
                                    AutomationProperties.Name="Previous episode" ToolTipService.ToolTip="Previous episode">
                                <FontIcon Glyph="&#xE892;" FontSize="16" />
                            </Button>
                        </Grid>
                        <Button x:Name="SkipBackButton" Style="{StaticResource SiloPlayerDiscButtonStyle}" Command="{x:Bind ViewModel.SkipBackCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSeek, Mode=OneWay}" AutomationProperties.AcceleratorKey="Left">
                            <Grid>
                                <!-- Segoe's refresh arrow, mirrored: a loop turning back, with the interval inside. -->
                                <FontIcon Glyph="&#xE72C;" FontSize="28" RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <TextBlock x:Name="SkipBackText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="9" />
                            </Grid>
                        </Button>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource SiloPlayerPlayButtonStyle}" Command="{x:Bind ViewModel.TogglePauseCommand}"
                                AutomationProperties.Name="{x:Bind PlayPauseName(ViewModel.IsPaused), Mode=OneWay}" AutomationProperties.AcceleratorKey="Space"
                                ToolTipService.ToolTip="{x:Bind PlayPauseToolTip(ViewModel.IsPaused), Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind PlayPauseGlyph(ViewModel.IsPaused), Mode=OneWay}" FontSize="24"
                                      Margin="{x:Bind PlayPauseGlyphMargin(ViewModel.IsPaused), Mode=OneWay}" />
                        </Button>
                        <Button x:Name="SkipForwardButton" Style="{StaticResource SiloPlayerDiscButtonStyle}" Command="{x:Bind ViewModel.SkipForwardCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSeek, Mode=OneWay}" AutomationProperties.AcceleratorKey="Right">
                            <Grid>
                                <FontIcon Glyph="&#xE72C;" FontSize="28" />
                                <TextBlock x:Name="SkipForwardText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="9" />
                            </Grid>
                        </Button>
                        <Grid Width="44" Visibility="{x:Bind ViewModel.ShowsEpisodeSlots, Mode=OneWay}">
                            <Button x:Name="NextEpisodeButton" Style="{StaticResource SiloPlayerDiscButtonStyle}"
                                    Command="{x:Bind ViewModel.PlayNextEpisodeCommand}" Visibility="{x:Bind ViewModel.HasNextEpisode, Mode=OneWay}"
                                    AutomationProperties.Name="Next episode" ToolTipService.ToolTip="Next episode">
                                <FontIcon Glyph="&#xE893;" FontSize="16" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="RightControls" Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                LayoutUpdated="OnRightControlsLayoutUpdated">
                        <Button x:Name="MuteButton" Style="{StaticResource SiloPlayerIconButtonStyle}" Command="{x:Bind ViewModel.ToggleMuteCommand}"
                                AutomationProperties.Name="{x:Bind MuteName(ViewModel.IsMuted), Mode=OneWay}" AutomationProperties.AcceleratorKey="M"
                                ToolTipService.ToolTip="{x:Bind MuteToolTip(ViewModel.IsMuted), Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind VolumeGlyph(ViewModel.IsMuted, ViewModel.Volume), Mode=OneWay}" FontSize="18" />
                        </Button>
                        <!-- Muted, the slider keeps the level to come back to and only dims. -->
                        <Slider x:Name="VolumeSlider" Width="96" Margin="0,0,4,0" VerticalAlignment="Center" Minimum="0" Maximum="100"
                                StepFrequency="1" SmallChange="5" LargeChange="10" IsThumbToolTipEnabled="False"
                                Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" Opacity="{x:Bind VolumeOpacity(ViewModel.IsMuted), Mode=OneWay}"
                                AutomationProperties.Name="Volume">
                            <Slider.Resources>
                                <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
                                <SolidColorBrush x:Key="SliderTrackFill" Color="#38FFFFFF" />
                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#4DFFFFFF" />
                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#4DFFFFFF" />
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="#EBFFFFFF" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="Transparent" />
                            </Slider.Resources>
                        </Slider>
                        <!-- Shown with a track to name; as on the web player it opens once there are two to choose from. -->
                        <Button x:Name="AudioButton" Style="{StaticResource SiloPlayerIconButtonStyle}"
                                Visibility="{x:Bind ViewModel.HasAudioTracks, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanChooseAudio, Mode=OneWay}"
                                AutomationProperties.Name="Audio tracks" ToolTipService.ToolTip="Audio tracks">
                            <FontIcon Glyph="&#xE9E9;" FontSize="18" />
                            <Button.Flyout>
                                <Flyout x:Name="AudioMenu" Placement="TopEdgeAlignedRight" FlyoutPresenterStyle="{StaticResource SiloPlayerMenuStyle}"
                                        Opened="OnAudioMenuOpened">
                                    <StackPanel XYFocusKeyboardNavigation="Enabled">
                                        <TextBlock Text="AUDIO" Style="{StaticResource SiloPlayerMenuHeaderTextStyle}" AutomationProperties.Name="Audio" />
                                        <ItemsControl x:Name="AudioRows" ItemsSource="{x:Bind ViewModel.AudioTracks, Mode=OneWay}" IsTabStop="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="player:AudioTrackOption">
                                                    <Button Style="{StaticResource SiloPlayerMenuItemStyle}" Click="OnAudioTrackClick"
                                                            AutomationProperties.Name="{x:Bind AccessibleName}"
                                                            AutomationProperties.ItemStatus="{x:Bind controls:PlayerMenus.Status(IsSelected)}">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="16" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="&#x2713;" FontSize="14" Margin="0,1,0,0" HorizontalAlignment="Center"
                                                                       Foreground="{StaticResource SiloPlayerMenuChosenBrush}" Visibility="{x:Bind IsSelected}" />
                                                            <StackPanel Grid.Column="1" Spacing="4">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="{x:Bind Title}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="14"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="180"
                                                                               Foreground="{x:Bind controls:PlayerMenus.RowForeground(IsSelected)}" />
                                                                    <Border Style="{StaticResource SiloPlayerMenuChipStyle}" Visibility="{x:Bind controls:PlayerMenus.Shows(Codec)}">
                                                                        <TextBlock Text="{x:Bind controls:PlayerMenus.Upper(Codec)}" Style="{StaticResource SiloPlayerMenuChipTextStyle}" />
                                                                    </Border>
                                                                    <Border Style="{StaticResource SiloPlayerMenuChipStyle}" Visibility="{x:Bind controls:PlayerMenus.Shows(Channels)}">
                                                                        <TextBlock Text="{x:Bind controls:PlayerMenus.Upper(Channels)}" Style="{StaticResource SiloPlayerMenuChipTextStyle}" />
                                                                    </Border>
                                                                    <Border Style="{StaticResource SiloPlayerMenuOutlineChipStyle}" Visibility="{x:Bind IsDefault}">
                                                                        <TextBlock Text="DEFAULT" Style="{StaticResource SiloPlayerMenuChipTextStyle}" Foreground="#B3FFFFFF" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{x:Bind Meta}" FontSize="11" Foreground="#8CFFFFFF" TextTrimming="CharacterEllipsis"
                                                                           Visibility="{x:Bind controls:PlayerMenus.Shows(Meta)}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!-- The web player's Chapters menu: a picture, the title and its start; a row seeks there and closes. -->
                        <Button x:Name="ChaptersButton" Style="{StaticResource SiloPlayerIconButtonStyle}"
                                Visibility="{x:Bind ViewModel.HasChapters, Mode=OneWay}"
                                AutomationProperties.Name="Chapters" ToolTipService.ToolTip="Chapters">
                            <FontIcon Glyph="&#xE8FD;" FontSize="18" />
                            <Button.Flyout>
                                <Flyout x:Name="ChaptersMenu" Placement="TopEdgeAlignedRight" FlyoutPresenterStyle="{StaticResource SiloPlayerWideMenuStyle}"
                                        Opened="OnChaptersMenuOpened">
                                    <StackPanel MinWidth="280" XYFocusKeyboardNavigation="Enabled">
                                        <TextBlock Text="CHAPTERS" Style="{StaticResource SiloPlayerMenuHeaderTextStyle}" AutomationProperties.Name="Chapters" />
                                        <ItemsControl x:Name="ChapterRows" ItemsSource="{x:Bind ViewModel.Chapters, Mode=OneWay}" IsTabStop="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="player:ChapterOption">
                                                    <Button Style="{StaticResource SiloPlayerMenuItemStyle}" Click="OnChapterClick"
                                                            Background="{x:Bind controls:PlayerMenus.SubtitleRowBackground(IsCurrent)}"
                                                            Foreground="{x:Bind controls:PlayerMenus.SubtitleRowForeground(IsCurrent)}"
                                                            AutomationProperties.Name="{x:Bind controls:PlayerMenus.ChapterName(Title, StartSeconds)}"
                                                            AutomationProperties.ItemStatus="{x:Bind controls:PlayerMenus.ChapterStatus(IsCurrent)}">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="80" Height="48" CornerRadius="4" Background="#0FFFFFFF">
                                                                <Grid>
                                                                    <FontIcon Glyph="&#xE714;" FontSize="16" Foreground="#33FFFFFF" />
                                                                    <Image Source="{x:Bind controls:PlayerMenus.ChapterThumbnail(Thumbnail)}" Stretch="UniformToFill" />
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                <TextBlock Text="{x:Bind Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind controls:PlayerMenus.ChapterStart(StartSeconds)}" FontSize="12" Foreground="#73FFFFFF"
                                                                           Typography.NumeralAlignment="Tabular" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!--
                            Subtitles: there for every server title, as its menu also adds them. White with the amber dot while one
                            shows; struck through while none does, as the web's CaptionsOff.
                        -->
                        <Grid Visibility="{x:Bind ViewModel.HasSubtitleMenu, Mode=OneWay}">
                        <Button x:Name="SubtitleButton" Style="{StaticResource SiloPlayerIconButtonStyle}"
                                Foreground="{x:Bind UtilityForeground(ViewModel.IsSubtitleOn), Mode=OneWay}"
                                AutomationProperties.Name="Subtitles" AutomationProperties.ItemStatus="{x:Bind OnStatus(ViewModel.IsSubtitleOn), Mode=OneWay}"
                                AutomationProperties.AcceleratorKey="C" ToolTipService.ToolTip="Subtitles (C)">
                            <Grid Width="20" Height="20">
                                <FontIcon x:Name="SubtitleGlyph" Glyph="&#xE7F0;" FontSize="18" />
                                <Line X1="3" Y1="3" X2="17" Y2="17" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{Binding Foreground, ElementName=SubtitleGlyph}" Visibility="{x:Bind Not(ViewModel.IsSubtitleOn), Mode=OneWay}" />
                            </Grid>
                            <Button.Flyout>
                                <Flyout x:Name="SubtitleMenu" Placement="TopEdgeAlignedRight" FlyoutPresenterStyle="{StaticResource SiloPlayerWideMenuStyle}"
                                        Opened="OnSubtitleMenuOpened">
                                    <StackPanel XYFocusKeyboardNavigation="Enabled">
                                    <ItemsControl x:Name="SubtitleRows" ItemsSource="{x:Bind ViewModel.SubtitleTracks, Mode=OneWay}" IsTabStop="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="player:SubtitleTrackOption">
                                                <Button Style="{StaticResource SiloPlayerMenuItemStyle}" Click="OnSubtitleTrackClick"
                                                        Background="{x:Bind controls:PlayerMenus.SubtitleRowBackground(IsSelected)}"
                                                        Foreground="{x:Bind controls:PlayerMenus.SubtitleRowForeground(IsSelected)}"
                                                        AutomationProperties.Name="{x:Bind AccessibleName}"
                                                        AutomationProperties.ItemStatus="{x:Bind controls:PlayerMenus.Status(IsSelected)}">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#x2713;" FontSize="12" Margin="0,2,0,0" HorizontalAlignment="Center"
                                                                   Visibility="{x:Bind IsSelected}" />
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{x:Bind Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <Border Style="{StaticResource SiloPlayerMenuChipStyle}" Visibility="{x:Bind controls:PlayerMenus.Shows(Format)}">
                                                                        <TextBlock Text="{x:Bind Format}" Style="{StaticResource SiloPlayerMenuChipTextStyle}"
                                                                                   FontSize="10" FontFamily="{StaticResource SiloFontRegular}" FontWeight="Normal" Foreground="#80FFFFFF" />
                                                                    </Border>
                                                                    <Border Style="{StaticResource SiloPlayerMenuChipStyle}" Visibility="{x:Bind controls:PlayerMenus.Shows(Source)}">
                                                                        <TextBlock Text="{x:Bind controls:PlayerMenus.Upper(Source)}" Style="{StaticResource SiloPlayerMenuChipTextStyle}"
                                                                                   FontSize="10" FontFamily="{StaticResource SiloFontRegular}" FontWeight="Normal" Foreground="#80FFFFFF" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                            <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="#66FFFFFF" TextTrimming="CharacterEllipsis"
                                                                       Visibility="{x:Bind controls:PlayerMenus.Shows(Detail)}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Silo's web: DELAY, then earlier, the value, later, and Reset; steps of 100 ms up to 10 s. -->
                                    <Grid Margin="0,6,0,0" Padding="12,8" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DELAY" FontSize="12" CharacterSpacing="25" Foreground="#80FFFFFF" VerticalAlignment="Center"
                                                   AutomationProperties.AccessibilityView="Raw" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SiloPlayerMenuStepButtonStyle}" Click="OnSubtitleEarlierClick"
                                                    IsEnabled="{x:Bind ViewModel.CanDelayEarlier, Mode=OneWay}"
                                                    AutomationProperties.Name="Subtitles 100 ms earlier">
                                                <FontIcon Glyph="&#xE738;" FontSize="12" />
                                            </Button>
                                            <TextBlock MinWidth="72" Text="{x:Bind ViewModel.SubtitleDelayText, Mode=OneWay}" FontFamily="Consolas" FontSize="12"
                                                       Foreground="#CCFFFFFF" TextAlignment="Center" VerticalAlignment="Center"
                                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{x:Bind controls:PlayerMenus.DelayName(ViewModel.SubtitleDelayText), Mode=OneWay}" />
                                            <Button Style="{StaticResource SiloPlayerMenuStepButtonStyle}" Click="OnSubtitleLaterClick"
                                                    IsEnabled="{x:Bind ViewModel.CanDelayLater, Mode=OneWay}"
                                                    AutomationProperties.Name="Subtitles 100 ms later">
                                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource SiloPlayerMenuStepButtonStyle}" Width="Auto" Padding="8,0" Margin="4,0,0,0"
                                                    Foreground="#99FFFFFF" Click="OnSubtitleDelayResetClick"
                                                    IsEnabled="{x:Bind ViewModel.CanResetSubtitleDelay, Mode=OneWay}"
                                                    AutomationProperties.Name="Reset subtitle delay">
                                                <TextBlock Text="Reset" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <!-- The web's footer: add a file or search for one, and the look. -->
                                    <StackPanel Padding="0,4" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">
                                        <Button x:Name="AddSubtitlesButton" Style="{StaticResource SiloPlayerMenuItemStyle}" Foreground="#B3FFFFFF"
                                                Click="OnAddSubtitlesClick" AutomationProperties.Name="Add Subtitles…">
                                            <TextBlock Text="Add Subtitles…" FontSize="14" />
                                        </Button>
                                        <Button x:Name="AppearanceButton" Style="{StaticResource SiloPlayerMenuItemStyle}" Foreground="#B3FFFFFF"
                                                Click="OnAppearanceClick" AutomationProperties.Name="Appearance…">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE790;" FontSize="13" Foreground="#80FFFFFF" />
                                                <TextBlock Text="Appearance…" FontSize="14" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Ellipse Style="{StaticResource SiloPlayerActiveDotStyle}" Visibility="{x:Bind ViewModel.IsSubtitleOn, Mode=OneWay}" />
                        </Grid>
                        <!--
                            The web player's settings (QualityMenu): the gear names the quality, and a speed other than 1x shows
                            beside it. SPEED always; VERSION with more than one file; QUALITY when the plan offers rungs.
                        -->
                        <Button x:Name="SettingsButton" Style="{StaticResource SiloPlayerIconButtonStyle}" Width="Auto" Padding="10,0,12,0"
                                Background="#14FFFFFF" AutomationProperties.Name="{x:Bind SettingsName(ViewModel.SpeedBadge), Mode=OneWay}"
                                ToolTipService.ToolTip="Playback settings">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE713;" FontSize="16" />
                                <TextBlock Text="{x:Bind ViewModel.SettingsLabel, Mode=OneWay}" VerticalAlignment="Center" FontFamily="{StaticResource SiloFontMedium}"
                                           FontWeight="Medium" FontSize="11" CharacterSpacing="25" Visibility="{x:Bind Shows(ViewModel.SettingsLabel), Mode=OneWay}" />
                                <Border Background="White" CornerRadius="7" Padding="5,0" Height="14" VerticalAlignment="Center"
                                        Visibility="{x:Bind Shows(ViewModel.SpeedBadge), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.SpeedBadge, Mode=OneWay}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                                               FontSize="9" Foreground="Black" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                </Border>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="SettingsMenu" Placement="TopEdgeAlignedRight" FlyoutPresenterStyle="{StaticResource SiloPlayerMenuStyle}">
                                    <StackPanel MinWidth="240" XYFocusKeyboardNavigation="Enabled">
                                        <controls:SpeedTrack x:Name="SpeedTrack" Speed="{x:Bind ViewModel.Speed, Mode=OneWay}" SpeedPicked="OnSpeedPicked"
                                                             AutomationProperties.Name="Playback speed" />

                                        <StackPanel Visibility="{x:Bind ViewModel.HasVersionOptions, Mode=OneWay}">
                                            <Border Height="1" Margin="0,4" Background="#1AFFFFFF" />
                                            <TextBlock Text="VERSION" Style="{StaticResource SiloPlayerMenuHeaderTextStyle}" AutomationProperties.Name="Version" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.VersionOptions, Mode=OneWay}" IsTabStop="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="player:VersionOption">
                                                        <Button Style="{StaticResource SiloPlayerMenuItemStyle}" Click="OnVersionClick" Tag="{x:Bind FileId}"
                                                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                                                AutomationProperties.ItemStatus="{x:Bind controls:PlayerMenus.Status(IsPlaying)}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{x:Bind Label}" FontSize="14" VerticalAlignment="Center"
                                                                           Foreground="{x:Bind controls:PlayerMenus.SubtitleRowForeground(IsPlaying)}" />
                                                                <Border Padding="6,2" CornerRadius="4" BorderThickness="1" BorderBrush="#26FFFFFF" Background="#1AFFFFFF"
                                                                        VerticalAlignment="Center" Visibility="{x:Bind controls:PlayerMenus.Shows(Status)}">
                                                                    <TextBlock Text="{x:Bind Status}" FontSize="10" Foreground="#B3FFFFFF" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Visibility="{x:Bind ViewModel.HasQualityOptions, Mode=OneWay}">
                                            <Border Height="1" Margin="0,4" Background="#1AFFFFFF" />
                                            <TextBlock Text="QUALITY" Style="{StaticResource SiloPlayerMenuHeaderTextStyle}" AutomationProperties.Name="Quality" />
                                            <ItemsControl x:Name="QualityRows" ItemsSource="{x:Bind ViewModel.QualityOptions, Mode=OneWay}" IsTabStop="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="player:QualityOption">
                                                        <Button Style="{StaticResource SiloPlayerMenuItemStyle}" Click="OnQualityClick" Tag="{x:Bind Preference}"
                                                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                                                AutomationProperties.ItemStatus="{x:Bind controls:PlayerMenus.Status(IsSelected)}">
                                                            <Grid ColumnSpacing="16">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{x:Bind Label}" FontSize="14" VerticalAlignment="Center"
                                                                           Foreground="{x:Bind controls:PlayerMenus.SubtitleRowForeground(IsSelected)}" />
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Bitrate}" FontSize="12" Foreground="#66FFFFFF" VerticalAlignment="Center" />
                                                                    <Border Width="16" Height="16" CornerRadius="8" Background="White" Visibility="{x:Bind IsSelected}">
                                                                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="Black" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!-- Edit markers, for an account that may: the web's tag button, white with the dot while the panel is open. -->
                        <Grid Visibility="{x:Bind ViewModel.CanEditMarkers, Mode=OneWay}">
                            <Button x:Name="EditMarkersButton" Style="{StaticResource SiloPlayerIconButtonStyle}" Command="{x:Bind ViewModel.ToggleMarkerEditCommand}"
                                    Foreground="{x:Bind UtilityForeground(ViewModel.MarkerEditor.IsEditing), Mode=OneWay}"
                                    AutomationProperties.Name="Edit markers" AutomationProperties.ItemStatus="{x:Bind OnStatus(ViewModel.MarkerEditor.IsEditing), Mode=OneWay}"
                                    ToolTipService.ToolTip="Edit markers">
                                <FontIcon Glyph="&#xE8EC;" FontSize="18" />
                            </Button>
                            <Ellipse Style="{StaticResource SiloPlayerActiveDotStyle}" Visibility="{x:Bind ViewModel.MarkerEditor.IsEditing, Mode=OneWay}" />
                        </Grid>
                        <!-- Playback info, the mini view (the web's Picture in Picture) and Fill screen, as on the web. -->
                        <Grid>
                            <Button x:Name="PlaybackInfoButton" Style="{StaticResource SiloPlayerIconButtonStyle}" Command="{x:Bind ViewModel.TogglePlaybackInfoCommand}"
                                    Foreground="{x:Bind UtilityForeground(ViewModel.IsPlaybackInfoShown), Mode=OneWay}"
                                    AutomationProperties.Name="Playback info" AutomationProperties.ItemStatus="{x:Bind OnStatus(ViewModel.IsPlaybackInfoShown), Mode=OneWay}"
                                    ToolTipService.ToolTip="Playback info">
                                <FontIcon Glyph="&#xE946;" FontSize="18" />
                            </Button>
                            <Ellipse Style="{StaticResource SiloPlayerActiveDotStyle}" Visibility="{x:Bind ViewModel.IsPlaybackInfoShown, Mode=OneWay}" />
                        </Grid>
                        <Button x:Name="MiniViewButton" Style="{StaticResource SiloPlayerIconButtonStyle}" Click="OnMiniViewClick"
                                AutomationProperties.Name="Mini view" AutomationProperties.AcceleratorKey="P" ToolTipService.ToolTip="Mini view (P)">
                            <FontIcon Glyph="&#xE93A;" FontSize="18" />
                        </Button>
                        <Grid>
                            <Button x:Name="FillButton" Style="{StaticResource SiloPlayerIconButtonStyle}" Command="{x:Bind ViewModel.ToggleFillCommand}"
                                    Foreground="{x:Bind UtilityForeground(ViewModel.IsFillingScreen), Mode=OneWay}"
                                    AutomationProperties.Name="Fill screen" AutomationProperties.ItemStatus="{x:Bind OnStatus(ViewModel.IsFillingScreen), Mode=OneWay}"
                                    ToolTipService.ToolTip="Fill screen">
                                <FontIcon Glyph="&#xE9A6;" FontSize="18" />
                            </Button>
                            <Ellipse Style="{StaticResource SiloPlayerActiveDotStyle}" Visibility="{x:Bind ViewModel.IsFillingScreen, Mode=OneWay}" />
                        </Grid>
                        <Button x:Name="FullScreenButton" Style="{StaticResource SiloPlayerIconButtonStyle}" Click="OnFullScreenClick"
                                AutomationProperties.Name="{x:Bind FullScreenName(IsFullScreen), Mode=OneWay}" AutomationProperties.AcceleratorKey="F"
                                ToolTipService.ToolTip="{x:Bind FullScreenToolTip(IsFullScreen), Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind FullScreenGlyph(IsFullScreen), Mode=OneWay}" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!--
            The skip pill of Silo's web player: bottom right, above the controls while they show (PlaceSkipPrompt). An intro
            pill fills from the left with its 5 s; above an automatic skip's pill, "Intro skipped" confirms it.
        -->
        <!--
            The web player's Playback info: under Exit, 320 px wide, scrolling above the bottom bar; it stays while the
            controls fade, until it is closed.
        -->
        <Border x:Name="PlaybackInfoPanel" Width="320" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="8" Background="#D9000000"
                Margin="{x:Bind PlaybackInfoMargin(IsFullScreen), Mode=OneWay}"
                Visibility="{x:Bind ShowsInWindow(ViewModel.IsPlaybackInfoShown, IsCompact), Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,12,10,4">
                    <TextBlock Text="Playback Info" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="14" Foreground="#E6FFFFFF"
                               VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
                    <Button Width="24" Height="24" HorizontalAlignment="Right" Style="{StaticResource SiloPlayerIconButtonStyle}" CornerRadius="4"
                            Command="{x:Bind ViewModel.TogglePlaybackInfoCommand}" AutomationProperties.Name="Close playback info">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" Padding="16,4,16,12" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PlaybackInfoSections, Mode=OneWay}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="player:PlaybackInfoSection">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{x:Bind controls:PlayerMenus.Upper(Title)}" Margin="0,0,0,4" FontFamily="{StaticResource SiloFontSemiBold}"
                                               FontWeight="SemiBold" FontSize="12" CharacterSpacing="75" Foreground="#80FFFFFF"
                                               AutomationProperties.Name="{x:Bind Title}" AutomationProperties.HeadingLevel="Level2" />
                                    <ItemsControl ItemsSource="{x:Bind Rows}" IsTabStop="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="player:PlaybackInfoRow">
                                                <Grid Padding="0,2" ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Label}" FontSize="14" Foreground="#99FFFFFF" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="14" Foreground="#E6FFFFFF" TextAlignment="Right"
                                                               TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!--
            The mini view: the window floats above the others, small, with only the picture; play or pause in the middle
            and the way back top left, under the title bar's drag area. They fade as the full controls do.
        -->
        <Grid x:Name="MiniChrome" Visibility="{x:Bind IsMiniView, Mode=OneWay}">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.3" />
            </Grid.OpacityTransition>
            <Border Background="#4D000000" IsHitTestVisible="False" />
            <Button x:Name="MiniPlayPauseButton" Style="{StaticResource SiloPlayerPlayButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.TogglePauseCommand}" AutomationProperties.Name="{x:Bind PlayPauseName(ViewModel.IsPaused), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind PlayPauseToolTip(ViewModel.IsPaused), Mode=OneWay}">
                <FontIcon Glyph="{x:Bind PlayPauseGlyph(ViewModel.IsPaused), Mode=OneWay}" FontSize="24"
                          Margin="{x:Bind PlayPauseGlyphMargin(ViewModel.IsPaused), Mode=OneWay}" />
            </Button>
            <Button x:Name="LeaveMiniViewButton" Style="{StaticResource SiloPlayerDiscButtonStyle}" Width="36" Height="36" Margin="12,44,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Click="OnMiniViewClick"
                    AutomationProperties.Name="Back to the full window" ToolTipService.ToolTip="Back to the full window (P or Esc)">
                <FontIcon Glyph="&#xE944;" FontSize="14" />
            </Button>
        </Grid>

        <StackPanel x:Name="SkipPrompt" Margin="0,0,28,28" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Visibility="{x:Bind ShowsInWindow(ViewModel.HasSkipPrompt, IsCompact), Mode=OneWay}">
            <StackPanel.TranslationTransition>
                <Vector3Transition Duration="0:0:0.3" />
            </StackPanel.TranslationTransition>
            <Grid Margin="0,0,12,0" HorizontalAlignment="Right" Visibility="{x:Bind Shows(ViewModel.SkipCaption), Mode=OneWay}">
                <Canvas x:Name="SkipCaptionShade" IsHitTestVisible="False" />
                <TextBlock x:Name="SkipCaptionText" Text="{x:Bind ViewModel.SkipCaption, Mode=OneWay}" FontFamily="{StaticResource SiloFontMedium}"
                           FontWeight="Medium" FontSize="12" Foreground="#BFFFFFFF" />
            </Grid>
            <Button x:Name="SkipButton" Style="{StaticResource SiloPlayerSkipButtonStyle}" HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.SkipCommand}" AutomationProperties.Name="{x:Bind ViewModel.SkipLabel, Mode=OneWay}">
                <Grid>
                    <Border controls:Pill.IsEnabled="True" CornerRadius="{StaticResource SiloPillCornerRadius}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Offset="0" Color="#26FFFFFF" />
                                <GradientStop Offset="{x:Bind ViewModel.SkipProgress, Mode=OneWay}" Color="#26FFFFFF" />
                                <GradientStop Offset="{x:Bind ViewModel.SkipProgress, Mode=OneWay}" Color="#00FFFFFF" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Margin="20,10" VerticalAlignment="Center" Text="{x:Bind ViewModel.SkipLabel, Mode=OneWay}" />
                </Grid>
            </Button>
        </StackPanel>

        <!-- The web's NextEpisodeOverlay at the credits: where the skip pill sits, and above the bar with it. -->
        <Border x:Name="NextUpCard" Margin="0,0,28,28" MinWidth="260" Padding="16" CornerRadius="8" Background="#CC000000"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{x:Bind ShowsInWindow(ViewModel.IsNextUpCardShown, IsCompact), Mode=OneWay}">
            <Border.TranslationTransition>
                <Vector3Transition Duration="0:0:0.3" />
            </Border.TranslationTransition>
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.NextUpCardHeading, Mode=OneWay}" FontSize="12" CharacterSpacing="50" Foreground="#99FFFFFF" />
                <TextBlock Text="{x:Bind ViewModel.NextUpEpisodeText, Mode=OneWay}" MaxWidth="320" TextWrapping="Wrap" FontFamily="{StaticResource SiloFontMedium}"
                           FontWeight="Medium" FontSize="14" Foreground="{StaticResource SiloPlayerForegroundBrush}" />
                <Grid Margin="0,4,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Play Now" Style="{StaticResource SiloPlayerCardButtonStyle}" HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.PlayNextNowCommand}" />
                    <Button Grid.Column="1" Content="Cancel" Style="{StaticResource SiloPlayerCardOutlineButtonStyle}"
                            Command="{x:Bind ViewModel.CancelNextUpCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <!--
            Playing Next (the web's PlayingNextScreen): 30 s before the end and at it. The next episode in the middle on a
            darkened, blurred copy of its still; Play Now with the countdown ring once the episode has ended; the
            auto-play switch; On Deck along the bottom. The video plays on small in the top left corner, above this.
        -->
        <Grid x:Name="NextUpScreen" Canvas.ZIndex="1" Background="Black" Visibility="{x:Bind ShowsInWindow(ViewModel.IsNextUpScreenShown, IsCompact), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- A still decoded 48 px wide and stretched over the page blurs itself. -->
            <Image x:Name="NextUpBackdrop" Grid.RowSpan="2" Stretch="UniformToFill" Opacity="0.35" IsHitTestVisible="False" />
            <Border Grid.RowSpan="2" Background="#B3000000" IsHitTestVisible="False" />

            <ScrollViewer x:Name="NextUpScroller" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="NextUpColumn" MaxWidth="820" Padding="32,24" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Bind NextUpLabel(ViewModel.HasNextEpisode), Mode=OneWay}" HorizontalAlignment="Center" Margin="0,0,0,12"
                               FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="11" CharacterSpacing="250"
                               Foreground="#66FFFFFF" />

                    <StackPanel Visibility="{x:Bind ViewModel.HasNextEpisode, Mode=OneWay}" HorizontalAlignment="Center">
                        <Border x:Name="NextUpStillFrame" CornerRadius="16" BorderThickness="1" BorderBrush="#14FFFFFF" Background="#0DFFFFFF"
                                Margin="0,0,0,20" HorizontalAlignment="Center">
                            <Image x:Name="NextUpStillImage" Stretch="UniformToFill" AutomationProperties.Name="{x:Bind ViewModel.NextUpTitle, Mode=OneWay}" />
                        </Border>
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.NextUpSeriesTitle, Mode=OneWay}" HorizontalAlignment="Center" FontFamily="{StaticResource SiloFontBold}"
                                       FontWeight="Bold" FontSize="18" Foreground="{StaticResource SiloPlayerForegroundBrush}"
                                       AutomationProperties.HeadingLevel="Level1" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.NextUpCode, Mode=OneWay}" VerticalAlignment="Center" FontFamily="{StaticResource SiloFontMedium}"
                                           FontWeight="Medium" FontSize="14" Foreground="#99FFFFFF" />
                                <TextBlock Text="—" VerticalAlignment="Center" FontSize="14" Foreground="#40FFFFFF" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Text="{x:Bind ViewModel.NextUpTitle, Mode=OneWay}" VerticalAlignment="Center" FontFamily="{StaticResource SiloFontSemiBold}"
                                           FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource SiloPlayerForegroundBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.NextUpMeta, Mode=OneWay}" HorizontalAlignment="Center" FontSize="12" Foreground="#66FFFFFF" />
                            <TextBlock Text="{x:Bind ViewModel.NextUpOverview, Mode=OneWay}" MaxWidth="576" Margin="0,4,0,0" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="14" LineHeight="22"
                                       Foreground="#80FFFFFF" Visibility="{x:Bind Shows(ViewModel.NextUpOverview), Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,16,0,0" HorizontalAlignment="Center">
                            <Button x:Name="PlayNowButton" Style="{StaticResource SiloNextUpPlayButtonStyle}" Command="{x:Bind ViewModel.PlayNextNowCommand}"
                                    AutomationProperties.Name="Play Now" AutomationProperties.AcceleratorKey="Enter">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                                    <TextBlock Text="Play Now" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.IsNextUpCountingDown, Mode=OneWay}">
                                <!-- The web's ring: 20 px radius, 3 px stroke, emptying with the countdown from the top. -->
                                <Grid Width="43" Height="43">
                                    <Ellipse Stroke="#14FFFFFF" StrokeThickness="3" />
                                    <Ellipse Stroke="{StaticResource SiloPrimaryBrush}" StrokeThickness="3" StrokeDashArray="41.89 41.89"
                                             StrokeDashCap="Round" StrokeDashOffset="{x:Bind RingOffset(ViewModel.NextUpCountdownLeft), Mode=OneWay}"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.NextUpSecondsText, Mode=OneWay}" VerticalAlignment="Center" FontSize="14"
                                           Typography.NumeralAlignment="Tabular" Foreground="#80FFFFFF" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </StackPanel>
                        <Button Content="{x:Bind ViewModel.AutoPlayText, Mode=OneWay}" Style="{StaticResource SiloNextUpTextButtonStyle}" Margin="0,10,0,0"
                                HorizontalAlignment="Center" Command="{x:Bind ViewModel.ToggleAutoPlayCommand}" />
                    </StackPanel>

                    <!-- No episode follows. -->
                    <StackPanel Spacing="8" HorizontalAlignment="Center" Visibility="{x:Bind Not(ViewModel.HasNextEpisode), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.NextUpFinishedHeading, Mode=OneWay}" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="24"
                                   Foreground="{StaticResource SiloPlayerForegroundBrush}" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock Text="There are no more episodes available. Pick something else from On Deck below." MaxWidth="448"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="14" Foreground="#80FFFFFF" />
                        <Button x:Name="FinishedBackButton" Content="Back" Style="{StaticResource SiloPlayerPillButtonStyle}" Height="44" Padding="28,0"
                                Background="#1AFFFFFF" Margin="0,12,0,0" HorizontalAlignment="Center" Command="{x:Bind ViewModel.CloseCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <controls:MediaRow Grid.Row="1" Margin="32,0,32,16" Bleed="32" Title="ON DECK" TitleStyle="{StaticResource SiloSectionLabelTextStyle}"
                               ItemsSource="{x:Bind ViewModel.OnDeck, Mode=OneWay}" CardInvokedCommand="{x:Bind ViewModel.PlayOnDeckCommand}"
                               Visibility="{x:Bind HasCards(ViewModel.OnDeck), Mode=OneWay}" />

            <Button x:Name="NextUpCloseButton" Style="{StaticResource SiloPlayerDiscButtonStyle}" Width="40" Height="40" Background="#1AFFFFFF"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{x:Bind CornerInset(IsFullScreen, 20), Mode=OneWay}"
                    Command="{x:Bind ViewModel.CloseCommand}" AutomationProperties.Name="Close" AutomationProperties.AcceleratorKey="Escape"
                    ToolTipService.ToolTip="Close (Esc)">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>

        <!-- The marker panel, bottom left above the controls; it can be moved by its header. -->
        <controls:MarkerEditPanel x:Name="MarkerPanel" Canvas.ZIndex="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,176"
                                  Visibility="{x:Bind ShowsInWindow(ViewModel.MarkerEditor.IsEditing, IsCompact), Mode=OneWay}" />

        <!--
            A message from the server or an administrator (the control lane), below the top bar, at most 576 px wide; it goes
            after eight seconds. Minimized, the window shows it above the bar (MainWindow.Player.cs).
        -->
        <controls:PlaybackNoticeView Canvas.ZIndex="4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,80,16,0" MaxWidth="576"
                                     NoticeTitle="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                                     IsWarning="{x:Bind ViewModel.IsNoticeWarning, Mode=OneWay}"
                                     Visibility="{x:Bind ShowsInWindow(ViewModel.HasNotice, IsCompact), Mode=OneWay}" />

        <!-- Add Subtitles and Subtitle appearance: over everything, as the web's dialogs (PlayerPage.Subtitles.cs). -->
        <controls:AddSubtitlesPanel x:Name="AddSubtitlesPanel" Canvas.ZIndex="5" Visibility="Collapsed" />
        <controls:SubtitleAppearancePanel x:Name="AppearancePanel" Canvas.ZIndex="5"
                                          Visibility="{x:Bind ShowsInWindow(ViewModel.IsAppearanceOpen, IsCompact), Mode=OneWay}" />

        <!-- The small video: a click returns to it, until the episode has ended. -->
        <Button x:Name="MiniPlayerButton" Canvas.ZIndex="3" Style="{StaticResource SiloPlayerCardOutlineButtonStyle}" Padding="0" BorderThickness="0"
                CornerRadius="16" HorizontalAlignment="Left" VerticalAlignment="Top" Width="320" Height="180"
                Margin="{x:Bind CornerInset(IsFullScreen, 24), Mode=OneWay}"
                Visibility="{x:Bind ShowsMiniPlayer(ViewModel.IsNextUpScreenShown, ViewModel.Phase, IsCompact), Mode=OneWay}"
                Command="{x:Bind ViewModel.KeepWatchingCommand}" AutomationProperties.Name="Keep watching" ToolTipService.ToolTip="Keep watching" />

        <!--
            Minimized: the bar at the bottom of the window while the viewer browses. The picture plays on at its left
            (VideoFrame, placed by PlayerPage.Dock.cs), and a click on it brings the player back; then the title, the
            transport, and on the right mute and Stop (✕). The seek bar runs along the
            top (DockSeekBar).
        -->
        <Grid x:Name="DockBar" Visibility="{x:Bind IsDocked, Mode=OneWay}" CornerRadius="14" BorderThickness="1"
              Background="{StaticResource SiloSurfaceRaisedBrush}" BorderBrush="{StaticResource SiloBorderBrush}"
              Padding="0,0,12,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                           FontSize="14" Foreground="{StaticResource SiloForegroundBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="12" Foreground="{StaticResource SiloMutedBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" Visibility="{x:Bind Shows(ViewModel.Subtitle), Mode=OneWay}" />
                <TextBlock Text="{x:Bind TimesText(ViewModel.PositionSeconds, ViewModel.DurationSeconds, ShowsRemaining), Mode=OneWay}" FontSize="12"
                           Foreground="{StaticResource SiloMutedBrush}" Typography.NumeralAlignment="Tabular" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Style="{StaticResource SiloPlayerIconButtonStyle}" Command="{x:Bind ViewModel.PlayPreviousEpisodeCommand}"
                        Visibility="{x:Bind ViewModel.HasPreviousEpisode, Mode=OneWay}" AutomationProperties.Name="Previous episode"
                        ToolTipService.ToolTip="Previous episode">
                    <FontIcon Glyph="&#xE892;" FontSize="14" />
                </Button>
                <Button x:Name="DockSkipBackButton" Style="{StaticResource SiloPlayerIconButtonStyle}" Command="{x:Bind ViewModel.SkipBackCommand}"
                        IsEnabled="{x:Bind ViewModel.CanSeek, Mode=OneWay}">
                    <Grid>
                        <FontIcon Glyph="&#xE72C;" FontSize="22" RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                        <TextBlock x:Name="DockSkipBackText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="8" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource SiloPlayerPlayButtonStyle}" Width="44" Height="44" Command="{x:Bind ViewModel.TogglePauseCommand}"
                        AutomationProperties.Name="{x:Bind PlayPauseName(ViewModel.IsPaused), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind PlayPauseName(ViewModel.IsPaused), Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind PlayPauseGlyph(ViewModel.IsPaused), Mode=OneWay}" FontSize="18"
                              Margin="{x:Bind PlayPauseGlyphMargin(ViewModel.IsPaused), Mode=OneWay}" />
                </Button>
                <Button x:Name="DockSkipForwardButton" Style="{StaticResource SiloPlayerIconButtonStyle}" Command="{x:Bind ViewModel.SkipForwardCommand}"
                        IsEnabled="{x:Bind ViewModel.CanSeek, Mode=OneWay}">
                    <Grid>
                        <FontIcon Glyph="&#xE72C;" FontSize="22" />
                        <TextBlock x:Name="DockSkipForwardText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource SiloFontBold}" FontWeight="Bold" FontSize="8" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource SiloPlayerIconButtonStyle}" Command="{x:Bind ViewModel.PlayNextEpisodeCommand}"
                        Visibility="{x:Bind ViewModel.HasNextEpisode, Mode=OneWay}" AutomationProperties.Name="Next episode"
                        ToolTipService.ToolTip="Next episode">
                    <FontIcon Glyph="&#xE893;" FontSize="14" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SiloPlayerIconButtonStyle}" Command="{x:Bind ViewModel.ToggleMuteCommand}"
                        AutomationProperties.Name="{x:Bind MuteName(ViewModel.IsMuted), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind MuteName(ViewModel.IsMuted), Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind VolumeGlyph(ViewModel.IsMuted, ViewModel.Volume), Mode=OneWay}" FontSize="16" />
                </Button>
                <!-- The web bar's ✕: playback ends, the page stays. -->
                <Button x:Name="DockStopButton" Style="{StaticResource SiloPlayerIconButtonStyle}" Click="OnDockStopClick"
                        AutomationProperties.Name="Stop playback" ToolTipService.ToolTip="Stop playback">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!--
            The bar's seek bar along its top edge right of the picture, the full player's own (thumb, picture and time under
            the pointer, a seek on release, the arrow keys' steps). Outside the bar, whose rounded corners would cut off the
            bubble above it.
        -->
        <controls:SeekBar x:Name="DockSeekBar" Canvas.ZIndex="4" VerticalAlignment="Top" Margin="184,-10,16,0"
                          Visibility="{x:Bind IsDocked, Mode=OneWay}" AutomationProperties.Name="Seek"
                          Position="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}"
                          Duration="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                          Markers="{x:Bind ViewModel.SeekBarMarkers, Mode=OneWay}"
                          Chapters="{x:Bind ViewModel.ChapterMarks, Mode=OneWay}"
                          Trickplay="{x:Bind ViewModel.Trickplay, Mode=OneWay}"
                          IsEnabled="{x:Bind ViewModel.CanSeek, Mode=OneWay}"
                          SeekRequested="OnSeekRequested" />

        <!--
            The picture in the bar: a click on it brings the full player back, its only way there. Under the pointer, or with
            the keyboard on it, the whole picture greys and a chevron up says what the click does: a veil of the picture's own
            size and place, under the button that takes the click.
        -->
        <Grid x:Name="DockVideoHover" Canvas.ZIndex="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
              Width="160" Height="90" CornerRadius="8" Background="#A6141417" Opacity="0" IsHitTestVisible="False"
              Visibility="{x:Bind IsDocked, Mode=OneWay}">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Grid.OpacityTransition>
            <FontIcon Glyph="&#xE70E;" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Button x:Name="DockVideoButton" Canvas.ZIndex="4" Style="{StaticResource SiloPlayerCardOutlineButtonStyle}" Padding="0" BorderThickness="0"
                CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Width="160" Height="90"
                Background="Transparent" Visibility="{x:Bind IsDocked, Mode=OneWay}" Click="OnExpandClick"
                PointerEntered="OnDockVideoPointerEntered" PointerExited="OnDockVideoPointerExited"
                GotFocus="OnDockVideoFocusChanged" LostFocus="OnDockVideoFocusChanged"
                AutomationProperties.Name="Back to the player" ToolTipService.ToolTip="Back to the player" />
    </Grid>
</Page>
