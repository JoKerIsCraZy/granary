<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Granary.App.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls">

    <Grid Background="Black">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Space" Invoked="OnPlayPauseInvoked" />
        </Grid.KeyboardAccelerators>

        <controls:MpvVideoHost x:Name="VideoHost" />

        <!-- Interim transport bar; the player controls in the Silo look replace it. -->
        <Grid VerticalAlignment="Bottom" Margin="24" Padding="16,10" CornerRadius="8" ColumnSpacing="12"
              Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Command="{x:Bind ViewModel.TogglePauseCommand}" Width="44" AutomationProperties.Name="Play or pause">
                <FontIcon Glyph="{x:Bind PlayPauseGlyph(ViewModel.IsPaused), Mode=OneWay}" />
            </Button>
            <Slider x:Name="SeekBar" Grid.Column="1" VerticalAlignment="Center" StepFrequency="0.1"
                    Minimum="0" Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                    Value="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}"
                    ValueChanged="OnSeekBarValueChanged" AutomationProperties.Name="Position" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="Consolas"
                       Text="{x:Bind TimeText(ViewModel.PositionSeconds, ViewModel.DurationSeconds), Mode=OneWay}" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource CaptionTextBlockStyle}"
                       Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
