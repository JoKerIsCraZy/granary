<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings → Downloads, Granary's own: the web has no downloads, and the apps keep these choices on the device. Each saves on
    this PC at once (DownloadSettingsViewModel).
-->
<UserControl
    x:Class="Granary.App.Views.Settings.DownloadsSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls">

    <!-- Its own copy: the view is made before it joins the page, whose resources it cannot see then. -->
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Themes/SiloSettings.xaml" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Downloads" Style="{StaticResource SiloSettingsPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Margin="0,8,0,32" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="14"
                   Text="Where downloads go and when they run, on this PC." />
        <!-- A folder Granary can't write to, or one that would not open. -->
        <InfoBar IsOpen="{x:Bind controls:SettingsText.Has(ViewModel.Status), Mode=OneWay}" Severity="Error" IsClosable="False"
                 Message="{x:Bind ViewModel.Status, Mode=OneWay}" Margin="0,0,0,16" />

        <controls:SettingsGroup Title="This PC" Description="Kept on this PC, not in your profile.">
            <StackPanel>
                <!-- The path in full, with Open and Change under it. -->
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="Folder"
                                      Description="New downloads go here. Downloads you have stay where they are.">
                    <StackPanel Spacing="8" HorizontalAlignment="Right">
                        <TextBlock Text="{x:Bind ViewModel.Folder, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SiloForegroundBrush}"
                                   MaxWidth="360" TextWrapping="Wrap" TextAlignment="Right" HorizontalAlignment="Right" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                            <HyperlinkButton Content="Open" Command="{x:Bind ViewModel.OpenFolderCommand}"
                                             ToolTipService.ToolTip="Show the folder in File Explorer" AutomationProperties.Name="Open the downloads folder" />
                            <Button Content="Change" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind ViewModel.ChangeFolderCommand}"
                                    AutomationProperties.Name="Change the downloads folder" />
                        </StackPanel>
                    </StackPanel>
                </controls:SettingsRow>
                <controls:SettingsRow Label="Download on metered connections"
                                      Description="Off: downloads wait while Windows says the connection is metered, such as a phone's hotspot.">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.DownloadsOnMetered, Mode=TwoWay}"
                                  AutomationProperties.Name="Download on metered connections" />
                </controls:SettingsRow>
                <!-- The list is labelled again once the server said what it offers: the select takes its items before its pick. -->
                <controls:SettingsRow Label="Default quality"
                                      Description="The quality a download starts on when your Silo server offers it, else Original.">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" ItemsSource="{x:Bind ViewModel.Qualities, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}" AutomationProperties.Name="Default quality" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>
    </StackPanel>
</UserControl>
