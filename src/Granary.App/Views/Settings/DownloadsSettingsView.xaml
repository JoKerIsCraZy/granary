<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings → Downloads, Granary's own: the web has no downloads, and the apps keep these choices on the device. Each saves on
    this PC at once (DownloadSettingsViewModel).
-->
<UserControl
    x:Class="Granary.App.Views.Settings.DownloadsSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:t="using:Granary.Core.Texts">

    <!-- Its own copy: the view is made before it joins the page, whose resources it cannot see then. -->
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Themes/SiloSettings.xaml" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{x:Bind t:AppText.Get('granary.settings.downloads.title')}" Style="{StaticResource SiloSettingsPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Margin="0,8,0,32" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="14"
                   Text="{x:Bind t:AppText.Get('granary.settings.downloads.subtitle')}" />
        <!-- A folder Granary can't write to, or one that would not open. -->
        <InfoBar IsOpen="{x:Bind controls:SettingsText.Has(ViewModel.Status), Mode=OneWay}" Severity="Error" IsClosable="False"
                 Message="{x:Bind ViewModel.Status, Mode=OneWay}" Margin="0,0,0,16" />

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('granary.settings.downloads.thisPc')}" Description="{x:Bind t:AppText.Get('granary.settings.downloads.thisPcDescription')}">
            <StackPanel>
                <!-- The path in full, with Open and Change under it. -->
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('granary.settings.downloads.folder')}"
                                      Description="{x:Bind t:AppText.Get('granary.settings.downloads.folderDescription')}">
                    <StackPanel Spacing="8" HorizontalAlignment="Right">
                        <TextBlock Text="{x:Bind ViewModel.Folder, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SiloForegroundBrush}"
                                   MaxWidth="360" TextWrapping="Wrap" TextAlignment="Right" HorizontalAlignment="Right" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                            <HyperlinkButton Content="{x:Bind t:AppText.Get('granary.settings.downloads.open')}" Command="{x:Bind ViewModel.OpenFolderCommand}"
                                             ToolTipService.ToolTip="{x:Bind t:AppText.Get('granary.settings.downloads.openTip')}" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.downloads.openName')}" />
                            <Button Content="{x:Bind t:AppText.Get('granary.settings.downloads.change')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind ViewModel.ChangeFolderCommand}"
                                    AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.downloads.changeName')}" />
                        </StackPanel>
                    </StackPanel>
                </controls:SettingsRow>
                <!--
                    The PC's drives, with their free space, while it has more than one. Windows' folder picker is a window of its
                    own that takes no controller and that Granary does not read the controller for, so this list is where a
                    controller chooses: a drive puts new downloads in a Granary folder there (the default folder on its drive).
                -->
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('granary.settings.downloads.drive')}" Description="{x:Bind t:AppText.Get('granary.settings.downloads.driveDescription')}"
                                      Visibility="{x:Bind ViewModel.ShowsDrives, Mode=OneWay}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" ItemsSource="{x:Bind ViewModel.Drives, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedDrive, Mode=TwoWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.downloads.driveName')}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('granary.settings.downloads.metered')}"
                                      Description="{x:Bind t:AppText.Get('granary.settings.downloads.meteredDescription')}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.DownloadsOnMetered, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.downloads.metered')}" />
                </controls:SettingsRow>
                <!-- The Apple app's Simultaneous Downloads, 1 to 4; two by default, as the Apple app runs them. -->
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('granary.settings.downloads.simultaneous')}" Description="{x:Bind t:AppText.Get('granary.settings.downloads.simultaneousDescription')}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" ItemsSource="{x:Bind ViewModel.SimultaneousChoices}"
                              SelectedItem="{x:Bind ViewModel.SelectedSimultaneous, Mode=TwoWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.downloads.simultaneous')}" />
                </controls:SettingsRow>
                <!--
                    Granary's own: no Silo client has an overall limit. The slider says its value beside it and saves once it
                    rests; 0 is no limit.
                -->
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('granary.settings.downloads.storageLimit')}"
                                      Description="{x:Bind t:AppText.Get('granary.settings.downloads.storageLimitDescription')}">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Slider Width="220" Minimum="0" Maximum="{x:Bind ViewModel.StorageLimitMaxGb}" StepFrequency="10" SmallChange="10" LargeChange="100"
                                Value="{x:Bind ViewModel.StorageLimitGb, Mode=TwoWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.downloads.storageLimit')}" />
                        <TextBlock Text="{x:Bind ViewModel.StorageLimitText, Mode=OneWay}" MinWidth="72" VerticalAlignment="Center"
                                   Style="{StaticResource SiloSettingsMutedTextStyle}" />
                    </StackPanel>
                </controls:SettingsRow>
                <!-- The list is labelled again once the server said what it offers: the select takes its items before its pick. -->
                <!-- Its name is the settings contract's for downloads.default_quality, its line the Apple app's footer for what the server
                     offers (DownloadSettingsViewModel.QualityDescription). -->
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('settingsManifest.downloads.default_quality.label')}" Description="{x:Bind ViewModel.QualityDescription, Mode=OneWay}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" ItemsSource="{x:Bind ViewModel.Qualities, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('settingsManifest.downloads.default_quality.label')}" />
                </controls:SettingsRow>
                <!-- The server's settings contract names it downloads.keep_watched, kept on the client; its words are the contract's. -->
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('settingsManifest.downloads.keep_watched.label')}" Description="{x:Bind t:AppText.Get('settingsManifest.downloads.keep_watched.description')}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.KeepWatched, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind t:AppText.Get('settingsManifest.downloads.keep_watched.label')}" />
                </controls:SettingsRow>
                <!-- Granary's own: the notice in the window and the Windows notification when downloads finish or fail. -->
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('granary.settings.downloads.notify')}"
                                      Description="{x:Bind t:AppText.Get('granary.settings.downloads.notifyDescription')}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.NotifyWhenFinished, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.downloads.notify')}" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <!--
            The Apple app's Monitoring Defaults: what a new monitor starts with in the download dialog's Monitor. Its stepper is
            a number box with spin buttons, 0 to 1000 GB in steps of 5, named as the Apple app names it.
        -->
        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('granary.settings.downloads.monitoringDefaults')}" Description="{x:Bind t:AppText.Get('granary.settings.downloads.monitoringDefaultsDescription')}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('granary.settings.downloads.deleteWatched')}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.DefaultDeleteWatched, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.downloads.deleteWatched')}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind ViewModel.DefaultMonitorLimitText, Mode=OneWay}">
                    <NumberBox Minimum="0" Maximum="{x:Bind ViewModel.DefaultMonitorLimitMaxGb}" SmallChange="{x:Bind ViewModel.DefaultMonitorLimitStepGb}"
                               LargeChange="50" SpinButtonPlacementMode="Inline" Width="160"
                               Value="{x:Bind ViewModel.DefaultMonitorLimitGb, Mode=TwoWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.downloads.monitorLimitName')}" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <!-- The Apple app's Storage: what this profile's downloads use, and Remove All Downloads, which asks first. -->
        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('granary.settings.downloads.storage')}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('granary.settings.downloads.used')}">
                    <TextBlock Text="{x:Bind ViewModel.UsedText, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}" VerticalAlignment="Center" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('granary.settings.downloads.removeAll')}" Description="{x:Bind t:AppText.Get('granary.settings.downloads.removeAllDescription')}"
                                      Visibility="{x:Bind ViewModel.CanRemoveAll, Mode=OneWay}">
                    <Button Content="{x:Bind t:AppText.Get('granary.settings.downloads.removeAllConfirm')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Foreground="{StaticResource SiloDestructiveBrush}"
                            Command="{x:Bind ViewModel.RemoveAllCommand}" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.downloads.removeAll')}" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>
    </StackPanel>
</UserControl>
