<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings → Playback → This PC → Edit: mpv.conf edited inside Granary, in place of the Playback page (Granary's own; Silo's
    clients have no player configuration). The text box holds the file as it is; the check under it is the player's own.
-->
<UserControl
    x:Class="Granary.App.Views.Settings.MpvConfigEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls">

    <!-- Its own copy: the view is made in code, outside the page's resources. -->
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Themes/SiloSettings.xaml" />
    </UserControl.Resources>

    <StackPanel>
        <Button x:Name="BackButton" Style="{StaticResource SiloSettingsBackButtonStyle}" Padding="0,4" Click="OnCancelClick"
                AutomationProperties.Name="Back to Playback">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE72B;" FontSize="12" />
                <TextBlock Text="Playback" FontSize="14" />
            </StackPanel>
        </Button>
        <TextBlock Margin="0,12,0,0" Text="mpv.conf" Style="{StaticResource SiloSettingsPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Margin="0,8,0,24" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="14"
                   Text="Your own mpv options for this PC, in mpv's syntax. Profiles, includes and comments stay as you write them. A change applies from the next title you play." />
        <InfoBar IsOpen="{x:Bind controls:SettingsText.Has(ViewModel.Message), Mode=OneWay}" Severity="Error" IsClosable="False"
                 Message="{x:Bind ViewModel.Message, Mode=OneWay}" Margin="0,0,0,16" />

        <!-- Monospace, unwrapped and without spelling help: a config file, not prose. -->
        <TextBox x:Name="Editor" Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="NoWrap" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                 FontFamily="Consolas" FontSize="14" Height="420" CornerRadius="8" Padding="12,10"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" IsReadOnly="{x:Bind ViewModel.IsSaving, Mode=OneWay}"
                 PreviewKeyDown="OnEditorPreviewKeyDown"
                 AutomationProperties.Name="mpv.conf" />

        <StackPanel Margin="0,16,0,0" Spacing="6">
            <TextBlock Text="Check" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="14"
                       Foreground="{StaticResource SiloForegroundBrush}" AutomationProperties.HeadingLevel="Level2" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}" IsTabStop="False" AutomationProperties.LiveSetting="Polite">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" Style="{StaticResource SiloSettingsMutedTextStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Click="OnCancelClick" />
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource SiloPrimaryButtonStyle}" controls:Pill.IsEnabled="False" CornerRadius="8"
                    MinHeight="36" Padding="20,0" FontSize="14" Click="OnSaveClick" AutomationProperties.Name="Save mpv.conf"
                    IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>
