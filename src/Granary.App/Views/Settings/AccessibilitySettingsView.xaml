<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings → Accessibility, as on Silo's web (pages/settings/AccessibilitySettings.tsx): its Language group, the profile's
    app language. The web's readability and date and time groups are its own; Granary has none of them.
-->
<UserControl
    x:Class="Granary.App.Views.Settings.AccessibilitySettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:t="using:Granary.Core.Texts">

    <!-- Its own copy: the view is made before it joins the page, whose resources it cannot see then. -->
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Themes/SiloSettings.xaml" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{x:Bind t:AppText.Get('web.settings.accessibility.title')}" Style="{StaticResource SiloSettingsPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Margin="0,8,0,32" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="14"
                   Text="{x:Bind t:AppText.Get('settingsManifest.ui.app_language.description')}" />

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('web.settings.accessibility.languageTitle')}"
                                Description="{x:Bind t:AppText.Get('granary.settings.accessibility.languageDescription')}"
                                Visibility="{x:Bind ViewModel.OffersLanguage, Mode=OneWay}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('web.settings.accessibility.appLanguage')}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" ItemsSource="{x:Bind ViewModel.Choices, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedChoice, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChoose, Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.accessibility.appLanguage')}" />
                </controls:SettingsRow>
                <!-- The read failed: the select waits, as a choice would overwrite one not seen. -->
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.LoadFailed, Mode=OneWay}">
                    <TextBlock Text="{x:Bind t:AppText.Get('granary.settings.accessibility.appLanguageLoadFailed')}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                               FontSize="13" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    <Button Content="{x:Bind t:AppText.Get('common.retry')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind ViewModel.RetryCommand}" />
                </StackPanel>
                <TextBlock Margin="0,12,0,0" Text="{x:Bind ViewModel.UnavailableNote, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                           FontSize="13" Visibility="{x:Bind controls:SettingsText.Shows(ViewModel.UnavailableNote), Mode=OneWay}" />
                <!-- Granary loads its texts as it starts, so a choice shows from the next start; the web switches at once. -->
                <TextBlock Margin="0,12,0,0" Text="{x:Bind ViewModel.RestartNote, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                           FontSize="13" Visibility="{x:Bind controls:SettingsText.Shows(ViewModel.RestartNote), Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
                <!-- The web says these in a toast; the settings pages say them under the row. -->
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="12" Visibility="{x:Bind controls:SettingsText.Shows(ViewModel.FailureText), Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.FailureText, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="13"
                               VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    <Button Content="{x:Bind t:AppText.Get('common.tryAgain')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind ViewModel.TryAgainCommand}"
                            Visibility="{x:Bind ViewModel.OffersTryAgain, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </controls:SettingsGroup>

        <!-- The server predates the setting: there is nowhere to keep a choice, as the web then shows no Language group. -->
        <Border Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="#FF28282E" Background="#0AFFFFFF"
                Visibility="{x:Bind ViewModel.IsUnsupported, Mode=OneWay}">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind t:AppText.Get('web.settings.interface.unsupportedTitle')}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium"
                           FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource SiloForegroundBrush}" />
                <TextBlock Text="{x:Bind t:AppText.Get('granary.settings.accessibility.unsupportedDescription')}" Style="{StaticResource SiloSettingsMutedTextStyle}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
