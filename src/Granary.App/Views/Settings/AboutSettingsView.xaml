<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings → About, as the apps' About (Version, Acknowledgements) with Granary's own: the mark, name and version;
    Updates with Check for updates, Automatic updates, and what a downloaded release changes; the changelog shipped with the
    app; the licence, third-party notices and source; the folders of Granary's data and logs.
-->
<UserControl
    x:Class="Granary.App.Views.Settings.AboutSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:vm="using:Granary.Core.ViewModels"
    xmlns:t="using:Granary.Core.Texts">

    <!-- Its own copy: the view is made before it joins the page, whose resources it cannot see then. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Themes/SiloSettings.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A group of changes: "Added", then its items as a bulleted list. -->
            <DataTemplate x:Key="ChangelogGroupTemplate" x:DataType="vm:ChangelogGroup">
                <StackPanel Spacing="6" Margin="0,0,0,8">
                    <TextBlock Text="{x:Bind Title}" Visibility="{x:Bind HasTitle}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                               FontSize="12" CharacterSpacing="80" Foreground="{StaticResource SiloMutedBrush}" />
                    <ItemsRepeater ItemsSource="{x:Bind Items}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="•" FontSize="14" Foreground="{StaticResource SiloMutedBrush}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind}" FontSize="14" LineHeight="21" TextWrapping="Wrap"
                                               Foreground="{StaticResource SiloForegroundBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="20">
            <Image Source="ms-appx:///Assets/Logo/granary-mark.svg" Width="64" Height="64" AutomationProperties.AccessibilityView="Raw" />
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <!-- The app's name: not a text. -->
                <TextBlock Text="Granary" Style="{StaticResource SiloSettingsPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{x:Bind ViewModel.VersionText}" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="14" IsTextSelectionEnabled="True" />
            </StackPanel>
        </StackPanel>
        <TextBlock Margin="0,16,0,32" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="14"
                   Text="{x:Bind t:AppText.Get('granary.settings.about.lead')}" />

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('granary.settings.about.updates')}" Description="{x:Bind ViewModel.Updates.Summary, Mode=OneWay}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind ViewModel.Updates.StatusText, Mode=OneWay}"
                                      Description="{x:Bind ViewModel.Updates.LastCheckedText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.Updates.IsBusy, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.Updates.IsBusy, Mode=OneWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.about.updating')}" />
                        <!-- With automatic updates off, what a release found changes is on its GitHub page until it is verified. -->
                        <HyperlinkButton Content="{x:Bind t:AppText.Get('granary.settings.about.releaseNotes')}" NavigateUri="{x:Bind ViewModel.AvailableReleaseUrl, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.HasAvailableReleaseUrl, Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind t:AppText.Get('granary.settings.about.releaseNotesTooltip')}"
                                         AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.about.releaseNotesName')}" />
                        <Button Content="{x:Bind t:AppText.Get('granary.settings.about.checkForUpdates')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}"
                                Command="{x:Bind ViewModel.Updates.CheckNowCommand}" Visibility="{x:Bind ViewModel.Updates.ShowsCheckNow, Mode=OneWay}" />
                        <Button Content="{x:Bind t:AppText.Get('granary.settings.about.downloadAndInstall')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}"
                                Command="{x:Bind ViewModel.Updates.DownloadAndInstallCommand}" Visibility="{x:Bind ViewModel.Updates.IsAvailable, Mode=OneWay}" />
                        <Button Content="{x:Bind ViewModel.Updates.RestartText, Mode=OneWay}" Style="{StaticResource SiloSettingsOutlineButtonStyle}"
                                Command="{x:Bind ViewModel.Updates.RestartNowCommand}" Visibility="{x:Bind ViewModel.Updates.IsReady, Mode=OneWay}" />
                    </StackPanel>
                </controls:SettingsRow>
                <!-- Only for a copy that updates itself; the row's label names the switch. -->
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('granary.settings.about.automaticUpdates')}"
                                      Description="{x:Bind t:AppText.Get('granary.settings.about.automaticUpdatesDescription')}"
                                      Visibility="{x:Bind ViewModel.Updates.CanUpdate}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.Updates.IsAutomatic, Mode=TwoWay}" />
                </controls:SettingsRow>

                <!-- What the downloaded release changes, as it was packed with. -->
                <StackPanel Margin="0,24,0,0" Spacing="10" Visibility="{x:Bind ViewModel.HasReadyChanges, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.ReadyChangesTitle, Mode=OneWay}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                               FontSize="14" Foreground="{StaticResource SiloForegroundBrush}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ReadyChanges, Mode=OneWay}" ItemTemplate="{StaticResource ChangelogGroupTemplate}" />
                </StackPanel>
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('granary.settings.about.whatsNew')}" Description="{x:Bind t:AppText.Get('granary.settings.about.whatsNewDescription')}"
                                Visibility="{x:Bind ViewModel.HasChangelog}">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Releases}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="24" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChangelogRelease">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{x:Bind Heading}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{StaticResource SiloForegroundBrush}" AutomationProperties.HeadingLevel="Level3" />
                            <ItemsRepeater ItemsSource="{x:Bind Groups}" ItemTemplate="{StaticResource ChangelogGroupTemplate}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </controls:SettingsGroup>

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('granary.settings.about.licenseAndSource')}"
                                Description="{x:Bind t:AppText.Get('granary.settings.about.licenseAndSourceDescription')}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('granary.settings.about.license')}"
                                      Description="{x:Bind t:AppText.Get('granary.settings.about.licenseDescription')}">
                    <Button Content="{x:Bind t:AppText.Get('granary.settings.about.view')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Click="OnViewLicenseClick"
                            AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.about.viewLicense')}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('granary.settings.about.exception')}"
                                      Description="{x:Bind t:AppText.Get('granary.settings.about.exceptionDescription')}">
                    <Button Content="{x:Bind t:AppText.Get('granary.settings.about.view')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Click="OnViewExceptionClick"
                            AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.about.viewException')}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('granary.settings.about.notices')}"
                                      Description="{x:Bind t:AppText.Get('granary.settings.about.noticesDescription')}">
                    <Button Content="{x:Bind t:AppText.Get('granary.settings.about.view')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Click="OnViewNoticesClick"
                            AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.about.viewNotices')}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('granary.settings.about.source')}" Description="{x:Bind controls:SettingsText.Of(ViewModel.SourceUrl)}"
                                      Visibility="{x:Bind ViewModel.HasSource}">
                    <HyperlinkButton Content="{x:Bind t:AppText.Get('granary.settings.about.open')}" NavigateUri="{x:Bind ViewModel.SourceUrl}"
                                     ToolTipService.ToolTip="{x:Bind t:AppText.Get('granary.settings.about.sourceTooltip')}"
                                     AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.about.openSource')}" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('granary.settings.about.troubleshooting')}"
                                Description="{x:Bind t:AppText.Get('granary.settings.about.troubleshootingDescription')}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('granary.settings.about.dataFolder')}" Description="{x:Bind ViewModel.DataDirectory}">
                    <Button Content="{x:Bind t:AppText.Get('granary.settings.about.open')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Click="OnOpenDataClick"
                            AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.about.openData')}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('granary.settings.about.logs')}" Description="{x:Bind ViewModel.LogsDirectory}">
                    <Button Content="{x:Bind t:AppText.Get('granary.settings.about.open')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Click="OnOpenLogsClick"
                            AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.about.openLogs')}" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>
    </StackPanel>
</UserControl>
