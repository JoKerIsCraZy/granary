<?xml version="1.0" encoding="utf-8"?>
<!-- Settings → Language & Subtitles, as on Silo's web (pages/settings/SubtitleAppearanceSettings.tsx). -->
<UserControl
    x:Class="Granary.App.Views.Settings.LanguageSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:settings="using:Granary.Core.ViewModels.Settings"
    xmlns:t="using:Granary.Core.Texts">

    <!-- Its own copy of the settings look: the view is made before it joins the page, whose resources it cannot see then. -->
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Themes/SiloSettings.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <!-- A 28 px colour; the chosen one has a white ring around it, as the web's swatches. -->
        <DataTemplate x:Key="SwatchTemplate" x:DataType="settings:ColorSwatch">
            <Button Width="32" Height="32" Padding="0" CornerRadius="16" Background="Transparent" Tag="{x:Bind Hex}"
                    BorderThickness="2" BorderBrush="{x:Bind controls:SettingsSwatches.Ring(IsSelected)}" Click="OnSwatchClick"
                    AutomationProperties.Name="{x:Bind Label}" AutomationProperties.ItemStatus="{x:Bind controls:SettingsSwatches.Status(IsSelected)}"
                    ToolTipService.ToolTip="{x:Bind Label}">
                <Ellipse Width="24" Height="24" Fill="{x:Bind controls:SettingsSwatches.Fill(Hex)}" Stroke="#33FFFFFF" StrokeThickness="1" />
            </Button>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="SwatchPanel">
            <StackPanel Orientation="Horizontal" Spacing="4" />
        </ItemsPanelTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.title')}" Style="{StaticResource SiloSettingsPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Margin="0,8,0,32" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="14"
                   Text="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.subtitle')}" />
        <InfoBar IsOpen="{x:Bind controls:SettingsText.Has(ViewModel.ErrorMessage), Mode=OneWay}" Severity="Error" IsClosable="False"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Margin="0,0,0,16" />

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.language.title')}">
            <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.language.spokenLabel')}"
                                  Description="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.language.spokenDescription')}">
                <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" ItemsSource="{x:Bind ViewModel.SpokenLanguageChoices}"
                          SelectedItem="{x:Bind ViewModel.SelectedSpokenLanguage, Mode=TwoWay}" MaxDropDownHeight="420" />
            </controls:SettingsRow>
        </controls:SettingsGroup>

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.subtitles.title')}"
                                Description="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.subtitles.description')}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.subtitles.languageLabel')}"
                                      Description="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.subtitles.languageDescription')}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" ItemsSource="{x:Bind ViewModel.SubtitleLanguageChoices}"
                              SelectedItem="{x:Bind ViewModel.SelectedSubtitleLanguage, Mode=TwoWay}" MaxDropDownHeight="420" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.subtitles.behaviorLabel')}"
                                      Description="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.subtitles.behaviorDescription')}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" ItemsSource="{x:Bind ViewModel.SubtitleModeChoices}"
                              SelectedItem="{x:Bind ViewModel.SelectedSubtitleMode, Mode=TwoWay}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('settingsManifest.playback.show_forced_subtitles.label')}"
                                      Description="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.subtitles.forcedDescription')}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.ShowForcedSubtitles, Mode=TwoWay}" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <!-- The preview's title column has Reset beside the title, so it is laid out as a group by hand. -->
        <Border Padding="0,32" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SiloSettingsHairlineBrush}">
            <Grid ColumnSpacing="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="256" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock Text="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.preview.title')}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{StaticResource SiloForegroundBrush}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                        <Button HorizontalAlignment="Right" Padding="8,4" Background="Transparent" BorderThickness="0"
                                Command="{x:Bind ViewModel.ResetAppearanceCommand}" Visibility="{x:Bind ViewModel.IsAppearanceCustomized, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.preview.reset')}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                                <TextBlock Text="{x:Bind t:AppText.Get('web.settings.resetButton.label')}" FontFamily="{StaticResource SiloFontMedium}" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.preview.description')}" Style="{StaticResource SiloSettingsMutedTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="16">
                    <controls:SubtitlePreview Appearance="{x:Bind ViewModel.Look.Appearance, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.preview.save')}" Style="{StaticResource SiloPrimaryButtonStyle}" controls:Pill.IsEnabled="False" CornerRadius="8"
                                Command="{x:Bind ViewModel.SaveAppearanceCommand}" />
                        <Button Content="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.preview.discard')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind ViewModel.DiscardAppearanceCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.text.title')}"
                                Description="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.text.description')}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.text.fontSize')}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" Width="192" ItemsSource="{x:Bind ViewModel.Look.FontSizeChoices}"
                              SelectedItem="{x:Bind ViewModel.Look.SelectedFontSize, Mode=TwoWay}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.text.fontFamily')}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" Width="192" ItemsSource="{x:Bind ViewModel.Look.FontFamilyChoices}"
                              SelectedItem="{x:Bind ViewModel.Look.SelectedFontFamily, Mode=TwoWay}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.text.fontColor')}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Look.FontColorSwatches, Mode=OneWay}" ItemTemplate="{StaticResource SwatchTemplate}"
                                  ItemsPanel="{StaticResource SwatchPanel}" Tag="font" IsTabStop="False" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.text.opacity')}"
                                      Description="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.text.opacityDescription')}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox Width="80" Minimum="1" Maximum="100" SmallChange="5" LargeChange="10"
                                   Value="{x:Bind ViewModel.Look.TextOpacity, Mode=TwoWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.text.opacity')}" />
                        <TextBlock Text="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.percentSign')}" VerticalAlignment="Center" Foreground="{StaticResource SiloMutedBrush}" />
                    </StackPanel>
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.text.outline')}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.Look.TextOutline, Mode=TwoWay}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.text.outlineColor')}"
                                      Description="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.text.outlineColorDescription')}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Look.OutlineColorSwatches, Mode=OneWay}" ItemTemplate="{StaticResource SwatchTemplate}"
                                  ItemsPanel="{StaticResource SwatchPanel}" Tag="outline" IsTabStop="False"
                                  Opacity="{x:Bind controls:SettingsText.Dim(ViewModel.Look.TextOutline), Mode=OneWay}" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.background.title')}"
                                Description="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.background.description')}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.background.style')}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" Width="192" ItemsSource="{x:Bind ViewModel.Look.BackgroundStyleChoices}"
                              SelectedItem="{x:Bind ViewModel.Look.SelectedBackgroundStyle, Mode=TwoWay}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.background.opacity')}"
                                      Description="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.background.opacityDescription')}">
                    <StackPanel Orientation="Horizontal" Spacing="8" Opacity="{x:Bind controls:SettingsText.Dim(ViewModel.Look.IsBox), Mode=OneWay}">
                        <NumberBox Width="80" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                   Value="{x:Bind ViewModel.Look.BackgroundOpacity, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Look.IsBox, Mode=OneWay}"
                                   AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.background.opacity')}" />
                        <TextBlock Text="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.percentSign')}" VerticalAlignment="Center" Foreground="{StaticResource SiloMutedBrush}" />
                    </StackPanel>
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.background.color')}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Look.BackgroundColorSwatches, Mode=OneWay}" ItemTemplate="{StaticResource SwatchTemplate}"
                                  ItemsPanel="{StaticResource SwatchPanel}" Tag="background" IsTabStop="False"
                                  Opacity="{x:Bind controls:SettingsText.Dim(ViewModel.Look.IsBox), Mode=OneWay}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.background.position')}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" Width="192" ItemsSource="{x:Bind ViewModel.Look.PositionChoices}"
                              SelectedItem="{x:Bind ViewModel.Look.SelectedPosition, Mode=TwoWay}" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.timing.title')}"
                                Description="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.timing.description')}">
            <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.timing.offset')}"
                                  Description="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.timing.offsetDescription')}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Width="36" Height="36" Padding="0" Style="{StaticResource SiloSettingsOutlineButtonStyle}"
                            Command="{x:Bind ViewModel.OffsetEarlierCommand}" IsEnabled="{x:Bind ViewModel.CanOffsetEarlier, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.OffsetEarlierName}">
                        <FontIcon Glyph="&#xE738;" FontSize="12" />
                    </Button>
                    <TextBlock MinWidth="72" Text="{x:Bind ViewModel.OffsetText, Mode=OneWay}" FontFamily="Consolas" FontSize="13" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource SiloForegroundBrush}" AutomationProperties.LiveSetting="Polite" />
                    <Button Width="36" Height="36" Padding="0" Style="{StaticResource SiloSettingsOutlineButtonStyle}"
                            Command="{x:Bind ViewModel.OffsetLaterCommand}" IsEnabled="{x:Bind ViewModel.CanOffsetLater, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.OffsetLaterName}">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                    </Button>
                    <Button Content="{x:Bind t:AppText.Get('web.settings.subtitleAppearance.timing.reset')}" Padding="12,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource SiloMutedBrush}"
                            Command="{x:Bind ViewModel.ResetOffsetCommand}" IsEnabled="{x:Bind ViewModel.CanResetOffset, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.subtitles.resetOffset')}" />
                </StackPanel>
            </controls:SettingsRow>
        </controls:SettingsGroup>
    </StackPanel>
</UserControl>
