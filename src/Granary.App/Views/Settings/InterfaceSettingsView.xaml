<?xml version="1.0" encoding="utf-8"?>
<!-- Settings → Navigation & Cards, as on Silo's web (pages/settings/InterfaceSettings.tsx, CardOverlaySettings.tsx): Posters, Badges, Pages (Granary's own), Sidebar. -->
<UserControl
    x:Class="Granary.App.Views.Settings.InterfaceSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:settings="using:Granary.Core.ViewModels.Settings"
    xmlns:t="using:Granary.Core.Texts">

    <!-- Its own copy of the settings look: the view is made before it joins the page, whose resources it cannot see then. -->
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Themes/SiloSettings.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <!-- A 28 px palette colour; the chosen one has a white ring, as the web's swatches. -->
        <DataTemplate x:Key="BadgeSwatchTemplate" x:DataType="settings:BadgeColorChoice">
            <Button Width="32" Height="32" Padding="0" CornerRadius="16" Background="Transparent" BorderThickness="2"
                    BorderBrush="{x:Bind controls:SettingsSwatches.Ring(IsSelected)}" Command="{x:Bind Pick}" CommandParameter="{x:Bind Hex}"
                    AutomationProperties.Name="{x:Bind Label}" AutomationProperties.ItemStatus="{x:Bind controls:SettingsSwatches.Status(IsSelected)}"
                    ToolTipService.ToolTip="{x:Bind Label}">
                <Ellipse Width="24" Height="24" Fill="{x:Bind controls:SettingsSwatches.Fill(Hex)}" Stroke="#33FFFFFF" StrokeThickness="1" />
            </Button>
        </DataTemplate>

        <!-- A choice of a poster setting or of Hero size: the chosen one filled in the accent, as the web's ChoiceButtons. -->
        <DataTemplate x:Key="SettingsChoiceTemplate" x:DataType="settings:SettingsChoice">
            <Button Content="{x:Bind Label}" Style="{StaticResource SiloSettingsChoiceButtonStyle}" Command="{x:Bind PickCommand}"
                    Background="{x:Bind controls:BadgeSettingsLook.ChoiceFill(IsSelected), Mode=OneWay}"
                    BorderBrush="{x:Bind controls:BadgeSettingsLook.ChoiceRing(IsSelected), Mode=OneWay}"
                    Foreground="{x:Bind controls:BadgeSettingsLook.ChoiceText(IsSelected), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind Label}"
                    AutomationProperties.ItemStatus="{x:Bind controls:SettingsSwatches.Status(IsSelected), Mode=OneWay}" />
        </DataTemplate>

        <!-- One sidebar entry: its icon and name, up and down within its section, and its switch. -->
        <DataTemplate x:Key="SidebarRowTemplate" x:DataType="settings:SidebarRowViewModel">
            <Grid Padding="0,10" ColumnSpacing="16" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SiloSettingsHairlineBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind controls:SidebarGlyphs.Of(Kind)}" FontSize="16" Foreground="{StaticResource SiloMutedBrush}"
                          Opacity="{x:Bind controls:SettingsText.Dim(IsShown), Mode=OneWay}" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Opacity="{x:Bind controls:SettingsText.Dim(IsShown), Mode=OneWay}">
                    <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="14"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource SiloForegroundBrush}" />
                    <TextBlock Text="{x:Bind Note}" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="12"
                               Visibility="{x:Bind controls:SettingsText.Shows(Note)}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Style="{StaticResource SiloSettingsGhostButtonStyle}" Width="32" Height="32" Padding="0" Command="{x:Bind MoveUpCommand}"
                            AutomationProperties.Name="{x:Bind controls:BadgeSettingsLook.MoveUpName(Label)}" ToolTipService.ToolTip="{x:Bind t:AppText.Get('granary.settings.moveUp')}">
                        <FontIcon Glyph="&#xE70E;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource SiloSettingsGhostButtonStyle}" Width="32" Height="32" Padding="0" Command="{x:Bind MoveDownCommand}"
                            AutomationProperties.Name="{x:Bind controls:BadgeSettingsLook.MoveDownName(Label)}" ToolTipService.ToolTip="{x:Bind t:AppText.Get('granary.settings.moveDown')}">
                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                    </Button>
                </StackPanel>
                <ToggleSwitch Grid.Column="3" Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind IsShown, Mode=TwoWay}"
                              VerticalAlignment="Center" AutomationProperties.Name="{x:Bind controls:BadgeSettingsLook.ShowName(Label)}" />
            </Grid>
        </DataTemplate>

        <!-- One badge: its words, Adjust while it is on, and its switch. -->
        <DataTemplate x:Key="BadgeRowTemplate" x:DataType="settings:BadgeRowViewModel">
            <Grid Padding="0,16" ColumnSpacing="16" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SiloSettingsHairlineBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="14"
                               TextWrapping="Wrap" Foreground="{StaticResource SiloForegroundBrush}" />
                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource SiloSettingsMutedTextStyle}" />
                    <TextBlock Text="{x:Bind Hint, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="12" FontStyle="Italic"
                               Opacity="0.8" Visibility="{x:Bind controls:SettingsText.Shows(Hint), Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SiloSettingsGhostButtonStyle}" Padding="10,6" VerticalAlignment="Center"
                        Visibility="{x:Bind IsEnabled, Mode=OneWay}" AutomationProperties.Name="{x:Bind controls:BadgeSettingsLook.AdjustName(Label)}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9E9;" FontSize="14" />
                        <TextBlock Text="{x:Bind t:AppText.Get('web.settings.cardOverlay.adjust')}" FontFamily="{StaticResource SiloFontMedium}" FontSize="13" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterStyle="{StaticResource SiloSettingsPopoverStyle}">
                            <StackPanel Width="288" Spacing="16">
                                <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource SiloForegroundBrush}" />

                                <!-- The corner on a small poster, as the web's: four buttons, the chosen one in the accent. -->
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="80" Height="120" CornerRadius="6" Background="#14FFFFFF" BorderThickness="1" BorderBrush="#1FFFFFFF"
                                          AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.cardOverlay.position')}">
                                        <Button Width="28" Height="16" Padding="0" Margin="4" CornerRadius="3" BorderThickness="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="{x:Bind controls:BadgeSettingsLook.CornerFill(IsTopLeft), Mode=OneWay}"
                                                Command="{x:Bind PickCornerCommand}" CommandParameter="TopLeft"
                                                AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.overlays.position.topLeft')}"
                                                ToolTipService.ToolTip="{x:Bind t:AppText.Get('web.settings.overlays.position.topLeft')}" />
                                        <Button Width="28" Height="16" Padding="0" Margin="4" CornerRadius="3" BorderThickness="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{x:Bind controls:BadgeSettingsLook.CornerFill(IsTopRight), Mode=OneWay}"
                                                Command="{x:Bind PickCornerCommand}" CommandParameter="TopRight"
                                                AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.badges.topRight')}"
                                                ToolTipService.ToolTip="{x:Bind t:AppText.Get('granary.settings.badges.topRight')}" />
                                        <Button Width="28" Height="16" Padding="0" Margin="4" CornerRadius="3" BorderThickness="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Background="{x:Bind controls:BadgeSettingsLook.CornerFill(IsBottomLeft), Mode=OneWay}"
                                                Command="{x:Bind PickCornerCommand}" CommandParameter="BottomLeft"
                                                AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.overlays.position.bottomLeft')}"
                                                ToolTipService.ToolTip="{x:Bind t:AppText.Get('web.settings.overlays.position.bottomLeft')}" />
                                        <Button Width="28" Height="16" Padding="0" Margin="4" CornerRadius="3" BorderThickness="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="{x:Bind controls:BadgeSettingsLook.CornerFill(IsBottomRight), Mode=OneWay}"
                                                Command="{x:Bind PickCornerCommand}" CommandParameter="BottomRight"
                                                AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.overlays.position.bottomRight')}"
                                                ToolTipService.ToolTip="{x:Bind t:AppText.Get('web.settings.overlays.position.bottomRight')}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{x:Bind t:AppText.Get('web.settings.cardOverlay.position')}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="14"
                                                   Foreground="{StaticResource SiloForegroundBrush}" />
                                        <TextBlock Text="{x:Bind t:AppText.Get('granary.settings.badges.cornerHint')}" Style="{StaticResource SiloSettingsMutedTextStyle}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind t:AppText.Get('web.settings.cardOverlay.color')}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="14"
                                               Foreground="{StaticResource SiloForegroundBrush}" />
                                    <Button Content="{x:Bind t:AppText.Get('web.settings.cardOverlay.colorDefault')}" Height="28" Padding="10,0" CornerRadius="14" FontSize="12" Background="Transparent"
                                            BorderThickness="1" BorderBrush="{x:Bind controls:BadgeSettingsLook.DefaultRing(IsDefaultColor), Mode=OneWay}"
                                            Command="{x:Bind PickColorCommand}" CommandParameter="{x:Null}"
                                            AutomationProperties.ItemStatus="{x:Bind controls:SettingsSwatches.Status(IsDefaultColor), Mode=OneWay}" />
                                    <ItemsControl ItemsSource="{x:Bind Swatches, Mode=OneWay}" ItemTemplate="{StaticResource BadgeSwatchTemplate}" IsTabStop="False"
                                                  AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.cardOverlay.color')}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="36" ItemHeight="36" MaximumRowsOrColumns="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>

                                <Grid Visibility="{x:Bind CanShowIcon}">
                                    <TextBlock Text="{x:Bind t:AppText.Get('web.settings.cardOverlay.showIcon')}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="14"
                                               VerticalAlignment="Center" Foreground="{StaticResource SiloForegroundBrush}" />
                                    <!-- A popover is outside the page, so the switch takes the settings' colours along itself. -->
                                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ShowIcon, Mode=TwoWay}"
                                                  AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.cardOverlay.showIcon')}">
                                        <ToggleSwitch.Resources>
                                            <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="SiloPrimaryBrush" />
                                            <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="SiloPrimaryHoverBrush" />
                                            <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="SiloPrimaryPressedBrush" />
                                            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FF3A3A42" />
                                            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#FF45454E" />
                                            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFE8E8EC" />
                                            <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="SiloOnPrimaryBrush" />
                                            <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="SiloOnPrimaryBrush" />
                                            <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="SiloOnPrimaryBrush" />
                                        </ToggleSwitch.Resources>
                                    </ToggleSwitch>
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <ToggleSwitch Grid.Column="2" Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                              VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Label}" />
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{x:Bind t:AppText.Get('web.settings.interface.title')}" Style="{StaticResource SiloSettingsPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Margin="0,8,0,32" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="14"
                   Text="{x:Bind t:AppText.Get('granary.settings.interface.lead')}" />

        <!-- Posters, as the web's PosterSettings: Reset beside the title, so laid out by hand as Badges. -->
        <Border Padding="0,32" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SiloSettingsHairlineBrush}">
            <Grid ColumnSpacing="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="256" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock Text="{x:Bind t:AppText.Get('web.settings.interface.postersTitle')}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{StaticResource SiloForegroundBrush}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                        <Button HorizontalAlignment="Right" Padding="8,4" Background="Transparent" BorderThickness="0"
                                Command="{x:Bind Posters.ResetCommand}" Visibility="{x:Bind Posters.HasOverride, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.interface.posterReset')}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                                <TextBlock Text="{x:Bind t:AppText.Get('web.settings.resetButton.label')}" FontFamily="{StaticResource SiloFontMedium}" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource SiloSettingsMutedTextStyle}"
                               Text="{x:Bind t:AppText.Get('granary.settings.posters.description')}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="24">
                    <TextBlock Text="{x:Bind t:AppText.Get('web.settings.interface.loading')}" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="14"
                               Visibility="{x:Bind Posters.IsLoading, Mode=OneWay}" />
                    <!-- Why the choices cannot show: the read failed, or the server predates them. -->
                    <Border Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="#FF28282E" Background="#0AFFFFFF"
                            Visibility="{x:Bind controls:SettingsText.Shows(Posters.BlockerTitle), Mode=OneWay}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind Posters.BlockerTitle, Mode=OneWay}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium"
                                       FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource SiloForegroundBrush}" />
                            <TextBlock Text="{x:Bind Posters.BlockerText, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="24" Visibility="{x:Bind Posters.IsReady, Mode=OneWay}">
                        <!-- This PC's own value outranks the desktop apps' choice: the web's notice, with its one way out. -->
                        <Grid Padding="16" ColumnSpacing="16" CornerRadius="12" BorderThickness="1" BorderBrush="#B328282E" Background="#0AFFFFFF"
                              Visibility="{x:Bind Posters.HasDeviceOverride, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind t:AppText.Get('granary.settings.posters.deviceOverride')}" FontSize="14"
                                       Style="{StaticResource SiloSettingsMutedTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{x:Bind t:AppText.Get('granary.settings.posters.matchOtherComputers')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}"
                                    MinHeight="32" VerticalAlignment="Center" Command="{x:Bind Posters.MatchOtherComputersCommand}" />
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind t:AppText.Get('web.settings.interface.posterSize')}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="14"
                                       Foreground="{StaticResource SiloForegroundBrush}" />
                            <ItemsControl ItemsSource="{x:Bind Posters.Sizes}" ItemTemplate="{StaticResource SettingsChoiceTemplate}" IsTabStop="False"
                                          IsEnabled="{x:Bind Posters.CanEdit, Mode=OneWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.interface.posterSize')}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind t:AppText.Get('granary.settings.posters.caption')}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="14"
                                       Foreground="{StaticResource SiloForegroundBrush}" />
                            <ItemsControl ItemsSource="{x:Bind Posters.Captions}" ItemTemplate="{StaticResource SettingsChoiceTemplate}" IsTabStop="False"
                                          IsEnabled="{x:Bind Posters.CanEdit, Mode=OneWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.posters.caption')}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <InfoBar IsOpen="{x:Bind controls:SettingsText.Not(ViewModel.CanEdit), Mode=OneWay}" Severity="Informational" IsClosable="False"
                 Message="{x:Bind t:AppText.Get('granary.settings.badges.serverOnly')}" Margin="0,0,0,16" />

        <!-- Reset sits beside the title, so the group is laid out by hand. -->
        <Border Padding="0,32" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SiloSettingsHairlineBrush}">
            <Grid ColumnSpacing="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="256" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock Text="{x:Bind t:AppText.Get('web.settings.cardOverlay.badgesTitle')}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{StaticResource SiloForegroundBrush}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                        <Button HorizontalAlignment="Right" Padding="8,4" Background="Transparent" BorderThickness="0" Click="OnResetBadgesClick"
                                Visibility="{x:Bind ViewModel.HasOverride, Mode=OneWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.cardOverlay.resetBadges')}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                                <TextBlock Text="{x:Bind t:AppText.Get('web.settings.resetButton.label')}" FontFamily="{StaticResource SiloFontMedium}" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{x:Bind t:AppText.Get('web.settings.cardOverlay.badgesDescription')}" Style="{StaticResource SiloSettingsMutedTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="24" IsHitTestVisible="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            Opacity="{x:Bind controls:SettingsText.Dim(ViewModel.CanEdit), Mode=OneWay}">
                    <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('web.settings.cardOverlay.showBadges')}">
                        <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.cardOverlay.showBadges')}" />
                    </controls:SettingsRow>

                    <StackPanel Spacing="24" Visibility="{x:Bind ViewModel.IsEnabled, Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{x:Bind t:AppText.Get('web.settings.cardOverlay.style')}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource SiloMutedBrush}" AutomationProperties.HeadingLevel="Level3" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Styles, Mode=OneWay}" IsTabStop="False" AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.overlays.look.style')}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="settings:BadgeStyleChoice">
                                        <!-- A tile with the style's "4K" on a dark slate, as the web's picker. -->
                                        <Button Width="112" Padding="8" CornerRadius="12" BorderThickness="1"
                                                Background="{x:Bind controls:BadgeSettingsLook.TileFill(IsSelected)}"
                                                BorderBrush="{x:Bind controls:BadgeSettingsLook.TileRing(IsSelected)}"
                                                Command="{x:Bind Pick}" CommandParameter="{x:Bind Id}" HorizontalContentAlignment="Stretch"
                                                AutomationProperties.Name="{x:Bind Label}" ToolTipService.ToolTip="{x:Bind Description}"
                                                AutomationProperties.ItemStatus="{x:Bind controls:SettingsSwatches.Status(IsSelected)}">
                                            <StackPanel Spacing="8">
                                                <Border Height="40" CornerRadius="6">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Offset="0" Color="#FF334155" />
                                                            <GradientStop Offset="1" Color="#FF0F172A" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ContentControl Content="{x:Bind controls:CardBadgeViews.Sample(Id)}" HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center" IsTabStop="False" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource SiloFontMedium}" FontSize="12"
                                                           HorizontalAlignment="Center" Foreground="{StaticResource SiloForegroundBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!--
                            Folded by category, each saying how many are on, so the page stays short: a flat accordion as the
                            web's, its headers and rows flush with each other and divided by hairlines only.
                        -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}" IsTabStop="False"
                                      BorderThickness="0,1,0,0" BorderBrush="{StaticResource SiloSettingsHairlineBrush}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="settings:BadgeGroupViewModel">
                                    <StackPanel BorderThickness="0,0,0,1" BorderBrush="{StaticResource SiloSettingsHairlineBrush}">
                                        <Button Style="{StaticResource SiloSettingsGhostButtonStyle}" CornerRadius="0" Padding="0" MinHeight="56"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{x:Bind ToggleCommand}"
                                                AutomationProperties.Name="{x:Bind Title}"
                                                AutomationProperties.ItemStatus="{x:Bind controls:BadgeSettingsLook.Folded(IsExpanded), Mode=OneWay}">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="40" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Title}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{StaticResource SiloForegroundBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind OnText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{StaticResource SiloMutedBrush}" />
                                                <FontIcon Grid.Column="2" Glyph="{x:Bind controls:BadgeSettingsLook.Chevron(IsExpanded), Mode=OneWay}" FontSize="12"
                                                          HorizontalAlignment="Center" Foreground="{StaticResource SiloMutedBrush}" />
                                            </Grid>
                                        </Button>
                                        <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource BadgeRowTemplate}" IsTabStop="False"
                                                      Visibility="{x:Bind IsExpanded, Mode=OneWay}" Margin="0,0,0,8" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            Granary's own: the title preview at the top of Home, For You and Discover (BrowseHero) is Granary's, so Silo's
            clients have no such switch. Kept for this profile on this PC (BrowseHeroSetting). Home's banner, a row marked as
            the hero on Silo's web, is not this switch's. Hero size is: it sets how tall the title preview and the banner are.
        -->
        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('granary.settings.pages.title')}" Description="{x:Bind t:AppText.Get('granary.settings.pages.description')}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('granary.settings.titlePreview.label')}"
                                      Description="{x:Bind t:AppText.Get('granary.settings.titlePreview.description')}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind TitlePreview.IsShown, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.titlePreview.label')}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('granary.settings.heroSize.label')}"
                                      Description="{x:Bind t:AppText.Get('granary.settings.heroSize.description')}">
                    <ItemsControl ItemsSource="{x:Bind TitlePreview.Sizes}" ItemTemplate="{StaticResource SettingsChoiceTemplate}" IsTabStop="False"
                                  AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.heroSize.label')}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <!-- The sidebar: Reset beside the title, so laid out by hand as Badges. -->
        <Border Padding="0,32" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SiloSettingsHairlineBrush}">
            <Grid ColumnSpacing="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="256" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock Text="{x:Bind t:AppText.Get('granary.settings.sidebar.title')}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{StaticResource SiloForegroundBrush}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                        <Button HorizontalAlignment="Right" Padding="8,4" Background="Transparent" BorderThickness="0"
                                Command="{x:Bind Sidebar.ResetCommand}" Visibility="{x:Bind Sidebar.IsCustomized, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.sidebar.reset')}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                                <TextBlock Text="{x:Bind t:AppText.Get('web.settings.resetButton.label')}" FontFamily="{StaticResource SiloFontMedium}" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource SiloSettingsMutedTextStyle}"
                               Text="{x:Bind t:AppText.Get('granary.settings.sidebar.description')}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="24">
                    <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('granary.settings.sidebar.serverLogo')}"
                                          Description="{x:Bind t:AppText.Get('granary.settings.sidebar.serverLogoDescription')}">
                        <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind Sidebar.ShowsServerLogo, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.sidebar.serverLogo')}" />
                    </controls:SettingsRow>
                    <ItemsControl ItemsSource="{x:Bind Sidebar.Groups}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="settings:SidebarGroupViewModel">
                                <StackPanel Margin="0,0,0,24" Visibility="{x:Bind HasRows, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Title}" Margin="0,0,0,8" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                                               FontSize="13" Foreground="{StaticResource SiloMutedBrush}" AutomationProperties.HeadingLevel="Level3" />
                                    <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource SidebarRowTemplate}" IsTabStop="False"
                                                  BorderThickness="0,0,0,1" BorderBrush="{StaticResource SiloSettingsHairlineBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
