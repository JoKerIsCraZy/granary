<?xml version="1.0" encoding="utf-8"?>
<!-- Settings → Title Pages, as on Silo's web (pages/settings/TitlePagesSettings.tsx), in its order of groups. -->
<UserControl
    x:Class="Granary.App.Views.Settings.TitlePagesSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:t="using:Granary.Core.Texts">

    <!-- Its own copy: the view is made before it joins the page, whose resources it cannot see then. -->
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Themes/SiloSettings.xaml" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{x:Bind t:AppText.Get('web.settings.titlePages.title')}" Style="{StaticResource SiloSettingsPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Margin="0,8,0,32" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="14"
                   Text="{x:Bind t:AppText.Get('web.settings.titlePages.subtitle')}" />
        <InfoBar IsOpen="{x:Bind controls:SettingsText.Has(ViewModel.ErrorMessage), Mode=OneWay}" Severity="Error" IsClosable="False"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Margin="0,0,0,16" />

        <!-- The web's TitleArtSettingsGroup.tsx: this PC's choice, the profile's for every device, or the server's default. -->
        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('web.settings.titleArt.title')}" Description="{x:Bind t:AppText.Get('web.settings.titleArt.description')}"
                                Visibility="{x:Bind ViewModel.OffersTitleArt, Mode=OneWay}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('settingsManifest.ui.title_art.label')}"
                                      Description="{x:Bind t:AppText.Get('web.settings.titleArt.titleArtDescription')}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.ShowsTitleArt, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanEditTitlePage, Mode=OneWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('settingsManifest.ui.title_art.label')}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('web.settings.titleArt.allDevices')}" Description="{x:Bind t:AppText.Get('web.settings.titleArt.allDevicesDescription')}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.TitleArtForAllDevices, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanEditTitlePage, Mode=OneWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.titleArt.allDevices')}" />
                </controls:SettingsRow>
                <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="12" Background="#0DFFFFFF"
                        Visibility="{x:Bind ViewModel.TitleArtNoteIsBoxed, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE946;" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="#D9FFFFFF"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="{x:Bind ViewModel.TitleArtNote, Mode=OneWay}" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                                   MaxWidth="620" Foreground="#D9FFFFFF" />
                    </StackPanel>
                </Border>
                <TextBlock Margin="0,12,0,0" Text="{x:Bind ViewModel.TitleArtNote, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                           FontSize="13" Visibility="{x:Bind ViewModel.ShowsTitleArtPlainNote, Mode=OneWay}" />
                <HyperlinkButton Margin="-4,8,0,0" Padding="4,2" FontSize="13" Foreground="{StaticResource SiloMutedBrush}"
                                 Command="{x:Bind ViewModel.UseServerDefaultTitleArtCommand}" AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.titleArt.useServerDefault')}"
                                 Visibility="{x:Bind ViewModel.CanUseServerDefaultTitleArt, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7A7;" FontSize="13" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="{x:Bind t:AppText.Get('web.settings.titleArt.useServerDefault')}" />
                    </StackPanel>
                </HyperlinkButton>
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('web.settings.titlePages.soundTitle')}" Description="{x:Bind t:AppText.Get('web.settings.titlePages.soundDescription')}"
                                Visibility="{x:Bind ViewModel.OffersThemeMusic, Mode=OneWay}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('settingsManifest.ui.theme_music_enabled.label')}"
                                      Description="{x:Bind t:AppText.Get('settingsManifest.ui.theme_music_enabled.description')}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.PlaysThemeMusic, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanEditTitlePage, Mode=OneWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('settingsManifest.ui.theme_music_enabled.label')}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('settingsManifest.ui.theme_music_loop.label')}"
                                      Description="{x:Bind t:AppText.Get('settingsManifest.ui.theme_music_loop.description')}"
                                      Visibility="{x:Bind ViewModel.OffersThemeMusicLoop, Mode=OneWay}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.LoopsThemeMusic, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanEditTitlePage, Mode=OneWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('settingsManifest.ui.theme_music_loop.label')}" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('web.settings.titlePages.spoilersTitle')}" Description="{x:Bind t:AppText.Get('web.settings.titlePages.spoilersDescription')}">
            <StackPanel>
                <TextBlock Text="{x:Bind t:AppText.Get('web.settings.interface.loading')}" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="14"
                           Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <!-- Why the switches cannot show: the read failed, or the server predates them. -->
                <Border Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="#FF28282E" Background="#0AFFFFFF"
                        Visibility="{x:Bind controls:SettingsText.Shows(ViewModel.BlockerTitle), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.BlockerTitle, Mode=OneWay}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium"
                                   FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource SiloForegroundBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.BlockerText, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}" />
                    </StackPanel>
                </Border>
                <StackPanel Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                    <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('settingsManifest.catalog.hide_unwatched_episode_images.label')}"
                                          Description="{x:Bind t:AppText.Get('settingsManifest.catalog.hide_unwatched_episode_images.description')}">
                        <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.HidesImages, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Bind t:AppText.Get('settingsManifest.catalog.hide_unwatched_episode_images.label')}" />
                    </controls:SettingsRow>
                    <controls:SettingsRow Label="{x:Bind t:AppText.Get('settingsManifest.catalog.hide_unwatched_episode_overviews.label')}"
                                          Description="{x:Bind t:AppText.Get('settingsManifest.catalog.hide_unwatched_episode_overviews.description')}">
                        <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.HidesOverviews, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Bind t:AppText.Get('settingsManifest.catalog.hide_unwatched_episode_overviews.label')}" />
                    </controls:SettingsRow>
                </StackPanel>
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('web.settings.titlePages.ageGuidanceTitle')}" Visibility="{x:Bind ViewModel.OffersAdvisoryAge, Mode=OneWay}">
            <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('settingsManifest.catalog.show_advisory_age.label')}"
                                  Description="{x:Bind t:AppText.Get('web.settings.titlePages.advisoryAgeDescription')}">
                <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.ShowsAdvisoryAge, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.CanEditTitlePage, Mode=OneWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('settingsManifest.catalog.show_advisory_age.label')}" />
            </controls:SettingsRow>
        </controls:SettingsGroup>
    </StackPanel>
</UserControl>
