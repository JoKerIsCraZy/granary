<?xml version="1.0" encoding="utf-8"?>
<!-- Settings → Playback, as on Silo's web (pages/settings/PlaybackSettings.tsx). -->
<UserControl
    x:Class="Granary.App.Views.Settings.PlaybackSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:settings="using:Granary.Core.ViewModels.Settings"
    xmlns:t="using:Granary.Core.Texts">

    <!-- Its own copy: the view is made before it joins the page, whose resources it cannot see then. -->
    <UserControl.Resources>
        <ResourceDictionary Source="ms-appx:///Themes/SiloSettings.xaml" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{x:Bind t:AppText.Get('web.settings.playback.title')}" Style="{StaticResource SiloSettingsPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Margin="0,8,0,32" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="14"
                   Text="{x:Bind t:AppText.Get('web.settings.playback.subtitle')}" />
        <InfoBar IsOpen="{x:Bind controls:SettingsText.Has(ViewModel.ErrorMessage), Mode=OneWay}" Severity="Error" IsClosable="False"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Margin="0,0,0,16" />

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('web.settings.playback.quality.title')}"
                                Description="{x:Bind t:AppText.Get('web.settings.playback.quality.groupDescription')}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('settingsManifest.playback.preferred_quality.label')}"
                                      Description="{x:Bind ViewModel.QualityDescription, Mode=OneWay}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" ItemsSource="{x:Bind ViewModel.QualityChoices}"
                              SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}" IsEnabled="{x:Bind controls:SettingsText.Not(ViewModel.IsLoading), Mode=OneWay}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('settingsManifest.playback.max_bitrate_kbps.label')}"
                                      Description="{x:Bind t:AppText.Get('web.settings.playback.maxBitrate.description')}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" ItemsSource="{x:Bind ViewModel.BitrateChoices, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedBitrate, Mode=TwoWay}" IsEnabled="{x:Bind controls:SettingsText.Not(ViewModel.IsLoading), Mode=OneWay}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('settingsManifest.playback.buffering_quality_mode.label')}" Visibility="{x:Bind ViewModel.ShowsBuffering, Mode=OneWay}"
                                      Description="{x:Bind t:AppText.Get('settingsManifest.playback.buffering_quality_mode.description')}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" ItemsSource="{x:Bind ViewModel.BufferingChoices}"
                              SelectedItem="{x:Bind ViewModel.SelectedBuffering, Mode=TwoWay}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind ViewModel.LearnedLimitText, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowsLearnedLimit, Mode=OneWay}">
                    <Button Content="{x:Bind t:AppText.Get('web.settings.playbackConnection.reset')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}"
                            Command="{x:Bind ViewModel.ResetLearnedLimitCommand}" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.playback.resetLearnedLimit')}" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <!-- Granary's own: about this PC's graphics card and player, so kept on the PC, not in the profile. -->
        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('granary.settings.playback.thisPc')}" Description="{x:Bind t:AppText.Get('granary.settings.playback.thisPcDescription')}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('granary.settings.playback.softwareDecoding')}"
                                      Description="{x:Bind t:AppText.Get('granary.settings.playback.softwareDecodingDescription')}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.DecodesInSoftware, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.playback.softwareDecoding')}" />
                </controls:SettingsRow>
                <!-- Granary's own: a remote's arrows and a keyboard's are the same keys, so the viewer says which they use. -->
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('granary.settings.playback.upDown')}"
                                      Description="{x:Bind t:AppText.Get('granary.settings.playback.upDownDescription')}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" ItemsSource="{x:Bind ViewModel.UpDownChoices}"
                              SelectedItem="{x:Bind ViewModel.SelectedUpDown, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.playback.upDown')}" />
                </controls:SettingsRow>
                <!-- player.resume_rewind_seconds, kept on the device as the contract has it, with its words and range; 0 by default, Granary's own choice (ResumeRewind). -->
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('settingsManifest.player.resume_rewind_seconds.label')}"
                                      Description="{x:Bind t:AppText.Get('settingsManifest.player.resume_rewind_seconds.description')}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <NumberBox Width="80" Minimum="0" Maximum="30" SmallChange="1" LargeChange="5" VerticalAlignment="Center"
                                   Value="{x:Bind ViewModel.ResumeRewindSeconds, Mode=TwoWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.playback.resumeRewindName')}" />
                        <TextBlock Text="{x:Bind t:AppText.Get('granary.settings.playback.secondsUnit')}" VerticalAlignment="Center" Foreground="{StaticResource SiloMutedBrush}" />
                    </StackPanel>
                </controls:SettingsRow>
                <!-- player.passout_threshold is kept on the device, as the contract has it, which also sets the highest number; the named choices are the Android app's. -->
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('settingsManifest.player.passout_threshold.label')}"
                                      Description="{x:Bind t:AppText.Get('granary.settings.playback.stillWatchingDescription')}">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <NumberBox Width="80" Minimum="1" Maximum="20" SmallChange="1" LargeChange="5" VerticalAlignment="Center"
                                   Value="{x:Bind ViewModel.StillWatchingEpisodes, Mode=TwoWay}"
                                   Visibility="{x:Bind ViewModel.IsStillWatchingCustom, Mode=OneWay}"
                                   AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.playback.stillWatchingEpisodes')}" />
                        <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" ItemsSource="{x:Bind ViewModel.StillWatchingChoices}"
                                  SelectedItem="{x:Bind ViewModel.SelectedStillWatching, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind t:AppText.Get('settingsManifest.player.passout_threshold.label')}" />
                    </StackPanel>
                </controls:SettingsRow>
                <!-- mpv reads the file when it starts, and each load starts a new one if the file changed (docs/architecture.md, "Your own mpv.conf"). -->
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('granary.settings.mpv.config')}" Description="{x:Bind t:AppText.Get('granary.settings.mpv.configDescription')}">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <!-- Only when the line below says how mpv.conf fared: the log has the details. -->
                        <HyperlinkButton Content="{x:Bind t:AppText.Get('granary.settings.mpv.openLogs')}" Command="{x:Bind ViewModel.OpenLogsCommand}"
                                         Visibility="{x:Bind controls:SettingsText.Shows(ViewModel.MpvConfigStatusText), Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind t:AppText.Get('granary.settings.mpv.openLogsTooltip')}"
                                         AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.mpv.openLogs')}" />
                        <HyperlinkButton Content="{x:Bind t:AppText.Get('granary.settings.mpv.openFolder')}" Command="{x:Bind ViewModel.OpenMpvFolderCommand}"
                                         ToolTipService.ToolTip="{x:Bind t:AppText.Get('granary.settings.mpv.openFolderTooltip')}"
                                         AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.mpv.openFolderName')}" />
                        <Button Content="{x:Bind t:AppText.Get('granary.settings.mpv.openFile')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}"
                                Command="{x:Bind ViewModel.OpenMpvConfigCommand}" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.mpv.openFile')}" />
                        <!-- Granary's own editor, in this page's place (MpvConfigEditorView), for a remote as for a keyboard. -->
                        <Button x:Name="EditMpvConfigButton" Content="{x:Bind t:AppText.Get('granary.settings.mpv.edit')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}"
                                Click="OnEditMpvConfigClick" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.mpv.editName')}" />
                    </StackPanel>
                </controls:SettingsRow>
                <!-- How the player fared with mpv.conf in this run; a fix counts from the next title, as the row says. -->
                <TextBlock Margin="0,12,0,0" Text="{x:Bind ViewModel.MpvConfigStatusText, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                           Visibility="{x:Bind controls:SettingsText.Shows(ViewModel.MpvConfigStatusText), Mode=OneWay}"
                           AutomationProperties.Name="{x:Bind ViewModel.MpvConfigStatusText, Mode=OneWay}" />
                <TextBlock Margin="0,12,0,0" Text="{x:Bind ViewModel.MpvConfigMessage, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                           Visibility="{x:Bind controls:SettingsText.Shows(ViewModel.MpvConfigMessage), Mode=OneWay}"
                           AutomationProperties.LiveSetting="Polite" />
                <!-- A change made here, until a title has started with it (MpvConfigChanges). -->
                <TextBlock Margin="0,12,0,0" Text="{x:Bind Mpv.ChangeText, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                           Visibility="{x:Bind controls:SettingsText.Shows(Mpv.ChangeText), Mode=OneWay}"
                           AutomationProperties.LiveSetting="Polite" />
                <!-- Granary's own: named copies of mpv.conf, plain files in mpv\presets (MpvPresets). -->
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('granary.settings.mpv.presets')}" Description="{x:Bind t:AppText.Get('granary.settings.mpv.presetsDescription')}">
                    <Button x:Name="SavePresetButton" Content="{x:Bind t:AppText.Get('granary.settings.mpv.saveAsPreset')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}"
                            Click="OnSavePresetClick" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.mpv.saveAsPresetName')}" />
                </controls:SettingsRow>
                <!-- The preset loaded last, while one is; Unload goes back to mpv.conf from before the first preset. -->
                <Grid Margin="0,12,0,0" ColumnSpacing="12" Visibility="{x:Bind Mpv.HasActivePreset, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Mpv.ActivePresetText, Mode=OneWay}" VerticalAlignment="Center" FontFamily="{StaticResource SiloFontMedium}"
                               FontWeight="Medium" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SiloForegroundBrush}" />
                    <Button x:Name="UnloadPresetButton" Grid.Column="1" Content="{x:Bind t:AppText.Get('granary.settings.mpv.unload')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}"
                            Click="OnUnloadPresetClick" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.mpv.unloadName')}" />
                </Grid>
                <TextBlock Margin="0,12,0,0" Text="{x:Bind t:AppText.Get('granary.settings.mpv.noPresets')}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                           Visibility="{x:Bind controls:SettingsText.Hides(Mpv.HasPresets), Mode=OneWay}" />
                <ItemsControl ItemsSource="{x:Bind Mpv.Presets, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="settings:MpvPresetRow">
                            <Grid Margin="0,12,0,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource SiloForegroundBrush}" />
                                <Button Grid.Column="1" Content="{x:Bind t:AppText.Get('granary.settings.mpv.load')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Tag="{x:Bind}"
                                        Click="OnLoadPresetClick" AutomationProperties.Name="{x:Bind LoadName}" />
                                <Button Grid.Column="2" Content="{x:Bind t:AppText.Get('granary.settings.mpv.delete')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Tag="{x:Bind}"
                                        Click="OnDeletePresetClick" AutomationProperties.Name="{x:Bind DeleteName}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,12,0,0" Text="{x:Bind Mpv.PresetMessage, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                           Visibility="{x:Bind controls:SettingsText.Shows(Mpv.PresetMessage), Mode=OneWay}"
                           AutomationProperties.LiveSetting="Polite" />
                <!-- Granary's own: Discord's status while a title plays (PlayerRichPresence), shown or taken away at once. -->
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('granary.settings.playback.discord')}"
                                      Description="{x:Bind t:AppText.Get('granary.settings.playback.discordDescription')}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.DiscordStatus, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.playback.discord')}" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <!--
            Granary's own: Silo's clients have no such editor. The right of the player's bar, for this profile on this PC
            (PlayerButtonsLayout), as Navigation & Cards arranges the sidebar: Reset beside the title, so laid out by hand.
            Move up and Move down keep the keyboard on their row as it moves (OnMovePlayerButtonClick), and take it while they are off at the ends,
            so a remote's Up and Down go along each column.
        -->
        <Border Padding="0,32" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SiloSettingsHairlineBrush}">
            <Grid ColumnSpacing="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="256" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock Text="{x:Bind t:AppText.Get('granary.settings.playerButtons.title')}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{StaticResource SiloForegroundBrush}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                        <Button x:Name="ResetPlayerButtonsButton" HorizontalAlignment="Right" Padding="8,4" Background="Transparent" BorderThickness="0"
                                Click="OnResetPlayerButtonsClick" Visibility="{x:Bind PlayerButtons.IsCustomized, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.playerButtons.reset')}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                                <TextBlock Text="{x:Bind t:AppText.Get('web.settings.resetButton.label')}" FontFamily="{StaticResource SiloFontMedium}" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource SiloSettingsMutedTextStyle}"
                               Text="{x:Bind t:AppText.Get('granary.settings.playerButtons.description')}" />
                </StackPanel>
                <ItemsControl x:Name="PlayerButtonRows" Grid.Column="1" ItemsSource="{x:Bind PlayerButtons.Rows}" IsTabStop="False"
                              BorderThickness="0,0,0,1" BorderBrush="{StaticResource SiloSettingsHairlineBrush}">
                    <ItemsControl.ItemTemplate>
                        <!-- One button: its icon and name, earlier or later in the bar, and its switch. -->
                        <DataTemplate x:DataType="settings:PlayerButtonRowViewModel">
                            <Grid Padding="0,10" ColumnSpacing="16" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SiloSettingsHairlineBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind controls:PlayerButtonGlyphs.Of(Button)}" FontSize="16" Foreground="{StaticResource SiloMutedBrush}"
                                          Opacity="{x:Bind controls:SettingsText.Dim(IsShown), Mode=OneWay}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Opacity="{x:Bind controls:SettingsText.Dim(IsShown), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="14"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource SiloForegroundBrush}" />
                                    <TextBlock Text="{x:Bind Note}" Style="{StaticResource SiloSettingsMutedTextStyle}" FontSize="12"
                                               Visibility="{x:Bind controls:SettingsText.Shows(Note)}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button Tag="up" Style="{StaticResource SiloSettingsGhostButtonStyle}" Width="32" Height="32" Padding="0"
                                            Click="OnMovePlayerButtonClick" AllowFocusWhenDisabled="True" IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind controls:BadgeSettingsLook.MoveUpName(Label)}" ToolTipService.ToolTip="{x:Bind t:AppText.Get('granary.settings.moveUp')}">
                                        <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                    </Button>
                                    <Button Tag="down" Style="{StaticResource SiloSettingsGhostButtonStyle}" Width="32" Height="32" Padding="0"
                                            Click="OnMovePlayerButtonClick" AllowFocusWhenDisabled="True" IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind controls:BadgeSettingsLook.MoveDownName(Label)}" ToolTipService.ToolTip="{x:Bind t:AppText.Get('granary.settings.moveDown')}">
                                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="3" Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind IsShown, Mode=TwoWay}"
                                              VerticalAlignment="Center" AutomationProperties.Name="{x:Bind controls:BadgeSettingsLook.ShowName(Label)}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!--
            This device's player.audio_sync_ms, as the web's device settings show it (DeviceSettingGroups: the Sound group, a
            slider with the value and its unit beside it), in the Android app's 50 ms steps. Positive plays the sound later.
            The view model makes the steps: a slider stepping by itself would move a value another app stored off them. A read
            that failed says so with Retry, as the Devices page does; a server that does not know the setting has no Sound.
        -->
        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('web.settings.deviceGroups.sound.title')}" Description="{x:Bind t:AppText.Get('web.settings.deviceGroups.sound.description')}"
                                Visibility="{x:Bind AudioDelay.IsSupported, Mode=OneWay}">
            <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('settingsManifest.player.audio_sync_ms.label')}"
                                  Description="{x:Bind t:AppText.Get('settingsManifest.player.audio_sync_ms.description')}">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Visibility="{x:Bind AudioDelay.HasLoadMessage, Mode=OneWay}">
                        <TextBlock Text="{x:Bind AudioDelay.LoadMessage, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <Button Content="{x:Bind t:AppText.Get('common.retry')}" Style="{StaticResource SiloSettingsOutlineButtonStyle}" Command="{x:Bind AudioDelay.LoadCommand}"
                                AutomationProperties.Name="{x:Bind t:AppText.Get('granary.settings.playback.audioSyncRetry')}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Visibility="{x:Bind AudioDelay.ShowsSlider, Mode=OneWay}">
                        <Slider x:Name="AudioSyncSlider" Width="160" VerticalAlignment="Center" IsThumbToolTipEnabled="False"
                                Minimum="{x:Bind settings:AudioDelaySettingsViewModel.Minimum}" Maximum="{x:Bind settings:AudioDelaySettingsViewModel.Maximum}"
                                StepFrequency="1" SmallChange="50" LargeChange="500"
                                Value="{x:Bind AudioDelay.Milliseconds, Mode=TwoWay}" IsEnabled="{x:Bind AudioDelay.IsLoaded, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind t:AppText.Get('settingsManifest.player.audio_sync_ms.label')}"
                                AutomationProperties.HelpText="{x:Bind t:AppText.Get('settingsManifest.player.audio_sync_ms.description')}" />
                        <TextBlock MinWidth="112" Text="{x:Bind AudioDelay.ValueText, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right"
                                   FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="12" Foreground="{StaticResource SiloMutedBrush}"
                                   Typography.NumeralAlignment="Tabular" AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                </Grid>
            </controls:SettingsRow>
        </controls:SettingsGroup>

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('web.settings.playbackConnection.title')}" Visibility="{x:Bind ViewModel.ShowsConnection, Mode=OneWay}">
            <StackPanel Spacing="16">
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('web.settings.playbackConnection.speed')}"
                                      Description="{x:Bind ViewModel.ConnectionSpeedText, Mode=OneWay}">
                    <Button Content="{x:Bind ViewModel.TestSpeedText, Mode=OneWay}" Style="{StaticResource SiloSettingsOutlineButtonStyle}"
                            Command="{x:Bind ViewModel.TestSpeedCommand}" Visibility="{x:Bind ViewModel.ShowsTestSpeed, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind t:AppText.Get('web.settings.playbackConnection.test')}" />
                </controls:SettingsRow>
                <TextBlock Text="{x:Bind ViewModel.SpeedTestMessage, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                           Visibility="{x:Bind controls:SettingsText.Shows(ViewModel.SpeedTestMessage), Mode=OneWay}"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{x:Bind ViewModel.BudgetText, Mode=OneWay}" Style="{StaticResource SiloSettingsMutedTextStyle}"
                           Visibility="{x:Bind controls:SettingsText.Shows(ViewModel.BudgetText), Mode=OneWay}" />
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('web.settings.playback.skipping.title')}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('settingsManifest.playback.intro_skip_mode.label')}"
                                      Description="{x:Bind t:AppText.Get('web.settings.playback.skipping.introModeDescription')}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" ItemsSource="{x:Bind ViewModel.IntroSkipChoices}"
                              SelectedItem="{x:Bind ViewModel.SelectedIntroSkip, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.ShowsIntroSkip, Mode=OneWay}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('settingsManifest.playback.auto_skip_recap.label')}"
                                      Description="{x:Bind t:AppText.Get('web.settings.playback.skipping.recapDescription')}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.AutoSkipRecaps, Mode=TwoWay}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('settingsManifest.playback.auto_skip_credits.label')}"
                                      Description="{x:Bind t:AppText.Get('settingsManifest.playback.auto_skip_credits.description')}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.AutoSkipCredits, Mode=TwoWay}" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('web.settings.playback.nextEpisode.title')}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('web.settings.playback.nextEpisode.previewLabel')}"
                                      Description="{x:Bind t:AppText.Get('web.settings.playback.nextEpisode.previewDescription')}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.StartNextAtPreview, Mode=TwoWay}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('settingsManifest.playback.auto_play_next.label')}"
                                      Description="{x:Bind t:AppText.Get('web.settings.playback.autoPlayNext.description')}">
                    <ToggleSwitch Style="{StaticResource SiloSettingsSwitchStyle}" IsOn="{x:Bind ViewModel.AutoPlayNext, Mode=TwoWay}" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>

        <StackPanel Padding="0,32,0,16" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SiloSettingsHairlineBrush}" Spacing="8">
            <TextBlock Text="{x:Bind t:AppText.Get('web.settings.playback.seek.title')}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="16"
                       Foreground="{StaticResource SiloForegroundBrush}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Style="{StaticResource SiloSettingsMutedTextStyle}" MaxWidth="660" HorizontalAlignment="Left"
                       Text="{x:Bind t:AppText.Get('web.settings.playback.seek.description')}" />
        </StackPanel>
        <controls:SettingsGroup Title="{x:Bind t:AppText.Get('web.settings.playback.seek.videoTitle')}"
                                Description="{x:Bind t:AppText.Get('web.settings.playback.seek.videoDescription')}">
            <StackPanel>
                <controls:SettingsRow Style="{StaticResource SiloSettingsFirstRowStyle}" Label="{x:Bind t:AppText.Get('web.settings.playback.seek.rewindInterval')}"
                                      Description="{x:Bind t:AppText.Get('web.settings.playback.seek.video.rewindDescription')}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" ItemsSource="{x:Bind ViewModel.SkipChoices}"
                              SelectedItem="{x:Bind ViewModel.SelectedRewind, Mode=TwoWay}" />
                </controls:SettingsRow>
                <controls:SettingsRow Label="{x:Bind t:AppText.Get('web.settings.playback.seek.forwardInterval')}"
                                      Description="{x:Bind t:AppText.Get('web.settings.playback.seek.video.forwardDescription')}">
                    <ComboBox Style="{StaticResource SiloSettingsComboBoxStyle}" ItemsSource="{x:Bind ViewModel.SkipChoices}"
                              SelectedItem="{x:Bind ViewModel.SelectedFastForward, Mode=TwoWay}" />
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsGroup>
    </StackPanel>
</UserControl>
