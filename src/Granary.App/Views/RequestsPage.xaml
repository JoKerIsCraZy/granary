<?xml version="1.0" encoding="utf-8"?>
<!--
    The Requests hub, as Silo's web shows it: the title, Discover and Yours as line tabs, then either rows of titles from
    TMDB or the account's requests grouped by what happens next. The page is cached: Back keeps the tab and its place.
-->
<Page
    x:Class="Granary.App.Views.RequestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:views="using:Granary.App.Views"
    xmlns:vm="using:Granary.Core.ViewModels"
    NavigationCacheMode="Enabled">

    <ScrollViewer x:Name="Scroller" XYFocusKeyboardNavigation="Enabled">
        <StackPanel Padding="48,32,48,48" Spacing="24">
            <StackPanel Spacing="6">
                <TextBlock Text="Requests" Style="{StaticResource SiloDisplayTextStyle}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="Ask for movies and series that aren’t in the library yet, and follow your requests." Style="{StaticResource SiloBodyTextStyle}"
                           Foreground="{StaticResource SiloMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Grid>
                <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource SiloBorderBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="4" XYFocusKeyboardNavigation="Enabled" AutomationProperties.Name="Requests view">
                    <RadioButton GroupName="RequestTabs" Content="Discover" Style="{StaticResource SiloLineTabStyle}"
                                 IsChecked="{x:Bind ViewModel.IsDiscoverTab, Mode=OneWay}" Checked="OnDiscoverChecked" />
                    <RadioButton GroupName="RequestTabs" Style="{StaticResource SiloLineTabStyle}" AutomationProperties.Name="Yours"
                                 IsChecked="{x:Bind ViewModel.IsYoursTab, Mode=OneWay}" Checked="OnYoursChecked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Yours" />
                            <Border MinWidth="20" Height="20" Padding="6,0" CornerRadius="10" Background="#33FFFFFF"
                                    Visibility="{x:Bind ViewModel.HasYoursCount, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.YoursCount, Mode=OneWay}" FontSize="10" FontFamily="{StaticResource SiloFontSemiBold}"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>

            <!-- Discover: rows of titles from TMDB. -->
            <StackPanel Visibility="{x:Bind ViewModel.IsDiscoverTab, Mode=OneWay}" Spacing="40">
                <!-- A card's Request that failed, in the web's toast words. -->
                <TextBlock Text="{x:Bind ViewModel.RequestNotice.Text, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloPrimaryBrush}"
                           Visibility="{x:Bind ViewModel.RequestNotice.HasText, Mode=OneWay}" AutomationProperties.LiveSetting="Assertive" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsDiscoverLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsDiscoverLoading, Mode=OneWay}"
                              Width="32" Height="32" Margin="0,48" HorizontalAlignment="Center" AutomationProperties.Name="Loading titles to discover" />
                <StackPanel Visibility="{x:Bind ViewModel.HasDiscoverError, Mode=OneWay}" Spacing="16" Margin="0,48" HorizontalAlignment="Center">
                    <TextBlock Text="TMDB couldn’t be reached, so there is nothing to discover right now." Style="{StaticResource SiloBodyTextStyle}"
                               Foreground="{StaticResource SiloMutedBrush}" TextAlignment="Center" />
                    <Button Content="Retry" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.RetryDiscoverCommand}" />
                </StackPanel>
                <TextBlock Visibility="{x:Bind ViewModel.IsDiscoverEmpty, Mode=OneWay}" Text="Nothing to discover right now." Margin="0,48"
                           HorizontalAlignment="Center" Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.DiscoverRows}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="40" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:RequestDiscoverRow">
                            <controls:MediaRow Title="{x:Bind Title}" ItemsSource="{x:Bind Cards}" CardInvokedCommand="{x:Bind OpenCommand}"
                                               ExploreAllCommand="{x:Bind ExploreAllCommand}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <!-- Studios, Networks and Genres, once the rows above have loaded, as on the web. -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.BrandRows}" Visibility="{x:Bind views:RequestsPage.Unless(ViewModel.IsDiscoverLoading), Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="40" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:RequestBrandRowViewModel">
                            <controls:BrandRow Row="{x:Bind}" Visibility="{x:Bind IsShown, Mode=OneWay}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- Yours: the account's requests by what happens next, as wide as the web's max-w-5xl and kept to the left. -->
            <Grid Visibility="{x:Bind ViewModel.IsYoursTab, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1024" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            <StackPanel Spacing="24">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Requests from your account, grouped by what happens next." Style="{StaticResource SiloBodyTextStyle}"
                               Foreground="{StaticResource SiloMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <!-- A plain button: the link style is a HyperlinkButton's, which cannot carry a flyout. -->
                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="8,4" Foreground="{StaticResource SiloMutedBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE946;" FontSize="14" />
                            <TextBlock Text="What the statuses mean" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <ItemsRepeater Width="320" ItemsSource="{x:Bind ViewModel.StatusHelp}" AutomationProperties.Name="Request statuses">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="10" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RequestStatusHelp">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Padding="8,2,8,3" CornerRadius="6" BorderThickness="1"
                                                        Background="{x:Bind views:RequestsPage.BadgeBackground(Look)}" BorderBrush="{x:Bind views:RequestsPage.BadgeBorder(Look)}">
                                                    <TextBlock Text="{x:Bind Label}" FontSize="11" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                                                               Foreground="{x:Bind views:RequestsPage.BadgeForeground(Look)}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Description}" Style="{StaticResource SiloCaptionTextStyle}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <TextBlock Text="{x:Bind ViewModel.Notice, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloPrimaryBrush}"
                           Visibility="{x:Bind ViewModel.HasNotice, Mode=OneWay}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsYoursLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsYoursLoading, Mode=OneWay}"
                              Width="32" Height="32" Margin="0,48" HorizontalAlignment="Center" AutomationProperties.Name="Loading your requests" />
                <StackPanel Visibility="{x:Bind ViewModel.HasYoursError, Mode=OneWay}" Spacing="16" Margin="0,48" HorizontalAlignment="Center">
                    <TextBlock Text="Couldn’t load your requests." Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}"
                               TextAlignment="Center" />
                    <Button Content="Retry" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.RetryYoursCommand}" />
                </StackPanel>
                <StackPanel Visibility="{x:Bind ViewModel.IsYoursEmpty, Mode=OneWay}" Spacing="10" Margin="0,48" HorizontalAlignment="Center">
                    <TextBlock Text="You haven’t requested anything." Style="{StaticResource SiloBodyTextStyle}" HorizontalAlignment="Center" />
                    <TextBlock MaxWidth="380" Text="Find a title on Discover or with search, and request it from its page. It shows up here with its status."
                               Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Content="Browse Discover" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="{x:Bind DiscoverTab}" />
                </StackPanel>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.RequestGroups}" Visibility="{x:Bind ViewModel.IsYoursReady, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="32" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:RequestGroupViewModel">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Title}" FontSize="18" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                                               Foreground="{StaticResource SiloForegroundBrush}" AutomationProperties.HeadingLevel="Level2" />
                                    <TextBlock Text="{x:Bind Count}" Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}"
                                               VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                </StackPanel>
                                <ItemsRepeater ItemsSource="{x:Bind Rows}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RequestRowViewModel">
                                            <Grid Padding="0,12" ColumnSpacing="16" BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="48" Height="72" CornerRadius="6" Background="#1AFFFFFF" VerticalAlignment="Top">
                                                    <Image Source="{x:Bind views:RequestsPage.Poster(PosterUrl)}" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Title}" FontSize="14" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource SiloForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                                        <Border Padding="8,1,8,2" CornerRadius="6" BorderThickness="1" VerticalAlignment="Center" Visibility="{x:Bind HasState}"
                                                                Background="{x:Bind views:RequestsPage.BadgeBackground(StateLook)}"
                                                                BorderBrush="{x:Bind views:RequestsPage.BadgeBorder(StateLook)}">
                                                            <TextBlock Text="{x:Bind StateLabel}" FontSize="11" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                                                                       Foreground="{x:Bind views:RequestsPage.BadgeForeground(StateLook)}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Details}" Style="{StaticResource SiloCaptionTextStyle}" />
                                                    <StackPanel Spacing="4" Width="256" HorizontalAlignment="Left" Visibility="{x:Bind HasDownload}">
                                                        <ProgressBar Value="{x:Bind DownloadValue}" Maximum="100" Visibility="{x:Bind HasDownloadBar}"
                                                                     Foreground="{StaticResource SiloPrimaryBrush}" AutomationProperties.Name="Download progress" />
                                                        <TextBlock Text="{x:Bind DownloadText}" Style="{StaticResource SiloCaptionTextStyle}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Dates}" Style="{StaticResource SiloCaptionTextStyle}" />
                                                    <TextBlock Text="{x:Bind Note}" Style="{StaticResource SiloCaptionTextStyle}" TextWrapping="Wrap" Visibility="{x:Bind HasNote}"
                                                               Foreground="{x:Bind views:RequestsPage.NoteForeground(IsError)}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SiloSecondaryButtonStyle}" Visibility="{x:Bind CanOpenInLibrary}"
                                                            Tag="{x:Bind}" Click="OnOpenInLibraryClick" AutomationProperties.Name="{x:Bind OpenName}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE8F1;" FontSize="13" />
                                                            <TextBlock Text="Open in library" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Content="Cancel request" Style="{StaticResource SiloSecondaryButtonStyle}" Visibility="{x:Bind CanCancel}"
                                                            IsEnabled="{x:Bind views:RequestsPage.Not(IsCancelling), Mode=OneWay}"
                                                            Tag="{x:Bind}" Click="OnCancelClick" AutomationProperties.Name="{x:Bind CancelName}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
