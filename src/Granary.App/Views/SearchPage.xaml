<?xml version="1.0" encoding="utf-8"?>
<!--
    Search as on Silo's web client (pages/SearchResults.tsx): the hero field (or, with nothing searched, the empty page and its box), the type menu with
    the sort, order and Filters beside it, and the views: Overview, In your library and Request to add. The overview shows
    the box sets found, two rows of the library's titles, the titles to request in a band of their own, people and three
    more rows; under another sort than Relevance people follow the rows instead. A person opens their page. Cached, so Back
    keeps the results and the view.
-->
<Page
    x:Class="Granary.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:vm="using:Granary.Core.ViewModels"
    xmlns:t="using:Granary.Core.Texts"
    NavigationCacheMode="Enabled"
    Loaded="OnLoaded"
    SizeChanged="OnSizeChanged">

    <Page.Resources>
        <!-- The empty page's title, as the web's .page-title: 60 px at a desktop width, extra bold, -0.05 em, tight. -->
        <Style x:Key="SearchPageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SiloDisplayTextStyle}">
            <Setter Property="FontSize" Value="60" />
            <Setter Property="LineHeight" Value="57" />
        </Style>

        <!-- The empty page's line, as the web's .page-subtitle: the foreground mixed 68 % into the muted colour. -->
        <SolidColorBrush x:Key="SearchSubtitleBrush" Color="#FFD2D2D8" />

        <!-- A heading of 18 px, as the web's text-lg font-semibold over box sets and Request to add. -->
        <Style x:Key="SearchSmallHeadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SiloRowTitleTextStyle}">
            <Setter Property="FontSize" Value="18" />
        </Style>

        <!-- The empty page's prominent box (search-paint-surface h-14 rounded-[1.4rem] border ps-12 pe-10 text-base). -->
        <Style x:Key="SearchProminentBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="48,16,40,0" />
            <Setter Property="CornerRadius" Value="22.4" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="{StaticResource SiloSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SiloBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="IsSpellCheckEnabled" Value="False" />
            <Setter Property="InputScope" Value="Search" />
        </Style>

        <!-- The results' hero field: no box, the text 48 px extra bold at -0.04 em, 48 px in after the magnifier (py-3 ps-12 pe-12). -->
        <Style x:Key="SearchHeroBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Padding" Value="48,12,48,12" />
            <Setter Property="FontFamily" Value="{StaticResource SiloFontExtraBold}" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="FontSize" Value="48" />
            <Setter Property="CharacterSpacing" Value="-40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="IsSpellCheckEnabled" Value="False" />
            <Setter Property="InputScope" Value="Search" />
        </Style>

        <!-- The fields' round clear button, at their end; the hero's on the surface's disc. -->
        <Style x:Key="SearchClearButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <!--
            A view's pill, as the web's result views: rounded-full px-4 py-2 text-sm font-semibold, muted until picked, then on
            the accent's light fill.
        -->
        <Style x:Key="SearchViewTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" Background="Transparent" CornerRadius="{StaticResource SiloPillCornerRadius}" controls:Pill.IsEnabled="True">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Shade.Foreground" Value="{StaticResource SiloForegroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Shade.Foreground" Value="{StaticResource SiloForegroundBrush}" />
                                            <Setter Target="Root.Opacity" Value="0.8" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#1FE8E8EC" />
                                            <Setter Target="Shade.Foreground" Value="{StaticResource SiloForegroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Shade" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                              FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A view's count beside its name: text-xs font-medium, muted, tabular. -->
        <Style x:Key="SearchViewCountTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>

        <!-- "Show all results →" beside a heading: text-sm font-semibold, muted until pointed at. -->
        <Style x:Key="SearchShowAllLinkStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource SiloLinkButtonStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CharacterSpacing" Value="0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <!-- The window's Ctrl+K leads here; on this page it returns to the box. -->
        <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="OnFocusSearchAccelerator" />
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFocusSearchAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid>
    <!-- Behind the header: the dimmed backdrop of the result the pointer or the keyboard is on. -->
    <controls:FocusBackdrop x:Name="Backdrop" Title="{x:Bind ViewModel.Backdrop.Shown, Mode=OneWay}" />

    <!--
        Nothing searched yet, as the web's empty search page (pages/Catalog.tsx, EmptySearch): in the middle a 40 px magnifier,
        "Search" as the page's title, its line, and the prominent box (SearchBar.tsx: 576 px at most, 56 high, 22.4 px corners,
        16 px text after a 20 px magnifier).
    -->
    <Grid Padding="48,64" Visibility="{x:Bind ViewModel.IsEmptySearch, Mode=OneWay}">
        <StackPanel MaxWidth="576" HorizontalAlignment="Center" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="{StaticResource SiloMutedBrush}" Margin="0,0,0,24" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="{x:Bind t:AppText.Get('web.catalog.page.searchTitle')}" Style="{StaticResource SearchPageTitleTextStyle}" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,0,0,16" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{x:Bind t:AppText.Get('web.catalog.page.searchSubtitle')}" FontSize="16" LineHeight="27" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" Foreground="{StaticResource SearchSubtitleBrush}" Margin="0,0,0,32" />
            <Grid Width="576" MaxWidth="576">
                <controls:SearchField x:Name="EmptySearchBox" Style="{StaticResource SearchProminentBoxStyle}"
                                      Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      PlaceholderText="{x:Bind t:AppText.Get('web.search.placeholderProminent')}"
                                      AutomationProperties.Name="{x:Bind t:AppText.Get('web.search.label')}" KeyDown="OnSearchBoxKeyDown"
                                      GotFocus="OnBoxFocusChanged" LostFocus="OnBoxFocusChanged">
                    <controls:SearchField.Resources>
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource SiloSurfaceColor}" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource SiloSurfaceColor}" />
                    </controls:SearchField.Resources>
                </controls:SearchField>
                <FontIcon Glyph="&#xE721;" FontSize="20" Margin="16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Foreground="{StaticResource SiloMutedBrush}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                <Button Style="{StaticResource SearchClearButtonStyle}" Width="28" Height="28" Margin="0,0,12,0" Click="OnClearClick"
                        Visibility="{x:Bind HasText(ViewModel.Query), Mode=OneWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('web.search.clear')}">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
            </Grid>
        </StackPanel>
    </Grid>

    <ScrollViewer x:Name="Scroller" XYFocusKeyboardNavigation="Enabled" Visibility="{x:Bind Hidden(ViewModel.IsEmptySearch), Mode=OneWay}">
        <StackPanel x:Name="Body" Padding="48,24,48,48" Spacing="32">
            <StackPanel Spacing="16">
                <!-- The page's name for screen readers; the field is the heading people see, as on the web. -->
                <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Height="1" Opacity="0" IsHitTestVisible="False" AutomationProperties.HeadingLevel="Level1" />

                <!--
                    The hero field, as the web's SearchBar hero: the text itself, large (48 px, extra bold, -0.04 em), after a 28 px
                    magnifier, on a hairline that takes the accent while the field has focus; a 36 px round clear button at its end.
                -->
                <Grid>
                    <controls:SearchField x:Name="SearchBox" Style="{StaticResource SearchHeroBoxStyle}"
                                          Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          PlaceholderText="{x:Bind t:AppText.Get('web.search.placeholderProminent')}"
                                          AutomationProperties.Name="{x:Bind t:AppText.Get('web.search.placeholderProminent')}" KeyDown="OnSearchBoxKeyDown"
                                          GotFocus="OnHeroFocusChanged" LostFocus="OnHeroFocusChanged">
                        <!-- No box in any state: the hairline under the field is all there is. -->
                        <controls:SearchField.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        </controls:SearchField.Resources>
                    </controls:SearchField>
                    <FontIcon x:Name="HeroIcon" Glyph="&#xE721;" FontSize="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Foreground="{StaticResource SiloMutedBrush}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                    <Button Style="{StaticResource SearchClearButtonStyle}" Width="36" Height="36" Background="{StaticResource SiloSurfaceBrush}" Click="OnClearClick"
                            Visibility="{x:Bind HasText(ViewModel.Query), Mode=OneWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('web.search.clear')}">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                    <Border x:Name="HeroLine" Height="1" VerticalAlignment="Bottom" Background="{StaticResource SiloBorderBrush}" IsHitTestVisible="False" />
                </Grid>

                <!-- The type menu, the sort, the order and Filters, as the web's search toolbar (CatalogFilterBar). -->
                <controls:WrapPanel HorizontalAlignment="Left" HorizontalSpacing="12" VerticalSpacing="8">
                    <DropDownButton x:Name="ScopeButton" CornerRadius="{StaticResource SiloPillCornerRadius}" controls:Pill.IsEnabled="True" MinHeight="38" Padding="16,6,12,6"
                                    FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="13" Background="#CC1C1C20" BorderBrush="{StaticResource SiloBorderBrush}"
                                    Content="{x:Bind ViewModel.ScopeLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind t:AppText.Get('web.catalog.search.scopeLabel')}">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="ScopeMenu" Placement="BottomEdgeAlignedLeft" Opening="OnScopeMenuOpening">
                                <RadioMenuFlyoutItem Tag="MoviesAndSeries" GroupName="SearchScope" Text="{x:Bind t:AppText.Get('web.catalog.mediaType.moviesAndSeries')}" Click="OnScopeClick" />
                                <RadioMenuFlyoutItem Tag="Movies" GroupName="SearchScope" Text="{x:Bind t:AppText.Get('web.catalog.mediaType.movies')}" Click="OnScopeClick" />
                                <RadioMenuFlyoutItem Tag="Series" GroupName="SearchScope" Text="{x:Bind t:AppText.Get('web.catalog.mediaType.series')}" Click="OnScopeClick" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Relevance leads the sorts; it has no order of its own. -->
                        <DropDownButton CornerRadius="{StaticResource SiloPillCornerRadius}" controls:Pill.IsEnabled="True" MinHeight="38" Padding="16,6,12,6"
                                        FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="13" Background="#CC1C1C20" BorderBrush="{StaticResource SiloBorderBrush}" Content="{x:Bind ViewModel.SortLabel, Mode=OneWay}"
                                        AutomationProperties.AutomationId="SearchSort" AutomationProperties.Name="{x:Bind SortName(ViewModel.SortLabel), Mode=OneWay}">
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedLeft" Opening="OnSortMenuOpening" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <DropDownButton CornerRadius="{StaticResource SiloPillCornerRadius}" controls:Pill.IsEnabled="True" MinHeight="38" Padding="16,6,12,6"
                                        FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="13" Background="#CC1C1C20" BorderBrush="{StaticResource SiloBorderBrush}" Content="{x:Bind ViewModel.OrderLabel, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsOrderShown, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind OrderName(ViewModel.OrderLabel), Mode=OneWay}">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <RadioMenuFlyoutItem Text="{x:Bind t:AppText.Get('web.catalog.sort.ascending')}" GroupName="SearchOrder" Command="{x:Bind ViewModel.SortAscendingCommand}"
                                                         IsChecked="{x:Bind Negate(ViewModel.IsDescending), Mode=OneWay}" />
                                    <RadioMenuFlyoutItem Text="{x:Bind t:AppText.Get('web.catalog.sort.descending')}" GroupName="SearchOrder" Command="{x:Bind ViewModel.SortDescendingCommand}"
                                                         IsChecked="{x:Bind ViewModel.IsDescending, Mode=OneWay}" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <controls:CatalogFiltersButton x:Name="FiltersButton" Filters="{x:Bind ViewModel.Filters}" />
                    </StackPanel>
                </controls:WrapPanel>
                <controls:ActiveFilterBadges Filters="{x:Bind ViewModel.Filters}" FiltersButton="{x:Bind FiltersButton}"
                                             Visibility="{x:Bind ViewModel.Filters.HasBadges, Mode=OneWay}" />

                <!-- The result views, as the web's: Overview, In your library with its count, Request to add while TMDB has titles. -->
                <StackPanel Orientation="Horizontal" Spacing="4" XYFocusKeyboardNavigation="Enabled"
                            Visibility="{x:Bind HasText(ViewModel.ResultsQuery), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind t:AppText.Get('web.search.results.viewsLabel')}">
                    <RadioButton GroupName="SearchViews" Tag="Overview" Style="{StaticResource SearchViewTabStyle}" Click="OnViewTabClick"
                                 IsChecked="{x:Bind ViewModel.IsOverviewShown, Mode=OneWay}" AutomationProperties.AutomationId="SearchViewOverview"
                                 Content="{x:Bind t:AppText.Get('web.search.results.overview')}" />
                    <RadioButton GroupName="SearchViews" Tag="Library" Style="{StaticResource SearchViewTabStyle}" Click="OnViewTabClick"
                                 IsChecked="{x:Bind ViewModel.IsLibraryViewShown, Mode=OneWay}" AutomationProperties.AutomationId="SearchViewLibrary"
                                 AutomationProperties.Name="{x:Bind t:AppText.Get('web.search.results.inLibrary')}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind t:AppText.Get('web.search.results.inLibrary')}" />
                            <TextBlock Text="{x:Bind ViewModel.LibraryCountText, Mode=OneWay}" Style="{StaticResource SearchViewCountTextStyle}"
                                       Visibility="{x:Bind HasText(ViewModel.LibraryCountText), Mode=OneWay}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="SearchViews" Tag="Requests" Style="{StaticResource SearchViewTabStyle}" Click="OnViewTabClick"
                                 IsChecked="{x:Bind ViewModel.IsRequestsViewShown, Mode=OneWay}" AutomationProperties.AutomationId="SearchViewRequests"
                                 Visibility="{x:Bind ViewModel.ShowsRequestsTab, Mode=OneWay}"
                                 AutomationProperties.Name="{x:Bind t:AppText.Get('web.search.results.requestToAdd')}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind t:AppText.Get('web.search.results.requestToAdd')}" />
                            <TextBlock Text="{x:Bind ViewModel.RequestCountText, Mode=OneWay}" Style="{StaticResource SearchViewCountTextStyle}"
                                       Visibility="{x:Bind HasText(ViewModel.RequestCountText), Mode=OneWay}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </StackPanel>

            <!--
                The box sets the text finds, as the web's search lists them (BoxSetSearchResults.tsx) ahead of the titles, in the
                titles' own columns. The overview only.
            -->
            <!-- The first titles on their way: twelve skeleton cards, as the web's. -->
            <controls:MediaGrid ItemsSource="{x:Bind Skeletons}" Visibility="{x:Bind ViewModel.ShowsSkeleton, Mode=OneWay}" IsHitTestVisible="False"
                                AutomationProperties.AccessibilityView="Raw" />

            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowsBoxSets, Mode=OneWay}" Opacity="{x:Bind Dim(ViewModel.IsStale), Mode=OneWay}">
                <TextBlock Text="{x:Bind t:AppText.Get('web.search.boxSets')}" Style="{StaticResource SearchSmallHeadingTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                <controls:MediaGrid ItemsSource="{x:Bind ViewModel.BoxSets, Mode=OneWay}" CardInvokedCommand="{x:Bind ViewModel.OpenBoxSetCommand}" />
            </StackPanel>

            <!-- The first two rows: "Best matches", or under another sort "In your library" with what it is sorted by. -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowsBestCards, Mode=OneWay}" Opacity="{x:Bind Dim(ViewModel.IsStale), Mode=OneWay}">
                <Grid>
                    <TextBlock Text="{x:Bind ViewModel.FirstRowsHeading, Mode=OneWay}" Style="{StaticResource SiloRowTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <HyperlinkButton HorizontalAlignment="Right" Style="{StaticResource SearchShowAllLinkStyle}" Command="{x:Bind ViewModel.ShowLibraryCommand}"
                                     Visibility="{x:Bind ViewModel.ShowsAllLinkAtFirstRows, Mode=OneWay}" AutomationProperties.AutomationId="SearchShowAllFirst">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind t:AppText.Get('web.search.results.showAll')}" />
                            <FontIcon Glyph="&#xE72A;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                    </HyperlinkButton>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,-6,0,0" Visibility="{x:Bind ViewModel.IsSortedOtherwise, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.SortedByText, Mode=OneWay}" FontSize="14" Foreground="{StaticResource SiloMutedBrush}" VerticalAlignment="Center" />
                    <HyperlinkButton Padding="0" Foreground="{StaticResource SiloMutedBrush}" FontSize="14" Command="{x:Bind ViewModel.BackToRelevanceCommand}">
                        <TextBlock Text="{x:Bind t:AppText.Get('web.search.results.backToRelevance')}" TextDecorations="Underline" />
                    </HyperlinkButton>
                </StackPanel>
                <controls:MediaGrid ItemsSource="{x:Bind ViewModel.BestCards, Mode=OneWay}" ColumnsCommand="{x:Bind ViewModel.SetColumnsCommand}"
                                    CardInvokedCommand="{x:Bind ViewModel.OpenCardCommand}" CardPointedCommand="{x:Bind ViewModel.PointCardCommand}" />
            </StackPanel>

            <!--
                The titles to request, two rows in, as the web's "Not in your library" band (bg-card/60, border-border/60,
                rounded-2xl, px-5 py-5): a row with Explore all, which opens the request view.
            -->
            <Border x:Name="RequestRowBand" Padding="20" CornerRadius="20" BorderThickness="1" Visibility="{x:Bind ViewModel.ShowsRequestRow, Mode=OneWay}">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource SiloSurfaceColor}" Opacity="0.6" />
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="{StaticResource SiloBorderColor}" Opacity="0.6" />
                </Border.BorderBrush>
                <StackPanel Spacing="12">
                    <controls:MediaRow Bleed="0" Title="{x:Bind t:AppText.Get('web.search.results.notInLibrary')}" ItemsSource="{x:Bind ViewModel.RequestRow, Mode=OneWay}"
                                       ExploreAllCommand="{x:Bind ViewModel.ShowRequestsCommand}" CardInvokedCommand="{x:Bind ViewModel.Requests.OpenCardCommand}"
                                       CardPointedCommand="{x:Bind ViewModel.PointCardCommand}" />
                    <!-- A row card's Request that failed, in the web's toast words: the grid below is not shown with the row. -->
                    <TextBlock Text="{x:Bind ViewModel.Requests.RequestNotice.Text, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}"
                               Foreground="{StaticResource SiloDestructiveBrush}" Visibility="{x:Bind ViewModel.Requests.RequestNotice.HasText, Mode=OneWay}"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </Border>

            <!-- People: after the titles to request under Relevance, after the more rows under another sort (SearchPage.PlacePeople). -->
            <StackPanel x:Name="PeopleSection" Spacing="12" Visibility="{x:Bind ViewModel.ShowsPeopleSection, Mode=OneWay}">
                <TextBlock Text="{x:Bind t:AppText.Get('web.catalog.page.people')}" Style="{StaticResource SiloRowTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                <!-- A failed lookup, in the web's words, with its own retry. -->
                <StackPanel Spacing="8" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.HasPeopleError, Mode=OneWay}">
                    <TextBlock Text="{x:Bind t:AppText.Get('web.catalog.page.peopleFailed')}" FontSize="14" Foreground="{StaticResource SiloMutedBrush}"
                               AutomationProperties.LiveSetting="Assertive" />
                    <Button Style="{StaticResource SiloSecondaryButtonStyle}" Command="{x:Bind ViewModel.RetryPeopleCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{x:Bind t:AppText.Get('web.catalog.page.retryPeople')}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- The web's CastCarousel: 110 px portrait cards 12 px apart. -->
                <ScrollView ContentOrientation="Horizontal" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                            VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                            controls:WheelScrollsPage.IsEnabled="True" Visibility="{x:Bind ViewModel.ShowsPeople, Mode=OneWay}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.People, Mode=OneWay}" Margin="0,0,0,12">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchPerson">
                                <Button Style="{StaticResource SiloCardButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Click="OnPersonClick" DataContext="{x:Bind}"
                                        AutomationProperties.Name="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}">
                                    <controls:PersonCard Person="{x:Bind}" />
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollView>
            </StackPanel>

            <!-- Up to three more rows: "More results" under Relevance; under another sort they go on with the list above. -->
            <StackPanel x:Name="MoreSection" Spacing="12" Visibility="{x:Bind ViewModel.ShowsMoreCards, Mode=OneWay}" Opacity="{x:Bind Dim(ViewModel.IsStale), Mode=OneWay}">
                <Grid Visibility="{x:Bind ViewModel.ShowsMoreHeading, Mode=OneWay}">
                    <TextBlock Text="{x:Bind t:AppText.Get('web.search.results.moreResults')}" Style="{StaticResource SiloRowTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <HyperlinkButton HorizontalAlignment="Right" Style="{StaticResource SearchShowAllLinkStyle}" Command="{x:Bind ViewModel.ShowLibraryCommand}"
                                     Visibility="{x:Bind ViewModel.ShowsAllLinkAtMoreRows, Mode=OneWay}" AutomationProperties.AutomationId="SearchShowAllMore">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind t:AppText.Get('web.search.results.showAll')}" />
                            <FontIcon Glyph="&#xE72A;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                    </HyperlinkButton>
                </Grid>
                <controls:MediaGrid ItemsSource="{x:Bind ViewModel.MoreCards, Mode=OneWay}"
                                    CardInvokedCommand="{x:Bind ViewModel.OpenCardCommand}" CardPointedCommand="{x:Bind ViewModel.PointCardCommand}" />
            </StackPanel>

            <!-- "Show all results" with the library's count, under the rows: the library view. -->
            <Button x:Name="ShowAllButton" HorizontalAlignment="Center" Style="{StaticResource SiloSecondaryButtonStyle}" CornerRadius="{StaticResource SiloPillCornerRadius}"
                    controls:Pill.IsEnabled="True" Padding="24,8" Command="{x:Bind ViewModel.ShowLibraryCommand}"
                    Visibility="{x:Bind ViewModel.ShowsAllButton, Mode=OneWay}" AutomationProperties.AutomationId="SearchShowAllButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind t:AppText.Get('web.search.results.showAll')}" />
                    <TextBlock Text="{x:Bind ViewModel.LibraryCountText, Mode=OneWay}" Foreground="{StaticResource SiloMutedBrush}" />
                </StackPanel>
            </Button>

            <!-- In your library: every title, read on as the grid scrolls. -->
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsLibraryViewShown, Mode=OneWay}">
                <TextBlock Text="{x:Bind t:AppText.Get('web.search.results.allInLibrary')}" Style="{StaticResource SiloRowTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                <controls:MediaGrid ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}"
                                    CardInvokedCommand="{x:Bind ViewModel.OpenCardCommand}" LoadMoreCommand="{x:Bind ViewModel.LoadMoreCommand}"
                                    CardPointedCommand="{x:Bind ViewModel.PointCardCommand}" />
            </StackPanel>

            <!-- Nothing at all found: the web's words, centred, 48 px above and below. -->
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Padding="0,48" FontSize="16" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource SiloMutedBrush}" Visibility="{x:Bind ViewModel.ShowsNothingFound, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />

            <!--
                A failed search, as the web's card: a 20 px rounded border, 64 px above and below, the title, its body (14 px, 448 px at
                most) and Retry search.
            -->
            <Border Padding="16,64" CornerRadius="20" BorderThickness="1" BorderBrush="{StaticResource SiloBorderBrush}" Background="{StaticResource SiloSurfaceBrush}"
                    Visibility="{x:Bind ViewModel.ShowsErrorCard, Mode=OneWay}">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Bind t:AppText.Get('web.catalog.page.searchFailed')}" FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="16"
                               HorizontalAlignment="Center" TextAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Text="{x:Bind ViewModel.ErrorBody, Mode=OneWay}" MaxWidth="448" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" Foreground="{StaticResource SiloMutedBrush}" />
                    <Button HorizontalAlignment="Center" Style="{StaticResource SiloSecondaryButtonStyle}" Command="{x:Bind ViewModel.RetryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{x:Bind t:AppText.Get('web.catalog.page.retrySearch')}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!--
                Request to add, as the web's RequestToAddSection: what TMDB finds that the library does not have. The request
                view, and the overview's answer while the library found nothing. Unlike the web's pager, TMDB's pages gather in
                one grid that reads on as its end comes into view, as Explore all does.
            -->
            <StackPanel x:Name="RequestSection" Spacing="12" Visibility="{x:Bind ViewModel.ShowsRequestGrid, Mode=OneWay}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind t:AppText.Get('web.requests.toAdd.heading')}" Style="{StaticResource SearchSmallHeadingTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{x:Bind ViewModel.Requests.Note, Mode=OneWay}" TextWrapping="Wrap" FontSize="14"
                               Foreground="{StaticResource SiloMutedBrush}" Visibility="{x:Bind HasText(ViewModel.Requests.Note), Mode=OneWay}" />
                </StackPanel>

                <!-- A card's Request that failed, in the web's toast words. -->
                <TextBlock Text="{x:Bind ViewModel.Requests.RequestNotice.Text, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}"
                           Foreground="{StaticResource SiloDestructiveBrush}" Visibility="{x:Bind ViewModel.Requests.RequestNotice.HasText, Mode=OneWay}"
                           AutomationProperties.LiveSetting="Assertive" />

                <controls:MediaGrid ItemsSource="{x:Bind ViewModel.Requests.Cards}" CardInvokedCommand="{x:Bind ViewModel.Requests.OpenCardCommand}"
                                    LoadMoreCommand="{x:Bind ViewModel.Requests.LoadMoreCommand}" CardPointedCommand="{x:Bind ViewModel.PointCardCommand}" />

                <TextBlock Text="{x:Bind t:AppText.Get('granary.search.allInLibrary')}" TextWrapping="Wrap" Style="{StaticResource SiloBodyTextStyle}"
                           Foreground="{StaticResource SiloMutedBrush}" Visibility="{x:Bind ViewModel.Requests.IsEmptySoFar, Mode=OneWay}" />
                <ProgressRing IsActive="{x:Bind ViewModel.Requests.IsLoadingMore, Mode=OneWay}" Visibility="{x:Bind ViewModel.Requests.IsLoadingMore, Mode=OneWay}"
                              Width="24" Height="24" HorizontalAlignment="Center" AutomationProperties.Name="{x:Bind t:AppText.Get('granary.search.loadingMoreRequests')}" />
                <!-- The grid's end coming into view presses it; it stays for the keyboard. -->
                <Button Content="{x:Bind t:AppText.Get('web.common.ui.loadMore.button')}" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.Requests.LoadMoreCommand}" Visibility="{x:Bind ViewModel.Requests.ShowsLoadMore, Mode=OneWay}" />
                <StackPanel Spacing="12" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.Requests.HasMoreError, Mode=OneWay}">
                    <TextBlock Text="{x:Bind t:AppText.Get('web.requests.results.loadMoreFailed')}" Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}"
                               HorizontalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
                    <Button Content="{x:Bind t:AppText.Get('common.tryAgain')}" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.Requests.TryAgainCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
