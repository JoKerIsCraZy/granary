<?xml version="1.0" encoding="utf-8"?>
<!--
    Search as on Silo's web client: a large title, a large rounded search box, the type switch, people as
    round photo cards, the titles, then Request to add. A person opens their page. Cached, so Back keeps the
    results and the Request to add page.
-->
<Page
    x:Class="Granary.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:vm="using:Granary.Core.ViewModels"
    NavigationCacheMode="Enabled"
    Loaded="OnLoaded">

    <Page.Resources>
        <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="54,15,56,0" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Background" Value="{StaticResource SiloSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SiloBorderBrush}" />
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <!-- The window's Ctrl+K leads here; on this page it returns to the box. -->
        <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="OnFocusSearchAccelerator" />
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFocusSearchAccelerator" />
    </Page.KeyboardAccelerators>

    <ScrollViewer x:Name="Scroller" XYFocusKeyboardNavigation="Enabled">
        <StackPanel Padding="48,32,48,48" Spacing="24">
            <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{StaticResource SiloDisplayTextStyle}" MaxLines="2"
                       TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level1" />

            <Grid MaxWidth="760" HorizontalAlignment="Stretch">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                         Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Search movies, series and people" IsSpellCheckEnabled="False" InputScope="Search"
                         AutomationProperties.Name="Search" KeyDown="OnSearchBoxKeyDown" />
                <FontIcon Glyph="&#xE721;" FontSize="18" Margin="22,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Foreground="{StaticResource SiloMutedBrush}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                <ProgressRing Width="20" Height="20" Margin="0,0,22,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                              AutomationProperties.Name="Searching" />
            </Grid>

            <SelectorBar x:Name="ScopeBar" SelectionChanged="OnScopeSelectionChanged" AutomationProperties.Name="Search in">
                <SelectorBarItem Text="Movies &amp; Series" />
                <SelectorBarItem Text="Movies" />
                <SelectorBarItem Text="Series" />
            </SelectorBar>

            <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.ShowsPeople, Mode=OneWay}">
                <TextBlock Text="People" Style="{StaticResource SiloRowTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                <ScrollView ContentOrientation="Horizontal" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                            VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                            controls:WheelScrollsPage.IsEnabled="True">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.People, Mode=OneWay}" Margin="0,0,0,12">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="20" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchPerson">
                                <Button Style="{StaticResource SiloCardButtonStyle}" HorizontalAlignment="Left" Click="OnPersonClick" DataContext="{x:Bind}"
                                        AutomationProperties.Name="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}">
                                    <controls:PersonCard Person="{x:Bind}" />
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollView>
            </StackPanel>

            <!-- Out of the way while Request to add stands in for a library that found nothing, as the web hides its grid. -->
            <StackPanel Spacing="14" Visibility="{x:Bind Not(ViewModel.IsLibraryRescued), Mode=OneWay}">
                <TextBlock Text="Titles" Style="{StaticResource SiloRowTitleTextStyle}" AutomationProperties.HeadingLevel="Level2"
                           Visibility="{x:Bind ViewModel.ShowsTitlesHeading, Mode=OneWay}" />
                <controls:MediaGrid ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}"
                                    CardInvokedCommand="{x:Bind ViewModel.OpenCardCommand}" LoadMoreCommand="{x:Bind ViewModel.LoadMoreCommand}" />
            </StackPanel>

            <!-- No titles, a failure, or what is loading; also announced. -->
            <StackPanel MaxWidth="480" HorizontalAlignment="Left" Spacing="14" Visibility="{x:Bind HasText(ViewModel.StatusText), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource SiloBodyTextStyle}"
                           Foreground="{StaticResource SiloMutedBrush}" AutomationProperties.LiveSetting="Polite" />
                <Button Content="Retry" Style="{StaticResource SiloSecondaryButtonStyle}" Command="{x:Bind ViewModel.RetryCommand}"
                        Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
            </StackPanel>

            <!--
                Request to add, as the web's RequestToAddSection: what TMDB finds that the library does not have. Laid out
                like People above: a plain heading over the titles. Unlike the web's pager, TMDB's pages gather in one grid
                that reads on as its end comes into view, as Explore all does.
            -->
            <StackPanel x:Name="RequestSection" Spacing="14" Visibility="{x:Bind ViewModel.ShowsRequests, Mode=OneWay}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Request to add" Style="{StaticResource SiloRowTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{x:Bind ViewModel.Requests.Note, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource SiloBodyTextStyle}"
                               Foreground="{StaticResource SiloMutedBrush}" Visibility="{x:Bind HasText(ViewModel.Requests.Note), Mode=OneWay}" />
                </StackPanel>

                <!-- A card's Request that failed, in the web's toast words. -->
                <TextBlock Text="{x:Bind ViewModel.Requests.RequestNotice.Text, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}"
                           Foreground="{StaticResource SiloPrimaryBrush}" Visibility="{x:Bind ViewModel.Requests.RequestNotice.HasText, Mode=OneWay}"
                           AutomationProperties.LiveSetting="Assertive" />

                <controls:MediaGrid ItemsSource="{x:Bind ViewModel.Requests.Cards}" CardInvokedCommand="{x:Bind ViewModel.Requests.OpenCardCommand}"
                                    LoadMoreCommand="{x:Bind ViewModel.Requests.LoadMoreCommand}" />

                <TextBlock Text="Every title found so far is already in your library." TextWrapping="Wrap" Style="{StaticResource SiloBodyTextStyle}"
                           Foreground="{StaticResource SiloMutedBrush}" Visibility="{x:Bind ViewModel.Requests.IsEmptySoFar, Mode=OneWay}" />
                <ProgressRing IsActive="{x:Bind ViewModel.Requests.IsLoadingMore, Mode=OneWay}" Visibility="{x:Bind ViewModel.Requests.IsLoadingMore, Mode=OneWay}"
                              Width="24" Height="24" HorizontalAlignment="Center" AutomationProperties.Name="Loading more titles to request" />
                <!-- The grid's end coming into view presses it; it stays for the keyboard. -->
                <Button Content="Load more" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.Requests.LoadMoreCommand}" Visibility="{x:Bind ViewModel.Requests.ShowsLoadMore, Mode=OneWay}" />
                <StackPanel Spacing="12" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.Requests.HasMoreError, Mode=OneWay}">
                    <TextBlock Text="Couldn’t load more titles." Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}"
                               HorizontalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
                    <Button Content="Try again" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.Requests.TryAgainCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
