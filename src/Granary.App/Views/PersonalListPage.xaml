<?xml version="1.0" encoding="utf-8"?>
<!--
    Favorites, Watchlist, History or a collection, as Silo's web catalog page shows them: the list's name and what it
    holds, the count on the right, the media and sort menus, and the posters. The watchlist adds the web's two line tabs
    when the server keeps titles the library does not have: In your library (the list) and Not in your library yet
    (WatchlistTitlesTab). The page is cached: Back keeps the list, the tab and the place.
-->
<Page
    x:Class="Granary.App.Views.PersonalListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    NavigationCacheMode="Enabled">

    <ScrollViewer x:Name="Scroller" XYFocusKeyboardNavigation="Enabled">
        <StackPanel Padding="48,32,48,48" Spacing="24">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource SiloDisplayTextStyle}"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}"
                               Foreground="{StaticResource SiloMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <!-- "18 RESULTS" behind a hairline, as on the web. -->
                <Border Grid.Column="1" VerticalAlignment="Bottom" BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="1,0,0,0"
                        Padding="14,0,0,0" Visibility="{x:Bind Both(ViewModel.Grid.IsReady, ViewModel.ShowsLibrary), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{x:Bind CountName(ViewModel.Grid.Total), Mode=OneWay}">
                        <TextBlock Text="{x:Bind CountText(ViewModel.Grid.Total), Mode=OneWay}" FontSize="30" FontWeight="Light"
                                   Foreground="{StaticResource SiloForegroundBrush}" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="{x:Bind CountLabel(ViewModel.Grid.Total), Mode=OneWay}" Style="{StaticResource SiloOverlineTextStyle}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,6" AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- The watchlist's tabs: the list, and the titles the library doesn't have yet with their count and an amber dot. -->
            <Grid Visibility="{x:Bind ViewModel.ShowsTabs, Mode=OneWay}">
                <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource SiloBorderBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="4" XYFocusKeyboardNavigation="Enabled" AutomationProperties.Name="Watchlist view">
                    <RadioButton GroupName="WatchlistTabs" Content="In your library" Style="{StaticResource SiloLineTabStyle}"
                                 IsChecked="{x:Bind Not(ViewModel.IsTitlesTab), Mode=OneWay}" Checked="OnLibraryTabChecked" />
                    <RadioButton GroupName="WatchlistTabs" Style="{StaticResource SiloLineTabStyle}" IsChecked="{x:Bind ViewModel.IsTitlesTab, Mode=OneWay}"
                                 Checked="OnTitlesTabChecked"
                                 AutomationProperties.Name="{x:Bind TitlesTabName(ViewModel.Titles.Count, ViewModel.Titles.NeedsAttention), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Not in your library yet" />
                            <Border MinWidth="20" Height="20" Padding="6,0" CornerRadius="10" Background="#33FFFFFF"
                                    Visibility="{x:Bind ViewModel.Titles.HasCount, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.Titles.Count, Mode=OneWay}" FontSize="10" FontFamily="{StaticResource SiloFontSemiBold}"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource SiloAttentionDotBrush}"
                                     Visibility="{x:Bind ViewModel.Titles.NeedsAttention, Mode=OneWay}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>

            <!-- In your library: the list itself. -->
            <StackPanel Spacing="24" Visibility="{x:Bind ViewModel.ShowsLibrary, Mode=OneWay}">
                <!-- "All Media ▾", "List Order ▾": dark pills, as the library's sort and order. -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <DropDownButton CornerRadius="{StaticResource SiloPillCornerRadius}" controls:Pill.IsEnabled="True" MinHeight="38" Padding="16,6,12,6"
                                    FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="13"
                                    Background="#CC1C1C20" BorderBrush="{StaticResource SiloBorderBrush}" Content="{x:Bind ViewModel.ScopeLabel, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ScopeName(ViewModel.ScopeLabel), Mode=OneWay}">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="ScopeMenu" Placement="BottomEdgeAlignedLeft" Opening="OnScopeMenuOpening" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton CornerRadius="{StaticResource SiloPillCornerRadius}" controls:Pill.IsEnabled="True" MinHeight="38" Padding="16,6,12,6"
                                    FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="13"
                                    Background="#CC1C1C20" BorderBrush="{StaticResource SiloBorderBrush}" Content="{x:Bind ViewModel.SortLabel, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind SortName(ViewModel.SortLabel), Mode=OneWay}">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedLeft" Opening="OnSortMenuOpening" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton CornerRadius="{StaticResource SiloPillCornerRadius}" controls:Pill.IsEnabled="True" MinHeight="38" Padding="16,6,12,6"
                                    FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="13"
                                    Background="#CC1C1C20" BorderBrush="{StaticResource SiloBorderBrush}" Content="{x:Bind ViewModel.OrderLabel, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsOrderShown, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind OrderName(ViewModel.OrderLabel), Mode=OneWay}">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <RadioMenuFlyoutItem Text="Ascending" GroupName="ListOrder" Command="{x:Bind ViewModel.SortAscendingCommand}"
                                                     IsChecked="{x:Bind Not(ViewModel.IsDescending), Mode=OneWay}" />
                                <RadioMenuFlyoutItem Text="Descending" GroupName="ListOrder" Command="{x:Bind ViewModel.SortDescendingCommand}"
                                                     IsChecked="{x:Bind ViewModel.IsDescending, Mode=OneWay}" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>

                <ProgressRing IsActive="{x:Bind ViewModel.Grid.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.Grid.IsLoading, Mode=OneWay}"
                              Width="32" Height="32" Margin="0,48" HorizontalAlignment="Center" AutomationProperties.Name="Loading titles" />
                <StackPanel Visibility="{x:Bind ViewModel.Grid.HasError, Mode=OneWay}" Spacing="16" Margin="0,48" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Grid.ErrorMessage, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}" TextAlignment="Center" />
                    <Button Content="Retry" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.Grid.RetryCommand}" />
                </StackPanel>
                <TextBlock Visibility="{x:Bind ViewModel.Grid.IsEmpty, Mode=OneWay}" Margin="0,48" HorizontalAlignment="Center"
                           Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}" Text="Nothing here yet." />

                <controls:MediaGrid x:Name="ListGrid" ItemsSource="{x:Bind ViewModel.Grid.Cards, Mode=OneWay}"
                                    CardInvokedCommand="{x:Bind ViewModel.OpenItemCommand}"
                                    ViewportCommand="{x:Bind ViewModel.Grid.ShowViewportCommand}"
                                    Visibility="{x:Bind ViewModel.Grid.IsReady, Mode=OneWay}" />

                <StackPanel Visibility="{x:Bind ViewModel.Grid.HasPageError, Mode=OneWay}" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="Couldn't load some titles." Style="{StaticResource SiloCaptionTextStyle}" VerticalAlignment="Center" />
                    <Button Content="Retry" Style="{StaticResource SiloSecondaryButtonStyle}" Command="{x:Bind ViewModel.Grid.RetryPagesCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Not in your library yet: the web's WatchlistTitlesTab. -->
            <StackPanel Spacing="24" Visibility="{x:Bind ViewModel.ShowsTitles, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind ViewModel.Titles.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.Titles.IsLoading, Mode=OneWay}"
                              Width="32" Height="32" Margin="0,48" HorizontalAlignment="Center" AutomationProperties.Name="Loading titles" />

                <Border Visibility="{x:Bind ViewModel.Titles.HasError, Mode=OneWay}" BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="1"
                        CornerRadius="20" Padding="16,64">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <TextBlock Text="Could not load these titles." Style="{StaticResource SiloBodyTextStyle}" FontSize="16"
                                   FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" HorizontalAlignment="Center"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <Button Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.Titles.RetryCommand}"
                                AutomationProperties.Name="Retry">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Retry" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Nothing waiting: a dashed box, as the web's. -->
                <Grid Visibility="{x:Bind ViewModel.Titles.IsEmpty, Mode=OneWay}">
                    <Rectangle RadiusX="20" RadiusY="20" Stroke="{StaticResource SiloBorderBrush}" StrokeThickness="1" StrokeDashArray="4,3" />
                    <StackPanel Spacing="12" Padding="16,64" HorizontalAlignment="Center">
                        <controls:BookmarkIcon Width="32" Height="32" HorizontalAlignment="Center" Foreground="{StaticResource SiloMutedBrush}"
                                               AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="Nothing waiting for the library" Style="{StaticResource SiloBodyTextStyle}" FontSize="16"
                                   FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" HorizontalAlignment="Center" />
                        <TextBlock Text="Add movies and series from Discover to your watchlist. The ones the library doesn’t have yet wait here until they arrive."
                                   Style="{StaticResource SiloBodyTextStyle}" FontSize="14" Foreground="{StaticResource SiloMutedBrush}" MaxWidth="448"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                        <Button Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.Titles.BrowseDiscoverCommand}"
                                AutomationProperties.Name="Browse Discover">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE909;" FontSize="14" />
                                <TextBlock Text="Browse Discover" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- What these titles are, and the way to more. -->
                <Border Visibility="{x:Bind ViewModel.Titles.IsReady, Mode=OneWay}" Background="{StaticResource SiloSurfaceBrush}" CornerRadius="16" Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.Titles.Hint, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}" FontSize="14"
                                   Foreground="{StaticResource SiloMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <HyperlinkButton Grid.Column="1" Content="Find more in Discover" VerticalAlignment="Center" Padding="4,2"
                                         FontFamily="{StaticResource SiloFontMedium}" FontWeight="Medium" FontSize="14"
                                         Foreground="{StaticResource SiloPrimaryBrush}" Command="{x:Bind ViewModel.Titles.BrowseDiscoverCommand}" />
                    </Grid>
                </Border>

                <controls:MediaGrid ItemsSource="{x:Bind ViewModel.Titles.Cards, Mode=OneWay}" CardInvokedCommand="{x:Bind ViewModel.Titles.OpenCardCommand}"
                                    Visibility="{x:Bind ViewModel.Titles.IsReady, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
