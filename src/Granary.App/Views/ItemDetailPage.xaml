<?xml version="1.0" encoding="utf-8"?>
<!--
    A movie, series, season or episode (docs/ui-design.md, "Detail pages"), laid out as Silage's title page: on black, the
    backdrop stands at the top right behind everything and fades to the left and down while the hero and the rows scroll
    over it. Then Granary's rows that fit the type: a series' seasons (opening a season's page) or a season's episodes,
    more episodes, trailers, cast and crew, more like this.
-->
<Page
    x:Class="Granary.App.Views.ItemDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:cards="using:Granary.Core.ViewModels.Cards"
    xmlns:detail="using:Granary.Core.ViewModels.Detail"
    xmlns:local="using:Granary.App.Views"
    xmlns:vm="using:Granary.Core.ViewModels">

    <Page.Resources>
        <!-- The page's black, under the standing backdrop and its fades. -->
        <SolidColorBrush x:Key="DetailPageBrush" Color="#FF000000" />
    </Page.Resources>

    <Grid Background="{StaticResource DetailPageBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SizeStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1400" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Sections.Spacing" Value="44" />
                        <Setter Target="Sections.Padding" Value="48,44,48,72" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="85*" />
            <RowDefinition Height="15*" />
        </Grid.RowDefinitions>

        <!--
            The backdrop stands still while the page scrolls: 85 % of the height at the top right, its placeholder first.
            Brushes, not Images: they fill the box the grid gives without asking for a height of their own.
        -->
        <Rectangle IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
            <Rectangle.Fill>
                <ImageBrush Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Top"
                            ImageSource="{x:Bind local:ItemDetailPage.Blur(ViewModel.BackdropThumbhash), Mode=OneWay}" />
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="Backdrop" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
            <Rectangle.Fill>
                <ImageBrush Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Top" ImageOpened="OnBackdropOpened"
                            ImageSource="{x:Bind controls:DetailHero.LoadImage(ViewModel.BackdropUrl, 0), Mode=OneWay}" />
            </Rectangle.Fill>
            <Rectangle.OpacityTransition>
                <ScalarTransition />
            </Rectangle.OpacityTransition>
        </Rectangle>
        <!-- Black under the text on the left, and down into the page. -->
        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#FF000000" />
                    <GradientStop Offset="0.25" Color="#EB000000" />
                    <GradientStop Offset="0.65" Color="#40000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.35" Color="#00000000" />
                    <GradientStop Offset="0.82" Color="#FF000000" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer x:Name="PageScroller" Grid.RowSpan="2" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
            <StackPanel>
                <controls:DetailHero x:Name="Hero" ViewModel="{x:Bind ViewModel}" />

                <StackPanel x:Name="Sections" Padding="48,56,48,96" Spacing="56">
                    <!-- Every season at once, wrapping at the page's width: a series rarely has more than a few rows of them. -->
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.HasSeasons, Mode=OneWay}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Seasons" Style="{StaticResource SiloRowTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind ViewModel.SeasonsTotalText, Mode=OneWay}"
                                       Style="{StaticResource SiloCaptionTextStyle}" FontSize="13" />
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Seasons, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="185" MinColumnSpacing="20" MinRowSpacing="28" ItemsStretch="None"
                                                   ItemsJustification="Start" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="cards:MediaCard">
                                    <Button Width="185" VerticalAlignment="Top" Style="{StaticResource SiloCardButtonStyle}" Click="OnSeasonClick"
                                            DataContext="{x:Bind}" AutomationProperties.Name="{x:Bind local:ItemDetailPage.SeasonName(Title, Caption, IsWatched)}">
                                        <controls:MediaCardView Card="{x:Bind}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.ShowsEpisodesSection, Mode=OneWay}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Episodes" Style="{StaticResource SiloRowTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind ViewModel.EpisodesTotalText, Mode=OneWay}"
                                       Style="{StaticResource SiloCaptionTextStyle}" FontSize="13" />
                        </Grid>
                        <Border Padding="20" CornerRadius="{StaticResource SiloCardCornerRadius}" Background="{StaticResource SiloSurfaceBrush}"
                                BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="1"
                                Visibility="{x:Bind ViewModel.ShowsNoEpisodes, Mode=OneWay}">
                            <TextBlock Text="{x:Bind vm:ItemDetailViewModel.NoEpisodesText}" Style="{StaticResource SiloBodyTextStyle}"
                                       Foreground="{StaticResource SiloMutedBrush}" />
                        </Border>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="280" MinColumnSpacing="20" MinRowSpacing="28" ItemsStretch="Fill"
                                                   ItemsJustification="Start" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="detail:DetailEpisode">
                                    <!-- Top-aligned: episodes without an overview are shorter than their row. -->
                                    <Button VerticalAlignment="Top" Style="{StaticResource SiloCardButtonStyle}" Click="OnEpisodeClick" DataContext="{x:Bind}"
                                            AutomationProperties.Name="{x:Bind AccessibleName}">
                                        <controls:DetailEpisodeCard Episode="{x:Bind}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <controls:MediaRow Title="More Episodes" ItemsSource="{x:Bind ViewModel.MoreEpisodes, Mode=OneWay}"
                                       CardInvokedCommand="{x:Bind ViewModel.OpenCardCommand}"
                                       Visibility="{x:Bind ViewModel.HasMoreEpisodes, Mode=OneWay}" />

                    <controls:DetailShelf Title="Trailers &amp; More" Visibility="{x:Bind ViewModel.HasTrailers, Mode=OneWay}">
                        <controls:DetailShelf.ShelfContent>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Trailers, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="16" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="detail:DetailTrailer">
                                        <Button Style="{StaticResource SiloCardButtonStyle}" Click="OnTrailerClick" DataContext="{x:Bind}"
                                                AutomationProperties.Name="{x:Bind AccessibleName}" ToolTipService.ToolTip="Play trailer">
                                            <controls:DetailTrailerCard Trailer="{x:Bind}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </controls:DetailShelf.ShelfContent>
                    </controls:DetailShelf>

                    <controls:DetailShelf Title="{x:Bind ViewModel.PeopleTitle, Mode=OneWay}" IsScrollerTabStop="True"
                                          Visibility="{x:Bind ViewModel.HasPeople, Mode=OneWay}">
                        <controls:DetailShelf.ShelfContent>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.People, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="16" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <!-- A card with a person opens their page; one without is only a card (not a stop for the keyboard). -->
                                    <DataTemplate x:DataType="detail:DetailPerson">
                                        <Button Style="{StaticResource SiloCardButtonStyle}" HorizontalAlignment="Left" Click="OnPersonClick" DataContext="{x:Bind}"
                                                IsTabStop="{x:Bind CanOpen}" IsHitTestVisible="{x:Bind CanOpen}"
                                                AutomationProperties.Name="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}">
                                            <controls:PersonCreditCard Person="{x:Bind}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </controls:DetailShelf.ShelfContent>
                    </controls:DetailShelf>

                    <controls:MediaRow Title="More Like This" ItemsSource="{x:Bind ViewModel.Similar, Mode=OneWay}"
                                       CardInvokedCommand="{x:Bind ViewModel.OpenCardCommand}"
                                       Visibility="{x:Bind ViewModel.HasSimilar, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing Grid.RowSpan="2" Width="48" Height="48" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" AutomationProperties.Name="Loading the title" />

        <StackPanel Grid.RowSpan="2" MaxWidth="520" Padding="48,0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                    Visibility="{x:Bind ViewModel.HasLoadError, Mode=OneWay}">
            <TextBlock Text="Couldn't load this title" Style="{StaticResource SiloPageTitleTextStyle}" TextAlignment="Center"
                       AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{x:Bind ViewModel.LoadErrorText, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}"
                       Foreground="{StaticResource SiloMutedBrush}" TextAlignment="Center" />
            <Button HorizontalAlignment="Center" Content="Try again" Style="{StaticResource SiloPrimaryButtonStyle}"
                    Command="{x:Bind ViewModel.RetryCommand}" />
        </StackPanel>

        <StackPanel Grid.RowSpan="2" MaxWidth="520" Padding="48,0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                    Visibility="{x:Bind ViewModel.IsNotFound, Mode=OneWay}">
            <TextBlock Text="{x:Bind vm:ItemDetailViewModel.NotFoundTitle}" Style="{StaticResource SiloPageTitleTextStyle}"
                       TextAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{x:Bind vm:ItemDetailViewModel.NotFoundHint}" Style="{StaticResource SiloBodyTextStyle}"
                       Foreground="{StaticResource SiloMutedBrush}" TextAlignment="Center" />
            <Button HorizontalAlignment="Center" Content="Go back" Style="{StaticResource SiloSecondaryButtonStyle}"
                    Command="{x:Bind ViewModel.GoBackCommand}" Visibility="{x:Bind ViewModel.CanGoBack}" />
        </StackPanel>
    </Grid>
</Page>
