<?xml version="1.0" encoding="utf-8"?>
<!--
    A cast or crew member, as Silo's web shows them (pages/PersonDetail.tsx): the 2:3 photo (initials without one) beside
    the name with Refresh metadata, the facts as badges and the bio; under a hairline the filmography, newest first, with
    All, Movies and Series. The page is cached: Back keeps it where it was.
-->
<Page
    x:Class="Granary.App.Views.PersonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <!-- The web's filmography filters: small outlined boxes, the picked one lighter with white text. -->
        <Style x:Key="FilmographyFilterStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{StaticResource SiloFontMedium}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="Transparent" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Text.Foreground" Value="{StaticResource SiloForegroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Box.Background" Value="#1AFFFFFF" />
                                            <Setter Target="Box.BorderBrush" Value="#33FFFFFF" />
                                            <Setter Target="Text.Foreground" Value="{StaticResource SiloForegroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Text" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller" XYFocusKeyboardNavigation="Enabled">
        <StackPanel>
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="32" Height="32" Margin="0,120" HorizontalAlignment="Center" AutomationProperties.Name="Loading person" />

            <!-- "Couldn't load this person" with Retry, or "This person isn't available". -->
            <StackPanel Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" Spacing="10" Margin="48,120" MaxWidth="440" HorizontalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}" Style="{StaticResource SiloRowTitleTextStyle}" HorizontalAlignment="Center"
                           TextAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Content="Retry" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0"
                        Command="{x:Bind ViewModel.RetryCommand}" Visibility="{x:Bind ViewModel.CanRetry, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                <!-- The person: photo, then name, facts and bio. -->
                <Grid Padding="48,80,48,32" ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="180" Height="270" VerticalAlignment="Top" CornerRadius="8" Background="{StaticResource SiloSurfaceBrush}"
                          BorderBrush="#0DFFFFFF" BorderThickness="1">
                        <TextBlock Text="{x:Bind ViewModel.Initials, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" FontSize="30"
                                   Foreground="{StaticResource SiloMutedBrush}" AutomationProperties.AccessibilityView="Raw" />
                        <Image x:Name="Photo" Stretch="UniformToFill" ImageFailed="OnPhotoFailed" AutomationProperties.Name="{x:Bind ViewModel.Name, Mode=OneWay}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Padding="0,4,0,0" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" FontSize="30" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                                       CharacterSpacing="-10" Foreground="{StaticResource SiloForegroundBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       AutomationProperties.HeadingLevel="Level1" />
                            <Button Style="{StaticResource SiloSecondaryButtonStyle}" MinHeight="32" Padding="12,4" VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.RefreshCommand}" AutomationProperties.Name="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                    <TextBlock Text="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ItemsRepeater ItemsSource="{x:Bind Badges(ViewModel.Facts), Mode=OneWay}" Visibility="{x:Bind ViewModel.HasFacts, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <controls:WrapLayout HorizontalSpacing="8" VerticalSpacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Style="{StaticResource SiloChipStyle}" Padding="10,4">
                                        <TextBlock Text="{x:Bind}" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold"
                                                   FontSize="11.2" CharacterSpacing="40" Foreground="{StaticResource SiloForegroundBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <TextBlock Text="{x:Bind ViewModel.Bio, Mode=OneWay}" MaxWidth="672" HorizontalAlignment="Left" FontSize="14" LineHeight="23"
                                   Foreground="{StaticResource SiloMutedBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Visibility="{x:Bind ViewModel.HasBio, Mode=OneWay}" />

                        <TextBlock Text="{x:Bind ViewModel.RefreshNotice, Mode=OneWay}" Style="{StaticResource SiloCaptionTextStyle}"
                                   Foreground="{x:Bind NoticeBrush(ViewModel.RefreshFailed), Mode=OneWay}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.HasRefreshNotice, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="#1AFFFFFF" />

                <!-- Filmography                                                   All  Movies  Series -->
                <StackPanel Padding="48,32,48,48" Spacing="24">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Filmography" FontSize="20" FontFamily="{StaticResource SiloFontSemiBold}" FontWeight="SemiBold" CharacterSpacing="-10"
                                   Foreground="{StaticResource SiloForegroundBrush}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" AutomationProperties.Name="Show">
                            <RadioButton x:Name="AllFilter" Content="All" GroupName="Filmography" Style="{StaticResource FilmographyFilterStyle}"
                                         Tag="0" IsChecked="True" Checked="OnFilterChecked" />
                            <RadioButton x:Name="MoviesFilter" Content="Movies" GroupName="Filmography" Style="{StaticResource FilmographyFilterStyle}"
                                         Tag="1" Checked="OnFilterChecked" />
                            <RadioButton x:Name="SeriesFilter" Content="Series" GroupName="Filmography" Style="{StaticResource FilmographyFilterStyle}"
                                         Tag="2" Checked="OnFilterChecked" />
                        </StackPanel>
                    </Grid>

                    <ProgressRing IsActive="{x:Bind ViewModel.IsFilmographyLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsFilmographyLoading, Mode=OneWay}"
                                  Width="28" Height="28" Margin="0,24" HorizontalAlignment="Center" AutomationProperties.Name="Loading titles" />
                    <TextBlock Text="No items found." Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,48" Visibility="{x:Bind ViewModel.IsFilmographyEmpty, Mode=OneWay}" />
                    <StackPanel Visibility="{x:Bind ViewModel.HasFilmographyError, Mode=OneWay}" Spacing="12" Margin="0,32" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.FilmographyError, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}"
                                   Foreground="{StaticResource SiloMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button Content="Retry" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                                Command="{x:Bind ViewModel.RetryCommand}" />
                    </StackPanel>

                    <controls:MediaGrid ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}" CardInvokedCommand="{x:Bind ViewModel.OpenCardCommand}"
                                        LoadMoreCommand="{x:Bind ViewModel.LoadMoreCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
