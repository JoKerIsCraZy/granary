<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Granary.App.Views.SignInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls">

    <ScrollViewer>
        <StackPanel Padding="36,24" Spacing="24" MaxWidth="1040" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind Heading(ViewModel.Server), Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                <HyperlinkButton Content="Use another server" Padding="0" Command="{x:Bind ViewModel.UseAnotherServerCommand}" />
            </StackPanel>

            <InfoBar Severity="Warning" IsClosable="False" Title="This connection is not encrypted"
                     Message="The server address starts with http://. Your password and sign-in would be readable by others on the network."
                     IsOpen="{x:Bind NeedsConsent(ViewModel.IsUnencrypted, ViewModel.IsUnencryptedAccepted), Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Sign in anyway" Command="{x:Bind ViewModel.AcceptUnencryptedCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid ColumnSpacing="40" Visibility="{x:Bind ViewModel.CanUseCredentials, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Width="340" Spacing="16" Visibility="{x:Bind ViewModel.IsPasswordSignInAvailable, Mode=OneWay}">
                    <TextBlock Text="With your password" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox x:Name="UsernameBox" Header="Username" IsSpellCheckEnabled="False" AutomationProperties.AutomationId="Username"
                             Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox Header="Password" AutomationProperties.AutomationId="Password" KeyDown="OnPasswordKeyDown"
                                 Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Sign in" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SignInCommand}" />
                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.SignInCommand.IsRunning, Mode=OneWay}" />
                    </StackPanel>
                    <InfoBar Severity="Error" IsClosable="False"
                             IsOpen="{x:Bind HasText(ViewModel.Status), Mode=OneWay}" Message="{x:Bind ViewModel.Status, Mode=OneWay}" />
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.IsPasswordSignInAvailable, Mode=OneWay}" />

                <controls:DeviceSignInPanel x:Name="DeviceSignIn" Grid.Column="2" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
