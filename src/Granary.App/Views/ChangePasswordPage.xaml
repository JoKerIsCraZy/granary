<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Granary.App.Views.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Granary.App.Views"
    xmlns:t="using:Granary.Core.Texts">

    <ScrollViewer>
        <StackPanel Padding="36,24" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
            <!-- The web's ChoosePassword page's words (pages/ChoosePassword.tsx). -->
            <TextBlock
                Text="{x:Bind t:AppText.Get('web.auth.passwordRules.chooseNewPassword')}"
                Style="{StaticResource TitleTextBlockStyle}"
                AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{x:Bind ViewModel.Explanation, Mode=OneWay}" TextWrapping="Wrap" />

            <PasswordBox
                x:Name="CurrentPasswordBox"
                Header="{x:Bind ViewModel.CurrentPasswordLabel, Mode=OneWay}"
                Password="{x:Bind ViewModel.CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <PasswordBox
                Header="{x:Bind t:AppText.Get('web.auth.passwordRules.newPassword')}"
                Password="{x:Bind ViewModel.NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <PasswordBox.Description>
                    <TextBlock Text="{x:Bind ViewModel.Requirements, Mode=OneWay}" TextWrapping="Wrap" />
                </PasswordBox.Description>
            </PasswordBox>
            <PasswordBox
                Header="{x:Bind t:AppText.Get('web.auth.passwordRules.confirmNewPassword')}"
                KeyDown="OnConfirmPasswordKeyDown"
                Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    Content="{x:Bind t:AppText.Get('web.auth.passwordRules.savePassword')}"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SubmitCommand}" />
                <Button Content="{x:Bind t:AppText.Get('common.signOut')}" Command="{x:Bind ViewModel.SignOutCommand}" />
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind t:AppText.Get('web.ui.saving')}" />
            </StackPanel>

            <InfoBar
                x:Name="StatusBar"
                IsClosable="False"
                IsOpen="{x:Bind local:ChangePasswordPage.HasText(ViewModel.Status), Mode=OneWay}"
                Message="{x:Bind ViewModel.Status, Mode=OneWay}"
                Severity="{x:Bind local:ChangePasswordPage.StatusSeverity(ViewModel.HasError), Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        Content="{x:Bind t:AppText.Get('common.tryAgain')}"
                        Command="{x:Bind ViewModel.LoadCommand}"
                        Visibility="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
    </ScrollViewer>
</Page>
