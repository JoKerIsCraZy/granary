<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Granary.App.Views.ProfilePickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Granary.App.Views"
    xmlns:vm="using:Granary.Core.ViewModels">

    <Grid Padding="36,48,36,24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Text="Who is watching?"
            HorizontalAlignment="Center"
            Style="{StaticResource TitleLargeTextBlockStyle}"
            AutomationProperties.HeadingLevel="Level1" />

        <InfoBar
            Grid.Row="1"
            MaxWidth="640"
            IsClosable="False"
            IsOpen="{x:Bind local:ProfilePickerPage.HasText(ViewModel.Status), Mode=OneWay}"
            Message="{x:Bind ViewModel.Status, Mode=OneWay}"
            Severity="{x:Bind local:ProfilePickerPage.StatusSeverity(ViewModel.HasLoadError), Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button
                    Content="Try again"
                    Command="{x:Bind ViewModel.RetryCommand}"
                    Visibility="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <ProgressRing
            Grid.Row="2"
            VerticalAlignment="Top"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            AutomationProperties.Name="Loading profiles" />

        <GridView
            x:Name="ProfileGrid"
            Grid.Row="2"
            HorizontalAlignment="Center"
            AutomationProperties.Name="Profiles"
            ContainerContentChanging="OnProfileContainerContentChanging"
            IsItemClickEnabled="True"
            ItemClick="OnProfileClick"
            ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
            SelectionMode="None">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="8" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileItemViewModel">
                    <StackPanel Width="168" Padding="16,20" Spacing="12">
                        <PersonPicture
                            Width="120"
                            Height="120"
                            AutomationProperties.AccessibilityView="Raw"
                            BadgeGlyph="{x:Bind local:ProfilePickerPage.LockBadge(HasPin)}"
                            DisplayName="{x:Bind Name}"
                            Initials="{x:Bind Initials}"
                            ProfilePicture="{x:Bind local:ProfilePickerPage.AvatarImage(AvatarUrl)}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            MaxLines="2"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <ContentDialog
            x:Name="PinDialog"
            Title="{x:Bind ViewModel.PinPromptTitle, Mode=OneWay}"
            CloseButtonText="Cancel"
            Closed="OnPinDialogClosed"
            DefaultButton="Primary"
            IsPrimaryButtonEnabled="False"
            Opened="OnPinDialogOpened"
            PrimaryButtonClick="OnPinDialogPrimaryButtonClick"
            PrimaryButtonText="Unlock">
            <StackPanel MinWidth="320" Spacing="12">
                <TextBlock Text="This profile is protected by a PIN." TextWrapping="Wrap" />
                <PasswordBox
                    x:Name="PinBox"
                    Header="PIN"
                    InputScope="NumericPin"
                    KeyDown="OnPinBoxKeyDown"
                    MaxLength="72"
                    PasswordChanged="OnPinBoxPasswordChanged" />
                <ProgressBar
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsVerifyingPin, Mode=OneWay}"
                    AutomationProperties.Name="Checking the PIN" />
                <!-- Cleared before every check, so each error reopens the bar and is announced. -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind local:ProfilePickerPage.HasText(ViewModel.PinError), Mode=OneWay}"
                    Message="{x:Bind ViewModel.PinError, Mode=OneWay}"
                    Severity="Error" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
