<?xml version="1.0" encoding="utf-8"?>
<!--
    One library, as on Silo's web client: "LIBRARY / NAME" on the left, Shuffle and the Recommended | Library |
    Collections switch on the right. Each tab scrolls on its own; the page is cached, so Back returns to the
    same tab and scroll position.
-->
<Page
    x:Class="Granary.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Granary.App.Controls"
    xmlns:vm="using:Granary.Core.ViewModels"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <!-- A segment of the tab switch: muted text, the picked one on a raised pill. -->
        <Style x:Key="LibraryTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SiloMutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" Background="Transparent" CornerRadius="{StaticResource SiloPillCornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Text.Foreground" Value="{StaticResource SiloForegroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.8" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource SiloSurfaceRaisedBrush}" />
                                            <Setter Target="Text.Foreground" Value="{StaticResource SiloForegroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                x:Name="Text"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shuffle, Filters: smaller dark pills than the detail page's buttons. -->
        <Style x:Key="LibraryPillButtonStyle" TargetType="Button" BasedOn="{StaticResource SiloSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- "Title ▾", "Ascending ▾". -->
        <Style x:Key="LibraryPillDropDownStyle" TargetType="DropDownButton">
            <Setter Property="CornerRadius" Value="{StaticResource SiloPillCornerRadius}" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,6,12,6" />
            <Setter Property="FontFamily" Value="{StaticResource SiloFontSemiBold}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#CC1C1C20" />
            <Setter Property="BorderBrush" Value="{StaticResource SiloBorderBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="48,32,48,0" ColumnSpacing="16" MinHeight="78">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Breadcrumb, Mode=OneWay}" Style="{StaticResource SiloSectionLabelTextStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       AutomationProperties.HeadingLevel="Level1"
                       AutomationProperties.Name="{x:Bind HeadingName(ViewModel.LibraryName), Mode=OneWay}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                <Button Style="{StaticResource LibraryPillButtonStyle}" Command="{x:Bind ViewModel.ShuffleCommand}"
                        Visibility="{x:Bind ViewModel.CanShuffle, Mode=OneWay}"
                        AutomationProperties.Name="Shuffle: open a random title" ToolTipService.ToolTip="Open a random title">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                        <TextBlock Text="Shuffle" />
                    </StackPanel>
                </Button>
                <Border Background="{StaticResource SiloSurfaceBrush}" BorderBrush="{StaticResource SiloBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource SiloPillCornerRadius}" Padding="4">
                    <StackPanel Orientation="Horizontal" Spacing="2" XYFocusKeyboardNavigation="Enabled"
                                AutomationProperties.Name="Library view">
                        <RadioButton GroupName="LibraryTabs" Tag="Recommended" Content="Recommended" Style="{StaticResource LibraryTabStyle}"
                                     IsChecked="{x:Bind ViewModel.IsRecommendedTab, Mode=OneWay}" Checked="OnTabChecked" />
                        <RadioButton GroupName="LibraryTabs" Tag="Library" Content="Library" Style="{StaticResource LibraryTabStyle}"
                                     IsChecked="{x:Bind ViewModel.IsLibraryTab, Mode=OneWay}" Checked="OnTabChecked" />
                        <RadioButton GroupName="LibraryTabs" Tag="Collections" Content="Collections" Style="{StaticResource LibraryTabStyle}"
                                     IsChecked="{x:Bind ViewModel.IsCollectionsTab, Mode=OneWay}" Checked="OnTabChecked" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1" Margin="48,16,48,0" Severity="Warning" IsClosable="True"
                 Message="{x:Bind ViewModel.ShuffleMessage, Mode=OneWay}"
                 IsOpen="{x:Bind ViewModel.HasShuffleMessage, Mode=TwoWay}" />

        <Grid Grid.Row="2">
            <!-- Page states -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.Name="Loading the library" />
            <StackPanel Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}" Spacing="8" MaxWidth="480"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="This library is not available" Style="{StaticResource SiloRowTitleTextStyle}" HorizontalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="It may have been removed, or this profile can't see it." Style="{StaticResource SiloBodyTextStyle}"
                           Foreground="{StaticResource SiloMutedBrush}" TextAlignment="Center" />
            </StackPanel>
            <StackPanel Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" Spacing="16" MaxWidth="480"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}" TextAlignment="Center" />
                <Button Content="Retry" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.RetryCommand}" />
            </StackPanel>

            <!-- Recommended: the library's rows. -->
            <ScrollViewer x:Name="RecommendedScroller" Visibility="{x:Bind ShowTab(ViewModel.IsReady, ViewModel.IsRecommendedTab), Mode=OneWay}">
                <StackPanel Padding="48,24,48,40">
                    <ProgressRing IsActive="{x:Bind ViewModel.Recommended.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.Recommended.IsLoading, Mode=OneWay}"
                                  Width="32" Height="32" Margin="0,48" HorizontalAlignment="Center" AutomationProperties.Name="Loading rows" />
                    <TextBlock Visibility="{x:Bind ViewModel.Recommended.IsEmpty, Mode=OneWay}" Margin="0,48" HorizontalAlignment="Center"
                               Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}"
                               Text="Nothing to recommend here yet. All titles are in the Library tab." />
                    <StackPanel Visibility="{x:Bind ViewModel.Recommended.HasError, Mode=OneWay}" Spacing="16" Margin="0,48" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Recommended.ErrorMessage, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}" TextAlignment="Center" />
                        <Button Content="Retry" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                                Command="{x:Bind ViewModel.Recommended.RetryCommand}" />
                    </StackPanel>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Recommended.Rows}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryRowViewModel">
                                <!-- Margin, not layout spacing: a hidden row must not leave a gap. -->
                                <controls:MediaRow Margin="0,0,0,40" Title="{x:Bind Title}" ItemsSource="{x:Bind Cards, Mode=OneWay}"
                                                   CardInvokedCommand="{x:Bind OpenCardCommand}" ExploreAllCommand="{x:Bind ExploreAllCommand}"
                                                   Visibility="{x:Bind HasCards, Mode=OneWay}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </ScrollViewer>

            <!-- Library: every title, with sort, filters and the A–Z bar. -->
            <Grid Visibility="{x:Bind ShowTab(ViewModel.IsReady, ViewModel.IsLibraryTab), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="LibraryScroller">
                    <StackPanel Padding="48,24,24,40" Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <DropDownButton Style="{StaticResource LibraryPillDropDownStyle}" Content="{x:Bind ViewModel.Browse.SortLabel, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind SortName(ViewModel.Browse.SortLabel), Mode=OneWay}">
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedLeft" Opening="OnSortMenuOpening" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <DropDownButton Style="{StaticResource LibraryPillDropDownStyle}" Content="{x:Bind ViewModel.Browse.OrderLabel, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind OrderName(ViewModel.Browse.OrderLabel), Mode=OneWay}">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <RadioMenuFlyoutItem Text="Ascending" GroupName="LibraryOrder" Command="{x:Bind ViewModel.Browse.SortAscendingCommand}"
                                                             IsChecked="{x:Bind Not(ViewModel.Browse.IsDescending), Mode=OneWay}" />
                                        <RadioMenuFlyoutItem Text="Descending" GroupName="LibraryOrder" Command="{x:Bind ViewModel.Browse.SortDescendingCommand}"
                                                             IsChecked="{x:Bind ViewModel.Browse.IsDescending, Mode=OneWay}" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button Style="{StaticResource LibraryPillButtonStyle}"
                                    AutomationProperties.Name="{x:Bind FiltersName(ViewModel.Browse.Filters.ActiveCount), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71C;" FontSize="14" />
                                    <TextBlock Text="Filters" />
                                    <Border Visibility="{x:Bind ViewModel.Browse.Filters.HasActiveFilters, Mode=OneWay}" Background="{StaticResource SiloPrimaryBrush}"
                                            CornerRadius="{StaticResource SiloPillCornerRadius}" MinWidth="20" Height="20" Padding="6,0">
                                        <TextBlock Text="{x:Bind CountText(ViewModel.Browse.Filters.ActiveCount), Mode=OneWay}" Style="{StaticResource SiloBadgeTextStyle}"
                                                   FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="FiltersFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnFiltersFlyoutOpening">
                                        <StackPanel Width="340" Spacing="18">
                                            <TextBlock Text="Filters" Style="{StaticResource SiloRowTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                                            <ComboBox Header="Genre" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Browse.Filters.GenreChoices}"
                                                      SelectedIndex="{x:Bind ViewModel.Browse.Filters.DraftGenreIndex, Mode=TwoWay}" />
                                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Browse.Filters.HasRatings, Mode=OneWay}">
                                                <TextBlock Text="Content rating" Style="{StaticResource SiloCaptionTextStyle}" />
                                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Browse.Filters.RatingOptions}">
                                                    <ItemsRepeater.Layout>
                                                        <UniformGridLayout MinItemWidth="72" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:LibraryFilterToggle">
                                                            <ToggleButton Content="{x:Bind Value}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                                                          CornerRadius="{StaticResource SiloPillCornerRadius}" />
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <NumberBox x:Name="YearFromBox" Header="Year from" PlaceholderText="Any" SpinButtonPlacementMode="Hidden"
                                                           Minimum="1" Maximum="9999" Value="{x:Bind ViewModel.Browse.Filters.DraftYearFrom, Mode=TwoWay}" />
                                                <NumberBox x:Name="YearToBox" Grid.Column="1" Header="Year to" PlaceholderText="Any" SpinButtonPlacementMode="Hidden"
                                                           Minimum="1" Maximum="9999" Value="{x:Bind ViewModel.Browse.Filters.DraftYearTo, Mode=TwoWay}" />
                                            </Grid>
                                            <TextBlock Visibility="{x:Bind ViewModel.Browse.Filters.HasOptionsError, Mode=OneWay}" TextWrapping="Wrap"
                                                       Style="{StaticResource SiloCaptionTextStyle}"
                                                       Text="Couldn't load the genres and ratings of this library. The year range still works." />
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <Button Content="Clear" Style="{StaticResource LibraryPillButtonStyle}"
                                                        Command="{x:Bind ViewModel.Browse.Filters.ClearCommand}" Click="OnFilterActionClick" />
                                                <Button Content="Apply" Style="{StaticResource SiloPrimaryButtonStyle}" MinHeight="38" Padding="20,6"
                                                        Command="{x:Bind ViewModel.Browse.Filters.ApplyCommand}" Click="OnFilterActionClick" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <TextBlock Text="{x:Bind ViewModel.Browse.Grid.TotalText, Mode=OneWay}" Style="{StaticResource SiloCaptionTextStyle}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>

                        <ProgressRing IsActive="{x:Bind ViewModel.Browse.Grid.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.Browse.Grid.IsLoading, Mode=OneWay}"
                                      Width="32" Height="32" Margin="0,48" HorizontalAlignment="Center" AutomationProperties.Name="Loading titles" />
                        <StackPanel Visibility="{x:Bind ViewModel.Browse.Grid.HasError, Mode=OneWay}" Spacing="16" Margin="0,48" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Browse.Grid.ErrorMessage, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}" TextAlignment="Center" />
                            <Button Content="Retry" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.Browse.Grid.RetryCommand}" />
                        </StackPanel>
                        <StackPanel Visibility="{x:Bind ShowBoth(ViewModel.Browse.Grid.IsEmpty, ViewModel.Browse.IsNarrowed), Mode=OneWay}"
                                    Spacing="16" Margin="0,48" HorizontalAlignment="Center">
                            <TextBlock Text="No titles match these filters" Style="{StaticResource SiloRowTitleTextStyle}" HorizontalAlignment="Center" />
                            <Button Content="Clear filters" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.Browse.ClearFiltersCommand}" />
                        </StackPanel>
                        <TextBlock Visibility="{x:Bind ShowFirstOnly(ViewModel.Browse.Grid.IsEmpty, ViewModel.Browse.IsNarrowed), Mode=OneWay}"
                                   Margin="0,48" HorizontalAlignment="Center" Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}"
                                   Text="This library has no titles yet." />

                        <controls:MediaGrid ItemsSource="{x:Bind ViewModel.Browse.Grid.Cards}" CardInvokedCommand="{x:Bind ViewModel.OpenItemCommand}"
                                            LoadMoreCommand="{x:Bind ViewModel.Browse.Grid.LoadMoreCommand}"
                                            Visibility="{x:Bind ViewModel.Browse.Grid.IsReady, Mode=OneWay}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.Browse.Grid.IsLoadingMore, Mode=OneWay}" Visibility="{x:Bind ViewModel.Browse.Grid.IsLoadingMore, Mode=OneWay}"
                                      Width="24" Height="24" HorizontalAlignment="Center" AutomationProperties.Name="Loading more titles" />
                        <StackPanel Visibility="{x:Bind ViewModel.Browse.Grid.HasLoadMoreError, Mode=OneWay}" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <TextBlock Text="Couldn't load more titles." Style="{StaticResource SiloCaptionTextStyle}" VerticalAlignment="Center" />
                            <Button Content="Retry" Style="{StaticResource LibraryPillButtonStyle}" Command="{x:Bind ViewModel.Browse.Grid.RetryLoadMoreCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <controls:AlphabetJumpBar Grid.Column="1" Margin="0,24,20,24" VerticalAlignment="Center"
                                          SelectedLetter="{x:Bind ViewModel.Browse.NamePrefix, Mode=OneWay}"
                                          LetterCommand="{x:Bind ViewModel.Browse.SelectLetterCommand}"
                                          Visibility="{x:Bind ViewModel.Browse.IsLetterBarVisible, Mode=OneWay}" />
            </Grid>

            <!-- Collections: shelves of collections; one opens as a grid of its titles. -->
            <ScrollViewer x:Name="CollectionsScroller" Visibility="{x:Bind ShowTab(ViewModel.IsReady, ViewModel.IsCollectionsTab), Mode=OneWay}">
                <StackPanel Padding="48,24,48,40">
                    <StackPanel Visibility="{x:Bind ViewModel.Collections.IsShelvesShown, Mode=OneWay}">
                        <ProgressRing IsActive="{x:Bind ViewModel.Collections.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.Collections.IsLoading, Mode=OneWay}"
                                      Width="32" Height="32" Margin="0,48" HorizontalAlignment="Center" AutomationProperties.Name="Loading collections" />
                        <StackPanel Visibility="{x:Bind ViewModel.Collections.IsEmpty, Mode=OneWay}" Spacing="8" Margin="0,48" HorizontalAlignment="Center">
                            <TextBlock Text="No collections yet" Style="{StaticResource SiloRowTitleTextStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Collections for this library will show up here." Style="{StaticResource SiloBodyTextStyle}"
                                       Foreground="{StaticResource SiloMutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Visibility="{x:Bind ViewModel.Collections.HasError, Mode=OneWay}" Spacing="16" Margin="0,48" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Collections.ErrorMessage, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}" TextAlignment="Center" />
                            <Button Content="Retry" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.Collections.LoadCommand}" />
                        </StackPanel>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Collections.Shelves}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:LibraryCollectionShelf">
                                    <StackPanel Spacing="14" Margin="0,0,0,40">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource SiloRowTitleTextStyle}" Visibility="{x:Bind HasTitle}"
                                                   AutomationProperties.HeadingLevel="Level2" />
                                        <controls:MediaGrid ItemsSource="{x:Bind Cards}" CardInvokedCommand="{x:Bind OpenCommand}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Visibility="{x:Bind ViewModel.Collections.IsCollectionOpen, Mode=OneWay}" Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Button Style="{StaticResource SiloIconButtonStyle}" Command="{x:Bind ViewModel.Collections.CloseCommand}"
                                    AutomationProperties.Name="Back to collections" ToolTipService.ToolTip="Back to collections">
                                <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            </Button>
                            <TextBlock Text="{x:Bind ViewModel.Collections.OpenCollectionTitle, Mode=OneWay}" Style="{StaticResource SiloPageTitleTextStyle}"
                                       VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Text="{x:Bind ViewModel.Collections.Items.TotalText, Mode=OneWay}" Style="{StaticResource SiloCaptionTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ProgressRing IsActive="{x:Bind ViewModel.Collections.Items.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.Collections.Items.IsLoading, Mode=OneWay}"
                                      Width="32" Height="32" Margin="0,48" HorizontalAlignment="Center" AutomationProperties.Name="Loading titles" />
                        <StackPanel Visibility="{x:Bind ViewModel.Collections.Items.HasError, Mode=OneWay}" Spacing="16" Margin="0,48" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Collections.Items.ErrorMessage, Mode=OneWay}" Style="{StaticResource SiloBodyTextStyle}" TextAlignment="Center" />
                            <Button Content="Retry" Style="{StaticResource SiloSecondaryButtonStyle}" HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.Collections.Items.RetryCommand}" />
                        </StackPanel>
                        <TextBlock Visibility="{x:Bind ViewModel.Collections.Items.IsEmpty, Mode=OneWay}" Margin="0,48" HorizontalAlignment="Center"
                                   Style="{StaticResource SiloBodyTextStyle}" Foreground="{StaticResource SiloMutedBrush}"
                                   Text="This collection has no titles this profile can see." />
                        <controls:MediaGrid ItemsSource="{x:Bind ViewModel.Collections.Items.Cards}" CardInvokedCommand="{x:Bind ViewModel.OpenItemCommand}"
                                            LoadMoreCommand="{x:Bind ViewModel.Collections.Items.LoadMoreCommand}"
                                            Visibility="{x:Bind ViewModel.Collections.Items.IsReady, Mode=OneWay}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.Collections.Items.IsLoadingMore, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.Collections.Items.IsLoadingMore, Mode=OneWay}"
                                      Width="24" Height="24" HorizontalAlignment="Center" AutomationProperties.Name="Loading more titles" />
                        <StackPanel Visibility="{x:Bind ViewModel.Collections.Items.HasLoadMoreError, Mode=OneWay}" Orientation="Horizontal" Spacing="12"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Couldn't load more titles." Style="{StaticResource SiloCaptionTextStyle}" VerticalAlignment="Center" />
                            <Button Content="Retry" Style="{StaticResource LibraryPillButtonStyle}"
                                    Command="{x:Bind ViewModel.Collections.Items.RetryLoadMoreCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
