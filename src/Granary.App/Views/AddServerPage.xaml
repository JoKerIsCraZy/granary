<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Granary.App.Views.AddServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <ResourceDictionary Source="ms-appx:///Themes/SiloAuth.xaml" />
    </Page.Resources>

    <!-- Silo's web login card with the words of the apps' server screen. -->
    <ContentControl Style="{StaticResource SiloAuthShellStyle}">
        <StackPanel Spacing="24">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Style="{StaticResource SiloAuthMarkStyle}" />
                    <TextBlock Grid.Column="1" Text="Connect to your Silo server" Style="{StaticResource SiloAuthTitleTextStyle}"
                               VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
                </Grid>
                <TextBlock Text="Type the address you use for Silo." Style="{StaticResource SiloAuthLeadTextStyle}" />
            </StackPanel>

            <StackPanel Spacing="16">
                <TextBox x:Name="AddressBox" Header="Server address" PlaceholderText="silo.example.org or 192.168.1.10:8090"
                         Style="{StaticResource SiloAuthTextBoxStyle}" InputScope="Url" KeyDown="OnAddressKeyDown"
                         Text="{x:Bind ViewModel.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Style="{StaticResource SiloAuthButtonStyle}" Command="{x:Bind ViewModel.ConnectCommand}"
                        Content="{x:Bind ConnectLabel(ViewModel.ConnectCommand.IsRunning), Mode=OneWay}" />
                <Button Content="Cancel" Style="{StaticResource SiloAuthOutlineButtonStyle}" Command="{x:Bind ViewModel.ConnectCancelCommand}"
                        Visibility="{x:Bind ViewModel.ConnectCommand.IsRunning, Mode=OneWay}" />
                <!-- Progress and refusals alike ("Trying …", "No Silo server answered …"). -->
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource SiloAuthTextStyle}" TextAlignment="Center"
                           Visibility="{x:Bind HasText(ViewModel.Status), Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ContentControl>
</Page>
