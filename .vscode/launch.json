{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Granary",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Granary.App/bin/Debug/net10.0-windows10.0.22621.0/win-x64/Granary.exe",
      "cwd": "${workspaceFolder}/src/Granary.App/bin/Debug/net10.0-windows10.0.22621.0/win-x64",
      "args": [],
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true
    },
    {
      "name": "Granary: play a video",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Granary.App/bin/Debug/net10.0-windows10.0.22621.0/win-x64/Granary.exe",
      "cwd": "${workspaceFolder}/src/Granary.App/bin/Debug/net10.0-windows10.0.22621.0/win-x64",
      "args": ["--play", "${input:videoPath}"],
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Attach to Granary",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ],
  "inputs": [
    {
      "id": "videoPath",
      "type": "promptString",
      "description": "Path or URL of a video",
      "default": "${workspaceFolder}/native/testmedia/sdr.mkv"
    }
  ]
}
