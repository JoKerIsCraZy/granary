# Read-only reference clones of the upstream Silo repositories (see docs/api-contract.md)
.ref/

# Build output
bin/
obj/
artifacts/
AppPackages/
BundleArtifacts/
*.msix
*.msixbundle
*.appx
*.appxbundle

# IDE and tooling state (shared VS Code workspace files are committed)
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.user
*.suo
*.userprefs
*.DotSettings.user

# Test results and coverage
TestResults/
coverage/
*.coverage
*.coveragexml
coverage.cobertura.xml

# NuGet
*.nupkg
*.snupkg
packages/

# Local secrets and environment (tokens, server URLs, credentials never go in git)
*.env
.env.*
appsettings.Local.json

# Native libmpv binaries are fetched by a script, not committed
/native/

# Plans and specs are working artifacts, not documentation
docs/superpowers/
