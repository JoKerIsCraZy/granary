<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Granary.Tests</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Granary.Core\Granary.Core.csproj" />
    <ProjectReference Include="..\..\src\Granary.Player\Granary.Player.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!-- Exercise the HWND boundary without loading the WinUI application. -->
  <ItemGroup>
    <Compile Include="..\..\src\Granary.App\Interop\CursorShield.cs" Link="Interop\CursorShield.cs" />
    <Compile Include="..\..\src\Granary.App\Controls\PlayerTime.cs" Link="Controls\PlayerTime.cs" />
    <Compile Include="..\..\src\Granary.App\Views\SettingsSearchPress.cs" Link="Settings\SettingsSearchPress.cs" />
  </ItemGroup>

  <!-- The phone remote's listener apart from its socket, the rule that picks the PC's LAN address, the PC's lock and the advertisement's answers apart from Windows: no test opens a socket, reads the adapters, asks Windows about the session or registers a service. -->
  <ItemGroup>
    <Compile Include="..\..\src\Granary.App\Services\RemoteAcceptLoop.cs" Link="Remote\App\RemoteAcceptLoop.cs" />
    <Compile Include="..\..\src\Granary.App\Services\DnssdAnswers.cs" Link="Remote\App\DnssdAnswers.cs" />
    <Compile Include="..\..\src\Granary.App\Services\DnssdRefusals.cs" Link="Remote\App\DnssdRefusals.cs" />
    <Compile Include="..\..\src\Granary.App\Services\AcceptedConnection.cs" Link="Remote\App\AcceptedConnection.cs" />
    <Compile Include="..\..\src\Granary.App\Services\LanAddressRule.cs" Link="Remote\App\LanAddressRule.cs" />
    <Compile Include="..\..\src\Granary.App\Services\SessionLockState.cs" Link="Remote\App\SessionLockState.cs" />
  </ItemGroup>

  <!-- libmpv integration tests skip themselves when the DLL has not been fetched. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\native\libmpv\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\libmpv\libmpv-2.dll')" />
  </ItemGroup>

</Project>
